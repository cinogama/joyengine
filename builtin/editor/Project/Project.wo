import pkg::std;
import pkg::toml;
import pkg::singleton;
import pkg::interface;
import pkg::fsys;
import pkg::try;
import pkg::worst;

import je;
import je::ecs;
import je::gui;
import je::internal;

import builtin::editor::Singleton;
import builtin::editor::Singleton::Universe;

import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::AskBox;
import builtin::editor::GUI::Statebar;

import builtin::editor::Editor::MainMenu;
import builtin::editor::Editor::Browser;
import builtin::editor::Editor::EntityList;
import builtin::editor::Editor::SystemList;
import builtin::editor::Editor::LogBrowser;
import builtin::editor::Editor::Inspector;
import builtin::editor::Editor::Material;
import builtin::editor::Editor::Shutdown;
import builtin::editor::Editor::WorldEditorViewport;
import builtin::editor::Editor::ResourcePath;

import NativeModuleCollection;

using je;
using toml;
using fsys;

using JEEditor;
using JEEditor::Editor;
using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Forms;
using JEEditor::GUI::Statebar;
using JEEditor::Singleton;

namespace JEEditor
{
    using Project = struct{
        m_shutdown_tombs: mut option<Tombs>,
        
        m_opened_worlds: map<path_t, void>,
        m_native_modules: NativeModuleCollection,
    }
    {
        /*
        编辑器正常退出时（参阅 builtin\editor\Editor\Shutdown.wo），会有一个
        针对 Project 的退出回调。
        此时，Project 会记录下当前编辑器的状态（例如还有哪些 World 出于打开状态）
        到正式退出时，Tomb 会按照单例的 temp 保存流程落盘
        */
        using Tombs = struct{
            // 世界文件路径 -> 该世界的编辑器状态（调试摄像机位姿 / 视口
            // 编辑模式等，由 WorldEditorViewport 编码为不透明 Toml）。
            // 键的出现本身即表示“下次启动需要打开这个世界”；
            // 值为空表表示该世界没有需要恢复的编辑器状态。
            m_worlds: map<path_t, Toml>,
        }
        {
            func save(self: Tombs)=> Toml
            {
                let dump = new_table();
                
                let worlds = new_table();
                for (let (path, state) : self.m_worlds)
                    worlds->set(path->to_string(), state);
                dump->set("worlds", worlds);
                
                return dump;
            }
            func restore(data: Toml)=> option<Tombs>
            {
                let mut worlds = {}mut: map<path_t, Toml>;
                match (data->get("worlds"))
                {
                    none?;
                    value(worlds_val)?
                    {
                        match (worlds_val->as_table)
                        {
                            none?;
                            value(worlds_tbl)?
                            {
                                for (let (pstr, state) : worlds_tbl)
                                    worlds->set(normalize(pstr), state);
                            }
                        }
                    }
                }
                
                return_value! Tombs{ m_worlds = worlds };
            }
        }
        
        public let SINGLETON_LABEL = "project";
        public let PROJECT_FILE_NAME = "project.je4project";
        
        func startUpEditorGUI()
        {
            gui::register_exit_callback(func(){
                    do AskBox::show(
                        "即将退出编辑器",
                        "JoyEngine 将在所有编辑器窗口关闭后退出，继续关闭？")
                        ->onYes(
                            func()
                            {
                                Shutdown::editorShutdownRequest(
                                    Singleton::Universe::getUniverse());
                            });
                    return false;
                });
                
            // 开启主菜单
            MainMenu::registerMainMenu();
            
            // 默认启动的编辑器窗口
            Browser::showBrowser();
            EntityList::showEntityList();
            SystemList::showSystemList();
            LogBrowser::showLogBrowser();
            Inspector::showInspector();
            Material::showMaterial();
            
            let runtime_path = fsys::workpath();
            
            internal::set_runtime_path(fsys::workpath()->to_string);
            
            // 展示第一条信息
            Statebar::showState(3.) <| func(){
                je::gui::TextDisabled(F"JoyEngine 4.X, 当前工作路径: {runtime_path->to_string}");
            };
        }
        
        public func createAndLoad(toml: option<Toml>)=> Project
            where require!(Project: ISingleton);
        {
            let proj = Project{
                m_shutdown_tombs = mut option::none,
                m_opened_worlds = {}mut,
                m_native_modules = NativeModuleCollection::create(),
            };
            
            match (load(workpath() / PROJECT_FILE_NAME))
            {
                ok(data)?
                {
                    do try!{
                        try! modules = data->get("modules")=>>\t = t->as_table;;
                        for (let (name, module_path): modules)
                        {
                            do try!
                            {
                                try! path = module_path->as_string;
                                if (proj.m_native_modules->reload(
                                        name,
                                        ResourcePath::toLocalResourcePath(path)))
                                {
                                    throw!;
                                }
                                return_value!;
                            }
                            catch!
                            {
                                MsgBox::msg("加载模块失败", F"加载模块 {name} 失败。");
                            };
                        }
                        return_value!;
                    };
                    
                    startUpEditorGUI();
                }
                err(msg)?
                    MsgBox::err("加载项目失败", F"项目文件损坏，因此无法打开:\n{msg}");
            }
            
            match (toml=>> \data = Tombs::restore(data);)
            {
                none?;
                value(tombs)?
                {
                    for (let (p, state) : tombs.m_worlds)
                    {
                        if (isfile(p))
                        {
                            let mut editor_state = option::none: option<Toml>;
                            if (state->len > 0)
                                editor_state = option::value(state);
                                
                            WorldEditorViewport::openWorldEditorViewportFromFile(
                                p, editor_state);
                        }
                    }
                }
            }
            
            return proj;
        }
        public func save(self: Project)=> option<Toml>
        {
            /* TODO: 在此处将 Project 数据保存为 Toml，然后写入 PROJECT_FILE_NAME */
            let project_file_path = workpath() / PROJECT_FILE_NAME;
            
            let project_toml = new_table();
            
            /* Module list */
            let native_modules = new_table();
            for (let (name, path) : self.m_native_modules->getAllLoadedModuleNameAndPath)
            {
                native_modules->set(name, ResourcePath::toRuntimeResourcePath(path));
            }
            project_toml->set("modules", native_modules);
            
            match (toml::save(project_toml, project_file_path))
            {
                ok(_)?;
                err(msg)?
                    logerr(F"保存项目文件失败: {msg}");
            }
            
            /* save 被调用时，引擎的几乎全部上下文都已经被关闭（包括 Universe），此时正好清理 native modules */
            self.m_native_modules->dropAllModuleWhileProjectExist();
            
            /*
            Project 的单例上下文分成两部分，一部分属于手动处理的 project.je4project
            另外一部分数据归属默认的单例上下文存储，保存到 .temp 目录下。
            */
            return option::value(
                self.m_shutdown_tombs
                    ->> \tombs = tombs->save;
                    -> or(new_table())
                    );
        }
        
        /* --------------------------------------------- */
        public func dumpTombs()
        {
            apply:<Project>(
                func(proj){
                    // 收集每个已打开世界视口的编辑器状态（调试摄像机位姿/
                    // 视口编辑模式），以规范化路径为键。
                    let mut states = {}mut: map<path_t, Toml>;
                    for (let vp : WorldEditorViewport::getAllViewports())
                    {
                        match (vp->getSavingPath)
                        {
                            none?;
                            value(path)?
                                states->set(
                                    normalize(path->to_string()),
                                    vp->dumpEditorStateToml());
                        }
                    }
                    
                    // 合并“下次需打开的世界”与“各自的编辑器状态”：
                    // 以编辑器记录的已打开世界为准，逐个取出对应状态，
                    // 没有状态的世界以空表占位（下次启动仍会打开）。
                    let mut worlds = {}mut: map<path_t, Toml>;
                    for (let p : proj.m_opened_worlds->keys)
                    {
                        let np = normalize(p->to_string);
                        worlds->set(np, states->get(np)->or(new_table()));
                    }
                    
                    proj.m_shutdown_tombs = option::value(Tombs{ m_worlds = worlds });
                });
        }
        public func worldOpen(world_path: path_t)
        {
            apply:<Project>(
                func(proj){
                    assert(proj.m_opened_worlds->insert(world_path, do nil));
                });
        }
        public func worldClose(world_path: path_t)
        {
            apply:<Project>(
                func(proj){
                    assert(proj.m_opened_worlds->remove(world_path));
                });
        }
    }
}
