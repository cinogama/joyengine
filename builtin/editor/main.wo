import woo::std;

import je;
import je::internal;

import pkg::singleton;
import pkg::interface;

import GUI::Windows;

using std;
using je;

namespace JEEditor
{
    using Environment = struct{
        m_universe: universe,
    }
    {
        public func create()=> Environment
        {
            let u = universe::create();
            je::internal::init_graphic_pipeline_for_editor(u);
            
            return Environment{
                m_universe = u,
            };
        }
        public func wait(self: Environment)
        {
            self.m_universe->wait;
        }
    }
    
    using DemoWindows = struct{}
    {
        import je::gui;
        using je::gui;

        public func create()=> DemoWindows
            where require!(DemoWindows: GUI::Windows::IWindows);
        {
            return DemoWindows{};
        }

        public func getAttrib(_: DemoWindows)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_None;
        }
        public func getTitle(_: DemoWindows)=> string
        {
            return "Example$ID";
        }
        public func run(_: DemoWindows)=> bool
        {
            Text("Helloworld~");

            return true;
        }
    }
}

func main()
{
    // 编辑器脚本退出之前清掉所有单例实例
    defer singleton::unsafe::reset_all_singleton();
    
    // 创建一个 Universe，之后编辑器将在这上面运行
    let e = JEEditor::Environment::create();
    defer e->wait();

    je::internal::set_window_size(1920, 1080);

    do JEEditor::GUI::Windows::show(JEEditor::DemoWindows::create());
    do JEEditor::GUI::Windows::show(JEEditor::DemoWindows::create());
}

main();
