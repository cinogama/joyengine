import woo::std;

import je;
import je::gui;
import je::ecs;
import je::graphic;
import je::internal;

import pkg::singleton;
import pkg::interface;
import pkg::fsys;

import GUI::Windows;
import GUI::Menu;
import GUI::Statebar;

import GUI::Forms::MsgBox;
import GUI::Forms::AskBox;

import Editor::Browser;
import Editor::EntityList;
import Editor::LogBrowser;
import Editor::MainMenu;
import Editor::Inspector;
import Editor::Material;
import Editor::ReplConsole;
import Editor::PanicBox;
import Editor::Shutdown;

import Inspector::Universe;

using std;
using je;
using je::internal;
using JEEditor;
using JEEditor::Editor;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Forms;

func main()
{
    // 设置当前引擎的运行时路径
    let origin_runtime_path = get_runtime_path();

    set_runtime_path(fsys::workpath()->to_string);
    defer set_runtime_path(origin_runtime_path);

    // 编辑器脚本退出之前清掉所有单例实例
    defer singleton::unsafe::reset_all_singleton();

    // 载入默认的类型值编辑器
    do towoo::unsafe::dynamic_parser::update_all("!/builtin/script/types.wo")->unwrap;
    
    // 注册 Woolang Panic 回调：当脚本运行时发生 panic 时，
    // 弹出 PanicBox 展示错误原因、位置与调用栈。
    // 回调参数依次为: src_file, lineno, functionname, rterrcode, reason, trace
    internal::register_panic_hook(
        \file, line, funcname, errcode, reason, trace =
            Editor::PanicBox::show(file, line, funcname, errcode, reason, trace););
            
    // 创建一个 Universe，之后编辑器将在这上面运行
    let u = Inspector::Universe::UniverseCtx::instance()->getUniverse();
    gui::register_exit_callback(func(){
            match (AskBox::showUnique(
                "即将退出编辑器", 
                "JoyEngine 将在所有编辑器窗口关闭后退出，继续关闭？"))
            {
                none?;
                value(askbox)?
                {
                    do askbox->onYes(
                        func()
                        {
                            Shutdown::editorShutdownRequest(u);
                        });
                }
            }
            return false;
        });
    defer {
        u->wait();
        gui::unregister_exit_callback();
        
        // 关闭上下文
        u->close();
    }
    
    // 编辑器，直接初始化图形处理流程。
    je::internal::init_graphic_pipeline_for_editor(u);
    
    // 开启状态栏
    JEEditor::GUI::Statebar::start();

    // 开启主菜单
    JEEditor::Editor::MainMenu::registerMainMenu();
    
    // 默认启动的编辑器窗口
    do Browser::showBrowser();
    do EntityList::showEntityList();
    do LogBrowser::showLogBrowser();
    do Inspector::showInspector();
    do Material::showMaterial();

    // 展示第一条信息
    JEEditor::GUI::Statebar::showState(24., 3.) <| func(){
        je::gui::Text(F"当前工作路径: {fsys::workpath()->to_string}");
    };
}

main();
