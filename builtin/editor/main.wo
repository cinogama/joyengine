import woo::std;

import je;
import je::ecs;
import je::graphic;
import je::internal;

import pkg::singleton;
import pkg::interface;

import GUI::Windows;
import GUI::Menu;

import GUI::Forms::MsgBox;
import GUI::Forms::AskBox;

import Editor::Browser;
import Editor::EntityList;
import Editor::LogBrowser;
import Editor::MainMenu;
import Editor::Inspector;
import Editor::ReplConsole;
import Editor::PanicBox;

import Inspector::Universe;

using std;
using je;

using JEEditor;
using JEEditor::Editor;
using JEEditor::GUI::Windows;

func main()
{
    // 编辑器脚本退出之前清掉所有单例实例
    defer singleton::unsafe::reset_all_singleton();
        
    // 注册 Woolang Panic 回调：当脚本运行时发生 panic 时，
    // 弹出 PanicBox 展示错误原因、位置与调用栈。
    // 回调参数依次为: src_file, lineno, functionname, rterrcode, reason, trace
    internal::register_panic_hook(
        \file, line, funcname, errcode, reason, trace =
            Editor::PanicBox::show(file, line, funcname, errcode, reason, trace););
    
    // 创建一个 Universe，之后编辑器将在这上面运行
    let u = Inspector::Universe::UniverseCtx::instance()->getUniverse();
    defer u->wait();
    
    // 编辑器，直接初始化图形处理流程。
    je::internal::init_graphic_pipeline_for_editor(u);
    
    JEEditor::Editor::MainMenu::registerMainMenu();

    do Browser::showBrowser();
    do EntityList::showEntityList();
    do LogBrowser::showLogBrowser();
    do Inspector::showInspector();
}

main();
