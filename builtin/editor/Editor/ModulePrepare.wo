import pkg::std;
import pkg::interface;
import pkg::fsys;
import pkg::iterator;
import pkg::thread;
import pkg::list;
import pkg::try;
import pkg::filestream;
import pkg::buffer;
import pkg::platform;
import pkg::process;

import je;
import je::gui;

import builtin::editor::Editor::Template;

import builtin::editor::GUI::Windows;

using fsys;
using iterator;
using thread;
using filestream;
using je::gui;
using JEEditor::GUI::Windows;

namespace JEEditor::Editor
{
    // 模块装载进度窗口
    //
    // 模态的异步任务执行窗口：create 在后台线程运行 thread_job，
    // 工作线程通过 postMessage 投递进度消息到 m_msg_list，
    // UI 协程每帧在 run 中加锁排空 m_msg_list 并显示，同时同步 m_finished/m_error。
    // m_module_state_mx 保护全部跨线程可变状态（m_msg_list / m_finished / m_error）。
    using ModulePrepare = struct{
        m_module_state_mx: mutex,

        // 工作线程 → 窗口的消息队列（受 m_module_state_mx 保护）
        m_msg_list: list<string>,
        // 窗口显示缓冲：仅 UI 协程访问，无需加锁
        m_logbuf: list<string>,

        m_finished: mut bool,
        // 任务结束时的错误信息，none 表示成功（受 m_module_state_mx 保护）
        m_error: mut option<string>,
    }
    {
        public func create(thread_job: (ModulePrepare)=> result<void, string>)=> ModulePrepare
            where require!(ModulePrepare: IWindows);
        {
            let self = ModulePrepare{
                m_module_state_mx = mutex::create(),
                m_msg_list = list::create:<string>(),
                m_logbuf = list::create:<string>(),
                m_finished = mut false,
                m_error = mut option::none,
            };

            do thread::create(func(){
                    let job_result = thread_job(self);

                    self.m_module_state_mx->lock();
                    defer self.m_module_state_mx->unlock();

                    match (job_result)
                    {
                        ok(_)? self.m_error = option::none;
                        err(message)? self.m_error = option::value(message);
                    }
                    self.m_finished = true;
                });
            return self;
        }

        // 工作线程调用：投递一条进度消息，窗口的 run 会在后续帧接收并显示。
        public func postMessage(self: ModulePrepare, message: string)=> void
        {
            self.m_module_state_mx->lock();
            defer self.m_module_state_mx->unlock();

            do self.m_msg_list->add(message);
        }

        // UI 协程调用：把工作线程投递的消息全部转移到显示缓冲，返回转移条数。
        func drainMessages(self: ModulePrepare)=> int
        {
            self.m_module_state_mx->lock();
            defer self.m_module_state_mx->unlock();

            let mut drained = 0;
            for (;;)
            {
                match (self.m_msg_list->pop_front())
                {
                    none? break;
                    value(message)?
                    {
                        do self.m_logbuf->add(message);
                        drained += 1;
                    }
                }
            }
            return drained;
        }

        // UI 协程调用：读取任务结束状态，返回 (是否已结束, 错误信息，none 表示成功)。
        func takeState(self: ModulePrepare)=> (bool, option<string>)
        {
            self.m_module_state_mx->lock();
            defer self.m_module_state_mx->unlock();

            return (self.m_finished, self.m_error);
        }

        public func getTitle(_: ModulePrepare)=> string
        {
            return "模块装载器";
        }
        public func getAttrib(_: ModulePrepare)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse;
        }
        public func getSizeConstraints(_: ModulePrepare)=> SizeConstraints
        {
            return SizeConstraints::Limited(((480., 320.), (4096., 4096.)));
        }
        public func isModal(_: ModulePrepare)=> bool
        {
            return true;
        }
        public func run(self: ModulePrepare)=> bool
        {
            let new_message_count = self->drainMessages();
            let (finished, error) = self->takeState();

            // 状态行：运行中显示动画提示，结束后按成败着色
            if (!finished)
            {
                let phase = ((GetTime() * 2.) as int) % 4;
                let busy_text = phase == 0 ? "正在执行，请稍候"
                    | phase == 1 ? "正在执行，请稍候."
                    | phase == 2 ? "正在执行，请稍候.."
                    | "正在执行，请稍候...";
                TextColored((120, 190, 255, 255), busy_text);

                // 不定进度条：0~1 往返，表示任务仍在推进
                let bar_phase = ((GetTime() * 1.5) as int) % 8;
                let bar_value = bar_phase < 4
                    ? bar_phase as real / 4.
                    | (8 - bar_phase) as real / 4.;
                ProgressBar(bar_value);
            }
            else
            {
                match (error)
                {
                    none? TextColored((110, 220, 110, 255), "执行完成。");
                    value(errmsg)?
                    {
                        TextColored((255, 90, 90, 255), "执行失败：");
                        PushTextWrapPos(0.);
                        TextColored((240, 110, 110, 255), errmsg);
                        PopTextWrapPos();
                    }
                }
            }

            Separator();

            // 消息日志区：自动滚动到底部（有新消息时）
            let avail = GetContentRegionAvail();
            if (BeginChildSizeFlags("##ModulePrepareMessages",
                    avail.0, avail.1 - (finished ? 30. | 0.),
                    WindowsAttribute::ImGuiWindowFlags_HorizontalScrollbar))
            {
                PushTextWrapPos(0.);
                if (self.m_logbuf->empty)
                {
                    TextDisabled("（暂无消息）");
                }
                else
                {
                    let mut line_iter = self.m_logbuf->iter();
                    for (;;)
                    {
                        match (line_iter->next())
                        {
                            none? break;
                            value(line)? Text(line);
                        }
                    }
                }
                PopTextWrapPos();

                if (new_message_count > 0)
                    SetScrollHereY(1.);
            }
            EndChild();

            if (finished && Button("关闭"))
                return false;

            return true;
        }
        
        /* -------------------------------------- */
        enum BuildConfig
        {
            DEBUG,
            RELEASE,
        }

        func configName(config: BuildConfig)=> string
        {
            return config == BuildConfig::DEBUG ? "debug" | "relwithdebinfo";
        }

        // 链接时使用的引擎核心库文件名，随平台位数与配置变化
        func engineCoreLibLinkFilename(libname: string, config: BuildConfig)=> string
        {
            let isdebug = config == BuildConfig::DEBUG;

            return libname
                + (platform::bit_width == 32 ? "32" | "")
                + (isdebug ? "_debug" | "")
                + (platform::os == platform::Os::WINDOWS
                    ? ".lib"
                    | platform::os == platform::Os::MACOS
                    ? ".a"
                    | ".so")
                ;
        }

        func writeAllText(file_path: path_t, content: string)
        {
            try! f = open(file_path, mode::write)
                -> ok_or(F"无法创建文件 {file_path->to_string}");

            defer do f->close;

            let content_buf = content as buffer;
            if (!f->write(content_buf, 0, content_buf->len))
                throw! F"写入文件 {file_path->to_string} 失败";

            return_ok!;
        }

        // 收集目录下全部头文件名（不含扩展名），目录不存在时返回空数组
        func collectHeaderPurenames(dir: path_t)=> array<string>
        {
            return subpath(dir)
                ->> \childs = childs
                    ->  forall(\f = isfile(f) && extension(f)->lower == ".hpp";)
                    ->> \f = purename(f);
                    ;
                ->  or([]);
        }

        func joinLines(lines: array<string>)=> string
        {
            return lines->reduce(\l, r = l + "\n" + r;)->or("");
        }

        // 启动进程并等待结束，退出码非0视为失败
        func startProcessAndWait(exec: path_t, args: array<string>, failmsg: string)
        {
            match (process::create(exec, args))
            {
                none? throw! F"无法启动进程：{exec->to_string}";
                value(proc)?
                {
                    match (process::wait(proc))
                    {
                        err(eno)? throw! F"{failmsg}（{eno}）";
                        ok(status)?
                        {
                            if (status != 0 as process::status_t)
                                throw! failmsg;
                        }
                    }
                }
            }

            return_ok!;
        }

        // 为指定的C++模块目录生成loader.hpp与CMakeLists.txt，
        // 刷新.engine内的引擎链接库，最后调用CMake完成配置与编译。
        public func buildCppModuleDir(path: path_t, name: string, config: BuildConfig)
        {
            // 1. 定位CMake
            try! cmake_env = platform::env("CMAKE")
                -> ok_or("无法读取CMake路径，请检查CMake配置和环境变量");

            let cmake_path = normalize(cmake_env);
            if (!isfile(cmake_path))
                throw! F"无法找到{cmake_path->to_string}，请检查CMake配置和环境变量";

            // 2. 扫描components与systems目录，生成loader.hpp
            let component_names = collectHeaderPurenames(path / "components");
            let system_names = collectHeaderPurenames(path / "systems");

            try! loader_template = Template::load(Template::Type::NATIVE_MODULE_LOADER_HPP)
                -> ok_or("读取模板文件失败 loader.hpp");

            let loader_src = loader_template
                ->replace("$$INCLUDE_COMPONENT_HEADERS$$",
                    joinLines(component_names->map(\f = F"#include \"{f}.hpp\"";)))
                ->replace("$$INCLUDE_SYSTEM_HEADERS$$",
                    joinLines(system_names->map(\f = F"#include \"{f}.hpp\"";)))
                ->replace("$$REGISTER_COMPONENT_TYPES$$",
                    joinLines(component_names->map(\f = F"        typing::register_type<{name}::{f}>(guard, \"{name}::{f}\");";)))
                ->replace("$$REGISTER_SYSTEM_TYPES$$",
                    joinLines(system_names->map(\f = F"        typing::register_type<{name}::{f}>(guard, \"{name}::{f}\");";)));

            try! _ = writeAllText(path / "loader.hpp", loader_src);

            // 3. 生成CMakeLists.txt
            try! cmake_template = Template::load(Template::Type::NATIVE_MODULE_CMAKELISTS)
                -> ok_or("读取模板文件失败 CMakeLists.txt");

            try! _ = writeAllText(
                path / "CMakeLists.txt",
                cmake_template->replace("$$JEMODULE_PROJECT_NAME$$", name));

            // 4. 从引擎根目录刷新.engine内的引擎链接库
            let engine_root = normalize(std::host_path());
            let engine_library_dir = path / ".engine" / "library";

            do remove(path / ".engine");
            try! _ = mkdir(path / ".engine")
                -> or_map(\eno = F"创建 .engine 目录失败：{eno}";);
            try! _ = mkdir(engine_library_dir)
                -> or_map(\eno = F"创建 .engine/library 目录失败：{eno}";);

            for (let p : walk(engine_root)->iter_result)
            {
                if (isfile(p))
                {
                    let ext = extension(p)->lower;
                    let lower_fname = filename(p)->lower;
                    if ((ext == ".lib" || ext == ".so" || ext == ".dylib")
                        && (lower_fname->begin_with("libjoyecs")
                            || lower_fname->begin_with("libwoo")))
                    {
                        try! _ = copy(p, engine_library_dir / filename(p))
                            -> or_map(\eno = F"复制文件：`{p}` 失败（{eno}）";);
                    }
                }
            }

            // 5. 生成编译配置并编译
            let config_name = configName(config);
            let building_dir = path / F".build_{config_name}";
            let core_lib_filename = engineCoreLibLinkFilename("libjoyecs", config);
            let engine_include_path = engine_root / "builtin" / "include";

            try! _ = startProcessAndWait(cmake_path,
                [
                    cmake_path->to_string,
                    path->to_string,
                    "-B", building_dir->to_string,
                    F"-DCMAKE_BUILD_TYPE={config_name}",
                    "-DBUILD_SHARED_LIBS=ON",
                    F"-DJEMODULE_ENGINE_CORE_LIB_FILENAME={core_lib_filename}",
                    F"-DJEMODULE_ENGINE_CORE_INCLUDE_PATH={engine_include_path}",
                ],
                "CMake生成失败");

            try! _ = startProcessAndWait(cmake_path,
                [
                    cmake_path->to_string,
                    "--build", building_dir->to_string,
                    "--config", config_name,
                    "-j", thread::concurrency() as string,
                ],
                "C++编译失败");

            return_ok!;
        }
        public func createNewCppModuleDir(path: path_t, name: string)
        {
            if (walk(path) |> iter_result |> collect->empty == false)
                throw! F"目标目录 `{path}` 不为空";
                
            func create_source_dir(name: string)
            {
                try! dir_path = mkdir(path / name)
                    -> or_map(\eno = F"创建 {name} 目录失败： {eno}";);
                    
                try! f = open(dir_path / ".gitkeepme", mode::write)
                    -> ok_or(F"在 {name} 目录创建 .gitkeepme 失败");
                    
                defer do f->close;
                
                return_ok!;
            }
            
            try! _ = create_source_dir("systems");
            try! _ = create_source_dir("components");
            try! _ = create_source_dir("sources");
            
            /* Create files */
            func create_file_with_content(fname: string, type: Template::Type)
            {
                try! template_content =
                    Template::load(type)
                        -> ok_or(F"读取模板文件失败 {fname}");
                        
                try! f = open(path / fname, mode::write)
                    -> ok_or(F"无法创建文件 {fname}");
                    
                defer do f->close;
                
                let template_content_buf = template_content as buffer;
                if (!f->write(template_content_buf, 0, template_content_buf->len))
                    throw! F"写入文件 {fname} 失败";
                
                return_ok!;
            }
            
            try! _ = create_file_with_content(".gitignore", Template::Type::NATIVE_MODULE_GITIGNORE);
            try! _ = create_file_with_content("main.cpp", Template::Type::NATIVE_MODULE_MAIN_CPP);

            try! _ = buildCppModuleDir(path, name, BuildConfig::DEBUG);

            return_ok!;
        }
    }
}
