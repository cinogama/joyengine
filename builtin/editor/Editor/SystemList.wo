import woo::std;

import je::internal;
import je::ecs;
import je::gui;
import je::typeinfo;

import pkg::interface;
import pkg::worst;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Forms::AskBox;

import WorldEditorViewport;
import Action::AddWorldSystem;
import Action::RemoveWorldSystem;
import Action::AddRuntimeSystem;
import Action::RemoveRuntimeSystem;
import Action::SwitchSystemGroup;

using std;
using je;
using je::gui;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Forms;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    // 系统列表：展示并管理当前编辑世界的两组系统——
    //   运行时：已 add_system 到世界，编辑器内正在运行（如图形系统）；
    //   调试时：保存在 WorldEditorViewport 中，仅在开始调试执行
    //   或导出时才会 add_system（调试/导出功能暂未支持）。
    // 组的含义通过悬浮分组标题的气泡提示展示。增删与两组之间的转换
    // 均通过 doAction 发布，支持撤销/重做并参与未保存判定；
    // 移除操作会先弹窗确认。
    using SystemList = struct{
        m_close: mut bool,
    }
    {
        let mut s_systemlist_singleton = option::none: option<SystemList>;

        // “添加系统”选择弹窗的状态；面板是单例，用模块级状态即可
        let mut s_add_system_filter = "";
        let mut s_add_system_focus = false;
        // 弹窗中“添加到哪一组”的选择：true=运行时，false=调试时
        let mut s_add_system_immediate = true;

        public func isSystemListExist()
        {
            return s_systemlist_singleton->is_value;
        }
        public func showSystemList()
        {
            do show(create());
        }
        public func closeSystemList()
        {
            match (s_systemlist_singleton)
            {
                none?;
                value(systemlist_instance)?
                    systemlist_instance->close();
            }
        }

        func create()=> SystemList
            where require!(SystemList: IWindows);
        {
            return SystemList{
                m_close = mut false,
            };
        }
        func close(self: SystemList)
        {
            self.m_close = true;
        }
        public func onCreate(self: SystemList)=> void
        {
            s_systemlist_singleton = option::value(self);
        }
        public func onClose(_: SystemList)=> void
        {
            s_systemlist_singleton = option::none;
        }
        public func getTitle(_: SystemList)=> string
        {
            return "系统列表";
        }
        public func getSizeConstraints(_: SystemList)=> SizeConstraints
        {
            return SizeConstraints::Limited(((260., 200.), (420., 4096.)));
        }

        // 将 "Transform::LocalPosition" 拆为 ("Transform", "LocalPosition")，
        // 不带命名空间的类型名返回 ("", 原名)。
        func splitTypeName(cname: string)=> (string, string)
        {
            let sep_pos = cname->find("::")->or(-1);
            if (sep_pos < 0)
                return ("", cname);
            return (cname->sub_len(0, sep_pos), cname->sub(sep_pos + 2));
        }

        // 移除系统前弹窗确认，避免误触；确认后才发布移除动作
        func requestRemoveSystem(wctx: WorldEditorViewport, systype: typeinfo, is_world_system: bool)=> void
        {
            let name = systype->name;
            do AskBox::show("移除系统", F"确认移除系统 \"{name}\" 吗？")
                ->onYes(func() {
                    if (is_world_system)
                        wctx->doAction(RemoveWorldSystem::create(systype, wctx->getWorld));
                    else
                        wctx->doAction(RemoveRuntimeSystem::create(systype));
                })
            ;
        }

        // 一行系统条目：与检视面板组件栏一致的带底色整行 + 行尾 × 移除按钮
        // （悬停红色）+ 右键上下文菜单。行内只显示短名
        // （悬停提示完整类型名）。
        func showSystemEntryRow(
            wctx: WorldEditorViewport, tag: string, systype: typeinfo, is_world_system: bool)=> void
        {
            let (_, short_name) = splitTypeName(systype->name);
            let row_label = F"{short_name}##{tag}";

            // Framed 叶子节点：无折叠箭头但带底色框，样式与检视面板的
            // 组件折叠头一致；SpanAvailWidth 让命中区横跨整行，
            // AllowItemOverlap 允许行尾 × 按钮抢占重叠区域的悬停与点击
            do TreeNodeEx(row_label,
                TreeNodeAttribute::ImGuiTreeNodeFlags_Leaf
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_Framed
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_AllowItemOverlap
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_SpanAvailWidth
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_NoTreePushOnOpen);
            if (IsItemHovered())
                do SetTooltip(systype->name);

            // 右键系统项弹出菜单；显式绑定到行的标签上，且紧跟行项调用
            // （悬停检测基于最后绘制的项），避免误绑到随后的 × 按钮
            if (BeginPopupContextItemLabel(row_label))
            {
                if (MenuItem("移除"))
                    requestRemoveSystem(wctx, systype, is_world_system);

                Separator();

                let switch_label = is_world_system
                    ? "转换为调试时启用" | "转换为运行时启用";
                if (MenuItem(switch_label))
                    wctx->doAction(SwitchSystemGroup::create(
                        systype, wctx->getWorld, !is_world_system));

                defer EndPopup();
            }

            // 行尾 × 移除按钮：平时与行融为一体，悬停时红色提示危险操作
            SameLine();
            let (cursor_x, cursor_y) = GetCursorPos();
            let (avail_width, _) = GetContentRegionAvail();
            SetCursorPos((cursor_x + avail_width - 28., cursor_y));
            PushStyleColor(ImGuiCol::ImGuiCol_Button, (0, 0, 0, 0));
            PushStyleColor(ImGuiCol::ImGuiCol_ButtonHovered, (140, 40, 40, 255));
            PushStyleColor(ImGuiCol::ImGuiCol_ButtonActive, (190, 55, 55, 255));
            if (ButtonSize(F"×##{tag}_remove", (24., 0.)))
                requestRemoveSystem(wctx, systype, is_world_system);
            PopStyleColor(3);
        }

        // 绘制一组系统：带数量的分组标题 + 条目列表。组的含义通过悬浮
        // 标题的气泡提示展示；系统不按命名空间分小节，仅区分两组。
        func showSystemGroup(
            wctx: WorldEditorViewport,
            systems: array<typeinfo>,
            tag_prefix: string,
            is_world_system: bool,
            title: string,
            description: string)=> void
        {
            // 编辑器内部系统（Editor::*）不在系统列表中显示
            let visible = systems
                ->forall(\stype = !stype->name->begin_with("Editor::");)
                |> sort(\l, r = l->name < r->name;);

            SeparatorText(F"{title}（{visible->len}）");
            if (IsItemHovered())
                do SetTooltip(description);

            for (let systype : visible)
                showSystemEntryRow(wctx, F"{tag_prefix}_{systype->name}", systype, is_world_system);

            if (visible->len == 0)
                TextDisabled("（空）");
        }

        // “添加系统”选择弹窗：先选择添加到哪一组，再搜索过滤 +
        // 候选列表（悬停提示完整类型名）。选中一项立即发布添加操作且
        // 保持弹窗打开，便于连续添加；已在任意一组中的系统自下一帧起
        // 从候选中消失。
        func showAddSystemPicker(wctx: WorldEditorViewport)=> void
        {
            // 弹窗大小由内容自适应；若控件用 -1 占满宽度，弹窗自身没有
            // 可参考的实宽，会塌缩成细条，因此这里给控件显式像素宽度
            let picker_width = 300.;

            if (RadioButton("运行时", s_add_system_immediate))
                s_add_system_immediate = true;
            if (IsItemHovered())
                do SetTooltip("添加后立即 add_system 到世界，编辑器内马上运行");

            SameLine();
            if (RadioButton("调试时", !s_add_system_immediate))
                s_add_system_immediate = false;
            if (IsItemHovered())
                do SetTooltip("保存在世界中，仅在开始调试执行或导出时才会 add_system");

            Spacing();

            SetNextItemWidth(picker_width);
            if (s_add_system_focus)
            {
                SetKeyboardFocusHere(0);
                s_add_system_focus = false;
            }
            match (InputText("##add_system_filter", s_add_system_filter))
            {
                none?;
                value(new_filter)?
                    s_add_system_filter = new_filter;
            }

            let filter_lower = s_add_system_filter->lower;
            let has_filter = filter_lower->len > 0;

            // 候选为全部已注册系统，排除编辑器内部系统（Editor::*）、
            // 两组中已存在的系统以及不匹配搜索词的系统（按含命名空间的全名匹配）
            let candidates = typeinfo::get_all_systems_types()
                ->forall(\stype = !stype->name->begin_with("Editor::") &&
                            !wctx->hasWorldSystem(stype) &&
                            !wctx->hasRuntimeSystem(stype) &&
                            (!has_filter ||
                                stype->name->lower->find(filter_lower)->is_value);)
                |> sort(\l, r = l->name < r->name;);

            // 列表高度固定为约 8 行，避免候选过多时撑爆弹窗
            if (BeginListBox("##add_system_candidates", picker_width,
                    GetFrameHeightWithSpacing() * 8.))
            {
                for (let stype : candidates)
                {
                    let name = stype->name;
                    let (_, short_name) = splitTypeName(name);

                    if (Selectable(F"{short_name}##add_{name}"))
                    {
                        if (s_add_system_immediate)
                            wctx->doAction(AddWorldSystem::create(stype));
                        else
                            wctx->doAction(AddRuntimeSystem::create(stype));
                    }
                    if (IsItemHovered())
                        do SetTooltip(name);
                }
                if (candidates->len == 0)
                    TextDisabled("（没有匹配的系统）");

                EndListBox();
            }
        }

        func showWorldSystems(wctx: WorldEditorViewport)
        {
            showSystemGroup(
                wctx,
                wctx->getWorld->internal::get_all_systems,
                "world",
                true,
                "运行时",
                "已 add_system 到世界，编辑器内正在运行的系统");

            Spacing();

            showSystemGroup(
                wctx,
                wctx->getRuntimeSystems(),
                "runtime",
                false,
                "调试时",
                "保存在世界中，仅在开始调试执行或导出时运行的系统");

            Spacing();
            if (ButtonSize("添加系统", (-1., 0.)))
            {
                // 每次打开弹窗都复位搜索词，并将焦点设到搜索框
                s_add_system_filter = "";
                s_add_system_focus = true;
                OpenPopup("##add_system_picker");
            }

            if (BeginPopup("##add_system_picker"))
            {
                showAddSystemPicker(wctx);
                defer EndPopup();
            }
        }

        public func run(self: SystemList)=> bool
        {
            match (WorldEditorViewport::getLastFocused())
            {
                none?
                    TextDisabled("（没有待编辑的世界）");
                value(wctx)?
                {
                    showWorldSystems(wctx);
                }
            }
            return !self.m_close;
        }

    // ===============
    }
}
