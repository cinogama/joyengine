import pkg::std;

import je::gui;
import je::internal;

import builtin::editor::GUI::Icons;

using std;
using je;
using je::gui;

using JEEditor::GUI;

namespace JEEditor::Editor
{
    // Woolang Panic 提示窗口
    //
    // 当引擎通过 je::internal::register_panic_hook 注册的回调被触发时，
    // 调用 PanicBox::show 即可为这条 panic 启动一个裸 ImGui 协程，
    // 直接 Begin/End 绘制窗口展示 panic 原因、发生位置与调用栈。
    // 不走 IWindows 流程：panic 发生时窗口单例/协程调度等机制可能已
    // 无法正常运作，这里只依赖 gui::launch_coroutine 与原生 ImGui 调用。
    //
    // 回调签名 (string, int, string, int, string, string) 对应:
    //   src_file, lineno, functionname, rterrcode, reason, trace
    using PanicBox = struct{
        m_file: string,
        m_line: int,
        m_func: string,
        m_code: int,
        m_reason: string,
        m_trace: string,
    }
    {
        func summary(self: PanicBox)=> string
        {
            return F"reason: {self.m_reason}\n  at {self.m_func} ({self.m_file}:{self.m_line}) [code: {self.m_code}]\n{self.m_trace}";
        }
        
        // 绘制一帧窗口，返回 false 表示已被用户关闭（按钮或标题栏 X）。
        // 标题用协程 JobID 作 ##ID 后缀，多条 panic 各占一个窗口。
        func draw(self: PanicBox)=> bool
        {
            SetNextWindowSizeConstraints((440., 300.), (4096., 4096.));
            
            let (show, open) = BeginAttrOpen(F"Woolang Panic##{JobID()}",
                WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                + WindowsAttribute::ImGuiWindowFlags_NoResize
                + WindowsAttribute::ImGuiWindowFlags_NoSavedSettings);
            defer End();
            
            if (show)
            {
                match (Icons::WARNING)
                {
                    none?;
                    value(icon)?
                    {
                        ImageSize(icon, 48., 48.);
                        SameLine();
                        TextColored((255, 80, 80, 255), "Woolang 运行时发生 Panic！");
                    }
                }
                
                Separator();
                
                Text("原因:");
                PushTextWrapPos(0.);
                TextColored((240, 110, 110, 255), self.m_reason);
                PopTextWrapPos();
                
                Text(F"位置: {self.m_func} ({self.m_file}:{self.m_line})");
                Text(F"错误码: {self.m_code}");
                
                Separator();
                
                Text("调用栈:");
                let avail = GetContentRegionAvail();
                if (BeginChildSizeFlags("##PanicTrace", avail.0, avail.1 - 30.,
                        WindowsAttribute::ImGuiWindowFlags_HorizontalScrollbar))
                {
                    PushTextWrapPos(0.);
                    Text(self.m_trace);
                    PopTextWrapPos();
                }
                EndChild();
                
                if (Button("复制信息"))
                    SetClipboardText(self->summary());
                SameLine();
                if (Button("关闭"))
                    return false;
            }
            
            return open;
        }
        
        func show(
            file: string, line: int, funcname: string,
            errcode: int, reason: string, trace: string)=> void
        {
            let panic_info = PanicBox{
                m_file = file,
                m_line = line,
                m_func = funcname,
                m_code = errcode,
                m_reason = reason,
                m_trace = trace,
            };
            
            // 一条 panic 一个协程一个窗口：独立 VM，由引擎 gui 帧循环直接驱动
            gui::launch_coroutine(func(){
                let mut first_frame = true;
                let mut keep_open = true;
                while (keep_open)
                {
                    // 首帧在鼠标处生成窗口（SetNextWindowPos 只应生效一次）
                    if (first_frame)
                    {
                        first_frame = false;
                        SetNextWindowPos(GetMousePos());
                    }
                    
                    keep_open = panic_info->draw;
                    if (keep_open)
                        yield();
                }
            });
        }
        
        public func register()
        {
            internal::register_panic_hook(
                \file, line, funcname, errcode, reason, trace =
                    PanicBox::show(file, line, funcname, errcode, reason, trace););
        }
    }
}
