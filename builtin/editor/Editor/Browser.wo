    using FilePayload = struct{
        m_path: fsys::path_t,
    }
    {
        public let type = "JE_EDITOR_BROWSER_FILE_PATH";
        
        public func create(p: fsys::path_t)=> FilePayload
            where require!(FilePayload : Drag::IDragPayload);
        {
            return FilePayload{
                m_path = p,
            };
        }
        
        public func restore(data: string) => option<FilePayload>
        {
            return option::value(FilePayload::create(normalize(data)));
        }
        public func dump(self: FilePayload) => string
        {
            return self.m_path->to_string;
        }
        public func tips(self: FilePayload) => string
        {
            return F"移动: {filename(self.m_path)}";
        }
    }
    
    // “保存世界”拖拽载荷：携带发起保存的世界视口。
    // ImGui 拖拽载荷只能以字符串传递，dump 时序列化为视口窗口标题
    // （标题对唯一窗口而言是唯一的），restore 时再反查回视口实例。
    using SavingRequestPayload = struct{
        m_viewport: WorldEditorViewport,
    }
    {
        public let type = "JE_EDITOR_BROWSER_SAVING_REQUEST";
        
        public func create(viewport: WorldEditorViewport)=> SavingRequestPayload
            where require!(SavingRequestPayload : Drag::IDragPayload);
        {
            return SavingRequestPayload{
                m_viewport = viewport,
            };
        }
        
        public func restore(data: string) => option<SavingRequestPayload>
        {
            match (WorldEditorViewport::findWorldEditorViewportByTitle(data))
            {
                none?
                    return option::none;
                value(viewport)?
                    return option::value(SavingRequestPayload::create(viewport));
            }
        }
        public func dump(self: SavingRequestPayload) => string
        {
            return self.m_viewport->getTitle;
        }
        public func tips(self: SavingRequestPayload) => string
        {
            return F"保存: {self.m_viewport->getName}.je4world";
        }
    }

    // “保存实体为预设体”拖拽载荷：携带发起的世界视口与目标实体的调试
    // EUID。entity 句柄不允许跨帧持有，这里跨帧只持有 EUID，待文件名
    // 确认后再按 EUID 反查实体实例执行保存（见 requestSavePrefabAs）。
    // ImGui 拖拽载荷只能以字符串传递：EUID 与实体名在 dump 时暂存于
    // 模块级 s_pending_dragging。暂存必须挂在 dump 而非 create 上：
    // DragPayload 每帧会对列表里每个实体项调用 create，而 dump 只在
    // 真正成为拖拽源的项上被调用；restore 时 dump 视口标题反查回视口
    // 实例并取回暂存内容。
    using EntitySavingRequestPayload = struct{
        m_viewport: WorldEditorViewport,
        m_euid: entity::internal::euid_t,
        m_entity_name: string,
    }
    {
        // ImGui 载荷类型名上限 32 字符（ImGuiPayload::DataType 为 char[33]）
        public let type = "JE_EDITOR_ENTITY_SAVING_REQUEST";

        let mut s_pending_dragging =
            option::none: option<(entity::internal::euid_t, string)>;

        public func create(
            viewport: WorldEditorViewport,
            euid: entity::internal::euid_t,
            entity_name: string)=> EntitySavingRequestPayload
            where require!(EntitySavingRequestPayload : Drag::IDragPayload);
        {
            return EntitySavingRequestPayload{
                m_viewport = viewport,
                m_euid = euid,
                m_entity_name = entity_name,
            };
        }

        public func restore(data: string) => option<EntitySavingRequestPayload>
        {
            match (WorldEditorViewport::findWorldEditorViewportByTitle(data))
            {
                none?
                    return option::none;
                value(viewport)?
                    match (s_pending_dragging)
                    {
                        none?
                            return option::none;
                        value(pending)?
                            return option::value(EntitySavingRequestPayload{
                                m_viewport = viewport,
                                m_euid = pending.0,
                                m_entity_name = pending.1,
                            });
                    }
            }
        }

        // 被拖拽实体的调试 EUID（字段私有，供实体列表等接收方读取）
        public func dragged_euid(self: EntitySavingRequestPayload)=> entity::internal::euid_t
        {
            return self.m_euid;
        }
        public func dump(self: EntitySavingRequestPayload) => string
        {
            // 只在成为拖拽源的项上被调用（拖拽期间每帧一次，幂等覆盖）
            s_pending_dragging =
                option::value((self.m_euid, self.m_entity_name));
            return self.m_viewport->getTitle;
        }
        public func tips(self: EntitySavingRequestPayload) => string
        {
            return F"保存预设体: {self.m_entity_name}.je4entity";
        }
    }

    using Browser = struct{
        m_close: mut bool,
        
        m_root: fsys::path_t,
        m_current: mut fsys::path_t,
        m_selected: mut option<fsys::path_t>,
        m_filter: mut string,
        // 是否显示以 '.' 开头的文件/目录及 *.je4cache 缓存文件，默认隐藏。
        m_show_hidden: mut bool,
        m_last_click_time: mut real,
        m_last_clicked: mut option<fsys::path_t>,
        
        // ---- caching ----
        // Set to true by async callbacks (mkdir/remove/move) to signal
        // that the filesystem changed and all caches need refreshing.
        m_fs_dirty: mutable<bool>,
        
        // Tree cache: maps a directory path string to its sorted subdirs.
        m_tree_cache: map<string, array<fsys::path_t>>,
        
        // File-list cache for the current directory.
        m_list_path: mut string,
        m_list_dirs: mut array<fsys::path_t>,
        m_list_files: mut array<fsys::path_t>,
    }
    {
        let mut s_browser_singleton = option::none: option<Browser>;
        // 待消费的定位请求（见 requestNavigateTo）
        let mut s_pending_navigate = option::none: option<fsys::path_t>;
        public func isBrowserExist()
        {
            return s_browser_singleton->is_value;
        }
        public func showBrowser()
        {
            do show(create());
        }
        public func closeBrowser()
        {
            match (s_browser_singleton)
            {
                none?;
                value(browser_instance)?
                    browser_instance->close();
            }
        }
        // 外部（如检视面板的预设体来源行）请求在资源管理器中定位到指定
        // 路径。浏览器窗口经协程创建，showBrowser 返回时 onCreate 尚未
        // 执行、单例未就绪，不能立即取实例导航：请求一律先暂存，由浏览器
        // 首帧（或已打开时的下一帧）run() 统一消费。
        public func requestNavigateTo(path: fsys::path_t)=> void
        {
            s_pending_navigate = option::value(path);
            if (s_browser_singleton->is_none)
                do showBrowser();
        }
        
        func childDirs(dir: fsys::path_t)=> array<fsys::path_t>
        {
            return walk(dir)
                |> iterator::iter_result
                |> iterator::filter(\v = isdir(v);)
                |> iterator::collect()
                |> std::sort(\a, b = filename(a) < filename(b);)
                ;
        }
        
        func childFiles(dir: fsys::path_t)=> array<fsys::path_t>
        {
            return walk(dir)
                |> iterator::iter_result
                |> iterator::filter(\v = isfile(v);)
                |> iterator::collect()
                |> std::sort(\a, b = filename(a) < filename(b);)
                ;
        }
        
        // 默认隐藏的名称：以 '.' 开头的文件/目录，以及引擎生成的 *.je4cache 缓存文件。
        func isHiddenName(name: string)=> bool
        {
            return name->begin_with(".") || name->end_with(".je4cache");
        }
        
        func isEntryVisible(self: Browser, name: string)=> bool
        {
            return self.m_show_hidden || !isHiddenName(name);
        }
        
        func visibleEntryCount(self: Browser, entries: array<fsys::path_t>)=> int
        {
            let mut count = 0;
            for (let entry : entries)
            {
                if (self->isEntryVisible(filename(entry)))
                    count += 1;
            }
            return count;
        }
        
        func toggleShowHidden(self: Browser)=> void
        {
            self.m_show_hidden = !self.m_show_hidden;
        }
        
        // Flush the global dirty flag: clear the tree cache and force the
        // file-list cache to reload on next access.
        func processDirty(self: Browser)=> void
        {
            if (self.m_fs_dirty->get())
            {
                self.m_tree_cache->clear();
                self.m_list_path = "";
                self.m_fs_dirty->set(false);
            }
        }
        
        // Cached lookup of subdirectories for the tree view.
        func getSubDirs(self: Browser, dir: fsys::path_t)=> array<fsys::path_t>
        {
            let key = dir->to_string();
            if (self.m_tree_cache->contains(key))
                return self.m_tree_cache->get(key)->unwrap;
                
            let dirs = childDirs(dir);
            self.m_tree_cache->set(key, dirs);
            return dirs;
        }
        
        // Refresh the file-list cache when the current directory changes
        // or after a global dirty flush.
        func ensureFileListCache(self: Browser)=> void
        {
            let cur_key = self.m_current->to_string();
            if (self.m_list_path != cur_key)
            {
                self.m_list_dirs = childDirs(self.m_current);
                self.m_list_files = childFiles(self.m_current);
                self.m_list_path = cur_key;
            }
        }
        
        public func create()=> Browser
            where require!(Browser: IWindows);
        {
            let root = workpath();
            return Browser{
                m_close = mut false,
                
                m_root = root,
                m_current = mut root,
                m_selected = mut option::none,
                m_filter = mut "",
                m_show_hidden = mut false,
                m_last_click_time = mut 0.,
                m_last_clicked = mut option::none,
                
                m_fs_dirty = mutable::create(false),
                m_tree_cache = {}mut,
                m_list_path = mut root->to_string(),
                m_list_dirs = mut childDirs(root),
                m_list_files = mut childFiles(root),
            };
        }
        func close(self: Browser)
        {
            self.m_close = true;
        }
        public func getTitle(_: Browser)=> string
        {
            return "项目资源管理器";
        }
        public func getSizeConstraints(_: Browser)=> SizeConstraints
        {
            return SizeConstraints::Limited(((600., 200.), (4096., 4096.)));
        }
        public func getMenu(self: Browser)=> option<Menu>
        {
            return option::value <|
                Menu::create("")
                    -> subMenu("视图")
                    ->  subItem("显示隐藏文件", \= self->toggleShowHidden();)
                    ->  checkWhen(\= self.m_show_hidden;)
                    ->  shortCut("Ctrl+H")
                    ->  endItem
                    -> endMenu
                    ;
        }
        public func getShortcut(self: Browser)=> option<Shortcut>
        {
            return option::value <|
                Shortcut::begin()
                    ->shortCut(
                        [ImGuiKey::ImGuiMod_Ctrl, ImGuiKey::ImGuiKey_H],
                        \= self->toggleShowHidden();)
                        ->finish();
        }
        public func onCreate(self: Browser)=> void
        {
            s_browser_singleton = option::value(self);
        }
        public func onClose(_: Browser)=> void
        {
            s_browser_singleton = option::none;
        }
        public func run(self: Browser)=> bool
        {
            // 消费外部请求的定位（见 requestNavigateTo）
            match (s_pending_navigate)
            {
                none?;
                value(path)?
                {
                    s_pending_navigate = option::none;
                    self->navigateTo(path);
                }
            }

            self->processDirty();
            self->drawToolbar();
            Separator();
            
            let avail = GetContentRegionAvail();
            let tree_width = 280.;
            let list_width = avail.0 - tree_width;
            
            if (BeginChildSizeFlags("##BrowserTree", tree_width, avail.1,
                    WindowsAttribute::ImGuiWindowFlags_None))
            {
                self->drawTree();
            }
            EndChild();
            
            SameLine();
            
            if (BeginChildSizeFlags("##BrowserList", list_width, avail.1,
                    WindowsAttribute::ImGuiWindowFlags_None))
            {
                self->drawFileList();
            }
            EndChild();
            
            self->acceptSavingDrop();
            
            return !self.m_close;
        }
        
        func drawToolbar(self: Browser)=> void
        {
            if (Button("向上"))
                self->navigateUp();
                
            SameLine();
            
            let mut rel = "";
            match (relative(self.m_current, self.m_root))
            {
                err(_)?;
                ok(r)?
                    rel = r;
            }
            let display = (rel->len == 0 || rel == ".") ? "/" | rel;
            TextDisabled(display);
            
            SameLine();
            
            if (Button("刷新"))
                self.m_selected = option::none;
                
            SameLine();
            
            if (Button("新建文件夹"))
            {
                let base = self.m_current;
                let dirty = self.m_fs_dirty;
                do InputBox::show("新建文件夹", "请输入文件夹名称：", "NewFolder")
                    ->then(func(name: string) {
                            do mkdir(base / name);
                            dirty->set(true);
                        })
                    ;
            }
            
            SameLine();
            
            Text("搜索:");
            SameLine();
            
            PushItemWidth(150.);
            match (InputText("##BrowserFilter", self.m_filter))
            {
                none?;
                value(new_text)?
                    self.m_filter = new_text;
            }
            PopItemWidth();
        }
        
        func navigateUp(self: Browser)=> void
        {
            if (self.m_current != self.m_root)
            {
                self.m_current = parent(self.m_current);
                self.m_selected = option::none;
            }
        }

        // 定位到指定路径：目录则进入该目录，文件则进入所在目录并选中
        // 该项；搜索过滤一并清除，保证目标项在列表中立即可见。目标所
        // 在目录不存在（如预设体文件已被移走）时静默放弃。
        func navigateTo(self: Browser, path: fsys::path_t)=> void
        {
            let target_dir = isdir(path) ? path | parent(path);
            if (!isdir(target_dir))
                return;

            self.m_current = target_dir;
            self.m_selected = option::value(path);
            self.m_filter = "";
        }
        
        func drawTree(self: Browser)=> void
        {
            let root_name = filename(self.m_root);
            let display_name = root_name->len > 0 ? root_name | "项目";
            
            let mut root_flags = TreeNodeAttribute::ImGuiTreeNodeFlags_DefaultOpen
                + TreeNodeAttribute::ImGuiTreeNodeFlags_OpenOnArrow
                + TreeNodeAttribute::ImGuiTreeNodeFlags_OpenOnDoubleClick
                + TreeNodeAttribute::ImGuiTreeNodeFlags_SpanAvailWidth;
                
            if (self.m_current == self.m_root)
                root_flags += TreeNodeAttribute::ImGuiTreeNodeFlags_Selected;
                
            let root_open = TreeNodeEx(F"{display_name}##browser_root", root_flags);
            
            self->acceptDirDrop(self.m_root);
            
            if (IsItemClickedLeft())
            {
                self.m_current = self.m_root;
                self.m_selected = option::value(self.m_root);
            }
            
            if (root_open)
            {
                self->drawDirNode(self.m_root);
                TreePop();
            }
        }
        
        func drawDirNode(self: Browser, dir: fsys::path_t)=> void
        {
            for (let d : self->getSubDirs(dir))
            {
                let name = filename(d);
                if (!self->isEntryVisible(name))
                    continue;
                    
                let is_selected = self.m_selected->is_value
                    && self.m_selected->unwrap == d;
                    
                let mut flags = TreeNodeAttribute::ImGuiTreeNodeFlags_OpenOnArrow
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_OpenOnDoubleClick
                    + TreeNodeAttribute::ImGuiTreeNodeFlags_SpanAvailWidth;
                    
                if (is_selected)
                    flags += TreeNodeAttribute::ImGuiTreeNodeFlags_Selected;
                    
                let node_open = TreeNodeEx(F"{name}##{d->to_string()}", flags);
                
                self->acceptDirDrop(d);
                
                if (IsItemClickedLeft())
                {
                    self.m_current = d;
                    self.m_selected = option::value(d);
                }
                
                if (node_open)
                {
                    self->drawDirNode(d);
                    TreePop();
                }
            }
        }
        
        // 根据路径返回对应的图标：目录返回文件夹图标，文件按扩展名走 ext_icon_map 查询，
        // 未命中则返回默认 FILE 图标。
        func iconForPath(path: fsys::path_t)=> option<texture>
        {
            // 扩展名 -> 图标 的查找表；命中即用，未命中走默认 FILE 图标。
            static let ext_icon_map = {
                [".png"] = Icons::TEXTURE,
                [".jpg"] = Icons::TEXTURE,
                [".jpeg"] = Icons::TEXTURE,
                [".bmp"] = Icons::TEXTURE,
                [".tga"] = Icons::TEXTURE,
                [".tif"] = Icons::TEXTURE,
                [".tiff"] = Icons::TEXTURE,
                [".gif"] = Icons::TEXTURE,
                [".webp"] = Icons::TEXTURE,
                [".hdr"] = Icons::TEXTURE,
                [".exr"] = Icons::TEXTURE,
                [".dds"] = Icons::TEXTURE,
                [".ico"] = Icons::TEXTURE,
                [".pvr"] = Icons::TEXTURE,
                [".ktx"] = Icons::TEXTURE,
                [".psd"] = Icons::TEXTURE,
                
                [".shader"] = Icons::SHADER,
                
                [".ttf"] = Icons::FONT,
                [".otf"] = Icons::FONT,
                [".font"] = Icons::FONT,
                [".fnt"] = Icons::FONT,
                
                [".wav"] = Icons::MUSIC,
                [".mp3"] = Icons::MUSIC,
                [".ogg"] = Icons::MUSIC,
                [".flac"] = Icons::MUSIC,
                [".aiff"] = Icons::MUSIC,
                [".m4a"] = Icons::MUSIC,
                
                [".cpp"] = Icons::CPP,
                [".cc"] = Icons::CPP,
                [".cxx"] = Icons::CPP,
                [".c"] = Icons::CPP,
                [".h"] = Icons::CPP,
                [".hpp"] = Icons::CPP,
                [".hxx"] = Icons::CPP,
                
                [".wo"] = Icons::WOOLANG,
                
                [".je4animation"] = Icons::ANIMATION,
                [".je4tilemap"] = Icons::TILEMAP,
                [".je4world"] = Icons::WORLD,
                [".je4entity"] = Icons::ENTITY,
            };
            
            
            if (isdir(path))
                return Icons::FOLDER;
                
            let ext = string::lower(extension(path));
            return ext_icon_map->get(ext)=>> \v = v;->or_bind(\= Icons::FILE;);
        }
        
        func drawItemIcon(path: fsys::path_t)=> void
        {
            match(iconForPath(path))
            {
                none?;
                value(icon)?
                {
                    ImageSize(icon, 16., 16.);
                    SameLine();
                }
            }
        }
        
        func drawFileList(self: Browser)=> void
        {
            self->ensureFileListCache();
            let dirs = self.m_list_dirs;
            let files = self.m_list_files;
            
            let filter_lower = self.m_filter->lower;
            let has_filter = filter_lower->len > 0;
            
            let visible_count = self->visibleEntryCount(dirs) + self->visibleEntryCount(files);
            if (visible_count == 0)
                TextDisabled("(空目录)");
                
            for (let d : dirs)
            {
                let name = filename(d);
                if (self->isEntryVisible(name) && (!has_filter || name->lower->find(filter_lower)->is_value))
                {
                    let is_selected = self.m_selected->is_value
                        && self.m_selected->unwrap == d;
                        
                    drawItemIcon(d);
                    let clicked = SelectableSelected(
                        F"{name}/##{d->to_string()}", is_selected);
                        
                    Drag::DragPayload(FilePayload::create(d));
                    
                    if (IsItemClicked(ImGuiMouseButton::ImGuiMouseButton_Right))
                        self.m_selected = option::value(d);
                        
                    if (clicked)
                        self->handleItemClick(d);
                }
            }
            
            for (let f : files)
            {
                let name = filename(f);
                if (self->isEntryVisible(name) && (!has_filter || name->lower->find(filter_lower)->is_value))
                {
                    let is_selected = self.m_selected->is_value
                        && self.m_selected->unwrap == f;
                        
                    drawItemIcon(f);
                    let clicked = SelectableSelected(
                        F"{name}##{f->to_string()}", is_selected);
                        
                    Drag::DragPayload(FilePayload::create(f));
                    
                    if (IsItemClicked(ImGuiMouseButton::ImGuiMouseButton_Right))
                        self.m_selected = option::value(f);
                        
                    if (clicked)
                        self->handleItemClick(f);
                }
            }
            
            if (BeginPopupContextWindow())
            {
                let base = self.m_current;
                let dirty = self.m_fs_dirty;
                
                if (MenuItem("新建文件夹"))
                {
                    do InputBox::show("新建文件夹", "请输入文件夹名称：", "NewFolder")
                        ->then(func(name: string) {
                                do mkdir(base / name);
                                dirty->set(true);
                            })
                        ;
                }
                
                Separator();
                
                if (self.m_selected->is_value)
                {
                    let sel = self.m_selected->unwrap;
                    let sel_name = filename(sel);
                    let sel_parent = parent(sel);
                    
                    if (isdir(sel) && MenuItem("打开"))
                        self.m_current = sel;

                    match (openActionForPath(sel))
                    {
                        none?;
                        value(open_action)?
                            if (MenuItem("打开"))
                                open_action(sel);
                    }
                        
                    if (MenuItem("重命名"))
                    {
                        do InputBox::show("重命名", "请输入新名称：", sel_name)
                            ->then(func(new_name: string) {
                                    let new_path = sel_parent / new_name;

                                    match (renameActionForPath(sel))
                                    {
                                        none?;
                                        value(on_renamed)?
                                            on_renamed(sel, new_path);
                                    }

                                    do move(sel, new_path);
                                    dirty->set(true);
                                })
                            ;
                    }
                    
                    Separator();
                    
                    if (MenuItem("删除"))
                    {
                        let target = sel;
                        do AskBox::show("删除", F"确认删除 \"{sel_name}\" 吗？")
                            ->onYes(func() {
                                    do remove(target);
                                    dirty->set(true);
                                })
                            ;
                    }
                    
                    Separator();
                    
                    if (MenuItem("复制路径"))
                        SetClipboardText(sel->to_string());

                    if (MenuItem("在资源管理器中展示"))
                        revealInSystemExplorer(sel);
                }
                
                EndPopup();
            }
        }
        
        // 双击 / 右键“打开”时按扩展名查找打开回调：目录与未注册的扩展名返回 none。
        func openActionForPath(path: fsys::path_t)=> option<(fsys::path_t)=> void>
        {
            // 扩展名 -> 打开回调 的查找表；新增可打开的文件类型时在此注册。
            static let ext_open_map = {
                [".je4world"] = func(p: fsys::path_t) {
                    WorldEditorViewport::openWorldEditorViewportFromFile(p);
                },
            };

            if (!isfile(path))
                return option::none;

            return ext_open_map->get(string::lower(extension(path)));
        }

        // 文件被重命名后按扩展名查找联动回调（参数为 旧路径, 新路径）：未注册返回 none。
        func renameActionForPath(path: fsys::path_t)=> option<(fsys::path_t, fsys::path_t)=> void>
        {
            // 扩展名 -> 重命名联动回调 的查找表；新增需要联动同步的文件类型时在此注册。
            static let ext_rename_map = {
                // 重命名的世界文件若已有打开的视口：按新路径重开视口
                //（同首次保存的逻辑），确保视口的保存路径与文件一致。
                [".je4world"] = func(old_path: fsys::path_t, new_path: fsys::path_t) {
                    match (WorldEditorViewport::findWorldEditorViewportByPath(old_path))
                    {
                        none?;
                        value(viewport)?
                            viewport->dropAndRetargetPath(new_path);
                    }
                },
            };

            return ext_rename_map->get(string::lower(extension(path)));
        }

        // 在系统文件管理器中展示指定路径：Windows 用 explorer /select 选中该项，
        // macOS 用 open -R 在 Finder 中定位；其余平台的 xdg-open 不支持定位，
        // 退化为打开所在目录。fsys 的路径统一为正斜杠，而 explorer /select 只认
        // 反斜杠，不转换的话定位会失败并回退打开默认位置（桌面）。
        func revealInSystemExplorer(path: fsys::path_t)=> void
        {
            let target = path->to_string();
            let current_os = platform::get_os();

            if (current_os == platform::Os::WINDOWS)
            {
                let win_path = target->replace("/", "\\");
                do platform::shell(F"explorer.exe /select,\"{win_path}\"");
            }
            else if (current_os == platform::Os::MACOS)
                do platform::shell(F"open -R \"{target}\"");
            else
                do platform::shell(F"xdg-open \"{parent(path)->to_string()}\"");
        }
        
        func handleItemClick(self: Browser, path: fsys::path_t)=> void
        {
            let now = GetTime();
            let is_double = self.m_last_clicked->is_value
                && self.m_last_clicked->unwrap == path
                && (now - self.m_last_click_time) < 0.5;
                
            self.m_last_click_time = now;
            self.m_last_clicked = option::value(path);
            self.m_selected = option::value(path);
            
            if (is_double && isdir(path))
                self.m_current = path;

            if (is_double)
            {
                match (openActionForPath(path))
                {
                    none?;
                    value(open_action)?
                        open_action(path);
                }
            }
        }
        
        func acceptDirDrop(self: Browser, target_dir: fsys::path_t)=> void
        {
            match (Drag::AcceptDrag:<FilePayload>())
            {
                none?;
                value(payload)?
                    self->requestMove(payload.m_path, target_dir);
            }

            match (Drag::AcceptDrag:<SavingRequestPayload>())
            {
                none?;
                value(payload)?
                {
                    let dirty = self.m_fs_dirty;
                    payload.m_viewport->requestSaveAs(
                        target_dir, \= dirty->set(true););
                }
            }

            match (Drag::AcceptDrag:<EntitySavingRequestPayload>())
            {
                none?;
                value(payload)?
                    requestSavePrefabAs(payload, target_dir, self.m_fs_dirty);
            }
        }

        // 拖到资源管理器窗口的空白/文件列表区域：保存到当前目录
        func acceptSavingDrop(self: Browser)=> void
        {
            match (Drag::AcceptDrag:<SavingRequestPayload>())
            {
                none?;
                value(payload)?
                {
                    let dirty = self.m_fs_dirty;
                    payload.m_viewport->requestSaveAs(
                        self.m_current, \= dirty->set(true););
                }
            }

            match (Drag::AcceptDrag:<EntitySavingRequestPayload>())
            {
                none?;
                value(payload)?
                    requestSavePrefabAs(payload, self.m_current, self.m_fs_dirty);
            }
        }

        // 把实体写入 dst 并将实体挂为该文件的预设体：未挂预设体或覆盖
        // 当前预设体源文件时落盘完整数据（更新预设体本体），已挂其他
        // 预设体时落盘为旧预设体的变体（差异 + "prefab" 键，详见
        // save_prefab）。
        // 文件写盘成功后，挂载关联（含此前挂有其他预设体时的旧路径还原
        // 信息）走可撤销的 ModifyPrefab Action，由 Practice 调用 redo 落实；
        // 把 path 写进命令缓冲临时实例的原因见 ModifyPrefab 的
        // applyPrefabState。没有 EUID 的实体无法支持撤销，退化为直接挂载。
        // dirty 在写盘成功后被置位以刷新资源管理器的文件缓存。
        func savePrefabEntityTo(
            wctx: WorldEditorViewport,
            e: entity, dst: fsys::path_t, dirty: mutable<bool>)=> void
        {
            let prefab_type = typeinfo::load("Editor::Prefab");
            let runtime_path = ResourcePath::toRuntimeResourcePath(dst->to_string());

            match (toml::save(Entity::save_prefab(e, dst->to_string()), dst))
            {
                err(msg)?
                    MsgBox::err("保存失败",
                        F"保存预设体到 \"{dst->to_string()}\" 失败：{msg}");
                ok(_)?
                {
                    // 文件创建成功：实体自此成为预设体
                    match (e->internal::get_entity_uid)
                    {
                        none?
                        {
                            logerr("保存预设体：实体缺少 EUID，预设体关联以不可撤销方式建立");
                            match (prefab_type)
                            {
                                none?
                                    logerr("保存预设体：无法解析 Editor::Prefab 组件类型，预设体关联未建立");
                                value(pt)?
                                {
                                    let cinst = e->add_component(pt);
                                    match (cinst->get_member("path"))
                                    {
                                        none?
                                            logerr("保存预设体：Editor::Prefab 缺少 path 成员，预设体关联未建立");
                                        value((mtype, minst))?
                                            do towoo::unsafe::dynamic_parser::restore(
                                                mtype, minst, runtime_path);
                                    }
                                }
                            }
                        }
                        value(eid)?
                            wctx->doAction(ModifyPrefab::create(
                                eid, e->internal::get_prefab_path,
                                option::value(runtime_path)));
                    }

                    dirty->set(true);

                    // 闭包按创建时的值捕获文本，之后每帧由 Statebar 调用绘制
                    let name = e->internal::name;
                    let path_str = dst->to_string();
                    Statebar::showState(3.) <| func(){
                        Text(F"预设体 \"{name}\" 已保存到 \"{path_str}\"");
                    };
                }
            }
        }

        // 拖拽实体到资源管理器后的保存流程（原资源管理器 requestSaveAs 的
        // 实体版）：弹输入框要文件名 → 已存在则确认覆盖 → 按载荷中的 EUID
        // 反查实体（entity 不跨帧持有，对话框确认时才反查；反查内部会检查
        // 视口存活性，实体已不存在则取消保存）→ 写盘并挂预设体。回调不
        // 捕获 Browser 实例，文件缓存刷新经 dirty 传出。
        func requestSavePrefabAs(
            payload: EntitySavingRequestPayload,
            target_dir: fsys::path_t,
            dirty: mutable<bool>)=> void
        {
            func saveTo(dst: fsys::path_t)=> void
            {
                match (payload.m_viewport->findListedEntityByEuid(payload.m_euid))
                {
                    none?
                        MsgBox::err("保存失败", "目标实体已不存在，预设体保存已取消");
                    value(e)?
                        savePrefabEntityTo(payload.m_viewport, e, dst, dirty);
                }
            }

            func savePrefabAs(file_name: string)=> void
            {
                if (file_name->len == 0)
                {
                    MsgBox::err("保存失败", "文件名不能为空");
                    return;
                }

                // 未带后缀时自动补全 .je4entity
                let full_name = file_name->end_with(".je4entity")
                    ? file_name
                    | F"{file_name}.je4entity";

                let dst = target_dir / full_name;

                if (isfile(dst))
                {
                    // 已存在同名文件时弹出覆盖确认
                    do AskBox::show(
                            "保存", F"目录中已存在 \"{full_name}\"，确认覆盖吗？")
                        ->onYes(\= saveTo(dst);)
                    ;
                }
                else
                    saveTo(dst);
            }

            do InputBox::show(
                    "保存预设体", "请输入保存的文件名：",
                    F"{payload.m_entity_name}.je4entity")
                ->then(savePrefabAs)
            ;
        }
        
        func requestMove(self: Browser, src: fsys::path_t, target_dir: fsys::path_t)=> void
        {
            if (parent(src) == target_dir)
                return;
                
            let src_name = filename(src);
            let dst = target_dir / src_name;
            let dirty = self.m_fs_dirty;
            let target_name = filename(target_dir);
            
            do AskBox::show("移动", F"确认将 \"{src_name}\" 移动到 \"{target_name}\" 吗？")
                ->onYes(func() {
                        do move(src, dst);
                        dirty->set(true);
                    })
                ;
        }
    }
}
