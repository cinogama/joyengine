import pkg::fsys;

import je;

export import ToWooCollectionTemplate;

using fsys;
using je::towoo;

namespace JEEditor::Editor::Project
{
    namespace ToWooSystemCollection
    {
        public let SUFFIX = ".je4system.wo";

        public func create(paths: array<path_t>)
        {
            return ToWooCollectionTemplate::create:<{SUFFIX}, {update_system}>(paths);
        }
    }

    using ToWooSystemCollection;

    protected alias ToWooSystemCollection = 
        ToWooCollectionTemplate<{SUFFIX}, {update_system}>;
}
