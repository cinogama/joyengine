import pkg::std;
import pkg::fsys;
import pkg::iterator;

import ToWooComponentCollection;
import ToWooSystemCollection;

using std;
using fsys;
using iterator;

namespace JEEditor::Editor::Project
{
    using ToWooCollection = struct{
        m_component_collection: ToWooComponentCollection,
        m_system_collection: ToWooSystemCollection,
    }
    {
        public func create()=> ToWooCollection
        {
            let towoo_component_and_systems =
                workpath() |> recursive_walk
                    |> iter_result
                    |> filter(
                        \p = isfile(p)
                            && (fname->end_with(ToWooSystemCollection::SYSTEM_SUFFIX)
                                || fname->end_with(ToWooComponentCollection::COMPONENT_SUFFIX))
                                where fname = filename(p)->lower
                            ;)
                    |> collect
                    ;
                    
            let towoo_components = towoo_component_and_systems
                ->forall(\p = filename(p)->lower->end_with(ToWooComponentCollection::COMPONENT_SUFFIX););
            let towoo_systems = towoo_component_and_systems
                ->forall(\p = filename(p)->lower->end_with(ToWooSystemCollection::SYSTEM_SUFFIX););

            return ToWooCollection{
                m_component_collection = ToWooComponentCollection::create(towoo_components),
                m_system_collection = ToWooSystemCollection::create(towoo_systems),
            };
        }
    }
}
