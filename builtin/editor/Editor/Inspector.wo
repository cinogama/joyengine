import woo::std;

import je;
import je::ecs;
import je::internal;
import je::gui;
import je::typeinfo;

import pkg::interface;
import pkg::worst;

import builtin::editor::GUI::Windows;

import WorldEditorViewport;
import EditSession;
import Action::RemoveComponent;

using std;
using je;
using je::gui;
using je::towoo;
using JEEditor::GUI::Windows;
using JEEditor::Editor::EditSession;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    using Inspector = struct{
        m_close: mut bool,
    }
    {
        // EditSession 中的面板标识，用于手势的焦点归属判定
        let PANEL_OWNER = "Inspector";
        
        let mut s_inspector_singleton = option::none: option<Inspector>;
        
        public func isInspectorExist()
        {
            return s_inspector_singleton->is_value;
        }
        public func showInspector()
        {
            do show(create());
        }
        public func closeInspector()
        {
            match (s_inspector_singleton)
            {
                none?;
                value(inst)?
                    inst->close();
            }
        }
        
        func create()=> Inspector
            where require!(Inspector: IWindows);
        {
            return Inspector{
                m_close = mut false,
            };
        }
        func close(self: Inspector)=> void
        {
            self.m_close = true;
        }
        public func onClose(_: Inspector)=> void
        {
            // 面板被关闭时，结束任何遗留的编辑手势
            EditSession::commit();
        }
        public func getTitle(_: Inspector)=> string
        {
            return "检视";
        }
        public func getSizeConstraints(_: Inspector)=> SizeConstraints
        {
            return SizeConstraints::Limited(((300., 200.), (600., 4096.)));
        }
        // 将 "Transform::LocalPosition" 拆为 ("Transform", "LocalPosition")，
        // 不带命名空间的类型名返回 ("", 原名)。
        func splitTypeName(cname: string)=> (string, string)
        {
            let sep_pos = cname->find("::")->or(-1);
            if (sep_pos < 0)
                return ("", cname);
            return (cname->sub_len(0, sep_pos), cname->sub(sep_pos + 2));
        }
        func showEntityNameEdit(wctx: WorldEditorViewport, e: entity)
        {
            TextDisabled("名称");
            SameLine();
            SetNextItemWidth(-1.);
            
            let NAME_EDIT_TAG = "##entity_name";
            
            match (InputText(NAME_EDIT_TAG, e->internal::name))
            {
                none?;
                value(new_name)?
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?
                            // 没有 EUID 的实体无法支持撤销
                            e->internal::set_name(new_name);
                        value(eid)?
                        {
                            // 手势首帧时新名字尚未写入，此刻的名字即撤销点；
                            // 输入期间的每一步改名立即生效，保证输入框状态连续
                            EditSession::trackRename(
                                NAME_EDIT_TAG, PANEL_OWNER, wctx, eid,
                                e->internal::name, new_name);
                            e->internal::set_name(new_name);
                        }
                    }
                }
            }
        }
        func showComponentMembersEdit(
            wctx: WorldEditorViewport, e: entity, ctype: typeinfo, cname: string)
        {
            let cinst = e->get_component(ctype)->unwrap;
            let eid = e->internal::get_entity_uid;
            
            Indent(0.);
            for (let (mname, mtype, mhandle) : cinst->get_members)
            {
                TextDisabled(mname);
                SameLine();
                SetNextItemWidth(-1.);
                
                let member_tag = F"##{cname}##{mname}##{mhandle}";
                
                // edit 一旦返回 true，成员值已被就地修改，先留档修改前的序列化值
                let old_value = eid=>> \_ = unsafe::dynamic_parser::save(mtype, mhandle);;
                
                match (unsafe::dynamic_parser::edit(mtype, mhandle, member_tag))
                {
                    none?
                    {
                        NewLine();
                        TextDisabled(F"编辑器没有为 `{mtype->script_name->or(mtype->name)}` 类型提供编辑组件");
                    }
                    value(updated)?
                    {
                        if (updated)
                        {
                            match (eid)
                            {
                                none?;
                                value(eidv)?
                                    match (old_value)
                                    {
                                        none?;
                                        value(before)?
                                            EditSession::trackMember(
                                                member_tag, PANEL_OWNER, wctx, eidv,
                                                ctype->name, mname,
                                                before,
                                                unsafe::dynamic_parser::save(mtype, mhandle)
                                                    ->or(before));
                                    }
                            }
                        }
                    // 返回 false 表示本次没有改动；手势是否结束由
                    // 超时/选中变化/其他成员改动判定（见 run()）。
                    }
                }
            }
            Unindent(0.);
        }
        func showEntityComponentEditImpl(wctx: WorldEditorViewport, e: entity)
        {
            showEntityNameEdit(wctx, e);
            SeparatorText("组件");
            
            // 组件按全名排序后同一命名空间的组件自然相邻，
            // 命名空间发生变化时输出一个分组标题。
            let mut visible_count = 0;
            let mut last_namespace = "";
            for (let ctype : e->internal::get_components_types
                |> sort(\l, r = l->name < r->name;))
            {
                let cname = ctype->name;
                // 编辑器内部组件（Editor::*）不在检视面板中显示
                if (cname->begin_with("Editor::"))
                    continue;
                    
                visible_count += 1;
                let (ns, short_name) = splitTypeName(cname);
                if (ns != last_namespace)
                {
                    if (ns != "")
                        SeparatorText(ns);
                    last_namespace = ns;
                }
                
                if (CollapsingHeaderFlags(
                        F"{short_name}##{cname}",
                        TreeNodeAttribute::ImGuiTreeNodeFlags_DefaultOpen))
                {
                    showComponentMembersEdit(wctx, e, ctype, cname);
                }

                // 右键组件标题可移除该组件；显式绑定到标题的标签上，
                // 避免展开时误绑到最后绘制的成员控件
                if (BeginPopupContextItemLabel(F"{short_name}##{cname}"))
                {
                    if (MenuItem(F"移除组件 {short_name}"))
                    {
                        // 先结束可能进行中的编辑手势，再发布移除组件的操作
                        EditSession::commit();
                        match (RemoveComponent::try_create(e, ctype))
                        {
                            none?
                                // 没有 EUID 的实体退化为直接移除（无法支持撤销）
                                do e->remove_component(ctype);
                            value(action)?
                                wctx->doAction(action);
                        }
                    }

                    defer EndPopup();
                }
                Spacing();
            }
            if (visible_count == 0)
                TextDisabled("（没有可显示的组件）");
        }
        func showEntityComponentEdit(
            wctx: WorldEditorViewport,
            selected_entity_id: entity::internal::euid_t)
        {
            for (let e : wctx->getEntitySelector)
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(eeuid)?
                        if (eeuid == selected_entity_id)
                            showEntityComponentEditImpl(wctx, e);
                }
            }
        }
        public func run(self: Inspector)=> bool
        {
            let selection = WorldEditorViewport::getLastFocused()
                =>> \wctx = wctx->getSelectedEntityId()
                    ->> \selected_entity_id = (wctx, selected_entity_id);
                    ;
                ;
                
            // 手势结束判定（超时/选中实体变化/本面板失去焦点），见 EditSession
            EditSession::update(
                PANEL_OWNER, IsWindowFocused(), selection->> \sel = sel.1;);
                
            match (selection)
            {
                none?
                    TextDisabled("（没有待编辑的实体）");
                value((wctx, selected_entity_id))?
                {
                    showEntityComponentEdit(wctx, selected_entity_id);
                }
            }
            return !self.m_close;
        }
    }
}
