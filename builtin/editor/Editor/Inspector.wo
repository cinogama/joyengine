import woo::std;

import je;
import je::ecs;
import je::internal;
import je::gui;
import je::typeinfo;

import pkg::interface;
import pkg::worst;

import builtin::editor::GUI::Windows;

import WorldEditorViewport;
import Action::RenameEntity;
import Action::ModifyComponentMember;

using std;
using je;
using je::gui;
using je::towoo;
using JEEditor::GUI::Windows;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    // 一次进行中的编辑手势（如一次连续输入、一次连续拖拽）。
    // 同一成员的连续改动会被归并进来，直到手势结束：
    //   1. 连续 EDIT_SESSION_TIMEOUT 之久没有新的改动（edit 持续返回 false）；
    //   2. 被编辑的实体不再是当前选中实体；
    //   3. 其他成员（或实体名）的编辑产生了新的改动；
    //   4. 检视面板窗体失去焦点或被关闭。
    // 手势结束后将汇总为一个可撤销的 Action 提交到 Practice。
    using EditSession = struct{
        m_tag: string,                     // 触发本次手势的控件标签
        m_world_view: WorldEditorViewport, // 提交 Action 的目标视口
        m_eid: entity::internal::euid_t,   // 被编辑的实体
        m_component_type: option<typeinfo>, // none 表示这是一次实体重命名手势
        m_member_name: string,             // 被编辑的组件成员名（重命名时为空）
        m_old_value: string,               // 手势开始前的值（名字或序列化的成员值）
        m_new_value: string,               // 手势过程中的最新值
        m_last_active_time: real,          // 最近一次改动发生的时间
    };

    using Inspector = struct{
        m_close: mut bool,
    }
    {
        // 编辑手势结束后，连续这么久没有新的改动即视为手势结束并提交
        let EDIT_SESSION_TIMEOUT = 2.;

        let mut s_inspector_singleton = option::none: option<Inspector>;
        let mut s_active_edit_session = option::none: option<EditSession>;

        // 提交进行中的编辑手势：值确有变化时发布一个可撤销的 Action
        func commitEditSession()=> void
        {
            match (s_active_edit_session)
            {
                none?;
                value(session)?
                {
                    if (session.m_old_value != session.m_new_value)
                    {
                        match (session.m_component_type)
                        {
                            none?
                                session.m_world_view->doAction(
                                    RenameEntity::create(
                                        session.m_eid,
                                        session.m_old_value,
                                        session.m_new_value));
                            value(component_type)?
                                session.m_world_view->doAction(
                                    ModifyComponentMember::create(
                                        session.m_eid,
                                        component_type,
                                        session.m_member_name,
                                        session.m_old_value,
                                        session.m_new_value));
                        }
                    }
                    s_active_edit_session = option::none;
                }
            }
        }

        // 追踪进行中的编辑手势：同一成员的连续改动（逐键输入、连续拖拽等）
        // 归并为一次手势，仅保留手势开始时的旧值与最新的新值。
        // 每次改动都会刷新最近活跃时间；手势的结束判定见 run() 与 EditSession 处的注释。
        func trackEditSession(
            tag: string,
            wctx: WorldEditorViewport,
            eid: entity::internal::euid_t,
            component_type: option<typeinfo>,
            member_name: string,
            old_value: string,
            new_value: string)=> void
        {
            match (s_active_edit_session)
            {
                none?;
                value(session)?
                    if (session.m_tag == tag)
                    {
                        s_active_edit_session = option::value(EditSession{
                            m_tag = session.m_tag,
                            m_world_view = session.m_world_view,
                            m_eid = session.m_eid,
                            m_component_type = session.m_component_type,
                            m_member_name = session.m_member_name,
                            m_old_value = session.m_old_value,
                            m_new_value = new_value,
                            m_last_active_time = time(),
                        });
                        return;
                    }
                    else
                        // 其他成员的编辑产生了新改动，上一次手势视为结束
                        commitEditSession();
            }

            s_active_edit_session = option::value(EditSession{
                m_tag = tag,
                m_world_view = wctx,
                m_eid = eid,
                m_component_type = component_type,
                m_member_name = member_name,
                m_old_value = old_value,
                m_new_value = new_value,
                m_last_active_time = time(),
            });
        }
        public func isInspectorExist()
        {
            return s_inspector_singleton->is_value;
        }
        public func showInspector()
        {
            do show(create());
        }
        public func closeInspector()
        {
            match (s_inspector_singleton)
            {
                none?;
                value(inst)?
                    inst->close();
            }
        }
        
        func create()=> Inspector
            where require!(Inspector: IWindows);
        {
            return Inspector{
                m_close = mut false,
            };
        }
        func close(self: Inspector)=> void
        {
            self.m_close = true;
        }
        public func onClose(_: Inspector)=> void
        {
            // 面板被关闭时，结束任何遗留的编辑手势
            commitEditSession();
        }
        public func getTitle(_: Inspector)=> string
        {
            return "检视";
        }
        public func getSizeConstraints(_: Inspector)=> SizeConstraints
        {
            return SizeConstraints::Limited(((300., 200.), (600., 4096.)));
        }
        // 将 "Transform::LocalPosition" 拆为 ("Transform", "LocalPosition")，
        // 不带命名空间的类型名返回 ("", 原名)。
        func splitTypeName(cname: string)=> (string, string)
        {
            let sep_pos = cname->find("::")->or(-1);
            if (sep_pos < 0)
                return ("", cname);
            return (cname->sub_len(0, sep_pos), cname->sub(sep_pos + 2));
        }
        func showEntityNameEdit(wctx: WorldEditorViewport, e: entity)
        {
            TextDisabled("名称");
            SameLine();
            SetNextItemWidth(-1.);

            let NAME_EDIT_TAG = "##entity_name";

            match (InputText(NAME_EDIT_TAG, e->internal::name))
            {
                none?;
                value(new_name)?
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?
                            // 没有 EUID 的实体无法支持撤销
                            e->internal::set_name(new_name);
                        value(eid)?
                        {
                            // 手势首帧时新名字尚未写入，此刻的名字即撤销点；
                            // 输入期间的每一步改名立即生效，保证输入框状态连续
                            trackEditSession(
                                NAME_EDIT_TAG, wctx, eid, option::none, "",
                                e->internal::name, new_name);
                            e->internal::set_name(new_name);
                        }
                    }
                }
            }
        }
        func showComponentMembersEdit(
            wctx: WorldEditorViewport, e: entity, ctype: typeinfo, cname: string)
        {
            let cinst = e->get_component(ctype)->unwrap;
            let eid = e->internal::get_entity_uid;

            Indent(0.);
            for (let (mname, mtype, mhandle) : cinst->get_members)
            {
                TextDisabled(mname);
                SameLine();
                SetNextItemWidth(-1.);

                let member_tag = F"##{cname}##{mname}##{mhandle}";

                // edit 一旦返回 true，成员值已被就地修改，先留档修改前的序列化值
                let old_value = eid=>> \_ = unsafe::dynamic_parser::save(mtype, mhandle);;

                match (unsafe::dynamic_parser::edit(mtype, mhandle, member_tag))
                {
                    none?
                    {
                        NewLine();
                        TextDisabled(F"编辑器没有为 `{mtype->script_name->or(mtype->name)}` 类型提供编辑组件");
                    }
                    value(updated)?
                    {
                        if (updated)
                        {
                            match (eid)
                            {
                                none?;
                                value(eidv)?
                                    match (old_value)
                                    {
                                        none?;
                                        value(before)?
                                            trackEditSession(
                                                member_tag, wctx, eidv,
                                                option::value(ctype), mname,
                                                before,
                                                unsafe::dynamic_parser::save(mtype, mhandle)
                                                    ->or(before));
                                    }
                            }
                        }
                        // 返回 false 表示本次没有改动；手势是否结束由
                        // 超时/选中变化/其他成员改动判定（见 run()）。
                    }
                }
            }
            Unindent(0.);
        }
        func showEntityComponentEditImpl(wctx: WorldEditorViewport, e: entity)
        {
            showEntityNameEdit(wctx, e);
            SeparatorText("组件");

            // 组件按全名排序后同一命名空间的组件自然相邻，
            // 命名空间发生变化时输出一个分组标题。
            let mut visible_count = 0;
            let mut last_namespace = "";
            for (let ctype : e->internal::get_components_types
                |> sort(\l, r = l->name < r->name;))
            {
                let cname = ctype->name;
                // 编辑器内部组件（Editor::*）不在检视面板中显示
                if (cname->begin_with("Editor::"))
                    continue;

                visible_count += 1;
                let (ns, short_name) = splitTypeName(cname);
                if (ns != last_namespace)
                {
                    if (ns != "")
                        SeparatorText(ns);
                    last_namespace = ns;
                }

                if (CollapsingHeaderFlags(
                        F"{short_name}##{cname}",
                        TreeNodeAttribute::ImGuiTreeNodeFlags_DefaultOpen))
                {
                    showComponentMembersEdit(wctx, e, ctype, cname);
                }
                Spacing();
            }
            if (visible_count == 0)
                TextDisabled("（没有可显示的组件）");
        }
        func showEntityComponentEdit(
            wctx: WorldEditorViewport,
            selected_entity_id: entity::internal::euid_t)
        {
            for (let e : wctx->getEntitySelector)
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(eeuid)?
                        if (eeuid == selected_entity_id)
                            showEntityComponentEditImpl(wctx, e);
                }
            }
        }
        public func run(self: Inspector)=> bool
        {
            // 检视面板窗体不再被选中时，视为一次编辑手势结束并提交
            if (!IsWindowFocused())
                commitEditSession();

            // 距离上一次改动超过 EDIT_SESSION_TIMEOUT（edit 持续返回 false），
            // 视为一次编辑手势结束并提交
            match (s_active_edit_session)
            {
                none?;
                value(session)?
                    if (time() - session.m_last_active_time >= EDIT_SESSION_TIMEOUT)
                        commitEditSession();
            }

            match (WorldEditorViewport::getLastFocused()
                =>> \wctx = wctx->getSelectedEntityId()
                    ->> \selected_entity_id = (wctx, selected_entity_id);
                    ;)
            {
                none?
                {
                    TextDisabled("（没有待编辑的实体）");

                    // 失去编辑目标时，结束任何遗留的编辑手势
                    commitEditSession();
                }
                value((wctx, selected_entity_id))?
                {
                    // 正在编辑的实体不再是当前选中实体（手势中途切换了选中项）时，
                    // 先提交被中断的手势
                    match (s_active_edit_session)
                    {
                        none?;
                        value(session)?
                            if (session.m_eid != selected_entity_id)
                                commitEditSession();
                    }

                    showEntityComponentEdit(wctx, selected_entity_id);
                }
            }
            return !self.m_close;
        }
    }
}
