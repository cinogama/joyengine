import woo::std;

import je;
import je::ecs;
import je::internal;
import je::gui;
import je::typeinfo;

import pkg::interface;
import pkg::worst;

import builtin::editor::GUI::Windows;

import WorldEditorViewport;
import EditSession;
import Action::AddComponent;
import Action::DestroyEntity;
import Action::RemoveComponent;
import Action::RemoveRendererShaders;
import Action::RemoveRendererShape;
import Action::RemoveRendererTextures;

using std;
using je;
using je::gui;
using je::towoo;
using JEEditor::GUI::Windows;
using JEEditor::Editor::EditSession;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    using Inspector = struct{
        m_close: mut bool,
    }
    {
        // EditSession 中的面板标识，用于手势的焦点归属判定
        let PANEL_OWNER = "Inspector";
        
        let mut s_inspector_singleton = option::none: option<Inspector>;

        // “添加组件”选择弹窗的状态；检视面板是单例，用模块级状态即可
        let mut s_add_component_filter = "";
        let mut s_add_component_focus = false;
        
        public func isInspectorExist()
        {
            return s_inspector_singleton->is_value;
        }
        public func showInspector()
        {
            do show(create());
        }
        public func closeInspector()
        {
            match (s_inspector_singleton)
            {
                none?;
                value(inst)?
                    inst->close();
            }
        }
        
        func create()=> Inspector
            where require!(Inspector: IWindows);
        {
            return Inspector{
                m_close = mut false,
            };
        }
        func close(self: Inspector)=> void
        {
            self.m_close = true;
        }
        public func onClose(_: Inspector)=> void
        {
            // 面板被关闭时，结束任何遗留的编辑手势
            EditSession::commit();
        }
        public func getTitle(_: Inspector)=> string
        {
            return "检视";
        }
        public func getSizeConstraints(_: Inspector)=> SizeConstraints
        {
            return SizeConstraints::Limited(((300., 200.), (600., 4096.)));
        }
        // 将 "Transform::LocalPosition" 拆为 ("Transform", "LocalPosition")，
        // 不带命名空间的类型名返回 ("", 原名)。
        func splitTypeName(cname: string)=> (string, string)
        {
            let sep_pos = cname->find("::")->or(-1);
            if (sep_pos < 0)
                return ("", cname);
            return (cname->sub_len(0, sep_pos), cname->sub(sep_pos + 2));
        }
        func showEntityNameEdit(wctx: WorldEditorViewport, e: entity)
        {
            TextDisabled("名称");
            SameLine();
            SetNextItemWidth(-1.);
            
            let NAME_EDIT_TAG = "##entity_name";
            
            match (InputText(NAME_EDIT_TAG, e->internal::name))
            {
                none?;
                value(new_name)?
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?
                            // 没有 EUID 的实体无法支持撤销
                            e->internal::set_name(new_name);
                        value(eid)?
                        {
                            // 手势首帧时新名字尚未写入，此刻的名字即撤销点；
                            // 输入期间的每一步改名立即生效，保证输入框状态连续
                            EditSession::trackRename(
                                NAME_EDIT_TAG, PANEL_OWNER, wctx, eid,
                                e->internal::name, new_name);
                            e->internal::set_name(new_name);
                        }
                    }
                }
            }
        }
        func showComponentMembersEdit(
            wctx: WorldEditorViewport, e: entity, ctype: typeinfo, cname: string)
        {
            let cinst = e->get_component(ctype)->unwrap;
            let eid = e->internal::get_entity_uid;
            
            Indent(0.);
            for (let (mname, mtype, mhandle) : cinst->get_members)
            {
                TextDisabled(mname);
                SameLine();
                SetNextItemWidth(-1.);
                
                let member_tag = F"##{cname}##{mname}##{mhandle}";
                
                // edit 一旦返回 true，成员值已被就地修改，先留档修改前的序列化值
                let old_value = eid=>> \_ = unsafe::dynamic_parser::save(mtype, mhandle);;
                
                match (unsafe::dynamic_parser::edit(mtype, mhandle, member_tag))
                {
                    none?
                    {
                        NewLine();
                        TextDisabled(F"编辑器没有为 `{mtype->script_name->or(mtype->name)}` 类型提供编辑组件");
                    }
                    value(updated)?
                    {
                        if (updated)
                        {
                            match (eid)
                            {
                                none?;
                                value(eidv)?
                                    match (old_value)
                                    {
                                        none?;
                                        value(before)?
                                            EditSession::trackMember(
                                                member_tag, PANEL_OWNER, wctx, eidv,
                                                ctype->name, mname,
                                                before,
                                                unsafe::dynamic_parser::save(mtype, mhandle)
                                                    ->or(before));
                                    }
                            }
                        }
                    // 返回 false 表示本次没有改动；手势是否结束由
                    // 超时/选中变化/其他成员改动判定（见 run()）。
                    }
                }
            }
            Unindent(0.);
        }
        // 渲染器三件套（Renderer::Shape/Shaders/Textures）的移除分发：
        // 按类型名转交 Action 目录下的专用 Action（RemoveRendererShaders /
        // RemoveRendererTextures / RemoveRendererShape），命中并成功提交时
        // 返回 true；未命中或无法创建（如缺少 EUID）返回 false，由调用方
        // 退回通用 RemoveComponent 流程。
        func tryRemoveRendererComponent(
            wctx: WorldEditorViewport, e: entity, ctype: typeinfo)=> bool
        {
            if (ctype->name == "Renderer::Shaders")
                return RemoveRendererShaders::remove(wctx, e);
            if (ctype->name == "Renderer::Textures")
                return RemoveRendererTextures::remove(wctx, e);
            if (ctype->name == "Renderer::Shape")
                return RemoveRendererShape::remove(wctx, e);
            return false;
        }
        // 移除组件的统一入口：先结束可能进行中的编辑手势，再发布可撤销的
        // 移除操作；渲染器三件套的数据不在反射成员里，走专用 Action。
        // 当待移除的是最后一个可见组件（Editor::* 之外）时，改为销毁整个
        // 实体——空实体没有保留意义，销毁同样可撤销。
        // 没有 EUID 的实体退化为直接移除（无法支持撤销）。
        func removeComponentFromEntity(
            wctx: WorldEditorViewport, e: entity, ctype: typeinfo)=> void
        {
            EditSession::commit();

            // 待移除组件必在可见组件之列；可见组件仅剩一个即为它
            let visible_count = e->internal::get_components_types
                ->forall(\t = !t->name->begin_with("Editor::");)->len;
            if (visible_count == 1)
            {
                wctx->doAction(DestroyEntity::try_create(e)->unwrap);
                return;
            }

            if (tryRemoveRendererComponent(wctx, e, ctype))
                return;
            match (RemoveComponent::try_create(e, ctype))
            {
                none?
                    do e->remove_component(ctype);
                value(action)?
                    wctx->doAction(action);
            }
        }
        // “添加组件”选择弹窗：搜索过滤 + 按命名空间分组的候选列表。
        // 选中一项立即发布添加操作且保持弹窗打开，便于连续添加；
        // 已添加的组件自下一帧起从候选中消失。
        func showAddComponentPicker(wctx: WorldEditorViewport, e: entity)=> void
        {
            // 弹窗大小由内容自适应；若控件用 -1 占满宽度，弹窗自身没有
            // 可参考的实宽，会塌缩成细条，因此这里给控件显式像素宽度
            let picker_width = 300.;

            SetNextItemWidth(picker_width);
            if (s_add_component_focus)
            {
                SetKeyboardFocusHere(0);
                s_add_component_focus = false;
            }
            match (InputText("##add_component_filter", s_add_component_filter))
            {
                none?;
                value(new_filter)?
                    s_add_component_filter = new_filter;
            }

            let filter_lower = s_add_component_filter->lower;
            let has_filter = filter_lower->len > 0;

            // 候选为全部已注册组件，排除编辑器内部组件（Editor::*）、
            // 实体已有的组件以及不匹配搜索词的组件（按含命名空间的全名匹配）
            let candidates = typeinfo::get_all_components_types()
                ->forall(\ctype = !ctype->name->begin_with("Editor::") &&
                            e->get_component(ctype)->is_none &&
                            (!has_filter ||
                                ctype->name->lower->find(filter_lower)->is_value);)
                |> sort(\l, r = l->name < r->name;);

            // 列表高度固定为约 8 行，避免候选过多时撑爆弹窗
            if (BeginListBox("##add_component_candidates", picker_width,
                    GetFrameHeightWithSpacing() * 8.))
            {
                // 与上方组件区一致的命名空间分组标题
                let mut last_namespace = "";
                for (let ctype : candidates)
                {
                    let (ns, short_name) = splitTypeName(ctype->name);
                    if (ns != last_namespace)
                    {
                        if (ns != "")
                            SeparatorText(ns);
                        last_namespace = ns;
                    }

                    if (Selectable(F"{short_name}##add_{ctype->name}"))
                    {
                        // 先结束可能进行中的编辑手势，再发布添加组件的操作
                        EditSession::commit();
                        match (AddComponent::try_create(e, ctype))
                        {
                            none?
                                // 没有 EUID 的实体退化为直接添加（无法支持撤销）
                                do e->add_component(ctype);
                            value(action)?
                                wctx->doAction(action);
                        }
                    }
                }
                if (candidates->len == 0)
                    TextDisabled("（没有匹配的组件）");

                EndListBox();
            }
        }
        func showEntityComponentEditImpl(wctx: WorldEditorViewport, e: entity)
        {
            showEntityNameEdit(wctx, e);
            SeparatorText("组件");
            
            // 组件按全名排序后同一命名空间的组件自然相邻，
            // 命名空间发生变化时输出一个分组标题。
            let mut visible_count = 0;
            let mut last_namespace = "";
            for (let ctype : e->internal::get_components_types
                |> sort(\l, r = l->name < r->name;))
            {
                let cname = ctype->name;
                // 编辑器内部组件（Editor::*）不在检视面板中显示
                if (cname->begin_with("Editor::"))
                    continue;
                    
                visible_count += 1;
                let (ns, short_name) = splitTypeName(cname);
                if (ns != last_namespace)
                {
                    if (ns != "")
                        SeparatorText(ns);
                    last_namespace = ns;
                }
                
                // AllowItemOverlap 允许后绘制的行尾 × 按钮抢占重叠区域的
                // 悬停与点击；折叠头的命中区总是横跨整行且忽略
                // SetNextItemWidth，不加此标志 × 的点击会被标题吞掉
                let expanded = CollapsingHeaderFlags(
                    F"{short_name}##{cname}",
                    TreeNodeAttribute::ImGuiTreeNodeFlags_DefaultOpen
                        + TreeNodeAttribute::ImGuiTreeNodeFlags_AllowItemOverlap);

                // 右键组件标题可移除该组件；显式绑定到标题的标签上，
                // 且必须紧跟标题项调用（悬停检测基于最后绘制的项），
                // 避免展开时误绑到成员控件或行尾按钮
                if (BeginPopupContextItemLabel(F"{short_name}##{cname}"))
                {
                    if (MenuItem(F"移除组件 {short_name}"))
                        removeComponentFromEntity(wctx, e, ctype);

                    defer EndPopup();
                }

                // 折叠头的布局宽度只覆盖文字，× 需手动定位到行尾
                SameLine();
                let (cursor_x, cursor_y) = GetCursorPos();
                let (avail_width, _) = GetContentRegionAvail();
                SetCursorPos((cursor_x + avail_width - 28., cursor_y));
                if (ButtonSize(F"×##remove_{cname}", (24., 0.)))
                    removeComponentFromEntity(wctx, e, ctype);

                if (expanded)
                    showComponentMembersEdit(wctx, e, ctype, cname);
                Spacing();
            }
            if (visible_count == 0)
                TextDisabled("（没有可显示的组件）");

            Spacing();
            if (ButtonSize("添加组件", (-1., 0.)))
            {
                // 每次打开弹窗都复位搜索词，并将焦点设到搜索框
                s_add_component_filter = "";
                s_add_component_focus = true;
                OpenPopup("##add_component_picker");
            }

            if (BeginPopup("##add_component_picker"))
            {
                showAddComponentPicker(wctx, e);
                defer EndPopup();
            }
        }
        func showEntityComponentEdit(
            wctx: WorldEditorViewport,
            selected_entity_id: entity::internal::euid_t)
        {
            for (let e : wctx->getEntitySelector)
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(eeuid)?
                        if (eeuid == selected_entity_id)
                            showEntityComponentEditImpl(wctx, e);
                }
            }
        }
        public func run(self: Inspector)=> bool
        {
            let selection = WorldEditorViewport::getLastFocused()
                =>> \wctx = wctx->getSelectedEntityId()
                    ->> \selected_entity_id = (wctx, selected_entity_id);
                    ;
                ;
                
            // 手势结束判定（超时/选中实体变化/本面板失去焦点），见 EditSession
            EditSession::update(
                PANEL_OWNER, IsWindowFocused(), selection->> \sel = sel.1;);
                
            match (selection)
            {
                none?
                    TextDisabled("（没有待编辑的实体）");
                value((wctx, selected_entity_id))?
                {
                    showEntityComponentEdit(wctx, selected_entity_id);
                }
            }
            return !self.m_close;
        }
    }
}
