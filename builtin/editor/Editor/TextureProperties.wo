import pkg::std;

import je;
import je::gui;
import je::graphic;
import je::internal;

import pkg::fsys;
import pkg::interface;
import pkg::toml;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::Singleton::Universe;

import ResourcePath;

using std;
using je;
using je::gui;
using je::graphic;
using fsys;
using toml;

using JEEditor::GUI;
using JEEditor::GUI::Forms;
using JEEditor::Singleton;
using JEEditor::GUI::Windows;
using JEEditor::Editor::ResourcePath;

namespace JEEditor::Editor
{
    // 图片纹理缓存的像素存储格式：
    //   COMPRESSED —— BC1/BC3 块压缩（默认），GPU 可直接上传，显存/缓存体积
    //                 降到 1/8（BC1）或 1/4（BC3）；
    //   RAW        —— 原始 RGBA8 像素，无损但体积最大。
    enum texture_pixel_format
    {
        COMPRESSED,
        RAW,
    }

    // 图片纹理属性窗口：编辑图片的颜色空间与缓存像素格式，写入
    // <图片路径>.je4texture（TOML）。
    // 引擎加载图片时按图片与该源文件生成/复用纹理缓存 <图片路径>.je4cache
    //（颜色空间 + 像素），颜色空间决定 GPU 纹理格式：
    //   SRGB   —— 颜色贴图（默认），采样时硬件把 sRGB 转为线性；
    //   LINEAR —— 法线/遮罩等非颜色数据，按线性数值直接采样。
    // 缓存像素格式（pixel_format）决定缓存与 GPU 纹理是否使用块压缩。
    using TextureProperties = struct{
        m_path: path_t,
        m_runtime_path: string,
        m_color_space: mut texture_color_space,
        m_pixel_format: mut texture_pixel_format,
        m_preview: mut option<texture2d>,
        m_status: mut string,
    }
    {
        public func create(path: path_t)=> TextureProperties
            where require!(TextureProperties: Windows::IWindows);
        {
            let runtime_path = ResourcePath::toRuntimeResourcePath(path);
            return TextureProperties{
                m_path = path,
                m_runtime_path = runtime_path,
                m_color_space = mut loadColorSpace(path),
                m_pixel_format = mut loadPixelFormat(path),
                m_preview = mut texture2d::load(
                    option::value(Singleton::Universe::getUniverse()), runtime_path),
                m_status = mut "",
            };
        }
        // 读取 <图片路径>.je4texture 中保存的颜色空间：属性源文件不存在、
        // 无法解析、键缺失或取值未知时按默认的 sRGB 处理（与引擎一致）。
        func loadColorSpace(path: path_t)=> texture_color_space
        {
            let settings_path = normalize(path->to_string + ".je4texture");
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(root)?
                    {
                        match (root["color_space"]->as_string)
                        {
                            value(name)?
                            {
                                if (name->lower == "linear")
                                    return texture_color_space::LINEAR;
                            }
                            none?;
                        }
                    }
                    err(_)?;
                }
            }
            return texture_color_space::SRGB;
        }
        // 读取 <图片路径>.je4texture 中保存的缓存像素格式：只有显式的
        // pixel_format = "raw" 关闭压缩，其他情况按默认的压缩处理。
        func loadPixelFormat(path: path_t)=> texture_pixel_format
        {
            let settings_path = normalize(path->to_string + ".je4texture");
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(root)?
                    {
                        match (root["pixel_format"]->as_string)
                        {
                            value(name)?
                            {
                                if (name->lower == "raw")
                                    return texture_pixel_format::RAW;
                            }
                            none?;
                        }
                    }
                    err(_)?;
                }
            }
            return texture_pixel_format::COMPRESSED;
        }
        public func showTextureProperties(path: path_t)
        {
            do Windows::show(create(path));
        }
        public func getTitle(self: TextureProperties)=> string
        {
            // $ID 让多张图片的属性窗口可以同时打开（见 Windows::show）。
            return F"图片属性: {filename(self.m_path)} $ID";
        }
        public func getAttrib(_: TextureProperties)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                + WindowsAttribute::ImGuiWindowFlags_NoSavedSettings
                ;
        }
        public func getSizeConstraints(_: TextureProperties)=> SizeConstraints
        {
            return SizeConstraints::Limited(((420., 300.), (960., 900.)));
        }
        // 属性改变后失效共享纹理缓存并重新加载预览。已经绑定到场景实体的
        // 旧纹理句柄不会自动替换，重新打开世界/视口后生效。
        func reloadPreview(self: TextureProperties)=> void
        {
            let univ = Singleton::Universe::getUniverse();
            do univ->internal::mark_shared_glresource_outdated(self.m_runtime_path);
            self.m_preview = texture2d::load(
                option::value(univ), self.m_runtime_path);
        }
        // 把当前颜色空间与缓存像素格式写入 <图片路径>.je4texture；属性源文件
        // 是唯一真相，校验码随之改变，引擎会在下次加载时重建纹理缓存。
        // 失败时弹窗并返回 false。
        func saveSettings(self: TextureProperties)=> bool
        {
            let settings_path = normalize(self.m_path->to_string + ".je4texture");
            let mut root = toml::new_table();
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(loaded)? root = loaded;
                    err(msg)?
                    {
                        do MsgBox::err("保存失败",
                            F"无法读取纹理属性文件：{msg}");
                        return false;
                    }
                }
            }
            root->set("color_space",
                (self.m_color_space == texture_color_space::LINEAR)
                    ? "linear" | "srgb");
            root->set("pixel_format",
                (self.m_pixel_format == texture_pixel_format::RAW)
                    ? "raw" | "compressed");

            match (toml::save(root, settings_path))
            {
                ok(_)? return true;
                err(msg)?
                {
                    do MsgBox::err("保存失败",
                        F"无法写入纹理属性文件：{msg}");
                    return false;
                }
            }
        }
        func drawPreview(self: TextureProperties)=> void
        {
            let avail = GetContentRegionAvail();
            if (BeginChildSizeFlags("##texture_preview", avail.0, 320.,
                    WindowsAttribute::ImGuiWindowFlags_None))
            {
                match (self.m_preview)
                {
                    none?
                        TextDisabled("无法加载图片预览");
                    value(tex)?
                    {
                        let (tw, th) = tex->size;
                        if (tw <= 0 || th <= 0)
                            TextDisabled("图片尺寸无效");
                        else
                        {
                            let panel = GetContentRegionAvail();
                            let scale_w = panel.0 / tw as real;
                            let scale_h = panel.1 / th as real;
                            let mut scale = (scale_w < scale_h)
                                ? scale_w | scale_h;
                            if (scale > 1.)
                                scale = 1.;
                            ImageSize(tex,
                                tw as real * scale, th as real * scale);
                        }
                    }
                }
            }
            EndChild();
        }
        public func run(self: TextureProperties)=> bool
        {
            Text(F"文件: {filename(self.m_path)}");
            TextDisabled(self.m_path->to_string);
            if (IsItemHovered())
                do SetTooltip(self.m_path->to_string);

            Separator();

            Text("颜色空间");
            let labels = [
                "sRGB（默认，颜色贴图）",
                "Linear（非颜色数据）",
            ];
            match (Combo("##texture_color_space", labels,
                    option::value(self.m_color_space as int)))
            {
                none?;
                value(index)?
                    self.m_color_space = (index == 1)
                        ? texture_color_space::LINEAR
                        | texture_color_space::SRGB;
            }
            if (IsItemHovered())
                do SetTooltip(
                    "sRGB：硬件在采样时把 8 位 sRGB 数据转换为线性；Linear：按线性数值直接采样，适用于法线图、遮罩等非颜色数据。");

            Separator();

            Text("缓存像素格式");
            let format_labels = [
                "压缩（默认，BC1/BC3）",
                "原始像素（RGBA8）",
            ];
            match (Combo("##texture_pixel_format", format_labels,
                    option::value(self.m_pixel_format as int)))
            {
                none?;
                value(index)?
                    self.m_pixel_format = (index == 1)
                        ? texture_pixel_format::RAW
                        | texture_pixel_format::COMPRESSED;
            }
            if (IsItemHovered())
                do SetTooltip(
                    "压缩：缓存与 GPU 纹理按 BC1/BC3 块压缩存储，块数据可直接上传——没有半透明像素时用 BC1（体积 1/8），否则用 BC3（1/4，保留 8 位 alpha）；不支持 BC 的图形后端会在加载时解码。原始：保存 RGBA8 像素，体积最大但无损。");

            Separator();
            self->drawPreview();
            Separator();

            if (Button("保存"))
            {
                if (self->saveSettings())
                {
                    self->reloadPreview();
                    self.m_status = "已保存。已打开视口中的纹理需重新加载后生效。";
                }
            }
            SameLine();
            if (Button("重新加载预览"))
            {
                self->reloadPreview();
                self.m_status = "预览已重新加载。";
            }

            if (self.m_status->len > 0)
                TextDisabled(self.m_status);

            return true;
        }
    }
}
