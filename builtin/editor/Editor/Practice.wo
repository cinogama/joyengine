/*
Practice: 对实体的一切改动均通过 Practice 对象执行落实。

Practice 是对实体的编辑管理，保留编辑操作的历史，并支持回退功能。
*/
import woo::std;

import je;
import je::ecs;
import je::internal;

import pkg::interface;
import pkg::toml;
import pkg::try;
import pkg::list;

import WorldEditorViewport;
import Action::IAction;

using je;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    using Practice = struct{
        m_history: vec<IAction>,
        m_history_place_index: mut int,
        
        m_operation_queue: list<ActionRequest>,
    }
    {
        union ActionRequest
        {
            Undo(bool /*retried*/),
            Redo(bool /*retried*/),
            Action((IAction, bool /* retried */)),
        }
        
        public func create()=> Practice
        {
            return Practice{
                m_history = []mut,
                m_history_place_index = mut 0,
                m_operation_queue = list::create:<ActionRequest>(),
            };
        }
        
        public func doAction<T>(self: Practice, action: T)
            where require!(T: IAction);
        {
            self.m_operation_queue->add(
                ActionRequest::Action((IAction::create(action), false)));
        }
        
        public func undo(self: Practice)
        {
            self.m_operation_queue->add(ActionRequest::Undo(false));
        }
        
        public func redo(self: Practice)
        {
            self.m_operation_queue->add(ActionRequest::Redo(false));
        }
        
        public func update(self: Practice, w: WorldEditorViewport)=> result<bool, string>
        {
            for (;;)
            {
                match (self.m_operation_queue->pop_front())
                {
                    none? break;
                    value(action)?
                    {
                        match (action)
                        {
                            Redo(retried)?
                            {
                                if (self.m_history_place_index < self.m_history->len)
                                {
                                    if (self.m_history[self.m_history_place_index]->redo(w))
                                        self.m_history_place_index += 1;
                                    else
                                    {
                                        if (!retried)
                                        {
                                            self.m_operation_queue->add_front(
                                                ActionRequest::Redo(true));
                                                
                                            return_ok! false;
                                        }
                                        // 已经推迟过一帧了，操作切实地失败了。
                                        throw! "重做操作失败";
                                    }
                                }
                            }
                            Undo(retried)?
                            {
                                let undo_action_index = self.m_history_place_index - 1;
                                if (undo_action_index >= 0)
                                {
                                    if (self.m_history[undo_action_index]->undo(w))
                                        self.m_history_place_index = undo_action_index;
                                    else
                                    {
                                        if (!retried)
                                        {
                                            self.m_operation_queue->add_front(
                                                ActionRequest::Undo(true));
                                                
                                            return_ok! false;
                                        }
                                        // 已经推迟过一帧了，操作切实地失败了。
                                        throw! "撤销操作失败";
                                    }
                                }
                            }
                            Action((action, retried))?
                            {
                                if (action->redo(w))
                                {
                                    if (self.m_history_place_index != self.m_history->len)
                                        assert(self.m_history->shrink(self.m_history_place_index));
                                        
                                    self.m_history->add(action);
                                    self.m_history_place_index += 1;
                                }
                                else
                                {
                                    if (!retried)
                                    {
                                        // 操作失败？可能是实体刚刚创建，下一个 action 未立刻生效。
                                        // 暂时先收摊，等待一帧之后再说.
                                        self.m_operation_queue->add_front(
                                            ActionRequest::Action((action, true)));
                                            
                                        return_ok! false;
                                    }
                                    // 已经推迟过一帧了，操作切实地失败了。
                                    throw! "操作失败";
                                }
                            }
                        }
                    }
                }
            }
            return_ok! true;
        }
    }
}
