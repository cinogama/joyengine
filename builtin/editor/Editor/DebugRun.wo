// 编辑器调试运行（Play in Editor）的全局编排。
//
// 开始运行（startDebugRun）：
//   ① 采集当前宇宙所有世界的上下文（有视口的带编辑器上下文）到
//      SavedEditorWorldContext 单例的 m_play_saved 槽位（世界保持存活，
//      区别于冻结的暂停+关闭视口后重建）；
//   ② set_enable(false) 暂停所有引擎世界实例；
//   ③ 把各视口“调试执行/导出时才启用”的系统（m_runtime_systems）
//      add_system 进世界——此刻世界处于暂停态，与编辑器建世界的
//      “先装系统再启用”流程一致；
//   ④ 关闭全部世界视口窗口（世界实例保留继续运行；关闭请求须在非沉浸
//      的一帧里泵到 run 才生效，进入沉浸模式因此推迟到协程让出一帧后）；
//   ⑤ 协程等待数帧（暂停/加系统的指令经世界命令缓冲在下一逻辑更新
//      生效）后 set_enable(true) 恢复所有世界运行；
//   ⑥ 运行期间默认隐藏所有常规窗口、主菜单栏与状态栏（沉浸模式），
//      仅留可拖动的调试运行停止条（默认悬浮于左上角、菜单区下方）；
//      运行中可经停止条按钮或 Shift+F6 随时切换编辑器 UI 显隐
//      （toggleDebugRunUI）。ClosingWorldChecker 会为各世界补给运行期
//      临时编辑视口（独立编辑历史、不执行保存，见 ClosingWorldChecker），
//      供运行期临场编辑，停止时统一关闭回收——因此运行期不做全局的
//      编辑历史抑制（编辑只会落入临时视口各自的独立历史）。
//
// 终止运行（stopDebugRun）：关闭当前宇宙中所有世界（运行中被游戏逻辑
// 改动的世界与运行期新建的世界一并关闭），用 ① 的快照重建世界，为有
// 编辑器上下文的条目重建视口窗口（不挂运行时系统，回到编辑态），恢复
// 编辑现场与 UI。
//
// 注意：调试运行期间模块/ToWoo 依然会经冻结机制（FreezeWorldsTodo）
// 更新世界——冻结与运行各持 SavedEditorWorldContext 的独立槽位
//（m_frozen_saved / m_play_saved）互不覆盖；冻结协程等待停止运行过渡
// 结束后才采集，本文件的停止流程则等待“冻结已生效”
//（isWorldsFrozenEngaged），两者不会互相等待。

import pkg::std;
import pkg::interface;

import je;
import je::ecs;
import je::gui;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Menu;
import builtin::editor::GUI::Statebar;

import WorldEditorViewport;
import builtin::editor::Editor::WorldEditorViewport::ClosingWorldChecker;

import builtin::editor::Singleton::Universe;

using std;
using je;
using je::gui;
using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Menu;
using JEEditor::GUI::Statebar;

namespace JEEditor::Editor::DebugRun
{
    // 恢复世界运行前等待的帧数（对齐 FreezeWorldsTodo 的等待帧数）：
    // 让暂停与加系统的命令切实落地后再恢复运行
    let DEBUG_RUN_RESUME_WAIT_FRAMES = 5;
    
    let mut s_debug_running = false;
    // 停止流程进行中（运行世界已关闭、尚未从运行快照重建完成）
    let mut s_transitioning = false;
    
    public func isDebugRunning()=> bool
    {
        return s_debug_running;
    }
    
    // 调试运行进行中或停止流程未完成（各编辑入口据此拒绝操作）
    public func isDebugRunActive()=> bool
    {
        return s_debug_running || s_transitioning;
    }
    
    // 调试运行期间编辑器 UI（常规窗口/主菜单栏/状态栏）是否可见：
    // 运行开始默认全部隐藏（沉浸模式），运行中可经停止条按钮或
    // Shift+F6 随时切换，便于边运行边做编辑操作；停止条本身常驻
    let mut s_debug_run_ui_visible = false;
    
    public func isDebugRunUIVisible()=> bool
    {
        return s_debug_run_ui_visible;
    }
    
    // 统一应用运行期编辑器 UI 显隐（可见 = 退出沉浸模式并显示主菜单与
    // 状态栏；调试运行停止条窗口豁免沉浸隐藏、常驻可见，见
    // DebugRunToolbar::isHiddenInImmersiveMode）
    func applyDebugRunUIVisibility()=> void
    {
        Windows::setImmersiveMode(!s_debug_run_ui_visible);
        Menu::setMainMenuHidden(!s_debug_run_ui_visible);
        Statebar::setHidden(!s_debug_run_ui_visible);
    }
    
    // 切换调试运行期间的编辑器 UI 显隐（仅运行中有效）
    public func toggleDebugRunUI()=> void
    {
        if (!s_debug_running)
            return;
            
        s_debug_run_ui_visible = !s_debug_run_ui_visible;
        applyDebugRunUIVisibility();
    }
    
    public func startDebugRun()=> bool
    {
        if (isDebugRunActive())
            return false;

        // 冻结流程中世界已暂停等待重建，无法采集运行快照
        if (WorldEditorViewport::isWorldsFrozen())
            return false;

        if (Singleton::Universe::getUniverse()->get_all_worlds->len == 0)
            return false;

        // ① 采集运行前所有世界的上下文（有视口的带编辑器上下文）
        WorldEditorViewport::saveAllWorldsForDebugRun();

        // ② 暂停所有引擎世界实例
        for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
            do w->set_enable(false);

        // ③ 把各视口“调试执行”系统加入世界（此刻视口窗口仍在）
        for (let vp : WorldEditorViewport::getAllViewports())
            vp->addRuntimeSystemsToWorld();

        // ④ 关闭全部世界视口窗口（世界实例保留继续运行）
        WorldEditorViewport::closeAllViewportWindows();

        // 复位运行期临时视口记账：ClosingWorldChecker 随后会为各世界补给
        // 临时编辑视口（独立编辑历史、不执行保存），停止时统一回收
        WorldEditorViewport::resetRuntimeEditingState();

        s_debug_running = true;

        // ⑤⑥ 协程：先让出一帧使视口窗口在非沉浸的帧里泵到 run 完成
        //    关闭，再进入沉浸模式；等待数帧后恢复所有世界运行
        launch_coroutine(func(){
                yield();

                s_debug_run_ui_visible = false;
                applyDebugRunUIVisibility();
                DebugRunToolbar::show();

                for (let mut i = 0; i < DEBUG_RUN_RESUME_WAIT_FRAMES; i += 1)
                    yield();

                // 等待期间冻结流程（模块/ToWoo 更新）抢进来时让路：
                // 世界已暂停，解冻重建会自行启用世界，待解冻后再统一恢复
                while (WorldEditorViewport::isWorldsFrozen())
                    yield();

                // 等待期间已被停止：恢复协程就此中止
                if (!s_debug_running)
                    return;

                for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
                    do w->set_enable(true);
            });

        return true;
    }

    public func stopDebugRun()=> void
    {
        if (!s_debug_running || s_transitioning)
            return;

        // 冻结已生效期间不允许停止：世界已暂停等待解冻，待解冻后再停止。
        // 用“已生效”而非“已受理”判断：请求已受理但尚未生效时，冻结协程
        // 正等待本停止过渡完成，此处照常停止，冻结随后采集停止后的结果
        if (WorldEditorViewport::isWorldsFrozenEngaged())
            return;

        s_transitioning = true;
        // 先落运行标志：等待恢复的协程据此自行中止
        s_debug_running = false;

        DebugRunToolbar::requestClose();

        launch_coroutine(
            func(){
                // 为了确保一切正常，结束调试时需要先把编辑器窗口收起来
                // 之后一并恢复
                s_debug_run_ui_visible = false;
                applyDebugRunUIVisibility();

                // 再等待一帧确保编辑器窗口被切实地收起来了
                yield();

                // 冻结流程（模块/ToWoo 更新）恰在此时插入的话等待其完全
                // 解除（含恢复过渡）：恢复期间的世界正处于关闭/重建中，
                // 不能并发关闭/重建
                while (WorldEditorViewport::isWorldsFrozenEngaged())
                    yield();

                // 统一回收运行期临时编辑视口：先从注册表注销再请求关闭
                //（沉浸模式隐藏期间同样生效），世界随后由停止流程关闭，
                // 不会触发意外关闭检查的错误框
                WorldEditorViewport::closeAllRuntimeEditingViewports();

                // 关闭当前宇宙中所有世界：运行中被游戏逻辑改动的世界与
                // 运行期新建的世界一并关闭（实际销毁在下一逻辑更新生效，
                // 需让出帧后再重建）
                WorldEditorViewport::closeAllWorldsForDebugRunStop();

                yield();

                while (WorldEditorViewport::isWorldsFrozenEngaged())
                    yield();

                // 用运行前的快照重建世界与视口（不挂运行时系统，回到编辑态）
                WorldEditorViewport::restoreAllWorldsFromDebugRun();

                // 让选择器/调试摄像机就绪一帧，再恢复编辑 UI
                yield();

                // 恢复编辑 UI：与运行期显隐标记无关，无条件退出沉浸模式
                s_debug_run_ui_visible = true;
                applyDebugRunUIVisibility();
                // 兜底：启动运行当帧即被停止时，工具条可能晚于上面的
                // requestClose 才创建，此处再请求关闭一次（幂等）
                DebugRunToolbar::requestClose();

                s_transitioning = false;
            });
    }
    
    // ==========================
    //  调试运行停止条
    // ==========================
    
    // 运行期间常驻的悬浮停止条（Windows::IWindows 窗口范式，经
    // Windows::show 展示，生命周期由窗口系统管理）：唯一标题（无 $ID）
    // 保证同一时刻至多一条；NoTitleBar + AutoSize 的悬浮小条，抓住
    // 文本/空白区域即可拖动。覆写 isHiddenInImmersiveMode 为 false：
    // 沉浸模式只隐藏常规窗口，停止条作为运行期间唯一的编辑器 UI 常驻
    // 显示。
    // 默认位置在窗口左上角、主菜单栏下方：不占用主视口底部（避免与
    // 状态栏 Statebar 抢占同一停靠位），也避开被融合模式（如 Parallels）
    // 下 OS 菜单栏遮挡的屏幕最顶端。
    using DebugRunToolbar = struct
    {
        m_close: mut bool,
    }
    {
        // 工具条窗口单例（onCreate/onClose 维护）：stopDebugRun 据此
        // 请求关闭；窗口经协程创建，show 返回时单例可能尚未就绪，但
        // 请求关闭只会发生在运行中的后续帧，无碍
        let mut s_toolbar_singleton = option::none: option<DebugRunToolbar>;
        // 默认位置仅在本编辑器会话首个工具条窗口生效一次
        let mut s_spawn_pos_applied = false;
        // 置位初值为 true：防止启动运行时按下的按键残留导致立即误触发
        let mut s_stop_key_latched = true;
        let mut s_toggle_key_latched = true;
        
        public func create()=> DebugRunToolbar
        where require!(DebugRunToolbar: Windows::IWindows);
        {
            return DebugRunToolbar{
                m_close = mut false,
            };
        }
        
        func show()=> void
        {
            do Windows::show(DebugRunToolbar::create());
        }
        // 请求关闭工具条（窗口协程下一泵生效）；窗口不在时无事可做
        func requestClose()=> void
        {
            match (s_toolbar_singleton)
            {
                none?;
                value(toolbar)?
                    toolbar->close();
            }
        }
        
        func close(self: DebugRunToolbar)
        {
            self.m_close = true;
        }
        
        public func getTitle(_: DebugRunToolbar)=> string
        {
            return "调试运行##debug_run_toolbar";
        }
        public func getAttrib(_: DebugRunToolbar)=> WindowsAttribute
        {
            // NoResize + AlwaysAutoResize 由窗口系统按 AutoSize 尺寸
            // 约束补上（见 Windows::_make_window_attrib）
            return WindowsAttribute::ImGuiWindowFlags_NoTitleBar
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                + WindowsAttribute::ImGuiWindowFlags_NoDocking;
        }
        public func getSizeConstraints(_: DebugRunToolbar)=> SizeConstraints
        {
            return SizeConstraints::AutoSize;
        }
        // 沉浸模式（调试运行）下不隐藏：停止条是运行期间唯一的编辑器 UI
        public func isHiddenInImmersiveMode(_: DebugRunToolbar)=> bool
        {
            return false;
        }        
        public func onCreate(self: DebugRunToolbar)=> void
        {
            s_toolbar_singleton = option::value(self);
        }
        public func onClose(_: DebugRunToolbar)=> void
        {
            s_toolbar_singleton = option::none;
        }
        
        // Shift+F5 终止运行（与主菜单项的快捷键标注一致）、Shift+F6 切换
        // 编辑器 UI 显隐；均为边沿触发防重复（与 GUI::Shortcut 的做法
        // 一致）。不走 getShortcut：该机制以窗口聚焦为前提，而运行期间
        // 焦点在游戏视口，停止条的快捷键需要全局生效
        public func onUpdate(_: DebugRunToolbar)=> void
        {
            let shift_down = IsKeyDown(ImGuiKey::ImGuiMod_Shift);
            let f5_down = IsKeyDown(ImGuiKey::ImGuiKey_F5);
            let stop_key_down = shift_down && f5_down;
            let f6_down = IsKeyDown(ImGuiKey::ImGuiKey_F6);
            let toggle_key_down = shift_down && f6_down;
            
            if (stop_key_down)
            {
                if (!s_stop_key_latched)
                {
                    s_stop_key_latched = true;
                    stopDebugRun();
                }
            }
            else
                s_stop_key_latched = false;
                
            if (toggle_key_down)
            {
                if (!s_toggle_key_latched)
                {
                    s_toggle_key_latched = true;
                    do toggleDebugRunUI();
                }
            }
            else
                s_toggle_key_latched = false;
        }
        
        public func run(self: DebugRunToolbar)=> bool
        {
            TextColored((90, 230, 115, 255), "● 调试运行中");
            SameLine();
            let text_toggle = isDebugRunUIVisible() ? "隐藏编辑器" | "显示编辑器";
            if (Button(text_toggle))
                do toggleDebugRunUI();
            SameLine();
            if (Button("■ 停止"))
                do stopDebugRun();
            
            return !self.m_close;
        }
    }
}
