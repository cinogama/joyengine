// 2D 帧动画编辑器 —— 数据模型与文件序列化。
// .je4animation 以 TOML 文本保存（便于 git 管理），数据模型与运行时
// Animation::FrameAnimation 对齐；引擎加载时会把 TOML 交给
// builtin/script/cache_generator/animation.wo 生成二进制 .je4cache，
// 运行时只读取缓存（见 src/jeecs_frame_animation_cache.cpp）。
//
// TOML 结构：
//   [[animations]]                 动作
//   name = "idle"
//   [[animations.frames]]          帧
//   time = 0.1
//   [[animations.frames.components]]
//   name / member / offset / type / value
//   [[animations.frames.uniforms]]
//   name / type / value
// type 为 int/float/vec2/vec3/vec4/quat4；quat4 的 value 保存欧拉角
// （度）[ex, ey, ez]，与 DataValue::QUAT4 的语义一致。

import pkg::std;

import je;
import je::gui;
import je::typeinfo;
import je::towoo;
import je::towoo::types;

import pkg::fsys;
import pkg::math;
import pkg::toml;

using std;
using je::gui;
using fsys;
using toml;

namespace JEEditor::Editor::Animation2D
{
    // ======================================================================
    // Section 1 — 数据模型（与 .je4animation 的 TOML 序列化对应）
    // ======================================================================
    public enum DataValueType
    {
        public INT,
        public FLOAT,
        public VEC2,
        public VEC3,
        public VEC4,
        public QUAT4,
    }
    public union DataValue
    {
        INT(int),
        FLOAT(real),
        VEC2((real, real)),
        VEC3((real, real, real)),
        VEC4((real, real, real, real)),
        QUAT4((real, real, real)),
    }
    namespace DataValue
    {
        using je::gui;

        func to_string(self: DataValue)
        {
            match (self)
            {
                INT(i)? return i as string;
                FLOAT(r)? return r as string;
                VEC2((x, y))? return F"({x}, {y})";
                VEC3((x, y, z))? return F"({x}, {y}, {z})";
                VEC4((x, y, z, w))? return F"({x}, {y}, {z}, {w})";
                QUAT4((x, y, z))? return F"({x}, {y}, {z})";
            }
        }

        public func input_data_value(
            label: string, value: DataValue, is_color: bool,
            on_change: (DataValue)=>void)
        {
            match (value)
            {
                INT(n)?
                    do InputInt(label, n)->> \nv = on_change(DataValue::INT(nv));;
                FLOAT(x)?
                    do InputFloat(label, x)->> \nv = on_change(DataValue::FLOAT(nv));;
                VEC2((x, y))?
                    do InputFloat2(label, x, y)->> \nv = on_change(DataValue::VEC2(nv));;
                VEC3((x, y, z))?
                    do InputFloat3(label, x, y, z)->> \nv = on_change(DataValue::VEC3(nv));;
                VEC4((x, y, z, w))?
                {
                    if (is_color)
                    {
                        // 颜色按线性存储，选择器以 sRGB 显示并写回线性值。
                        let display = ((x, y, z, w) as color)->to_srgb;
                        match (ColorEdit4(label, display as raw vec4))
                        {
                            value(picked)?
                            {
                                let linear =
                                    color::from_srgb(picked as vec4)->to_linear;
                                do on_change(DataValue::VEC4(
                                    (linear.0, linear.1, linear.2, linear.3)));
                            }
                            none?;
                        }
                    }
                    else
                        do InputFloat4(label, x, y, z, w)
                            ->> \nv = on_change(DataValue::VEC4(nv));;
                }
                QUAT4((x, y, z))?
                    do InputFloat3(label, x, y, z)->> \nv = on_change(DataValue::QUAT4(nv));;
            }
        }

        // TOML 中的类型名（与缓存生成器 animation.wo 的约定一致）
        func type_name(self: DataValue)=> string
        {
            match (self)
            {
                INT(_)? return "int";
                FLOAT(_)? return "float";
                VEC2(_)? return "vec2";
                VEC3(_)? return "vec3";
                VEC4(_)? return "vec4";
                QUAT4(_)? return "quat4";
            }
        }

        // 把 DataValue 写入 TOML 表的 "value" 键；调用方另行写入 "type"。
        // quat4 保存欧拉角三元组，运行时缓存由生成器换算成四元数。
        func write_toml(self: DataValue, tbl: Toml)=> void
        {
            match (self)
            {
                INT(n)? tbl->set("value", n);
                FLOAT(x)? tbl->set("value", x);
                VEC2((x, y))?
                {
                    let values = toml::new_array();
                    values->push(x);
                    values->push(y);
                    tbl->set("value", values);
                }
                VEC3((x, y, z))?
                {
                    let values = toml::new_array();
                    values->push(x);
                    values->push(y);
                    values->push(z);
                    tbl->set("value", values);
                }
                VEC4((x, y, z, w))?
                {
                    let values = toml::new_array();
                    values->push(x);
                    values->push(y);
                    values->push(z);
                    values->push(w);
                    tbl->set("value", values);
                }
                QUAT4((ex, ey, ez))?
                {
                    let values = toml::new_array();
                    values->push(ex);
                    values->push(ey);
                    values->push(ez);
                    tbl->set("value", values);
                }
            }
        }
    }

    public using FrameComponentData = struct{
        protected m_component_name: string,
        protected m_member_name: string,
        protected m_offset_mode: mut bool,
        protected m_value: mut DataValue,
    }
    {
        public func to_string(self: FrameComponentData)
        {
            if (self.m_offset_mode)
                return F"{self.m_component_name}.{self.m_member_name}+={self.m_value->to_string}";
            else
                return F"{self.m_component_name}.{self.m_member_name}={self.m_value->to_string}";
        }
        public func dup(self: FrameComponentData)
        {
            return FrameComponentData{
                m_component_name = self.m_component_name,
                m_member_name = self.m_member_name,
                m_value = mut self.m_value,
                m_offset_mode = mut self.m_offset_mode,
            };
        }
    }
    public using FrameUniformData = struct{
        protected m_uniform_name: string,
        protected m_value: mut DataValue,
    }
    {
        public func to_string(self: FrameUniformData)
        {
            return F"{self.m_uniform_name}={self.m_value->to_string}";
        }
        public func dup(self: FrameUniformData)
        {
            return FrameUniformData{
                m_uniform_name = self.m_uniform_name,
                m_value = mut self.m_value,
            };
        }
    }
    public using Animation2dFrameData = struct{
        protected m_component_data: vec<FrameComponentData>,
        protected m_uniform_data: vec<FrameUniformData>,
        protected m_time: mut real,
    }
    {
        public func dup(self: Animation2dFrameData)
        {
            return Animation2dFrameData{
                m_time = mut self.m_time,
                m_component_data = self.m_component_data->dup()->>\v = v->dup;,
                m_uniform_data = self.m_uniform_data->dup()->>\v = v->dup;,
            };
        }
    }
    public using AnimationActionData = struct{
        protected m_frames: vec<Animation2dFrameData>,
    }
    {
        public func dup(self: AnimationActionData)
        {
            return AnimationActionData{
                m_frames = self.m_frames->>\afd = afd->dup();,
            };
        }
    }
    public union SelectedComponentOrUniformData
    {
        ComponentIndex(int),
        UniformIndex(int),
        None,
    }
    namespace SelectedComponentOrUniformData
    {
        public func is_selected_component_idx(self: SelectedComponentOrUniformData, id: int)
        {
            match (self)
            {
                ComponentIndex(idx)? return idx == id;
                _? return false;
            }
        }
        public func is_selected_uniform_idx(self: SelectedComponentOrUniformData, id: int)
        {
            match (self)
            {
                UniformIndex(idx)? return idx == id;
                _? return false;
            }
        }
    }

    public func lerp(a, b, deg: real)
        where std::type_traits::is_same :<typeof(a),typeof(b)>
        , a is int
        || a is real
        || a is (real, real)
        || a is (real, real, real)
        || a is (real, real, real, real)
        ;
    {
        if (a is int)
            return math::round(a as real + (b as real - a as real) * deg);
        else if (a is real)
            return a + (b - a) * deg;
        else if (a is (real, real))
            return (lerp(a[0], b[0], deg), lerp(a[1], b[1], deg));
        else if (a is (real, real, real))
            return (lerp(a[0], b[0], deg), lerp(a[1], b[1], deg), lerp(a[2], b[2], deg));
        else if (a is (real, real, real, real))
            return (lerp(a[0], b[0], deg), lerp(a[1], b[1], deg), lerp(a[2], b[2], deg), lerp(a[3], b[3], deg));
        else
            std::panic("lerp: unsupported value type");
    }
    public func lerp_data_value(a, b, deg: real)
    {
        match (a)
        {
            INT(v)? return DataValue::INT(lerp(v, b->unsafe::cast :<(void, int)>()[1], deg));
            FLOAT(v)? return DataValue::FLOAT(lerp(v, b->unsafe::cast :<(void, real)>()[1], deg));
            VEC2(v)? return DataValue::VEC2(lerp(v, b->unsafe::cast :<(void, (real, real))>()[1], deg));
            VEC3(v)? return DataValue::VEC3(lerp(v, b->unsafe::cast :<(void, (real, real, real))>()[1], deg));
            VEC4(v)? return DataValue::VEC4(lerp(v, b->unsafe::cast :<(void, (real, real, real, real))>()[1], deg));
            QUAT4(v)? return DataValue::QUAT4(lerp(v, b->unsafe::cast :<(void, (real, real, real))>()[1], deg));
        }
    }

    // slerp 版本的数据值插值：QUAT4 走球面插值（quat::slerp），其余复用 lerp_data_value。
    // 调用方需保证 a、b 同类型（由 collect_interp_pairs 的 m_type_match 把关）。
    public func interp_data_value(a: DataValue, b: DataValue, t: real) => DataValue
    {
        match (a)
        {
            QUAT4((aex, aey, aez))?
            {
                let (bex, bey, bez) = b->unsafe::cast :<(void, (real, real, real))>()[1];
                let qa = quat::euler(aez, aey, aex);
                let qb = quat::euler(bez, bey, bex);
                let qr = quat::slerp(qa, qb, t);
                let (rz, ry, rx) = qr->euler_angle as (real, real, real);
                return DataValue::QUAT4((rx, ry, rz));
            }
            _? return lerp_data_value(a, b, t);
        }
    }
    func data_value_type_tag(v: DataValue) => DataValueType
    {
        match (v)
        {
            INT(_)? return DataValueType::INT;
            FLOAT(_)? return DataValueType::FLOAT;
            VEC2(_)? return DataValueType::VEC2;
            VEC3(_)? return DataValueType::VEC3;
            VEC4(_)? return DataValueType::VEC4;
            QUAT4(_)? return DataValueType::QUAT4;
        }
    }
    func data_value_same_type(a: DataValue, b: DataValue) => bool
    {
        return data_value_type_tag(a) == data_value_type_tag(b);
    }

    // 插值键：标识一个可插值的组件成员或着色器变量
    public union InterpKey
    {
        Component((string, string)),
        Uniform(string),
    }
    namespace InterpKey
    {
        public func label(k: InterpKey) => string
        {
            match (k)
            {
                Component((c, m))? return c + "." + m;
                Uniform(u)? return u;
            }
        }
    }

    // 两帧之间的键配对信息：标注每个键在 A/B 中的存在性与类型一致性
    public using InterpPair = struct{
        protected m_key: InterpKey,
        protected m_ks: string,
        protected m_in_a: bool,
        protected m_in_b: bool,
        protected m_type_match: bool,
        protected m_a_val: option<DataValue>,
        protected m_b_val: option<DataValue>,
        protected m_a_offset_mode: bool,
    };

    // 在一帧中按 (组件名, 成员名) 查找已存在的值
    func find_component_value(frame: Animation2dFrameData, cname: string, mname: string) => option<DataValue>
    {
        let mut res = option::none: option<DataValue>;
        for (let cd : frame.m_component_data)
        {
            if (cd.m_component_name == cname && cd.m_member_name == mname)
            {
                res = option::value(cd.m_value);
                break;
            }
        }
        return res;
    }
    // 在一帧中按变量名查找已存在的着色器变量值
    func find_uniform_value(frame: Animation2dFrameData, uname: string) => option<DataValue>
    {
        let mut res = option::none: option<DataValue>;
        for (let ud : frame.m_uniform_data)
        {
            if (ud.m_uniform_name == uname)
            {
                res = option::value(ud.m_value);
                break;
            }
        }
        return res;
    }

    // 汇总两帧中所有组件/着色器变量键，标注存在性与类型一致性（不做原地修改）
    public func collect_interp_pairs(a: Animation2dFrameData, b: Animation2dFrameData) => vec<InterpPair>
    {
        let mut result = []mut as vec<InterpPair>;
        // A 的组件键：若 B 中也存在则配对
        for (let cd : a.m_component_data)
        {
            let ks = "C:" + cd.m_component_name + "." + cd.m_member_name;
            match (find_component_value(b, cd.m_component_name, cd.m_member_name))
            {
                value(bval)?
                    do result->add(InterpPair{
                            m_key = InterpKey::Component((cd.m_component_name, cd.m_member_name)),
                            m_ks = ks,
                            m_in_a = true, m_in_b = true,
                            m_type_match = data_value_same_type(cd.m_value, bval),
                            m_a_val = option::value(cd.m_value), m_b_val = option::value(bval),
                            m_a_offset_mode = cd.m_offset_mode,
                        });
                none?
                    do result->add(InterpPair{
                            m_key = InterpKey::Component((cd.m_component_name, cd.m_member_name)),
                            m_ks = ks,
                            m_in_a = true, m_in_b = false, m_type_match = false,
                            m_a_val = option::value(cd.m_value), m_b_val = option::none,
                            m_a_offset_mode = cd.m_offset_mode,
                        });
            }
        }
        // A 的 uniform 键
        for (let ud : a.m_uniform_data)
        {
            let ks = "U:" + ud.m_uniform_name;
            match (find_uniform_value(b, ud.m_uniform_name))
            {
                value(bval)?
                    do result->add(InterpPair{
                            m_key = InterpKey::Uniform(ud.m_uniform_name),
                            m_ks = ks,
                            m_in_a = true, m_in_b = true,
                            m_type_match = data_value_same_type(ud.m_value, bval),
                            m_a_val = option::value(ud.m_value), m_b_val = option::value(bval),
                            m_a_offset_mode = false,
                        });
                none?
                    do result->add(InterpPair{
                            m_key = InterpKey::Uniform(ud.m_uniform_name),
                            m_ks = ks,
                            m_in_a = true, m_in_b = false, m_type_match = false,
                            m_a_val = option::value(ud.m_value), m_b_val = option::none,
                            m_a_offset_mode = false,
                        });
            }
        }
        // B 的组件键中，A 里没有的
        for (let cd : b.m_component_data)
        {
            if (find_component_value(a, cd.m_component_name, cd.m_member_name)->is_none)
            {
                let ks = "C:" + cd.m_component_name + "." + cd.m_member_name;
                do result->add(InterpPair{
                        m_key = InterpKey::Component((cd.m_component_name, cd.m_member_name)),
                        m_ks = ks,
                        m_in_a = false, m_in_b = true, m_type_match = false,
                        m_a_val = option::none, m_b_val = option::value(cd.m_value),
                        m_a_offset_mode = cd.m_offset_mode,
                    });
            }
        }
        // B 的 uniform 键中，A 里没有的
        for (let ud : b.m_uniform_data)
        {
            if (find_uniform_value(a, ud.m_uniform_name)->is_none)
            {
                let ks = "U:" + ud.m_uniform_name;
                do result->add(InterpPair{
                        m_key = InterpKey::Uniform(ud.m_uniform_name),
                        m_ks = ks,
                        m_in_a = false, m_in_b = true, m_type_match = false,
                        m_a_val = option::none, m_b_val = option::value(ud.m_value),
                        m_a_offset_mode = false,
                    });
            }
        }
        return result;
    }

    // 取单个键在 t 处的值：可插值则插值，否则复制存在侧
    func interp_pair_value(p: InterpPair, t: real) => DataValue
    {
        if (p.m_in_a && p.m_in_b && p.m_type_match)
            return interp_data_value(p.m_a_val->unwrap, p.m_b_val->unwrap, t);
        if (p.m_in_a)
            return p.m_a_val->unwrap;
        return p.m_b_val->unwrap;
    }

    // 按勾选状态与 t 生成一帧（offset_mode 沿用 A 侧）
    public func build_interpolated_frame(
        pairs: vec<InterpPair>, checked: map<string, bool>, t: real, ftime: real) => Animation2dFrameData
    {
        let mut comps = []mut as vec<FrameComponentData>;
        let mut unis = []mut as vec<FrameUniformData>;
        for (let p : pairs)
        {
            // 默认与弹窗一致：可插值键默认勾选，其余默认不勾（未在 map 中显式设置时取此默认）
            let defv = p.m_in_a && p.m_in_b && p.m_type_match;
            if (!checked->get_or(p.m_ks, defv))
                continue;
            let val = interp_pair_value(p, t);
            match (p.m_key)
            {
                Component((cname, mname))?
                    do comps->add(FrameComponentData{
                            m_component_name = cname,
                            m_member_name = mname,
                            m_offset_mode = mut p.m_a_offset_mode,
                            m_value = mut val,
                        });
                Uniform(uname)?
                    do unis->add(FrameUniformData{
                            m_uniform_name = uname,
                            m_value = mut val,
                        });
            }
        }
        return Animation2dFrameData{
            m_time = mut ftime,
            m_component_data = comps,
            m_uniform_data = unis,
        };
    }

    // 把 je::typeinfo 映射为对应的默认 DataValue（添加组件/变量时使用）
    public func default_data_value_for_type(t: je::typeinfo) => DataValue
    {
        if (t == je::typeinfo::int)
            return DataValue::INT(0);
        else if (t == je::typeinfo::float)
            return DataValue::FLOAT(0.);
        else if (t == je::typeinfo::float2)
            return DataValue::VEC2((0., 0.));
        else if (t == je::typeinfo::float3)
            return DataValue::VEC3((0., 0., 0.));
        else if (t == je::typeinfo::float4 || t == color::type::typeinfo)
            return DataValue::VEC4((0., 0., 0., 0.));
        else if (t == je::typeinfo::quat)
            return DataValue::QUAT4((0., 0., 0.));
        return DataValue::INT(0);
    }
    public func type_is_animatable(t: je::typeinfo) => bool
    {
        return t == je::typeinfo::int
            || t == je::typeinfo::float
            || t == je::typeinfo::float2
            || t == je::typeinfo::float3
            || t == je::typeinfo::float4
            || t == color::type::typeinfo
            || t == je::typeinfo::quat;
    }
    public func type_is_color(t: je::typeinfo) => bool
    {
        return t == color::type::typeinfo;
    }

    // 组件成员是否为 color 类型。动画文件只存 VEC4 数值，编辑器据此决定
    // 用颜色选择器还是原始数值编辑；类型系统在会话内不变，结果做缓存。
    let mut s_component_member_is_color = {}mut: map<string, bool>;
    public func component_member_is_color(
        comp_name: string, member_name: string) => bool
    {
        let key = comp_name + "." + member_name;
        match (s_component_member_is_color->get(key))
        {
            value(cached)? return cached;
            none?;
        }

        let mut is_color = false;
        match (je::typeinfo::load(comp_name))
        {
            value(t)?
            {
                for (let (name, mtype) : t->get_members_info)
                {
                    if (name == member_name)
                    {
                        is_color = mtype == color::type::typeinfo;
                        break;
                    }
                }
            }
            none?;
        }
        s_component_member_is_color->set(key, is_color);
        return is_color;
    }

    // ======================================================================
    // Section 2 — AnimationContext 与 TOML 读写
    // ======================================================================
    // TOML 读取辅助：缺失/类型不符的字段按空值处理，让手写文件也能打开。
    func array_of_toml(value: Toml)=> array<Toml>
    {
        let mut result = []mut: vec<Toml>;
        match (value->as_array)
        {
            value(items)?
            {
                for (let item : items)
                    result->add(item);
            }
            none?;
        }
        return result->to_array;
    }
    func string_of_toml(value: Toml)=> string
    {
        match (value->as_string)
        {
            value(str)? return str;
            none?;
        }
        return "";
    }
    func bool_of_toml(value: Toml)=> bool
    {
        match (value->as_bool)
        {
            value(flag)? return flag;
            none?;
        }
        return false;
    }
    func real_of_toml(value: Toml)=> real
    {
        match (value->as_float)
        {
            value(number)? return number;
            none?;
        }
        match (value->as_int)
        {
            value(number)? return number as real;
            none?;
        }
        return 0.;
    }
    func int_of_toml(value: Toml)=> int
    {
        match (value->as_int)
        {
            value(number)? return number;
            none?;
        }
        return 0;
    }
    func real_at_toml(values: array<Toml>, index: int)=> real
    {
        if (index < 0 || index >= values->len)
            return 0.;
        return real_of_toml(values[index]);
    }
    // 按 TOML 的 type 名解析 value；类型未知或数值数组过短时返回 none。
    // quat4 的 value 是欧拉角三元组，与 DataValue::QUAT4 的语义一致。
    func read_data_value(type_name: string, value: Toml)=> option<DataValue>
    {
        let kind = type_name->lower;
        if (kind == "int")
            return option::value(DataValue::INT(int_of_toml(value)));
        if (kind == "float")
            return option::value(DataValue::FLOAT(real_of_toml(value)));

        let values = array_of_toml(value);
        if (kind == "vec2")
        {
            if (values->len < 2)
                return option::none;
            return option::value(DataValue::VEC2(
                (real_at_toml(values, 0), real_at_toml(values, 1))));
        }
        if (kind == "vec3")
        {
            if (values->len < 3)
                return option::none;
            return option::value(DataValue::VEC3(
                (real_at_toml(values, 0), real_at_toml(values, 1),
                    real_at_toml(values, 2))));
        }
        if (kind == "vec4")
        {
            if (values->len < 4)
                return option::none;
            return option::value(DataValue::VEC4(
                (real_at_toml(values, 0), real_at_toml(values, 1),
                    real_at_toml(values, 2), real_at_toml(values, 3))));
        }
        if (kind == "quat4")
        {
            if (values->len < 3)
                return option::none;
            return option::value(DataValue::QUAT4(
                (real_at_toml(values, 0), real_at_toml(values, 1),
                    real_at_toml(values, 2))));
        }
        return option::none;
    }

    public using AnimationContext = struct{
        protected m_animations: map<string, AnimationActionData>,
        protected m_path: fsys::path_t,

        // 编辑期选择状态
        protected m_selected_action_name: mut string,
        protected m_selected_frame: mut int,
        protected m_selected_c_or_u_data: mut SelectedComponentOrUniformData,
    }
    {
        public func create(path: fsys::path_t)
        {
            return AnimationContext{
                m_animations = {}mut,
                m_path = path,
                m_selected_action_name = mut "",
                m_selected_frame = mut -1,
                m_selected_c_or_u_data = mut SelectedComponentOrUniformData::None,
            };
        }
        // 从 TOML 读取动画；文件无法解析时返回错误。结构上缺失的字段
        // 按空值处理（手写 TOML 也能打开），未知类型的数据项跳过。
        public func open(path: fsys::path_t)=> result<AnimationContext, string>
        {
            let mut loaded = option::none: option<Toml>;
            match (toml::load(path))
            {
                ok(root)? loaded = option::value(root);
                err(msg)? return result::err(msg);
            }
            let root = loaded->unwrap;

            let self = AnimationContext{
                m_animations = {}mut,
                m_path = path,
                m_selected_action_name = mut "",
                m_selected_frame = mut -1,
                m_selected_c_or_u_data = mut SelectedComponentOrUniformData::None,
            };

            for (let action : array_of_toml(root["animations"]))
            {
                let frames = AnimationActionData{m_frames = []mut};
                self.m_animations->set(string_of_toml(action["name"]), frames);

                for (let frame_toml : array_of_toml(action["frames"]))
                {
                    let frame_data = Animation2dFrameData{
                        m_time = mut real_of_toml(frame_toml["time"]),
                        m_component_data = []mut,
                        m_uniform_data = []mut,
                    };

                    for (let component : array_of_toml(frame_toml["components"]))
                    {
                        match (read_data_value(
                                string_of_toml(component["type"]), component["value"]))
                        {
                            value(v)?
                                do frame_data.m_component_data->add(FrameComponentData{
                                        m_component_name = string_of_toml(component["name"]),
                                        m_member_name = string_of_toml(component["member"]),
                                        m_offset_mode = mut bool_of_toml(component["offset"]),
                                        m_value = mut v,
                                    });
                            none?; // 未知类型或数值缺失，跳过该条目
                        }
                    }

                    for (let uniform : array_of_toml(frame_toml["uniforms"]))
                    {
                        match (read_data_value(
                                string_of_toml(uniform["type"]), uniform["value"]))
                        {
                            value(v)?
                                do frame_data.m_uniform_data->add(FrameUniformData{
                                        m_uniform_name = string_of_toml(uniform["name"]),
                                        m_value = mut v,
                                    });
                            none?;
                        }
                    }

                    frames.m_frames->add(frame_data);
                }
            }
            return result::ok(self);
        }
        public func save(self: AnimationContext)=> bool
        {
            let root = toml::new_table();

            let actions = toml::new_array();
            for (let (action_name, action_data) : self.m_animations)
            {
                let action = toml::new_table();
                action->set("name", action_name);

                let frames = toml::new_array();
                for (let frame : action_data.m_frames)
                {
                    let frame_toml = toml::new_table();
                    frame_toml->set("time", frame.m_time);

                    let components = toml::new_array();
                    for (let cdata : frame.m_component_data)
                    {
                        let component = toml::new_table();
                        component->set("name", cdata.m_component_name);
                        component->set("member", cdata.m_member_name);
                        component->set("offset", cdata.m_offset_mode);
                        component->set("type", cdata.m_value->type_name);
                        cdata.m_value->write_toml(component);
                        components->push(component);
                    }
                    frame_toml->set("components", components);

                    let uniforms = toml::new_array();
                    for (let udata : frame.m_uniform_data)
                    {
                        let uniform = toml::new_table();
                        uniform->set("name", udata.m_uniform_name);
                        uniform->set("type", udata.m_value->type_name);
                        udata.m_value->write_toml(uniform);
                        uniforms->push(uniform);
                    }
                    frame_toml->set("uniforms", uniforms);

                    frames->push(frame_toml);
                }
                action->set("frames", frames);

                actions->push(action);
            }
            // 即使没有动作也写出 animations 键，保证源文件非空
            //（jeecs_create_cache_file 拒绝为 0 字节文件生成缓存）。
            root->set("animations", actions);

            match (toml::save(root, self.m_path))
            {
                ok(_)? return true;
                err(msg)?
                {
                    je::logerr(F"保存动画 {self.m_path->to_string()} 失败：{msg}");
                    return false;
                }
            }
        }

        // 取当前选中动作的帧列表（vec 是引用语义，外部修改会写回）
        public func current_frames(self: AnimationContext) => option<vec<Animation2dFrameData>>
        {
            return self.m_animations->get(self.m_selected_action_name)->>\a = a.m_frames;;
        }
        public func total_duration(frames: vec<Animation2dFrameData>) => real
        {
            let mut s = 0.;
            for (let f : frames)
                s += f.m_time;
            return s;
        }

        // 取文件中的全部动作名（供 types.wo 的值编辑器列举可选动作）
        public func action_names(self: AnimationContext) => array<string>
        {
            let mut arr = []mut as vec<string>;
            for (let (name, _) : self.m_animations)
                arr->add(name);
            return arr->to_array;
        }
    }

    // ======================================================================
    // Section 5 — 精灵图：UV 解析
    // ======================================================================
    // 解析一帧的 Renderer::Textures2D::offset/tiling，得到引擎 UV 空间的 uv0/uv1。
    public func frame_uv(frame: Animation2dFrameData) => option<((real, real), (real, real))>
    {
        let mut offset = (0., 0.);
        let mut tiling = (1., 1.);
        let mut found = false;
        for (let cd : frame.m_component_data)
        {
            if (cd.m_component_name == "Renderer::Textures2D")
            {
                if (cd.m_member_name == "offset")
                {
                    match (cd.m_value)
                    {
                        VEC2((ox, oy))? { offset = (ox, oy); found = true; }
                            _?;
                    }
                }
                else if (cd.m_member_name == "tiling")
                {
                    match (cd.m_value)
                    {
                        VEC2((tx, ty))? { tiling = (tx, ty); found = true; }
                            _?;
                    }
                }
            }
        }
        if (!found)
            return option::none;
        // 对应 woshader: finalUV = (uv + offset) * tiling
        let uv0 = (offset[0] * tiling[0], offset[1] * tiling[1]);
        let uv1 = ((offset[0] + 1.) * tiling[0], (offset[1] + 1.) * tiling[1]);
        return option::value((uv0, uv1));
    }
}
