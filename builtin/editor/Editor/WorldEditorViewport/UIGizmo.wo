// 世界编辑器视口 —— UI 元素（UserInterface::Element）gizmo。
// 选中带 Element 的实体即在其解析后的显示矩形上提供可视化编辑：
// 矩形/参考矩形/锚点/pivot 的显示、矩形内部拖拽移动、四角四边 8 向
// 缩放（pivot 固定语义）、旋转茎环（写 Rotation.angle，仅实体已带
// Rotation 组件时提供），以及视口覆盖 UI 的锚点/轴心九宫格与
// ratio_unit 三态切换。
// 尺寸/偏移分两层编辑，默认编辑比例通道（size_ratio/offset_ratio）：
// 比例层框即元素的实际渲染矩形（外层，青色主线框），缩放手柄默认
// 挂在外层框上；按住 Shift 切到绝对通道（size/offset），手柄挂到
// size 层框（同心内侧的浅灰细框，= size 的像素贡献），层在拖拽开始
// 时冻结。比例通道的像素换算系数（单位一）= 参考矩形尺寸按
// ratio_unit 折叠（height_unit 两轴取参考高 / width_unit 两轴取参考
// 宽 / per_axis 逐轴），size_ratio 与 offset_ratio 共用；写回时层像
// 素增量按轴除以单位一。Ctrl 为吸附键（移动/缩放按 UI_SNAP_PX 吸附、旋转
// 吸附 15°，对两层移动/缩放均生效）。UI 编辑模式下视口不显示任何
// 网格与其他 gizmo（见 uiEditingActive），仅保留本文件的矩形手柄与
// 参考矩形/锚点/pivot 标记。
// 防误操作交互：拖拽带激活死区——按下手柄仅捕获快照（ARMED），位移
// 超过 UI_DRAG_ACTIVATE_PX（屏幕像素，不受视口缩放影响）才激活写值
//（ACTIVE），阈值内松开视为点击（移动手柄转 UI 空间循环选取，不写
// 值、不产生撤销记录）；激活中的拖拽可按 Esc 取消（恢复快照值，不
// 发布撤销）。缩放/旋转手柄命中半径收紧为 UI_HANDLE_HIT_PX 且仅在
// 元素边界带（UI_HIT_PX 容差）内响应，元素某轴屏幕尺寸过小时跳过
// 该轴四边中点手柄（防小元素中心误抓）。“锁定编辑”开关（见
// ViewportUI.wo）打开时不响应任何手柄，点击仅做 UI 空间选取。
// 布局解析复用引擎的 Element::get_layout（显示像素空间，原点=显示区
// 左下、y 向上），祖先旋转链按
// UserInterfaceGraphicPipelineSystem::ResolveUiNodes 同式在脚本侧
// 复算（WorldLayout 的成员未暴露给脚本，累计角沿 Transform 锚点链
// 求 Rotation.angle 之和得到）。拖拽结束值有变化时发布可撤销的
// ModifyComponentMember（与变换游标同一套撤销机制）。覆盖层绘制走
// ImGui 窗口 DrawList（屏幕空间，语义上与 UI 的屏幕空间一致），
// 交互命中判定复用 ColliderGizmo 的屏幕空间距离方式。
// 视口缩放：UI 编辑模式下可对视口纹理做显示级放大（滚轮以鼠标为锚
// 缩放、中键拖拽平移、F 聚焦选中元素，见 updateUIViewNavigation）。
// framebuffer 尺寸与布局解析不变，显示侧按可见子矩形放大（ImageUV），
// 屏幕↔显示换算经 uiViewScreenRect 折叠为“虚拟全图”矩形——现有
// uiDisplayToScreen/uiScreenToDisplay/uiHitTolerance 无需感知缩放；
// zoom==1 时为恒等视图，全部行为与未缩放一致。

import pkg::std;

import je;
import je::ecs;
import je::graphic;
import je::gui;
import je::internal;
import je::typeinfo;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::iterator;
import pkg::math;
import pkg::try;
import pkg::worst;

import builtin::editor::Editor::Action::ModifyComponentMember;

import Definition;
import GizmoMath;
import EntityPicking;
import TransformGizmo;

using std;
using iterator;

using je;
using je::gui;

using JEEditor::Editor::Action;

namespace JEEditor::Editor::WorldEditorViewport
{
    // ---- 纯函数几何工具（显示像素空间） ----

    // 二维旋转（角度制，逆时针；显示空间 y 向上）
    protected func uiRotateVec2(deg: real, v: vec2)=> vec2
    {
        let rad = deg * mathf::DEG2RAD;
        let c = mathf::cos(rad);
        let s = mathf::sin(rad);
        return (v[0] * c - v[1] * s, v[0] * s + v[1] * c) as vec2;
    }

    // alignment 位组合在参考矩形内的锚点偏移：left → −x/2、right → +x/2、
    // top → +y/2、bottom → −y/2（与引擎 UserInterface::anchor_shift 同式）
    protected func uiAnchorShift(alignment_bits: int, ref_size: vec2)=> vec2
    {
        let mut sx = 0.;
        if ((alignment_bits->band(1)) != 0)
            sx -= 0.5;
        if ((alignment_bits->band(2)) != 0)
            sx += 0.5;
        let mut sy = 0.;
        if ((alignment_bits->band(4)) != 0)
            sy += 0.5;
        if ((alignment_bits->band(8)) != 0)
            sy -= 0.5;
        return (sx * ref_size[0], sy * ref_size[1]) as vec2;
    }

    // pivot 位组合在某轴上的侧别：−1（left/bottom）/ 0（居中）/ +1（right/top）
    protected func uiPivotSide(pivot_bits: int, axis: int)=> int
    {
        if (axis == 0)
        {
            if ((pivot_bits->band(1)) != 0)
                return -1;
            if ((pivot_bits->band(2)) != 0)
                return 1;
            return 0;
        }
        if ((pivot_bits->band(4)) != 0)
            return 1;
        if ((pivot_bits->band(8)) != 0)
            return -1;
        return 0;
    }

    // 缩放手柄的轴向符号（显示空间）：axis 0 → x、axis 1 → y，
    // 四角 ±1/±1、四边非零轴 ±1、另一轴 0
    protected func uiHandleSigns(handle: int)=> (int, int)
    {
        if (handle == UI_HANDLE_RESIZE_LB)
            return (-1, -1);
        if (handle == UI_HANDLE_RESIZE_RB)
            return (1, -1);
        if (handle == UI_HANDLE_RESIZE_LT)
            return (-1, 1);
        if (handle == UI_HANDLE_RESIZE_RT)
            return (1, 1);
        if (handle == UI_HANDLE_RESIZE_L)
            return (-1, 0);
        if (handle == UI_HANDLE_RESIZE_R)
            return (1, 0);
        if (handle == UI_HANDLE_RESIZE_B)
            return (0, -1);
        if (handle == UI_HANDLE_RESIZE_T)
            return (0, 1);
        return (0, 0);
    }

    // 显示像素 → ImGui 屏幕坐标（视口图像整幅显示在 rect 内，等比
    // 缩放 + y 翻转；显示空间原点在左下，ImGui 在左上）
    protected func uiDisplayToScreen(
        p: vec2, rmin: vec2, rsize: vec2, display_range: vec2)=> vec2
    {
        return (rmin[0] + p[0] / display_range[0] * rsize[0],
            rmin[1] + (1. - p[1] / display_range[1]) * rsize[1]) as vec2;
    }

    // ImGui 屏幕坐标 → 显示像素
    protected func uiScreenToDisplay(
        p: vec2, rmin: vec2, rsize: vec2, display_range: vec2)=> vec2
    {
        return ((p[0] - rmin[0]) / rsize[0] * display_range[0],
            (1. - (p[1] - rmin[1]) / rsize[1]) * display_range[1]) as vec2;
    }

    // 屏幕命中半径（UI_HIT_PX 像素）换算为各轴的显示像素容差
    //（用于退化尺寸元素的点命中）
    protected func uiHitTolerance(rsize: vec2, display_range: vec2)=> vec2
    {
        return (UI_HIT_PX / (rsize[0] / display_range[0]),
            UI_HIT_PX / (rsize[1] / display_range[1])) as vec2;
    }

    // 向下取整（mathf 未提供 floor；as int 是向零截断，负数会偏一格）
    protected func uiFloor(v: real)=> real
    {
        let i = v as int;
        return (v < i as real) ? (i as real) - 1. | i as real;
    }

    // 按步进取整（half-up；mathf 未提供 round）
    protected func uiRoundTo(v: real, step: real)=> real
    {
        return uiFloor(v / step + 0.5) * step;
    }

    // 某轴的边缘/中心对齐吸附：元素的三条关键线（负边/中心/正边）
    // 与参考矩形的三条关键线两两比对，距离在 UI_SNAP_ALIGN_PX 内时返回
    //（吸附修正量, 命中的参考线坐标）；无命中返回 none。坐标均在祖先
    // 未旋转帧（显示像素）
    protected func uiSnapAlignAxis(
        e0: real, e1: real, e2: real,
        r0: real, r1: real, r2: real)=> option<(real, real)>
    {
        let elem_lines = [e0, e1, e2];
        let ref_lines = [r0, r1, r2];

        let mut best = option::none: option<(real, real)>;
        let mut best_dist = UI_SNAP_ALIGN_PX + 0.001;

        for (let el : elem_lines)
        {
            for (let rl : ref_lines)
            {
                let d = rl - el;
                let ad = mathf::abs(d);
                if (ad < best_dist)
                {
                    best_dist = ad;
                    best = option::value((d, rl));
                }
            }
        }
        return best;
    }

    // ---- 解析与查询 ----

    // 显示空间 = 调试摄像机 framebuffer 的尺寸（UI 管线按相机渲染
    // 目标尺寸解析布局；walk camera 的渲染目标即视口显示的画面）
    protected func uiGetDisplayRange(self: WorldEditorViewport)=> option<vec2>
    {
        return or(option::none: option<vec2>) <| try!{
            try! fb = self.m_editor_walk_camera_frame_buffer;
            let (w, h) = fb->size;
            if (w <= 0 || h <= 0)
                return_value! option::none: option<vec2>;
            return_value! option::value((w as real, h as real) as vec2);
        };
    }

    // ---- UI 编辑视口缩放（显示级放大，不改变 framebuffer）----
    // 可见子矩形 = [m_ui_view_offset, offset + display_range/zoom]。缩放
    // 只作用于显示：布局解析（uiResolveDisplay/get_layout/引擎
    // ResolveUiNodes）始终按完整 display_range 进行，与游戏运行一致。

    // 视口缩放折叠后的有效映射矩形（“虚拟全图”）：把完整显示空间图像
    // 等效视作绘制在 (rmin_v, rsize_v) 上、其中的可见窗口恰好落在真实
    // (rmin, rsize) 上。uiDisplayToScreen/uiScreenToDisplay/uiHitTolerance
    // 不改签名与实现，继续以 (rmin_v, rsize_v, display_range) 调用即自动
    // 获得缩放语义（display_range 保持完整值，布局解析与换算共用）：
    // 容差/屏幕尺寸随 zoom 放大，uiScreenToDisplay 的输出仍是完整显示
    // 空间坐标（写回组件所需）。非 UI 编辑或 zoom==1（offset 恒为 0）
    // 时即原始 (rmin, rsize)，与未缩放行为逐位一致。
    protected func uiViewScreenRect(
        self: WorldEditorViewport,
        rmin: vec2, rsize: vec2, display_range: vec2)=> (vec2, vec2)
    {
        if (!self->uiEditingActive() || self.m_ui_view_zoom == 1.)
            return (rmin, rsize);

        let z = self.m_ui_view_zoom;
        let rsize_v = rsize * z;
        let k = rsize_v / display_range;
        let off = self.m_ui_view_offset;
        let rmin_v = (
            rmin[0] - k[0] * off[0],
            rmin[1] + rsize[1] + k[1] * off[1] - rsize_v[1]) as vec2;
        return (rmin_v, rsize_v);
    }

    // 可见子矩形 → 纹理 UV（引擎约定 V 向上，uv0/uv1 = 可见窗口在显示
    // 空间中的归一化 min/max 角）；未缩放（或非 UI 编辑）返回 none，
    // 调用方回退 ImageSize 全图绘制
    protected func uiVisibleUV(self: WorldEditorViewport)=> option<(vec2, vec2)>
    {
        if (!self->uiEditingActive() || self.m_ui_view_zoom == 1.)
            return option::none: option<(vec2, vec2)>;

        return or(option::none: option<(vec2, vec2)>) <| try!{
            try! dr = self->uiGetDisplayRange();
            let vis = dr / self.m_ui_view_zoom;
            let off = self.m_ui_view_offset;
            return_value! option::value <|
                ((off[0] / dr[0], off[1] / dr[1]) as vec2,
                 ((off[0] + vis[0]) / dr[0],
                  (off[1] + vis[1]) / dr[1]) as vec2);
        };
    }

    // 可见窗口 offset 夹取到合法范围（每轴 [0, dr-vis]，保证可见子矩形
    // 落在显示范围内、纹理 UV 不越出 [0,1]）。UI_VIEW_ZOOM_MIN 为 1，
    // vis <= dr 恒成立；vis > dr 的居中分支仅为防御性保留
    protected func uiClampViewOffset(
        off: vec2, vis: vec2, display_range: vec2)=> vec2
    {
        return (mathf::clamp(off[0],
                math::min(0., display_range[0] - vis[0]),
                math::max(0., display_range[0] - vis[0])),
            mathf::clamp(off[1],
                math::min(0., display_range[1] - vis[1]),
                math::max(0., display_range[1] - vis[1]))) as vec2;
    }

    // 缩放到 new_zoom：保持显示空间锚点 anchor 在可见窗口内的比例不变
    //（滚轮缩放传鼠标下的显示点即“以鼠标为锚”），随后夹取 offset
    protected func uiZoomAt(
        self: WorldEditorViewport, new_zoom: real, anchor: vec2)=> void
    {
        do try!{
            try! dr = self->uiGetDisplayRange();
            let z = mathf::clamp(new_zoom, UI_VIEW_ZOOM_MIN, UI_VIEW_ZOOM_MAX);
            let vis = dr / z;
            let frac = (anchor - self.m_ui_view_offset)
                / (dr / self.m_ui_view_zoom);
            self.m_ui_view_zoom = z;
            self.m_ui_view_offset =
                uiClampViewOffset(anchor - frac * vis, vis, dr);
            return_value!;
        };
    }

    // 工具栏步进缩放：锚点取当前可见窗口中心（工具栏不在视口内，
    // 无法以鼠标为锚）
    protected func uiZoomStep(self: WorldEditorViewport, factor: real)=> void
    {
        do try!{
            try! dr = self->uiGetDisplayRange();
            let vis = dr / self.m_ui_view_zoom;
            self->uiZoomAt(self.m_ui_view_zoom * factor,
                self.m_ui_view_offset + vis * 0.5);
            return_value!;
        };
    }

    // 鼠标屏幕坐标 → 完整显示空间 NDC（缩放感知）。y 已随显示空间向上，
    // 无需再翻转；zoom==1 时与旧换算 ((mouse-rect)/size-0.5)*2 逐位等价。
    // 供 3D 射线拾取的回退路径（点击选取/右键菜单/拖放生成点）保持与
    // 缩放后的可见图像一致
    protected func uiMouseToViewportNDC(
        self: WorldEditorViewport,
        mouse: vec2, rmin: vec2, rsize: vec2)=> option<vec2>
    {
        return or(option::none: option<vec2>) <| try!{
            try! dr = self->uiGetDisplayRange();
            let (rmin_v, rsize_v) = self->uiViewScreenRect(rmin, rsize, dr);
            let disp = uiScreenToDisplay(mouse, rmin_v, rsize_v, dr);
            return_value! option::value <|
                (disp[0] / dr[0] * 2. - 1.,
                 disp[1] / dr[1] * 2. - 1.) as vec2;
        };
    }

    // UI 编辑模式的视口导航（由 updateCameraControl 在 UI 编辑模式下
    // 调用，摄像机控制的滚轮/中键此时让位，见 control*Camera 的卫语句）：
    // 滚轮以鼠标为锚缩放显示、中键拖拽平移可见窗口、F 聚焦选中元素。
    // framebuffer 重建（尺寸变化）时 offset 按比例迁移后夹取，zoom 保留
    protected func updateUIViewNavigation(
        self: WorldEditorViewport,
        hovered: bool,
        viewport_rect: option<(ImVec2, ImVec2)>)=> void
    {
        if (!self->uiEditingActive())
            return;

        do try!{
            try! dr = self->uiGetDisplayRange();

            // 显示范围变化（窗口尺寸稳定后 framebuffer 重建）：
            // offset 按比例迁移（保持相对视野）后夹取到新范围
            if (self.m_ui_view_last_range[0] != dr[0]
                || self.m_ui_view_last_range[1] != dr[1])
            {
                let old = self.m_ui_view_last_range;
                self.m_ui_view_offset = (old[0] > 0. && old[1] > 0.)
                    ? uiClampViewOffset(
                        self.m_ui_view_offset * dr / old,
                        dr / self.m_ui_view_zoom, dr)
                    | uiClampViewOffset(
                        self.m_ui_view_offset,
                        dr / self.m_ui_view_zoom, dr);
                self.m_ui_view_last_range = dr;
            }

            match (viewport_rect)
            {
                none?;
                value((rect_min, rect_max))?
                {
                    let rmin = rect_min as vec2;
                    let rsize = (rect_max.0 - rect_min.0,
                        rect_max.1 - rect_min.1) as vec2;
                    if (rsize[0] <= 0. || rsize[1] <= 0.)
                        return_value!;
                    let vis = dr / self.m_ui_view_zoom;

                    // 中键拖拽平移可见窗口（内容跟手；屏幕 y 向下、
                    // 显示空间 y 向上，故 y 取反）
                    if (hovered && IsMouseClicked(
                            ImGuiMouseButton::ImGuiMouseButton_Middle))
                        self.m_ui_view_panning = true;
                    if (!IsMouseDown(
                            ImGuiMouseButton::ImGuiMouseButton_Middle))
                        self.m_ui_view_panning = false;
                    if (self.m_ui_view_panning)
                    {
                        let (mdx, mdy) = GetMouseDeltaPos();
                        self.m_ui_view_offset = uiClampViewOffset(
                            (self.m_ui_view_offset[0]
                                - mdx * vis[0] / rsize[0],
                             self.m_ui_view_offset[1]
                                + mdy * vis[1] / rsize[1]) as vec2,
                            vis, dr);
                    }

                    // 滚轮缩放：以鼠标下的显示点为锚
                    let wv = GetMouseWheel().1;
                    if (hovered && wv != 0.)
                    {
                        let (rmin_v, rsize_v) =
                            self->uiViewScreenRect(rmin, rsize, dr);
                        self->uiZoomAt(
                            self.m_ui_view_zoom
                                * (1. + wv * UI_VIEW_WHEEL_STEP),
                            uiScreenToDisplay(
                                GetMousePos() as vec2, rmin_v, rsize_v, dr));
                    }

                    // F 聚焦选中元素
                    if (hovered && IsKeyPressed(ImGuiKey::ImGuiKey_F, false))
                        self->uiFocusSelected();
                }
            }
            return_value!;
        };
    }

    // F 聚焦：选中元素的显示矩形（旋转后取轴对齐包围盒）缩放到约占
    // 视口 UI_VIEW_FIT_MARGIN 并居中；元素本身接近铺满显示范围时即 1x
    protected func uiFocusSelected(self: WorldEditorViewport)=> void
    {
        if (!self.m_ui_draw_visible)
            return;

        do try!{
            try! dr = self->uiGetDisplayRange();

            // 旋转矩形的轴对齐包围盒半宽：两相邻角向量各分量绝对值之和
            let half = self.m_ui_draw_size * 0.5;
            let total = self.m_ui_draw_total_angle;
            let c = uiRotateVec2(total, (half[0], half[1]) as vec2);
            let s = uiRotateVec2(total, (half[0], -half[1]) as vec2);
            let ext = (mathf::abs(c[0]) + mathf::abs(s[0]),
                mathf::abs(c[1]) + mathf::abs(s[1])) as vec2;

            let z = mathf::clamp(
                math::min(dr[0] / math::max(ext[0] * 2., 1.),
                    dr[1] / math::max(ext[1] * 2., 1.)) * UI_VIEW_FIT_MARGIN,
                UI_VIEW_ZOOM_MIN, UI_VIEW_ZOOM_MAX);
            let vis = dr / z;
            self.m_ui_view_zoom = z;
            self.m_ui_view_offset =
                uiClampViewOffset(self.m_ui_draw_center - vis * 0.5, vis, dr);
            return_value!;
        };
    }

    // 当前选中的 UI 元素实体（在 UI 元素选择器范围内按调试 EUID 反查）
    protected func uiFindSelectedUIElement(
        self: WorldEditorViewport)=> option<entity>
    {
        return or(option::none: option<entity>) <| try!{
            try! euid = self.m_selected_entity_id;
            for (let e : self.m_ui_element_entity_selector)
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(entity_uid)? if (entity_uid == euid)
                        return_value! option::value(e);
                }
            }
            return_value! option::none: option<entity>;
        };
    }

    // 按调试 EUID 在 UI 元素选择器范围内反查实体（拖拽期间重取实体用）
    protected func uiFindEntityByEuidInSelector(
        self: WorldEditorViewport,
        euid: entity::internal::euid_t)=> option<entity>
    {
        return or(option::none: option<entity>) <| try!{
            for (let e : self.m_ui_element_entity_selector)
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(entity_uid)? if (entity_uid == euid)
                        return_value! option::value(e);
                }
            }
            return_value! option::none: option<entity>;
        };
    }

    // 实体的 UI 父元素（LocalToParent.parent_uid 指向的锚点主人须同为
    // UI 元素才构成参考矩形；与 UI 管线的节点匹配语义一致）
    protected func uiFindUIParent(
        self: WorldEditorViewport, e: entity)=> option<entity>
    {
        return or(option::none: option<entity>) <| try!{
            try! l2p = e->towoo::get_component:<Transform::LocalToParent>();
            try! parent = self->findEntityByAnchorUid(l2p.parent_uid->get as string);
            if (parent->towoo::get_component:<UserInterface::Element>->is_none)
                return_value! option::none: option<entity>;
            return_value! option::value(parent);
        };
    }

    // 解析 UI 元素在显示像素空间的矩形（含祖先旋转链合成）。
    // 自底向上沿 Transform 锚点链收集同为 UI 元素的祖先，再自顶向下
    // 逐级用 Element::get_layout 解析（get_layout 返回祖先未旋转帧中的
    // 矩形），显示中心按 ResolveUiNodes 的旋转链公式合成：子中心先绕
    // 父 pivot 转父自身角，再经父的祖先累计角提升。链断/非 UI 父即视
    // 为根（与引擎“问题可见”的回退策略一致）。
    protected func uiResolveDisplay(
        self: WorldEditorViewport,
        e: entity,
        display_range: vec2)=> option<UIRectInfo>
    {
        return or(option::none: option<UIRectInfo>) <| try!{
            // 自底向上收集祖先链（实体 + 各自 Rotation 角，无组件则 0）
            let ui_chain = []mut: vec<mut (entity, real)>;
            {
                let mut cur = e;
                let mut guard_count = 0;
                let mut walking = true;
                while (walking && guard_count < 64)
                {
                    guard_count += 1;

                    let mut own_angle = 0.;
                    match (cur->towoo::get_component:<UserInterface::Rotation>)
                    {
                        none?;
                        value(rot)? own_angle = rot.angle->get;
                    }
                    ui_chain->add(mut (cur, own_angle));

                    match (cur->towoo::get_component:<Transform::LocalToParent>)
                    {
                        none? walking = false;
                        value(l2p)?
                            match (self->findEntityByAnchorUid(l2p.parent_uid->get as string))
                            {
                                none? walking = false;
                                value(parent)?
                                {
                                    // 父必须同为 UI 元素才参与 UI 布局，
                                    // 否则当前元素按根元素处理
                                    if (parent->towoo::get_component:<UserInterface::Element>->is_none)
                                        walking = false;
                                    else
                                        cur = parent;
                                }
                            }
                    }
                }
            }

            // 自顶向下逐级解析并合成（ui_chain 末尾是根）
            let mut have_prev = false;
            let mut prev_center = (0., 0.) as vec2;
            let mut prev_size = (0., 0.) as vec2;
            let mut prev_pivot_off = (0., 0.) as vec2;
            let mut prev_display = (0., 0.) as vec2;
            let mut prev_angle_acc = 0.;
            let mut prev_own = 0.;

            let mut out_center = (0., 0.) as vec2;
            let mut out_size = (0., 0.) as vec2;
            let mut out_pivot_off = (0., 0.) as vec2;
            let mut out_display = (0., 0.) as vec2;
            let mut out_angle_acc = 0.;
            let mut out_own = 0.;
            let mut out_anchor = (0., 0.) as vec2;
            let mut out_unit_px = (1., 1.) as vec2;
            let mut out_unrot_center = (0., 0.) as vec2;
            let mut out_ref_center = (0., 0.) as vec2;
            let mut out_ref_size = (0., 0.) as vec2;

            let mut i = ui_chain->len - 1;
            while (i >= 0)
            {
                let (ent, own_angle) = ui_chain[i];
                try! ent_elem = ent->towoo::get_component:<UserInterface::Element>();
                let (rc, rs, rp) = ent_elem->get_layout(
                    ent->towoo::get_component:<UserInterface::WorldLayout>,
                    display_range);

                let mut display_center = rc;
                if (have_prev)
                {
                    let p_pivot = prev_center - prev_pivot_off;
                    let rotated_by_parent =
                        p_pivot + uiRotateVec2(prev_own, rc - p_pivot);
                    display_center = prev_display
                        + uiRotateVec2(
                            prev_angle_acc, rotated_by_parent - prev_center);
                }

                if (i == 0)
                {
                    // 目标实体：累计角 = 父之上的祖先和 + 父自身角；
                    // 参考矩形（祖先未旋转帧）：父矩形或整个显示区
                    out_center = rc;
                    out_unrot_center = rc;
                    out_ref_center = have_prev ? prev_center | display_range * 0.5;
                    out_ref_size = have_prev ? prev_size | display_range;
                    out_size = rs;
                    out_pivot_off = rp;
                    out_display = display_center;
                    out_angle_acc = prev_angle_acc + prev_own;
                    out_own = own_angle;

                    // 单位一（比例通道的像素换算系数）：按自身 ratio_unit
                    // 折叠参考矩形——height_unit 两轴取参考高、width_unit
                    // 两轴取参考宽、per_axis 逐轴取参考宽/高；根元素参考
                    // 矩形为整个显示区（与布局阶段的 unit 折叠 +
                    // resolve_layout 的 ratio_scale 折算一致）
                    let ref_size = have_prev ? prev_size | display_range;
                    out_unit_px = ref_size;
                    if (ent_elem.unit_kind->get == UserInterface::ratio_unit::height_unit)
                        out_unit_px = (ref_size[1], ref_size[1]) as vec2;
                    else if (ent_elem.unit_kind->get == UserInterface::ratio_unit::width_unit)
                        out_unit_px = (ref_size[0], ref_size[0]) as vec2;

                    // 锚点基点：参考矩形中心 − 参考 pivot 偏移 + 锚点在
                    // 参考矩形内的偏移（未旋转帧），再经父的祖先链旋转
                    // 提升到显示空间；根元素的参考矩形即整个显示区
                    let anchor_bits = ent_elem.anchor->get as int;
                    let base_unrot = have_prev
                        ? (prev_center - prev_pivot_off
                            + uiAnchorShift(anchor_bits, prev_size))
                        | (display_range * 0.5
                            + uiAnchorShift(anchor_bits, display_range));
                    out_anchor = have_prev
                        ? (prev_display
                            + uiRotateVec2(prev_angle_acc, base_unrot - prev_center))
                        | base_unrot;
                }
                else
                {
                    // 为下一级准备父量：angle_acc(本实体) = 父之上累计 + 父自身
                    let next_angle_acc = prev_angle_acc + prev_own;
                    prev_center = rc;
                    prev_size = rs;
                    prev_pivot_off = rp;
                    prev_display = display_center;
                    prev_own = own_angle;
                    prev_angle_acc = next_angle_acc;
                    have_prev = true;
                }
                i -= 1;
            }

            // 绘制四边形中心 D = display_center − R(acc)·p + R(total)·p，
            // pivot 显示位置 K = display_center − R(acc)·p（旋转不动点）
            let total = out_angle_acc + out_own;
            let out_draw_center = out_display
                - uiRotateVec2(out_angle_acc, out_pivot_off)
                + uiRotateVec2(total, out_pivot_off);
            let out_pivot_display =
                out_display - uiRotateVec2(out_angle_acc, out_pivot_off);

            return_value! option::value(UIRectInfo{
                m_center = out_draw_center,
                m_size = out_size,
                m_pivot_display = out_pivot_display,
                m_pivot_offset = out_pivot_off,
                m_angle_acc = out_angle_acc,
                m_own_angle = out_own,
                m_anchor_display = out_anchor,
                m_depth = ui_chain->len - 1,
                m_unit_px = out_unit_px,
                m_unrot_center = out_unrot_center,
                m_ref_center = out_ref_center,
                m_ref_size = out_ref_size,
            });
        };
    }

    // ---- 拾取（点击选取，UI 空间优先于 3D 射线） ----

    // 鼠标位置命中的全部 UI 元素（旋转矩形包含测试，退化尺寸按点命中
    // 容差），按层级深度降序（子画在父之上，更深的为优先候选）
    protected func pickUIElementsAt(
        self: WorldEditorViewport,
        rmin: vec2,
        rsize: vec2,
        display_range: vec2)=> vec<mut (int, entity::internal::euid_t)>
    {
        let mut hits = []mut: vec<mut (int, entity::internal::euid_t)>;
        let mouse_disp =
            uiScreenToDisplay(GetMousePos() as vec2, rmin, rsize, display_range);
        let tol = uiHitTolerance(rsize, display_range);

        for (let e : self.m_ui_element_entity_selector)
        {
            match (self->uiResolveDisplay(e, display_range))
            {
                none?;
                value(info)?
                {
                    let total = info.m_angle_acc + info.m_own_angle;
                    let local =
                        uiRotateVec2(-total, mouse_disp - info.m_center);
                    if (mathf::abs(local[0]) <= info.m_size[0] * 0.5 + tol[0]
                        && mathf::abs(local[1]) <= info.m_size[1] * 0.5 + tol[1])
                    {
                        match (e->internal::get_entity_uid)
                        {
                            none?;
                            value(entity_uid)? hits->add(mut (info.m_depth, entity_uid));
                        }
                    }
                }
            }
        }

        sort_in_place(hits, \(da, _), (db, _) = da > db;);
        return hits;
    }

    // 鼠标位置点击选取 UI 元素：命中列表按深度降序循环选中下一个
    //（与射线拾取的循环规则一致）；未命中返回 none（由调用方决定是否
    // 回落到 3D 射线拾取，且不应清空当前选中）
    protected func selectUIElementAt(
        self: WorldEditorViewport,
        rmin: vec2,
        rsize: vec2)=> option<entity::internal::euid_t>
    {
        return or(option::none: option<entity::internal::euid_t>) <| try!{
            try! display_range = self->uiGetDisplayRange();
            // 视口缩放折叠（zoom==1 时即原值；rmin/rsize 为真实视口矩形）
            let (vrmin, vrsize) =
                self->uiViewScreenRect(rmin, rsize, display_range);
            let hits = self->pickUIElementsAt(vrmin, vrsize, display_range);
            if (hits->empty)
                return_value! option::none: option<entity::internal::euid_t>;

            let mut next_index = 0;
            match (self.m_selected_entity_id)
            {
                none?;
                value(current_uid)?
                {
                    for (let mut i = 0; i < hits->len; i += 1)
                    {
                        if (hits[i].1 == current_uid)
                        {
                            next_index = (i + 1) % hits->len;
                            break;
                        }
                    }
                }
            }
            return_value! option::value(hits[next_index].1);
        };
    }

    // ---- 交互（悬停检测、拖拽开始/进行/结束） ----

    // 检测当前鼠标悬停的 UI 手柄（屏幕空间距离判定），返回手柄编号。
    // 优先级：旋转手柄 > 缩放手柄（四角+四边中点，挂在 handle_box 给出
    // 的编辑层框上）> 矩形内部（移动）。命中细化（防误抓）：手柄命中
    // 半径收紧为 UI_HANDLE_HIT_PX（与绘制的方块匹配）；点击位于元素
    // 边界带（UI_HIT_PX 容差）之内深处时不判缩放手柄，直接归移动
    //（大元素想拖动内部不会误抓角落缩放）；元素某轴屏幕尺寸过小时
    // 跳过该轴四边中点手柄（小元素中心区域距边手柄过近，只留四角）
    protected func pickUIHandle(
        e: entity,
        info: UIRectInfo,
        handle_box: vec2,
        mouse: vec2,
        rmin: vec2,
        rsize: vec2,
        display_range: vec2)=> int
    {
        let total = info.m_angle_acc + info.m_own_angle;
        let handle_half = handle_box * 0.5;

        // 鼠标在元素本地坐标系（相对中心，随元素旋转）与显示容差，
        // 缩放/移动判定共用
        let local = uiRotateVec2(
            -total,
            uiScreenToDisplay(mouse, rmin, rsize, display_range) - info.m_center);
        let half = info.m_size * 0.5;
        let tol = uiHitTolerance(rsize, display_range);

        // 旋转手柄：沿元素自身 up 轴、距上缘 UI_ROTATE_STALK_PX 的圆点；
        // 无 Rotation 组件的实体不提供旋转手柄（避免拖拽隐式添加组件）
        if (e->towoo::get_component:<UserInterface::Rotation>->is_value)
        {
            let up = uiRotateVec2(total, (0., 1.) as vec2);
            let rot_pos = info.m_pivot_display
                + up * (info.m_size[1] * 0.5 + UI_ROTATE_STALK_PX);
            if ((mouse
                    - uiDisplayToScreen(rot_pos, rmin, rsize, display_range))->length
                < UI_HANDLE_HIT_PX)
                return UI_HANDLE_ROTATE;
        }

        // 缩放手柄；auto_size 文本每帧按纹理重算尺寸，不提供缩放
        let mut auto_sized = false;
        match (e->towoo::get_component:<UserInterface::Text>)
        {
            none?;
            value(text)? auto_sized = text.auto_size->get;
        }
        if (!auto_sized)
        {
            // 边界带判定：位于按容差收缩后的矩形之内（离四边均超过
            // UI_HIT_PX）的点击不判缩放手柄；小元素收缩矩形为空，
            // 自然退化为全域可抓手柄
            let near_border = !(mathf::abs(local[0]) <= half[0] - tol[0]
                && mathf::abs(local[1]) <= half[1] - tol[1]);
            // 元素的屏幕尺寸（换算到屏幕像素，判定与视口缩放无关）
            let elem_scr = (info.m_size[0] * rsize[0] / display_range[0],
                info.m_size[1] * rsize[1] / display_range[1]) as vec2;
            if (near_border)
            {
                let mut h = UI_HANDLE_RESIZE_LB;
                while (h <= UI_HANDLE_RESIZE_T)
                {
                    let (sx, sy) = uiHandleSigns(h);
                    // 某轴过小的元素跳过该轴的四边中点手柄（L/R 看
                    // 宽、T/B 看高），中心区域让给移动
                    let edge_h_disabled =
                        ((h == UI_HANDLE_RESIZE_L || h == UI_HANDLE_RESIZE_R)
                            && elem_scr[0] < UI_EDGE_HANDLE_MIN_ELEM_PX)
                        || ((h == UI_HANDLE_RESIZE_B || h == UI_HANDLE_RESIZE_T)
                            && elem_scr[1] < UI_EDGE_HANDLE_MIN_ELEM_PX);
                    if (!edge_h_disabled)
                    {
                        let cpos = info.m_center
                            + uiRotateVec2(
                                total,
                                ((sx as real) * handle_half[0], (sy as real) * handle_half[1]) as vec2);
                        if ((mouse
                                - uiDisplayToScreen(cpos, rmin, rsize, display_range))->length
                            < UI_HANDLE_HIT_PX)
                            return h;
                    }
                    h += 1;
                }
            }
        }

        // 矩形内部（含退化尺寸的点击容差）→ 移动
        //（按有效矩形判定，与编辑层无关）
        if (mathf::abs(local[0]) <= half[0] + tol[0]
            && mathf::abs(local[1]) <= half[1] + tol[1])
            return UI_HANDLE_MOVE;

        return UI_HANDLE_NONE;
    }

    // 每帧更新 UI gizmo 状态：解析选中元素写绘制快照、悬停检测、
    // 拖拽开始/进行/结束。选中实体不带 Element 时不做任何事
    protected func updateUIGizmo(
        self: WorldEditorViewport,
        hovered: bool,
        rect_min: ImVec2,
        rect_size: ImVec2)=> void
    {
        self.m_ui_draw_visible = false;
        self.m_ui_snap_guide_x = option::none: option<real>;
        self.m_ui_snap_guide_y = option::none: option<real>;

        // 激活中的拖拽按 Esc 取消：恢复拖拽前捕获的成员值，不发布撤销
        //（置于左键松开判定之前，优先于提交）
        if (self.m_ui_dragging
            && self.m_ui_drag_active
            && IsKeyPressed(ImGuiKey::ImGuiKey_Escape, false))
        {
            self->cancelUIDrag();
        }

        // 松开左键：结束拖拽并提交撤销记录
        if (self.m_ui_dragging
            && !IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Left))
        {
            self->finishUIDrag(rect_min as vec2, rect_size as vec2);
            self.m_ui_dragging = false;
            self.m_ui_drag_handle = UI_HANDLE_NONE;
        }

        self.m_ui_hover_handle = UI_HANDLE_NONE;

        if (rect_size.0 <= 0. || rect_size.1 <= 0.)
            return;

        // 显示空间 = 调试摄像机 framebuffer 的尺寸
        let display_opt = self->uiGetDisplayRange();
        if (display_opt->is_none)
            return;
        let dr = display_opt->unwrap;

        // 视口缩放折叠：屏幕↔显示换算改用“虚拟全图”矩形（zoom==1 时
        // 即原值），下游 pickUIHandle/beginUIDrag/applyUIDrag 透传即自动
        // 感知缩放（display_range 保持完整值，布局解析不受影响）。注意
        // finishUIDrag 在此之前已按真实矩形调用（其内部的选取入口
        // selectUIElementAt 自行折叠）
        let (rmin, rsize) = self->uiViewScreenRect(
            rect_min as vec2, rect_size as vec2, dr);
        {
                let selected = self->uiFindSelectedUIElement();
                if (selected->is_none)
                    return;

                do try!{
                    try! e = selected;
                    let info = self->uiResolveDisplay(e, dr);
                    try! ui_info = info;

                    // 参考矩形：父元素（同为 UI 元素）或整个显示区
                    let mut ref_center = dr * 0.5;
                    let mut ref_size = dr;
                    let mut ref_total = 0.;
                    match (self->uiFindUIParent(e))
                    {
                        none?;
                        value(parent)?
                            match (self->uiResolveDisplay(parent, dr))
                            {
                                none?;
                                value(pinfo)?
                                {
                                    ref_center = pinfo.m_center;
                                    ref_size = pinfo.m_size;
                                    ref_total = pinfo.m_angle_acc + pinfo.m_own_angle;
                                }
                            }
                    }

                    // auto_size 文本每帧按纹理重算尺寸，禁用缩放手柄；
                    // 无 Rotation 组件不显示旋转手柄
                    let mut auto_sized = false;
                    match (e->towoo::get_component:<UserInterface::Text>)
                    {
                        none?;
                        value(text)? auto_sized = text.auto_size->get;
                    }

                    // 两层框：比例层框（默认编辑层）即有效矩形本身
                    //（外层，与 UI 对象实际渲染大小一致）；绝对层框 =
                    // size 的像素贡献（同心内侧）。有效尺寸 = 两层之和
                    try! elem = e->towoo::get_component:<UserInterface::Element>();
                    let size_box = elem.size->get;
                    let ratio_box = ui_info.m_size;

                    // 写入本帧绘制快照（锁定编辑时不绘制手柄，仅保留
                    // 矩形与参考标记）
                    self.m_ui_draw_visible = true;
                    self.m_ui_draw_can_resize = !auto_sized && !self.m_ui_edit_locked;
                    self.m_ui_draw_can_rotate =
                        e->towoo::get_component:<UserInterface::Rotation>->is_value
                        && !self.m_ui_edit_locked;
                    self.m_ui_draw_display_range = dr;
                    self.m_ui_draw_center = ui_info.m_center;
                    self.m_ui_draw_size = ui_info.m_size;
                    self.m_ui_draw_total_angle =
                        ui_info.m_angle_acc + ui_info.m_own_angle;
                    self.m_ui_draw_pivot_display = ui_info.m_pivot_display;
                    self.m_ui_draw_anchor_display = ui_info.m_anchor_display;
                    self.m_ui_draw_unit_px = ui_info.m_unit_px;
                    self.m_ui_draw_size_box = size_box;
                    self.m_ui_draw_ratio_box = ratio_box;
                    self.m_ui_draw_has_ref = true;
                    self.m_ui_draw_ref_center = ref_center;
                    self.m_ui_draw_ref_size = ref_size;
                    self.m_ui_draw_ref_total_angle = ref_total;

                    // 拖拽进行中：每帧按当前鼠标应用（不要求仍悬停视口内）
                    if (self.m_ui_dragging)
                    {
                        self->applyUIDrag(rmin, rsize, dr);
                        self.m_ui_hover_handle = self.m_ui_drag_handle;
                        return_value!;
                    }

                    let hoverable = hovered
                        && !self.m_is_look_active
                        && !self.m_is_pan_active
                        && !self.m_is_orbit_active
                        // 视图平移（UI 编辑缩放的中键拖拽）期间不悬停手柄
                        && !self.m_ui_view_panning
                        // 碰撞体/光源/粒子编辑手柄优先
                        && self.m_collider_hover_handle == GIZMO_HANDLE_NONE
                        && !self.m_collider_dragging
                        && self.m_light_hover_handle == GIZMO_HANDLE_NONE
                        && !self.m_light_dragging
                        && self.m_particle_hover_handle == GIZMO_HANDLE_NONE
                        && !self.m_particle_dragging
                        // 锁定编辑：不响应任何手柄（悬停保持 NONE，点击
                        // 回落为 CameraControl 的常规 UI 空间选取）
                        && !self.m_ui_edit_locked;

                    if (!hoverable)
                        return_value!;

                    // 编辑层：默认编辑比例通道（size_ratio/offset_ratio），
                    // 手柄挂有效矩形（外层）；按住 Shift 切到绝对通道，
                    // 手柄挂 size 层框（内侧）；Ctrl 为吸附键
                    let handle_box = IsKeyDown(ImGuiKey::ImGuiKey_LeftShift)
                        ? size_box
                        | ratio_box;

                    let mouse = GetMousePos() as vec2;
                    let handle = pickUIHandle(
                        e, ui_info, handle_box, mouse, rmin, rsize, dr);
                    self.m_ui_hover_handle = handle;

                    // 悬停手柄上按下左键：开始拖拽
                    if (handle != UI_HANDLE_NONE
                        && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Left))
                        self->beginUIDrag(e, ui_info, handle, mouse, rmin, rsize, dr);

                    return_value!;
                };
        }
    }

    // 开始一次拖拽：按手柄语义捕获快照与撤销记录所需的旧值
    protected func beginUIDrag(
        self: WorldEditorViewport,
        selected_entity: entity,
        info: UIRectInfo,
        handle: int,
        mouse: vec2,
        rmin: vec2,
        rsize: vec2,
        display_range: vec2)=> void
    {
        self.m_ui_drag_handle = handle;
        self.m_ui_drag_euid =
            selected_entity->internal::get_entity_uid->or(0h as entity::internal::euid_t);
        self.m_ui_drag_start_mouse = uiScreenToDisplay(mouse, rmin, rsize, display_range);
        // 按下时的屏幕坐标与激活标记：位移超过 UI_DRAG_ACTIVATE_PX
        //（屏幕像素）前不写值（ARMED），避免点击抖动误改组件
        self.m_ui_drag_press_screen = mouse;
        self.m_ui_drag_active = false;
        self.m_ui_drag_angle_acc = info.m_angle_acc;
        self.m_ui_drag_undo_component = "";
        self.m_ui_drag_undo_member = "";
        self.m_ui_drag_undo_old_value = "";
        self.m_ui_dragging = false;

        do try!{
            try! elem =
                selected_entity->towoo::get_component:<UserInterface::Element>();

            // 编辑层：默认编辑比例通道（size_ratio/offset_ratio），按住
            // Shift 切到绝对通道；移动/缩放在拖拽开始时定层并冻结
            //（单位一随之冻结；绝对层的换算系数恒为 1）
            let edit_ratio = handle != UI_HANDLE_ROTATE
                && !IsKeyDown(ImGuiKey::ImGuiKey_LeftShift);
            self.m_ui_drag_edit_ratio = edit_ratio;
            self.m_ui_drag_unit_px = edit_ratio ? info.m_unit_px | (1., 1.) as vec2;

            if (handle == UI_HANDLE_MOVE)
            {
                if (edit_ratio)
                {
                    self.m_ui_drag_start_offset = elem.offset_ratio->get;
                    self.m_ui_drag_undo_member = "offset_ratio";
                }
                else
                {
                    self.m_ui_drag_start_offset = elem.offset->get;
                    self.m_ui_drag_undo_member = "offset";
                }
                self.m_ui_drag_start_member_px = self.m_ui_drag_unit_px
                    * self.m_ui_drag_start_offset;
                // Ctrl 对齐吸附的基准：拖拽起始时祖先未旋转帧中的元素中心
                self.m_ui_drag_start_unrot_center = info.m_unrot_center;
                self.m_ui_drag_undo_component = "UserInterface::Element";
            }
            else if (handle >= UI_HANDLE_RESIZE_LB && handle <= UI_HANDLE_RESIZE_T)
            {
                let other_box = edit_ratio
                    ? elem.size->get
                    | info.m_unit_px * elem.size_ratio->get;
                if (edit_ratio)
                {
                    self.m_ui_drag_start_size = elem.size_ratio->get;
                    self.m_ui_drag_undo_member = "size_ratio";
                }
                else
                {
                    self.m_ui_drag_start_size = elem.size->get;
                    self.m_ui_drag_undo_member = "size";
                }
                self.m_ui_drag_start_member_px = self.m_ui_drag_unit_px
                    * self.m_ui_drag_start_size;
                self.m_ui_drag_other_box_px = other_box;
                self.m_ui_drag_undo_component = "UserInterface::Element";
            }
            else
            {
                // 旋转：旋转手柄仅在实体已带 Rotation 组件时提供
                //（见 pickUIHandle），此处直接取用
                try! rot =
                    selected_entity->towoo::get_component:<UserInterface::Rotation>();
                self.m_ui_drag_start_angle_deg = rot.angle->get;
                self.m_ui_drag_undo_component = "UserInterface::Rotation";
                self.m_ui_drag_undo_member = "angle";
            }

            // 撤销旧值序列统一在拖拽开始时采集
            self.m_ui_drag_undo_old_value = serializeMemberValue(
                selected_entity,
                self.m_ui_drag_undo_component,
                self.m_ui_drag_undo_member)->or("");

            if (handle == UI_HANDLE_ROTATE)
            {
                // 起始鼠标绕 pivot 的方位角（显示空间，弧度）
                self.m_ui_drag_start_mouse_angle = mathf::atan2(
                    self.m_ui_drag_start_mouse[1] - info.m_pivot_display[1],
                    self.m_ui_drag_start_mouse[0] - info.m_pivot_display[0]);
            }

            self.m_ui_dragging = true;
            return_value!;
        };
    }

    // 拖拽进行中：按当前鼠标换算并写回组件值（每帧重取实体与解析，
    // 框架/角度取当前帧的，元素随拖拽实时反馈）。带激活死区：位移
    // 超过 UI_DRAG_ACTIVATE_PX（屏幕像素）前不写值
    protected func applyUIDrag(
        self: WorldEditorViewport,
        rmin: vec2,
        rsize: vec2,
        display_range: vec2)=> void
    {
        do try!{
            // 激活死区（屏幕像素判定，不受视口缩放影响）：阈值内的轻微
            // 抖动不修改组件（松开视为点击，见 finishUIDrag），亦不
            // 产生吸附引导线
            if (!self.m_ui_drag_active
                && (GetMousePos() as vec2 - self.m_ui_drag_press_screen)->length
                    > UI_DRAG_ACTIVATE_PX)
                self.m_ui_drag_active = true;
            if (!self.m_ui_drag_active)
                return_value!;

            try! selected_entity =
                self->uiFindEntityByEuidInSelector(self.m_ui_drag_euid);

            let mouse_disp = uiScreenToDisplay(
                GetMousePos() as vec2, rmin, rsize, display_range);
            let delta_disp = mouse_disp - self.m_ui_drag_start_mouse;

            let ctrl_down = IsKeyDown(ImGuiKey::ImGuiMod_Ctrl);
            let handle = self.m_ui_drag_handle;
            // 拖拽期间编辑层与单位一冻结（拖拽开始时按 Shift 定层）
            let edit_ratio = self.m_ui_drag_edit_ratio;
            let unit = self.m_ui_drag_unit_px;

            if (handle == UI_HANDLE_MOVE)
            {
                try! elem =
                    selected_entity->towoo::get_component:<UserInterface::Element>();
                try! info = self->uiResolveDisplay(selected_entity, display_range);
                // 显示位移 → 未旋转帧偏移增量：d(display)/d(offset)
                // = R(angle_acc)，故逆旋转祖先累计角（不含自身角）
                let mut delta_local = uiRotateVec2(-self.m_ui_drag_angle_acc, delta_disp);

                // Ctrl 对齐吸附（优先于格点）：元素的三条关键线（左/中/
                // 右、下/中/上）对齐参考矩形的三条关键线（祖先未旋转帧）
                let mut snapped_x = false;
                let mut snapped_y = false;
                if (ctrl_down)
                {
                    let target_c = self.m_ui_drag_start_unrot_center + delta_local;
                    let hw = info.m_size[0] * 0.5;
                    let hh = info.m_size[1] * 0.5;
                    let rhw = info.m_ref_size[0] * 0.5;
                    let rhh = info.m_ref_size[1] * 0.5;

                    match (uiSnapAlignAxis(
                            target_c[0] - hw, target_c[0], target_c[0] + hw,
                            info.m_ref_center[0] - rhw, info.m_ref_center[0],
                            info.m_ref_center[0] + rhw))
                    {
                        none?;
                        value((d, line))?
                        {
                            delta_local = (delta_local[0] + d, delta_local[1]) as vec2;
                            self.m_ui_snap_guide_x = option::value(line);
                            snapped_x = true;
                        }
                    }
                    match (uiSnapAlignAxis(
                            target_c[1] - hh, target_c[1], target_c[1] + hh,
                            info.m_ref_center[1] - rhh, info.m_ref_center[1],
                            info.m_ref_center[1] + rhh))
                    {
                        none?;
                        value((d, line))?
                        {
                            delta_local = (delta_local[0], delta_local[1] + d) as vec2;
                            self.m_ui_snap_guide_y = option::value(line);
                            snapped_y = true;
                        }
                    }
                }

                // 再在“层像素”空间合成目标；对齐未命中的轴按 Ctrl 格点
                // 吸附，最后除以单位一换算回成员增量（绝对层单位一恒为 1）
                let mut tx = self.m_ui_drag_start_member_px[0] + delta_local[0];
                let mut ty = self.m_ui_drag_start_member_px[1] + delta_local[1];
                if (ctrl_down)
                {
                    if (!snapped_x)
                        tx = uiRoundTo(tx, UI_SNAP_PX);
                    if (!snapped_y)
                        ty = uiRoundTo(ty, UI_SNAP_PX);
                }
                let dx = (unit[0] > 0.0001)
                    ? (tx - self.m_ui_drag_start_member_px[0]) / unit[0]
                    | 0.;
                let dy = (unit[1] > 0.0001)
                    ? (ty - self.m_ui_drag_start_member_px[1]) / unit[1]
                    | 0.;

                if (edit_ratio)
                    elem.offset_ratio->set(self.m_ui_drag_start_offset + (dx, dy) as vec2);
                else
                    elem.offset->set(self.m_ui_drag_start_offset + (dx, dy) as vec2);
            }
            else if (handle >= UI_HANDLE_RESIZE_LB && handle <= UI_HANDLE_RESIZE_T)
            {
                try! elem =
                    selected_entity->towoo::get_component:<UserInterface::Element>();
                try! info = self->uiResolveDisplay(selected_entity, display_range);
                let total = info.m_angle_acc + info.m_own_angle;

                // 鼠标 → 元素本地坐标（相对 pivot，随元素旋转）
                let mut c = uiRotateVec2(-total, mouse_disp - info.m_pivot_display);

                let pivot_bits = elem.pivot->get as int;
                let (shx, shy) = uiHandleSigns(handle);
                let spx = uiPivotSide(pivot_bits, 0);
                let spy = uiPivotSide(pivot_bits, 1);

                // Ctrl 对齐吸附（优先于格点）：被拖边缘恒在鼠标处（未旋转
                // 帧），把该轴的鼠标坐标吸附到参考矩形的关键线上即可让
                // 边缘对齐；仅在元素自身无旋转时做（旋转下边缘方位随角
                // 变化，线对齐无确定方向）
                let mut snapped_x = false;
                let mut snapped_y = false;
                if (ctrl_down && mathf::abs(info.m_own_angle) < 0.01)
                {
                    let pivot_unrot = info.m_unrot_center - info.m_pivot_offset;
                    let mouse_unrot = pivot_unrot + c;
                    let rhw = info.m_ref_size[0] * 0.5;
                    let rhh = info.m_ref_size[1] * 0.5;

                    if (shx != 0)
                    {
                        match (uiSnapAlignAxis(
                                mouse_unrot[0], mouse_unrot[0], mouse_unrot[0],
                                info.m_ref_center[0] - rhw, info.m_ref_center[0],
                                info.m_ref_center[0] + rhw))
                        {
                            none?;
                            value((d, line))?
                            {
                                c = (c[0] + d, c[1]) as vec2;
                                self.m_ui_snap_guide_x = option::value(line);
                                snapped_x = true;
                            }
                        }
                    }
                    if (shy != 0)
                    {
                        match (uiSnapAlignAxis(
                                mouse_unrot[1], mouse_unrot[1], mouse_unrot[1],
                                info.m_ref_center[1] - rhh, info.m_ref_center[1],
                                info.m_ref_center[1] + rhh))
                        {
                            none?;
                            value((d, line))?
                            {
                                c = (c[0], c[1] + d) as vec2;
                                self.m_ui_snap_guide_y = option::value(line);
                                snapped_y = true;
                            }
                        }
                    }
                }

                // 逐轴解编辑层框的新尺寸（pivot 固定语义对有效矩形生效）：
                // pivot 居中 → 对称伸缩（边界在中心 ±s/2）；pivot 靠边 →
                // 从 pivot 单向伸缩；把手与 pivot 同侧的轴锁定。
                // 比例层（默认）手柄挂在有效矩形（外层）上，直接解有效
                // 尺寸目标，下限为 size 的像素贡献（保证 ratio ≥ 0）；
                // 绝对层（Shift）手柄挂在 size 层框（同心内侧）上，其边
                // 界在 pivot 之外还差比例贡献的半宽（−other/2）。层像素
                // 目标经 Ctrl 吸附后除以单位一写回成员
                let mut sx_new = self.m_ui_drag_start_member_px[0];
                if (shx != 0 && !(spx != 0 && spx == shx))
                {
                    if (edit_ratio)
                    {
                        // 有效框目标；起始有效尺寸 = size 贡献 + 比例贡献
                        sx_new = (spx == 0)
                            ? (shx as real) * c[0] * 2.
                            | (shx as real) * c[0];
                        if (sx_new < self.m_ui_drag_other_box_px[0])
                            sx_new = self.m_ui_drag_other_box_px[0];
                        if (ctrl_down && !snapped_x)
                        {
                            sx_new = uiRoundTo(sx_new, UI_SNAP_PX);
                            // round 可能回跳到低于下限的格点，取下限上方
                            // 最近的格点（保证 size_ratio ≥ 0）
                            if (sx_new < self.m_ui_drag_other_box_px[0])
                                sx_new = uiRoundTo(
                                    self.m_ui_drag_other_box_px[0] + UI_SNAP_PX * 0.5,
                                    UI_SNAP_PX);
                        }
                        let target = self.m_ui_drag_other_box_px[0]
                            + self.m_ui_drag_start_member_px[0];
                        sx_new = sx_new - target + self.m_ui_drag_start_member_px[0];
                    }
                    else
                    {
                        sx_new = (spx == 0)
                            ? (shx as real) * c[0] * 2.
                            | (shx as real) * c[0] - self.m_ui_drag_other_box_px[0] * 0.5;
                        if (sx_new < UI_GIZMO_MIN_SIZE)
                            sx_new = UI_GIZMO_MIN_SIZE;
                        if (ctrl_down && !snapped_x)
                            sx_new = uiRoundTo(sx_new, UI_SNAP_PX);
                    }
                }
                let mut sy_new = self.m_ui_drag_start_member_px[1];
                if (shy != 0 && !(spy != 0 && spy == shy))
                {
                    if (edit_ratio)
                    {
                        sy_new = (spy == 0)
                            ? (shy as real) * c[1] * 2.
                            | (shy as real) * c[1];
                        if (sy_new < self.m_ui_drag_other_box_px[1])
                            sy_new = self.m_ui_drag_other_box_px[1];
                        if (ctrl_down && !snapped_y)
                        {
                            sy_new = uiRoundTo(sy_new, UI_SNAP_PX);
                            if (sy_new < self.m_ui_drag_other_box_px[1])
                                sy_new = uiRoundTo(
                                    self.m_ui_drag_other_box_px[1] + UI_SNAP_PX * 0.5,
                                    UI_SNAP_PX);
                        }
                        let target = self.m_ui_drag_other_box_px[1]
                            + self.m_ui_drag_start_member_px[1];
                        sy_new = sy_new - target + self.m_ui_drag_start_member_px[1];
                    }
                    else
                    {
                        sy_new = (spy == 0)
                            ? (shy as real) * c[1] * 2.
                            | (shy as real) * c[1] - self.m_ui_drag_other_box_px[1] * 0.5;
                        if (sy_new < UI_GIZMO_MIN_SIZE)
                            sy_new = UI_GIZMO_MIN_SIZE;
                        if (ctrl_down && !snapped_y)
                            sy_new = uiRoundTo(sy_new, UI_SNAP_PX);
                    }
                }

                let dx = (unit[0] > 0.0001)
                    ? (sx_new - self.m_ui_drag_start_member_px[0]) / unit[0]
                    | 0.;
                let dy = (unit[1] > 0.0001)
                    ? (sy_new - self.m_ui_drag_start_member_px[1]) / unit[1]
                    | 0.;

                if (edit_ratio)
                    elem.size_ratio->set(self.m_ui_drag_start_size + (dx, dy) as vec2);
                else
                    elem.size->set(self.m_ui_drag_start_size + (dx, dy) as vec2);
            }
            else
            {
                try! rot =
                    selected_entity->towoo::get_component:<UserInterface::Rotation>();
                try! info = self->uiResolveDisplay(selected_entity, display_range);
                // 绕 pivot 显示位置的角度增量（拖拽期间 pivot 不动）
                let angle_now = mathf::atan2(
                    mouse_disp[1] - info.m_pivot_display[1],
                    mouse_disp[0] - info.m_pivot_display[0]);
                let mut delta = angle_now - self.m_ui_drag_start_mouse_angle;
                while (delta > mathf::PI)
                {
                    delta -= 2. * mathf::PI;
                }
                while (delta < -mathf::PI)
                {
                    delta += 2. * mathf::PI;
                }

                let mut new_deg =
                    self.m_ui_drag_start_angle_deg + delta * mathf::RAD2DEG;
                if (ctrl_down)
                    new_deg = uiRoundTo(new_deg, UI_ROTATE_SNAP_DEG);
                rot.angle->set(new_deg);
            }
            return_value!;
        };
    }

    // 结束拖拽：未激活（位移在死区内）的按下视为“点击”——移动手柄转
    // UI 空间循环选取（便于选中父元素矩形内部的子元素），缩放/旋转手柄
    // 无操作；此路径未写值，不发布撤销记录。已激活的拖拽在值有变化时
    // 发布一条可撤销的 Action
    protected func finishUIDrag(
        self: WorldEditorViewport,
        rmin: vec2,
        rsize: vec2)=> void
    {
        if (!self.m_ui_drag_active)
        {
            if (self.m_ui_drag_handle == UI_HANDLE_MOVE)
            {
                match (self->selectUIElementAt(rmin, rsize))
                {
                    none?;
                    value(picked_uid)? self.m_selected_entity_id = option::value(picked_uid);
                }
            }
            return;
        }

        if (self.m_ui_drag_undo_old_value == "")
            return;

        do try!{
            try! selected_entity =
                self->uiFindEntityByEuidInSelector(self.m_ui_drag_euid);
            let new_value = serializeMemberValue(
                selected_entity,
                self.m_ui_drag_undo_component,
                self.m_ui_drag_undo_member)->or("");

            if (new_value != "" && new_value != self.m_ui_drag_undo_old_value)
                self->doAction(ModifyComponentMember::create(
                        self.m_ui_drag_euid,
                        self.m_ui_drag_undo_component,
                        self.m_ui_drag_undo_member,
                        self.m_ui_drag_undo_old_value,
                        new_value));
            return_value!;
        };
    }

    // 取消激活中的拖拽（Esc）：把 beginUIDrag 捕获的成员旧值写回组件，
    // 清除拖拽状态；不走 finishUIDrag 的撤销发布路径。值恢复失败（实体
    // 已不可寻回等）时拖拽状态仍一并清空
    protected func cancelUIDrag(self: WorldEditorViewport)=> void
    {
        do try!{
            try! selected_entity =
                self->uiFindEntityByEuidInSelector(self.m_ui_drag_euid);
            let handle = self.m_ui_drag_handle;

            if (handle == UI_HANDLE_MOVE)
            {
                try! elem =
                    selected_entity->towoo::get_component:<UserInterface::Element>();
                if (self.m_ui_drag_edit_ratio)
                    elem.offset_ratio->set(self.m_ui_drag_start_offset);
                else
                    elem.offset->set(self.m_ui_drag_start_offset);
            }
            else if (handle >= UI_HANDLE_RESIZE_LB && handle <= UI_HANDLE_RESIZE_T)
            {
                try! elem =
                    selected_entity->towoo::get_component:<UserInterface::Element>();
                if (self.m_ui_drag_edit_ratio)
                    elem.size_ratio->set(self.m_ui_drag_start_size);
                else
                    elem.size->set(self.m_ui_drag_start_size);
            }
            else
            {
                try! rot =
                    selected_entity->towoo::get_component:<UserInterface::Rotation>();
                rot.angle->set(self.m_ui_drag_start_angle_deg);
            }
            return_value!;
        };

        self.m_ui_dragging = false;
        self.m_ui_drag_handle = UI_HANDLE_NONE;
        self.m_ui_drag_active = false;
    }

    // ---- 绘制（ImGui 窗口 DrawList 覆盖层） ----

    // UI gizmo 覆盖层：参考矩形+锚点基点、元素矩形、pivot、缩放手柄、
    // 旋转茎环与拖拽数值标签。在视口图像之后提交，天然盖在画面上
    protected func drawUIGizmo(
        self: WorldEditorViewport,
        rect_min: ImVec2,
        rect_size: ImVec2)=> void
    {
        if (!self.m_ui_draw_visible)
            return;

        let dr = self.m_ui_draw_display_range;
        if (rect_size.0 <= 0. || rect_size.1 <= 0.
            || dr[0] <= 0. || dr[1] <= 0.)
            return;

        // 视口缩放折叠：换算用“虚拟全图”矩形（zoom==1 时即原值），
        // 所有 uiDisplayToScreen 透传即自动感知缩放
        let (rmin, rsize) = self->uiViewScreenRect(
            rect_min as vec2, rect_size as vec2, dr);

        let draw_list = GetWindowDrawList();
        let total = self.m_ui_draw_total_angle;
        let half = self.m_ui_draw_size * 0.5;

        // 当前编辑层（拖拽期间冻结为拖拽开始时的层）：默认编辑比例通道，
        // 按住 Shift 切到绝对通道；缩放手柄挂在编辑层框上，offset 拖拽
        // 写对应成员
        let edit_ratio = self.m_ui_dragging
            ? self.m_ui_drag_edit_ratio
            | !IsKeyDown(ImGuiKey::ImGuiKey_LeftShift);
        let handle_half = (edit_ratio ? self.m_ui_draw_ratio_box | self.m_ui_draw_size_box) * 0.5;

        // 参考矩形（父元素矩形或整个显示区）
        {
            let ref_half = self.m_ui_draw_ref_size * 0.5;
            let rt = self.m_ui_draw_ref_total_angle;
            let r0 = uiDisplayToScreen(
                self.m_ui_draw_ref_center
                    + uiRotateVec2(rt, (-ref_half[0], -ref_half[1]) as vec2),
                rmin, rsize, dr);
            let r1 = uiDisplayToScreen(
                self.m_ui_draw_ref_center
                    + uiRotateVec2(rt, (ref_half[0], -ref_half[1]) as vec2),
                rmin, rsize, dr);
            let r2 = uiDisplayToScreen(
                self.m_ui_draw_ref_center
                    + uiRotateVec2(rt, (ref_half[0], ref_half[1]) as vec2),
                rmin, rsize, dr);
            let r3 = uiDisplayToScreen(
                self.m_ui_draw_ref_center
                    + uiRotateVec2(rt, (-ref_half[0], ref_half[1]) as vec2),
                rmin, rsize, dr);
            do draw_list->AddLine((r0[0], r0[1]), (r1[0], r1[1]), UI_GIZMO_COLOR_REF, 1.);
            do draw_list->AddLine((r1[0], r1[1]), (r2[0], r2[1]), UI_GIZMO_COLOR_REF, 1.);
            do draw_list->AddLine((r2[0], r2[1]), (r3[0], r3[1]), UI_GIZMO_COLOR_REF, 1.);
            do draw_list->AddLine((r3[0], r3[1]), (r0[0], r0[1]), UI_GIZMO_COLOR_REF, 1.);
        }

        // 锚点基点标记（小圆 + 十字）
        let an = uiDisplayToScreen(self.m_ui_draw_anchor_display, rmin, rsize, dr);
        do draw_list->AddCircle((an[0], an[1]), 5., UI_GIZMO_COLOR_REF, 1.5);
        do draw_list->AddLine(
            (an[0] - 7., an[1]), (an[0] + 7., an[1]), UI_GIZMO_COLOR_REF, 1.);
        do draw_list->AddLine(
            (an[0], an[1] - 7.), (an[0], an[1] + 7.), UI_GIZMO_COLOR_REF, 1.);

        // 绝对层框（size 的像素贡献，同心内侧，浅灰）：Shift 激活绝对层
        // 时描粗以示当前写入目标。比例层框即有效矩形本身（外层，与
        // UI 对象实际渲染大小一致），随下方主框绘制
        {
            let s_half = self.m_ui_draw_size_box * 0.5;
            let size_w = edit_ratio ? 1. | 1.5;
            let s0 = uiDisplayToScreen(
                self.m_ui_draw_center
                    + uiRotateVec2(total, (-s_half[0], -s_half[1]) as vec2),
                rmin, rsize, dr);
            let s1 = uiDisplayToScreen(
                self.m_ui_draw_center
                    + uiRotateVec2(total, (s_half[0], -s_half[1]) as vec2),
                rmin, rsize, dr);
            let s2 = uiDisplayToScreen(
                self.m_ui_draw_center
                    + uiRotateVec2(total, (s_half[0], s_half[1]) as vec2),
                rmin, rsize, dr);
            let s3 = uiDisplayToScreen(
                self.m_ui_draw_center
                    + uiRotateVec2(total, (-s_half[0], s_half[1]) as vec2),
                rmin, rsize, dr);
            do draw_list->AddLine((s0[0], s0[1]), (s1[0], s1[1]), UI_GIZMO_COLOR_SIZE_LAYER, size_w);
            do draw_list->AddLine((s1[0], s1[1]), (s2[0], s2[1]), UI_GIZMO_COLOR_SIZE_LAYER, size_w);
            do draw_list->AddLine((s2[0], s2[1]), (s3[0], s3[1]), UI_GIZMO_COLOR_SIZE_LAYER, size_w);
            do draw_list->AddLine((s3[0], s3[1]), (s0[0], s0[1]), UI_GIZMO_COLOR_SIZE_LAYER, size_w);
        }

        // 比例层激活（默认态）时画锚点基点 → 矩形中心的偏移链连线，
        // 提示 offset 拖拽当前写入 offset_ratio
        if (edit_ratio)
        {
            let ct = uiDisplayToScreen(self.m_ui_draw_center, rmin, rsize, dr);
            do draw_list->AddLine(
                (an[0], an[1]), (ct[0], ct[1]), UI_GIZMO_COLOR_RATIO_LAYER, 1.);
        }

        // 元素矩形（旋转后的四角连线）= 比例层框（外层，与 UI 对象实际
        // 渲染大小一致），默认编辑层时描粗；锁定编辑时改用暗淡配色
        //（手柄不绘制，见 m_ui_draw_can_resize / m_ui_draw_can_rotate）
        let main_w = edit_ratio ? 1.5 | 1.;
        let main_color = self.m_ui_edit_locked
            ? UI_GIZMO_COLOR_LOCKED
            | UI_GIZMO_COLOR;
        let c0 = uiDisplayToScreen(
            self.m_ui_draw_center + uiRotateVec2(total, (-half[0], -half[1]) as vec2),
            rmin, rsize, dr);
        let c1 = uiDisplayToScreen(
            self.m_ui_draw_center + uiRotateVec2(total, (half[0], -half[1]) as vec2),
            rmin, rsize, dr);
        let c2 = uiDisplayToScreen(
            self.m_ui_draw_center + uiRotateVec2(total, (half[0], half[1]) as vec2),
            rmin, rsize, dr);
        let c3 = uiDisplayToScreen(
            self.m_ui_draw_center + uiRotateVec2(total, (-half[0], half[1]) as vec2),
            rmin, rsize, dr);
        do draw_list->AddLine((c0[0], c0[1]), (c1[0], c1[1]), main_color, main_w);
        do draw_list->AddLine((c1[0], c1[1]), (c2[0], c2[1]), main_color, main_w);
        do draw_list->AddLine((c2[0], c2[1]), (c3[0], c3[1]), main_color, main_w);
        do draw_list->AddLine((c3[0], c3[1]), (c0[0], c0[1]), main_color, main_w);

        // pivot 标记（圆 + 十字）
        let pv = uiDisplayToScreen(self.m_ui_draw_pivot_display, rmin, rsize, dr);
        do draw_list->AddCircle((pv[0], pv[1]), 4., UI_GIZMO_COLOR_PIVOT, 1.5);
        do draw_list->AddLine(
            (pv[0] - 6., pv[1]), (pv[0] + 6., pv[1]), UI_GIZMO_COLOR_PIVOT, 1.);
        do draw_list->AddLine(
            (pv[0], pv[1] - 6.), (pv[0], pv[1] + 6.), UI_GIZMO_COLOR_PIVOT, 1.);

        // 旋转手柄：从 pivot 沿元素自身 up 轴伸出茎 + 端点圆
        //（无 Rotation 组件的实体不显示）
        if (self.m_ui_draw_can_rotate)
        {
            let up = uiRotateVec2(total, (0., 1.) as vec2);
            let rpos = uiDisplayToScreen(
                self.m_ui_draw_pivot_display + up * (half[1] + UI_ROTATE_STALK_PX),
                rmin, rsize, dr);
            let rot_color = (self.m_ui_hover_handle == UI_HANDLE_ROTATE)
                ? UI_GIZMO_COLOR_HOVER
                | UI_GIZMO_COLOR_REF;
            do draw_list->AddLine((pv[0], pv[1]), (rpos[0], rpos[1]), rot_color, 1.);
            do draw_list->AddCircle((rpos[0], rpos[1]), 5., rot_color, 1.5);
        }

        // 缩放手柄方块（四角+四边中点，挂在编辑层框上，悬停/拖拽高亮）
        if (self.m_ui_draw_can_resize)
        {
            let hs = COLLIDER_HANDLE_SIZE_PX * 0.5;
            let mut h = UI_HANDLE_RESIZE_LB;
            while (h <= UI_HANDLE_RESIZE_T)
            {
                let (sx, sy) = uiHandleSigns(h);
                let hp = uiDisplayToScreen(
                    self.m_ui_draw_center
                        + uiRotateVec2(total, ((sx as real) * handle_half[0], (sy as real) * handle_half[1]) as vec2),
                    rmin, rsize, dr);
                let hcolor = (self.m_ui_hover_handle == h)
                    ? UI_GIZMO_COLOR_HOVER
                    | UI_GIZMO_COLOR_HANDLE;
                do draw_list->AddRectFilled(
                    (hp[0] - hs, hp[1] - hs), (hp[0] + hs, hp[1] + hs), hcolor);
                h += 1;
            }
        }

        // Ctrl 对齐吸附命中的参考线（洋红；跟随参考矩形旋转、两端延长）
        match (self.m_ui_snap_guide_x)
        {
            none?;
            value(lx)?
            {
                let rt = self.m_ui_draw_ref_total_angle;
                let dx = lx - self.m_ui_draw_ref_center[0];
                let hh2 = self.m_ui_draw_ref_size[1] * 0.5 + UI_SNAP_GUIDE_EXT_PX;
                let g0 = uiDisplayToScreen(
                    self.m_ui_draw_ref_center + uiRotateVec2(rt, (dx, -hh2) as vec2),
                    rmin, rsize, dr);
                let g1 = uiDisplayToScreen(
                    self.m_ui_draw_ref_center + uiRotateVec2(rt, (dx, hh2) as vec2),
                    rmin, rsize, dr);
                do draw_list->AddLine((g0[0], g0[1]), (g1[0], g1[1]), UI_GIZMO_COLOR_SNAP, 1.);
            }
        }
        match (self.m_ui_snap_guide_y)
        {
            none?;
            value(ly)?
            {
                let rt = self.m_ui_draw_ref_total_angle;
                let dy = ly - self.m_ui_draw_ref_center[1];
                let ww2 = self.m_ui_draw_ref_size[0] * 0.5 + UI_SNAP_GUIDE_EXT_PX;
                let g0 = uiDisplayToScreen(
                    self.m_ui_draw_ref_center + uiRotateVec2(rt, (-ww2, dy) as vec2),
                    rmin, rsize, dr);
                let g1 = uiDisplayToScreen(
                    self.m_ui_draw_ref_center + uiRotateVec2(rt, (ww2, dy) as vec2),
                    rmin, rsize, dr);
                do draw_list->AddLine((g0[0], g0[1]), (g1[0], g1[1]), UI_GIZMO_COLOR_SNAP, 1.);
            }
        }

        // 拖拽中的数值标签（跟随鼠标，按编辑层显示对应成员）；激活死区
        // 内（ARMED 未写值）不显示
        if (self.m_ui_dragging && self.m_ui_drag_active)
        {
            let mouse = GetMousePos() as vec2;
            do try!{
                try! selected_entity =
                    self->uiFindEntityByEuidInSelector(self.m_ui_drag_euid);
                let handle = self.m_ui_drag_handle;

                let mut label = "";
                if (handle == UI_HANDLE_MOVE)
                {
                    try! elem =
                        selected_entity->towoo::get_component:<UserInterface::Element>();
                    if (self.m_ui_drag_edit_ratio)
                    {
                        let o = elem.offset_ratio->get;
                        let ox = uiRoundTo(o[0], 0.001);
                        let oy = uiRoundTo(o[1], 0.001);
                        label = F"offset_ratio: ({ox}, {oy})";
                    }
                    else
                    {
                        let o = elem.offset->get;
                        let ox = uiRoundTo(o[0], 0.1);
                        let oy = uiRoundTo(o[1], 0.1);
                        label = F"offset: ({ox}, {oy})";
                    }
                }
                else if (handle >= UI_HANDLE_RESIZE_LB && handle <= UI_HANDLE_RESIZE_T)
                {
                    let box = self.m_ui_drag_edit_ratio
                        ? self.m_ui_draw_ratio_box
                        | self.m_ui_draw_size_box;
                    let sw = uiRoundTo(box[0], 0.1);
                    let sh = uiRoundTo(box[1], 0.1);
                    label = self.m_ui_drag_edit_ratio
                        ? F"size_ratio: {sw} × {sh} px"
                        | F"size: {sw} × {sh} px";
                }
                else
                {
                    try! rot =
                        selected_entity->towoo::get_component:<UserInterface::Rotation>();
                    let deg = uiRoundTo(rot.angle->get, 0.1);
                    label = F"角度: {deg}°";
                }

                do draw_list->AddText(
                    (mouse[0] + 14., mouse[1] - 20.), UI_GIZMO_COLOR_HOVER, label);
                return_value!;
            };
        }
    }

    // 当前是否处于 UI 编辑模式（选中实体为 UI 元素）：此模式下视口
    // 保持干净——跳过世界网格/实体图标/选中高亮等 3D gizmo（见
    // drawGizmos/updateIconGizmos），隐藏视口工具栏，仅保留 UI 矩形
    // 手柄与参考矩形/锚点/pivot 标记
    protected func uiEditingActive(self: WorldEditorViewport)=> bool
    {
        return self->uiFindSelectedUIElement()->is_value;
    }

}