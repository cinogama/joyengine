// 世界编辑器视口 —— gizmo 绘制。
// 世界坐标网格、被选中实体高亮、摄像机实体 gizmo（视锥体线框 + 图标）、
// 2D 光源实体图标、粒子发射器实体图标、变换游标本体、2D 物理碰撞体
// 线框与编辑手柄、2D 光源形状（Range 同心环 / BlockShadow 遮挡多边形）
// 线框与编辑手柄、粒子发射器（发射形状 / 方向箭头 / 散布角环）线框
// 与编辑手柄的渲染，走视口自有的 render 分支。单层模式只绘制当前
// 编辑层（变换 / 碰撞体 / 光源 / 粒子）的手柄，其余层只保留淡化线框
// 作背景；全部模式绘制所有层的手柄（后绘制的层在命中时优先）。
// 选中实体图标降为半号淡色徽标，让出原点附近的手柄。
// 2D（正交）模式下游标与视线平行的轴/环、粒子发射器与视线平行的
// 形状手柄不绘制（剔除口径与各 update*Gizmo 的悬停检测一致，见
// GizmoMath.wo）。

import pkg::std;

import je;
import je::ecs;
import je::graphic;
import je::gui;
import je::internal;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::try;

import builtin::editor::GUI::Icons;

import builtin::editor::Editor::Gizmo::Shaders;
import builtin::editor::Editor::Gizmo::Shapes;

import Definition;
import CameraControl;
import GizmoMath;
import EntityPicking;
import TransformGizmo;
import ColliderGizmo;
import LightGizmo;
import ParticleGizmo;
import UIGizmo;

using std;

using je;
using je::gui;
using je::graphic;

using JEEditor::GUI;
using JEEditor::GUI::Icons;
using JEEditor::Editor::Gizmo::Shaders;
using JEEditor::Editor::Gizmo::Shapes;

namespace JEEditor::Editor::WorldEditorViewport
{
    public func drawGizmos(self: WorldEditorViewport, debug_camera: option<entity>)=> void
    {
        do try!{
            try! camera_entity = debug_camera;
            try! camera_projection = camera_entity->towoo::get_component:<Camera::Projection>();

            // 获取目标纹理缓冲区，如果没有就不绘制 gizmo 了。
            try! fb = self.m_editor_walk_camera_frame_buffer;

            // GIZMO 的绘制层级，需要一个足够大的数字以确保 GIZMO 总是最后绘制
            let GIZMO_REND_QUEUE = 1000000;

            // 开始新的一帧~
            self.m_gizmo_draw_branch->new_frame(GIZMO_REND_QUEUE);

            // UI 编辑模式（选中 UI 元素）：世界坐标网格/实体图标/选中
            // 高亮等 3D gizmo 对屏幕空间的 UI 编辑无意义，本帧不再提交
            // 任何内容，保持视口干净。注意 branch 的帧内容保留到下一次
            // new_frame（上面的空帧即用于清掉上一帧的世界网格，直接
            // 跳过本函数会让旧内容残留）
            if (self->uiEditingActive())
                return_value!;

            let gizmo_rend_chain = self.m_gizmo_draw_branch->new_command_buffer(
                option::value(fb), 0, 0, 0, 0);
                
            // 绑定默认 ubo
            gizmo_rend_chain->bind_uniform_buffer(
                camera_projection->get_default_uniform_buffer);
                
            // 世界坐标网格铺在最底层，先于其余 gizmo 绘制
            drawWorldGrid(camera_entity, camera_projection, gizmo_rend_chain);
            
            func drawGizmo(
                pos: vec3,
                rot: quat,
                scale: vec3,
                shader: option<shader>,
                texture: option<(texture2d, vec2, vec2)>,
                shape: option<vertex>)
            {
                do try!{
                    try! shader_instance = shader;
                    try! shape_instance = shape;
                    
                    let model = mat4::transform(pos, rot, scale);
                    let model_view = camera_projection->get_view_mat * model;
                    let model_view_proj = camera_projection->get_view_proj_mat * model;
                    
                    match (texture)
                    {
                        none?;
                        value((texture_instance, _, _))?
                        {
                            gizmo_rend_chain->bind_texture(0, texture_instance);
                        }
                    }
                    
                    let draw_action = gizmo_rend_chain->draw(shader_instance, shape_instance);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_M", model as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MV", model_view as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MVP", model_view_proj as raw mat4);
                    
                    match (texture)
                    {
                        none?;
                        value((_, tiling, offset))?
                        {
                            draw_action->set_uniform(shader_instance, "JE_UV_TILING", tiling as raw vec2);
                            draw_action->set_uniform(shader_instance, "JE_UV_OFFSET", offset as raw vec2);
                        }
                    }
                    return_value!;
                };
            }
            
            // 绘制实体图标（摄像机/2D 光源）：公告板四边形采样图标纹理，
            // 染色（悬停/选中高亮）通过 JE_COLOR 提供；图标统一半透明
            // 渲染，JE_COLOR 的 alpha 固定为 0.5（悬停/选中只改 rgb）
            func drawBillboardIcon(
                pos: vec3,
                rot: quat,
                icon_size: real,
                icon: texture2d,
                tint: (real, real, real, real),
                alpha: real)
            {
                do try!{
                    try! shader_instance = GIZMO_ICON;
                    try! shape_instance = DEFAULT_SQUARE_SHAPE;
                    
                    let scale = (icon_size, icon_size, icon_size) as vec3;
                    let model = mat4::transform(pos, rot, scale);
                    let model_view = camera_projection->get_view_mat * model;
                    let model_view_proj = camera_projection->get_view_proj_mat * model;
                    
                    gizmo_rend_chain->bind_texture(0, icon);
                    
                    let draw_action = gizmo_rend_chain->draw(
                        shader_instance, shape_instance);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_M", model as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MV", model_view as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MVP", model_view_proj as raw mat4);
                    draw_action->set_uniform(shader_instance, "JE_UV_TILING", (1., 1.) as raw vec2);
                    draw_action->set_uniform(shader_instance, "JE_UV_OFFSET", (0., 0.) as raw vec2);
                    // 半透明图标：沿用染色的 rgb，alpha 由调用方提供
                    //（选中实体降为小号淡色徽标，避免盖住原点手柄）
                    let icon_color = (tint.0, tint.1, tint.2, alpha);
                    draw_action->set_uniform(shader_instance, "JE_COLOR", icon_color);
                    return_value!;
                };
            }
            
            // 绘制被选中的实体
            do try!{
                try! selected_euid = self.m_selected_entity_id;
                try! selected_entity = self->findEntityByEuid(selected_euid);
                
                if (isCameraEntity(selected_entity)
                    || isLight2DEntity(selected_entity)
                    || isParticleEmitterEntity(selected_entity))
                    return_value!;
                    
                let trans = selected_entity->towoo::get_component:<Transform::Translation>->unwrap;
                let texture = selected_entity->towoo::get_component:<Renderer::Textures2D>;
                
                drawGizmo(
                    trans->get_global_pos,
                    trans->get_global_rot,
                    trans->get_local_scale,
                    SELECTED_ENTITY_HILIGHT,
                    option::value <|
                        texture
                            =>> \textures = textures->get_texture(0)
                                ->> \texture_instance = (
                                        texture_instance,
                                        textures.tiling->get,
                                        textures.offset->get,)
                                    ;
                                ;
                            -> or((WHITE, (1., 1.) as vec2, (0.,0.) as vec2)),
                        DEFAULT_SQUARE_SHAPE);
                return_value!;
            };
            
            // 编辑器 gizmo 配色以 sRGB 设计；引擎 shader 现在在线性空间工作，
            // 提交 JE_COLOR 前统一转换到线性，最终由 sRGB 交换链编码。
            func linearColor(
                srgb: (real, real, real, real))=> (real, real, real, real)
            {
                let linear = color::from_srgb(srgb as vec4);
                return (linear.0, linear.1, linear.2, linear.3);
            }

            // 绘制变换游标（纯色，颜色由每次绘制的 JE_COLOR 提供）
            func drawSolid(
                pos: vec3,
                rot: quat,
                scale: vec3,
                shape: option<vertex>,
                color: (real, real, real, real))
            {
                do try!{
                    try! shape_instance = shape;
                    try! shader_instance = GIZMO_SOLID;
                    
                    let model = mat4::transform(pos, rot, scale);
                    let model_view = camera_projection->get_view_mat * model;
                    let model_view_proj = camera_projection->get_view_proj_mat * model;
                    
                    let draw_action = gizmo_rend_chain->draw(
                        shader_instance, shape_instance);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_M", model as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MV", model_view as raw mat4);
                    draw_action->set_uniform_mat4x4(shader_instance, "JE_MVP", model_view_proj as raw mat4);
                    draw_action->set_uniform(shader_instance, "JE_COLOR", linearColor(color));
                    return_value!;
                };
            }

            // 按比例降低颜色透明度：非激活层线框降为背景，激活层中
            // 未被悬停的手柄淡化，突出当前操作目标
            func dimColor(
                color: (real, real, real, real),
                factor: real)=> (real, real, real, real)
            {
                return (color.0, color.1, color.2, color.3 * factor);
            }
            
            // 绘制摄像机实体 gizmo（视锥体线框 + 图标）：
            // 含 Translation 与 Projection 且不带 Invisible 的实体视为摄像机
            // 实体（编辑器调试摄像机带 Invisible，不在此列）。
            do try!{
                try! debug_camera_trans =
                    camera_entity->towoo::get_component:<Transform::Translation>();
                let (fbw, fbh) = fb->size();
                let fb_rsize = (fbw as real, fbh as real) as vec2;
                let debug_view_proj = camera_projection->get_view_proj_mat;
                let debug_view = camera_projection->get_view_mat;
                let debug_cam_pos = debug_camera_trans->get_global_pos;
                let debug_cam_rot = debug_camera_trans->get_global_rot;
                let debug_cam_forward =
                    debug_cam_rot * ((0., 0., 1.) as vec3);
                    
                // 视锥体棱线的眼空间裁剪参数（见 gizmoClipEyeSegmentToScreen）：
                // 透视为 tan 半 FOV（乘纵横比得横向），正交为可视半宽高
                let debug_znear = camera_projection.znear->get;
                let debug_is_persp = !(
                    camera_entity->towoo::get_component:<Camera::PerspectiveProjection>()->is_none);
                let mut clip_sy = 0.;
                if (debug_is_persp)
                    clip_sy = mathf::tan(
                        camera_entity->towoo::get_component:<Camera::PerspectiveProjection>->unwrap.angle->get
                            * 0.5 * mathf::DEG2RAD);
                else
                    // 正交纵向可视半高为 ORTHO_PROJECTION_RATIO（5.0）/ scale
                    clip_sy = 5. / camera_entity
                        ->towoo::get_component:<Camera::OrthoProjection>->unwrap.scale->get;
                let clip_sx = clip_sy * fb_rsize[0] / fb_rsize[1];
                
                // 单条视锥体棱：先在眼空间对调试摄像机做屏幕边界裁剪
                //（远平面不裁，超出 zfar 的部分由 GizmoSolid 钳制 z 绘制），
                // 再把单位 X 轴线段旋到 ab 方向绘制
                func drawFrustumEdge(
                    a: vec3, b: vec3, color: (real, real, real, real))=> void
                {
                    let clipped = gizmoClipEyeSegmentToScreen(
                        gizmoMat4MulPoint(debug_view, a),
                        gizmoMat4MulPoint(debug_view, b),
                        debug_znear, clip_sx, clip_sy, debug_is_persp);
                    if (clipped->is_none)
                        return;
                    let (ca, cb) = clipped->unwrap;
                    let wa = debug_cam_pos + debug_cam_rot * ca;
                    let wb = debug_cam_pos + debug_cam_rot * cb;
                    
                    let ab = wb - wa;
                    let len = ab->length;
                    if (len < 0.0001)
                        return;
                    drawSolid(
                        wa, gizmoEdgeRotation(ab), (len, len, len) as vec3,
                        GIZMO_LINE_X, color);
                }
                
                for (let e : self.m_camera_entity_selector)
                {
                    do try!{
                        try! cam_trans =
                            e->towoo::get_component:<Transform::Translation>();
                        try! cam_proj =
                            e->towoo::get_component:<Camera::Projection>();
                        try! euid = e->internal::get_entity_uid;
                        
                        let pos = cam_trans->get_global_pos;
                        let rot = cam_trans->get_global_rot;
                        
                        let mut is_selected = false;
                        match (self.m_selected_entity_id)
                        {
                            none?;
                            value(selected)?
                                is_selected = selected == euid;
                        }
                        let mut is_hover = false;
                        match (self.m_icon_gizmo_hover)
                        {
                            none?;
                            value(hovered)?
                                is_hover = hovered == euid;
                        }
                        
                        let mut frustum_color = CAMERA_GIZMO_COLOR;
                        if (is_hover)
                            frustum_color = CAMERA_GIZMO_COLOR_HOVER;
                        if (is_selected)
                            frustum_color = GIZMO_COLOR_HOVER;
                        let mut icon_tint = (1., 1., 1., 1.);
                        if (is_hover)
                            icon_tint = linearColor((1., 1., 0.6, 1.));
                        if (is_selected)
                            icon_tint = linearColor((1., 1., 0.25, 1.));
                            
                        // ---- 视锥体线框 ----
                        // 用该摄像机自己的逆投影矩阵反变换 NDC 角点
                        //（近/远平面 z 分别为 0/1），宽高比随之与其渲染
                        // 目标一致，无需手工推算
                        let inv_proj = cam_proj->get_inv_proj_mat;
                        let near_rect = [
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot, -1., -1., 0.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot,  1., -1., 0.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot,  1.,  1., 0.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot, -1.,  1., 0.),
                        ];
                        let far_rect = [
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot, -1., -1., 1.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot,  1., -1., 1.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot,  1.,  1., 1.),
                            gizmoCameraUnprojectPoint(inv_proj, pos, rot, -1.,  1., 1.),
                        ];
                        for (let mut i = 0; i < 4; i += 1)
                        {
                            let j = (i + 1) % 4;
                            drawFrustumEdge(near_rect[i], near_rect[j], frustum_color);
                            drawFrustumEdge(far_rect[i], far_rect[j], frustum_color);
                            drawFrustumEdge(near_rect[i], far_rect[i], frustum_color);
                        }
                        
                        // ---- 图标 ----
                        // 绘制在 Translation 位置、面向调试摄像机（公告板），
                        // 大小按屏幕像素恒定（与变换游标同一套估算）；
                        // 位于调试摄像机身后的摄像机不绘制图标（避免镜像投影）
                        if ((pos - debug_cam_pos)->dot(debug_cam_forward) > 0.)
                        {
                            match (Icons::GIZMO_CAMERA)
                            {
                                none?;
                                value(icon)?
                                {
                                    let world_per_pixel = gizmoWorldPerPixel(
                                        camera_entity, debug_camera_trans,
                                        debug_view_proj, pos, fb_rsize);
                                    // 选中实体：图标缩为半号并降低透明度，
                                    // 让出原点处的变换/组件手柄
                                    let icon_size_px = is_selected
                                        ? CAMERA_GIZMO_ICON_SIZE_PX * 0.5
                                        | CAMERA_GIZMO_ICON_SIZE_PX;
                                    drawBillboardIcon(
                                        pos,
                                        debug_camera_trans->get_global_rot,
                                        icon_size_px * world_per_pixel,
                                        icon,
                                        icon_tint,
                                        is_selected ? 0.2 | 0.5);
                                }
                            }
                        }
                        return_value!;
                    };
                }
                return_value!;
            };
            
            // 绘制 2D 光源与粒子发射器实体图标 gizmo（仅图标，无附加线框）：
            // 点光源（Translation+Point/Range 且不带 Invisible）绘制
            // gizmo_point_light2d，平行光源（Translation+Parallel 且不带
            // Invisible）绘制 gizmo_parallel_light2d，粒子发射器
            //（Translation+Particle::Emitter 且不带 Invisible）绘制
            // gizmo_particle；绘制规则与摄像机图标一致（Translation 位置、
            // 面向调试摄像机的公告板、屏幕像素恒定大小、身后不绘制），
            // 光源图标默认染色跟随光源自身的 Renderer::Color（无该组件
            // 则白色）、发射器图标默认染色取其初始颜色区间中点，悬停
            // 提亮/选中染黄；平行光源图标额外随实体最终旋转自转（箭头
            // 指向照射方向）。
            do try!{
                try! debug_camera_trans =
                    camera_entity->towoo::get_component:<Transform::Translation>();
                let (fbw, fbh) = fb->size();
                let fb_rsize = (fbw as real, fbh as real) as vec2;
                let debug_view_proj = camera_projection->get_view_proj_mat;
                let debug_cam_pos = debug_camera_trans->get_global_pos;
                let debug_cam_forward =
                    debug_camera_trans->get_global_rot * ((0., 0., 1.) as vec3);
                    
                // follow_rotation 为真时（平行光源）图标随实体最终旋转在
                // 公告板面内自转，箭头指向实际照射方向；点/范围光源全向
                // 发光，图标不随旋转
                func drawLight2DIcon(
                    e: entity,
                    icon: option<texture2d>,
                    follow_rotation: bool)=> void
                {
                    do try!{
                        try! trans =
                            e->towoo::get_component:<Transform::Translation>();
                        try! euid = e->internal::get_entity_uid;
                        try! icon_instance = icon;
                        
                        let pos = trans->get_global_pos;
                        
                        let billboard_rot = debug_camera_trans->get_global_rot;
                        let mut icon_rot = billboard_rot;
                        if (follow_rotation)
                            icon_rot = billboard_rot * gizmoDirectionalIconSpin(
                                trans->get_global_rot, billboard_rot);
                                
                        let mut is_selected = false;
                        match (self.m_selected_entity_id)
                        {
                            none?;
                            value(selected)?
                                is_selected = selected == euid;
                        }
                        let mut is_hover = false;
                        match (self.m_icon_gizmo_hover)
                        {
                            none?;
                            value(hovered)?
                                is_hover = hovered == euid;
                        }
                        
                        // 默认状态下图标 rgb 跟随光源自身的颜色
                        //（Renderer::Color 的 color），没有该组件的
                        // 光源实体回退白色；悬停/选中仍用各自高亮色
                        let mut icon_tint = (1., 1., 1., 1.);
                        match (e->towoo::get_component:<Renderer::Color>())
                        {
                            none?;
                            value(light_color)?
                            {
                                let c = light_color.color->get->to_linear;
                                icon_tint = (c.0, c.1, c.2, 1.);
                            }
                        }
                        if (is_hover)
                            icon_tint = linearColor((1., 1., 0.6, 1.));
                        if (is_selected)
                            icon_tint = linearColor((1., 1., 0.25, 1.));
                            
                        // 位于调试摄像机身后的光源不绘制图标（避免镜像投影）
                        if ((pos - debug_cam_pos)->dot(debug_cam_forward) > 0.)
                        {
                            let world_per_pixel = gizmoWorldPerPixel(
                                camera_entity, debug_camera_trans,
                                debug_view_proj, pos, fb_rsize);
                            let icon_size_px = is_selected
                                ? LIGHT2D_GIZMO_ICON_SIZE_PX * 0.5
                                | LIGHT2D_GIZMO_ICON_SIZE_PX;
                            drawBillboardIcon(
                                pos,
                                icon_rot,
                                icon_size_px * world_per_pixel,
                                icon_instance,
                                icon_tint,
                                is_selected ? 0.2 | 0.5);
                        }
                        return_value!;
                    };
                }
                
                // 粒子发射器图标：绘制规则与光源图标一致（Translation
                // 位置、面向调试摄像机的公告板、屏幕像素恒定大小、身后
                // 不绘制），默认染色取发射器自身初始颜色区间的中点
                //（color_min 与 color_max 的均值，逐分量钳制 0~1），
                // 全向发射不随旋转，悬停提亮/选中染黄
                func drawParticleEmitterIcon(e: entity, icon: option<texture2d>)=> void
                {
                    do try!{
                        try! trans =
                            e->towoo::get_component:<Transform::Translation>();
                        try! emitter =
                            e->towoo::get_component:<Particle::Emitter>();
                        try! euid = e->internal::get_entity_uid;
                        try! icon_instance = icon;
                        
                        let pos = trans->get_global_pos;
                        
                        let mut is_selected = false;
                        match (self.m_selected_entity_id)
                        {
                            none?;
                            value(selected)?
                                is_selected = selected == euid;
                        }
                        let mut is_hover = false;
                        match (self.m_icon_gizmo_hover)
                        {
                            none?;
                            value(hovered)?
                                is_hover = hovered == euid;
                        }
                        
                        let cmin = emitter.color_min->get->to_linear;
                        let cmax = emitter.color_max->get->to_linear;
                        let mut icon_tint = (
                            mathf::clamp((cmin.0 + cmax.0) * 0.5, 0., 1.),
                            mathf::clamp((cmin.1 + cmax.1) * 0.5, 0., 1.),
                            mathf::clamp((cmin.2 + cmax.2) * 0.5, 0., 1.),
                            1.);
                        if (is_hover)
                            icon_tint = linearColor((1., 1., 0.6, 1.));
                        if (is_selected)
                            icon_tint = linearColor((1., 1., 0.25, 1.));
                            
                        // 位于调试摄像机身后的发射器不绘制图标（避免镜像投影）
                        if ((pos - debug_cam_pos)->dot(debug_cam_forward) > 0.)
                        {
                            let world_per_pixel = gizmoWorldPerPixel(
                                camera_entity, debug_camera_trans,
                                debug_view_proj, pos, fb_rsize);
                            let icon_size_px = is_selected
                                ? PARTICLE_GIZMO_ICON_SIZE_PX * 0.5
                                | PARTICLE_GIZMO_ICON_SIZE_PX;
                            drawBillboardIcon(
                                pos,
                                debug_camera_trans->get_global_rot,
                                icon_size_px * world_per_pixel,
                                icon_instance,
                                icon_tint,
                                is_selected ? 0.2 | 0.5);
                        }
                        return_value!;
                    };
                }
                
                for (let e : self.m_point_light2d_entity_selector)
                {
                    drawLight2DIcon(e, Icons::GIZMO_POINT_LIGHT2D, false);
                }
                for (let e : self.m_range_light2d_entity_selector)
                {
                    drawLight2DIcon(e, Icons::GIZMO_POINT_LIGHT2D, false);
                }
                for (let e : self.m_parallel_light2d_entity_selector)
                {
                    drawLight2DIcon(e, Icons::GIZMO_PARALLEL_LIGHT2D, true);
                }
                for (let e : self.m_particle_emitter_entity_selector)
                {
                    drawParticleEmitterIcon(e, Icons::GIZMO_PARTICLE);
                }
                return_value!;
            };
            
            // 绘制变换游标（操作手柄）。变换层或全部模式下绘制；单层
            // 组件模式下变换游标整体让位，避免轴/环/中心与组件手柄叠加
            //（按 1 或工具栏切到变换层）。2D（正交）模式下跳过与视线
            // 平行的部件：轴向手柄投影成一点、锥体叠在中央手柄上，
            // 旋转环侧视成过心的线段（命中剔除见 pickGizmoHandle）
            if (self.m_gizmo_draw_visible
                && (self.m_gizmo_active_layer == GizmoLayer::TRANSFORM
                    || self.m_gizmo_active_layer == GizmoLayer::ALL
                    || self.m_gizmo_dragging))
            {
                let origin = self.m_gizmo_draw_origin;
                let orientation = self.m_gizmo_draw_rotation;
                let active_handle = self.m_gizmo_dragging
                    ? self.m_gizmo_drag_handle
                    | self.m_gizmo_hover_handle;
                let any_active = active_handle != GIZMO_HANDLE_NONE;
                let is_2d = isDebugCamera2DMode(camera_entity);
                
                let axis_colors = [
                    (active_handle == GIZMO_HANDLE_X)
                        ? GIZMO_COLOR_HOVER
                        | (any_active
                            ? dimColor(GIZMO_COLOR_X, GIZMO_INACTIVE_HANDLE_ALPHA)
                            | GIZMO_COLOR_X),
                    (active_handle == GIZMO_HANDLE_Y)
                        ? GIZMO_COLOR_HOVER
                        | (any_active
                            ? dimColor(GIZMO_COLOR_Y, GIZMO_INACTIVE_HANDLE_ALPHA)
                            | GIZMO_COLOR_Y),
                    (active_handle == GIZMO_HANDLE_Z)
                        ? GIZMO_COLOR_HOVER
                        | (any_active
                            ? dimColor(GIZMO_COLOR_Z, GIZMO_INACTIVE_HANDLE_ALPHA)
                            | GIZMO_COLOR_Z),
                ];
                
                if (self.m_gizmo_mode == GizmoMode::ROTATE)
                {
                    let ring_size = self.m_gizmo_draw_size * GIZMO_RING_RADIUS_RATIO;
                    let ring_scale = (ring_size, ring_size, ring_size) as vec3;
                    
                    let rings = [
                        GIZMO_RING_AROUND_X,
                        GIZMO_RING_AROUND_Y,
                        GIZMO_RING_AROUND_Z];
                    for (let mut axis = 0; axis < 3; axis += 1)
                    {
                        // 2D 模式仅保留屏幕内旋转的绕 Z 环
                        if (is_2d && gizmoRingEdgeOnIn2D(
                                orientation * gizmoUnitAxis(axis)))
                            continue;
                        drawSolid(origin, orientation, ring_scale,
                            rings[axis], axis_colors[axis]);
                    }
                }
                else
                {
                    let axis_len = (self.m_gizmo_mode == GizmoMode::SCALE)
                        ? self.m_gizmo_draw_size * GIZMO_SCALE_AXIS_RATIO
                        | self.m_gizmo_draw_size;
                    let axis_scale = (axis_len, axis_len, axis_len) as vec3;
                    
                    let lines = [GIZMO_LINE_X, GIZMO_LINE_Y, GIZMO_LINE_Z];
                    // 平移用箭头锥，缩放用方块手柄
                    let mut tips = [GIZMO_CONE_X, GIZMO_CONE_Y, GIZMO_CONE_Z];
                    if (self.m_gizmo_mode == GizmoMode::SCALE)
                        tips = [GIZMO_BOX_X, GIZMO_BOX_Y, GIZMO_BOX_Z];
                    for (let mut axis = 0; axis < 3; axis += 1)
                    {
                        // 2D 模式跳过与视线平行的轴
                        if (is_2d && gizmoAxisHiddenIn2D(
                                orientation * gizmoUnitAxis(axis)))
                            continue;
                        drawSolid(origin, orientation, axis_scale, lines[axis], axis_colors[axis]);
                        drawSolid(origin, orientation, axis_scale, tips[axis], axis_colors[axis]);
                    }
                    
                    // 中央手柄：屏幕平面移动 / 整体缩放
                    let center = self.m_gizmo_draw_center_size;
                    let center_color = (active_handle == GIZMO_HANDLE_CENTER)
                        ? GIZMO_COLOR_HOVER
                        | (any_active
                            ? dimColor(GIZMO_COLOR_CENTER, GIZMO_INACTIVE_HANDLE_ALPHA)
                            | GIZMO_COLOR_CENTER);
                    drawSolid(
                        origin, orientation, (center, center, center) as vec3,
                        DEFAULT_SQUARE_SHAPE,
                        center_color);
                }
            }
            
            // 绘制 2D 物理碰撞体实体 gizmo（线框 + 编辑手柄）：
            // 所有碰撞体实体恒绘制线框；碰撞体层激活时为选中实体绘制
            // 可拖拽的编辑手柄，其他层仅把线框作为淡化背景保留，不绘制
            // 手柄也不参与命中。线段用单位 X 轴线段旋到边方向绘制；
            // 手柄为面向调试摄像机的方块（屏幕像素恒定大小）。
            do try!{
                try! debug_camera_trans =
                    camera_entity->towoo::get_component:<Transform::Translation>();
                let (fbw, fbh) = fb->size();
                let fb_rsize = (fbw as real, fbh as real) as vec2;
                let debug_view_proj = camera_projection->get_view_proj_mat;
                let billboard_rot = debug_camera_trans->get_global_rot;

                let layer_active =
                    self.m_gizmo_active_layer == GizmoLayer::COLLIDER
                    || self.m_gizmo_active_layer == GizmoLayer::ALL
                    || self.m_collider_dragging;
                let active_handle = self.m_collider_dragging
                    ? self.m_collider_drag_handle
                    | self.m_collider_hover_handle;
                let any_active = active_handle != GIZMO_HANDLE_NONE;
                
                // 单条碰撞体边：单位 X 轴线段旋到 ab 方向
                func drawColliderEdge(
                    a: vec3, b: vec3, color: (real, real, real, real))=> void
                {
                    let ab = b - a;
                    let len = ab->length;
                    if (len < 0.0001)
                        return;
                    drawSolid(
                        a, gizmoEdgeRotation(ab), (len, len, len) as vec3,
                        GIZMO_LINE_X, color);
                }
                
                // 手柄方块：面向调试摄像机、屏幕像素恒定大小，激活时染黄
                func drawColliderHandle(
                    pos: vec3, active: bool, color: (real, real, real, real))=> void
                {
                    let world_per_pixel = gizmoWorldPerPixel(
                        camera_entity, debug_camera_trans,
                        debug_view_proj, pos, fb_rsize);
                    let size = COLLIDER_HANDLE_SIZE_PX * world_per_pixel;
                    drawSolid(
                        pos, billboard_rot, (size, size, size) as vec3,
                        DEFAULT_SQUARE_SHAPE,
                        active ? GIZMO_COLOR_HOVER | color);
                }
                
                for (let e : self.m_physics2d_body_entity_selector)
                {
                    do try!{
                        try! euid = e->internal::get_entity_uid;
                        try! outline = getColliderOutline(e);
                        
                        let mut is_selected = false;
                        match (self.m_selected_entity_id)
                        {
                            none?;
                            value(selected)?
                                is_selected = selected == euid;
                        }
                        
                        let mut color = is_selected
                            ? COLLIDER_GIZMO_COLOR_SELECTED
                            | COLLIDER_GIZMO_COLOR;
                        if (!layer_active)
                            color = dimColor(color, GIZMO_CONTEXT_WIRE_ALPHA);
                        for (let mut i = 0; i < outline->len; i += 1)
                            drawColliderEdge(
                                outline[i], outline[(i + 1) % outline->len], color);
                                
                        // 为选中实体绘制编辑手柄（仅碰撞体层激活时）
                        if (is_selected && layer_active)
                        {
                            match (getColliderHandles(e))
                            {
                                none?;
                                value(handles_info)?
                                {
                                    let handles = handles_info.1;
                                    for (let mut i = 0; i < handles->len; i += 1)
                                    {
                                        let handle_color =
                                            (any_active && i != active_handle)
                                            ? dimColor(
                                                COLLIDER_HANDLE_COLOR,
                                                GIZMO_INACTIVE_HANDLE_ALPHA)
                                            | COLLIDER_HANDLE_COLOR;
                                        drawColliderHandle(
                                            handles[i], i == active_handle,
                                            handle_color);
                                    }
                                }
                            }
                            
                            // 中心把手（Offset::Position）：拖拽改变碰撞体中心
                            match (getColliderOffsetPositionHandle(e))
                            {
                                none?;
                                value(p)?
                                {
                                    let handle_color =
                                        (any_active
                                            && active_handle
                                                != COLLIDER_HANDLE_OFFSET_POSITION)
                                        ? dimColor(
                                            COLLIDER_OFFSET_HANDLE_COLOR,
                                            GIZMO_INACTIVE_HANDLE_ALPHA)
                                        | COLLIDER_OFFSET_HANDLE_COLOR;
                                    drawColliderHandle(
                                        p,
                                        active_handle
                                            == COLLIDER_HANDLE_OFFSET_POSITION,
                                        handle_color);
                                }
                            }
                            
                            // 旋转环与环上把手（Offset::Rotation）：
                            // 拖拽旋转碰撞体，环随框架 +X 方向的把手指示角度
                            match (getColliderOffsetRotationGizmo(e))
                            {
                                none?;
                                value((ring, hp))?
                                {
                                    let ring_active = active_handle
                                        == COLLIDER_HANDLE_OFFSET_ROTATION;
                                    let ring_color = ring_active
                                        ? GIZMO_COLOR_HOVER
                                        | (any_active
                                            ? dimColor(
                                                COLLIDER_ROTATION_GIZMO_COLOR,
                                                GIZMO_INACTIVE_HANDLE_ALPHA)
                                            | COLLIDER_ROTATION_GIZMO_COLOR);
                                    for (let mut i = 0; i < ring->len; i += 1)
                                        drawColliderEdge(
                                            ring[i], ring[(i + 1) % ring->len],
                                            ring_color);
                                    drawColliderHandle(
                                        hp, ring_active,
                                        COLLIDER_ROTATION_GIZMO_COLOR);
                                }
                            }
                        }
                        return_value!;
                    };
                }
                return_value!;
            };
            
            // 绘制 2D 光源编辑 gizmo（仅选中实体）：
            // Light2D::Range 的多层同心环线框（环色亮度随该环强度调制，
            // 各环按闭合环绘制）与 Light2D::BlockShadow 的多边形线框
            //（仅依次连接相邻顶点、不加隐式闭合边——与渲染 TRIANGLESTRIP
            // 语义一致，闭合由数据以首尾重复同一点显式表达）；光源层
            // 激活时为选中实体绘制可拖拽的顶点手柄（菱形）与阴影偏移
            // 把手（方块 + 连线）。其他层仅保留淡化线框作背景，不绘制
            // 手柄。点光源无形状线框时偏移把手仍可显示；光照本身仍从
            // Translation 渲染。
            do try!{
                try! debug_camera_trans =
                    camera_entity->towoo::get_component:<Transform::Translation>();
                let (fbw, fbh) = fb->size();
                let fb_rsize = (fbw as real, fbh as real) as vec2;
                let debug_view_proj = camera_projection->get_view_proj_mat;
                let billboard_rot = debug_camera_trans->get_global_rot;

                let layer_active =
                    self.m_gizmo_active_layer == GizmoLayer::LIGHT2D
                    || self.m_gizmo_active_layer == GizmoLayer::ALL
                    || self.m_light_dragging;
                let active_handle = self.m_light_dragging
                    ? self.m_light_drag_handle
                    | self.m_light_hover_handle;
                let any_active = active_handle != GIZMO_HANDLE_NONE;

                // 单条形状边：单位 X 轴线段旋到 ab 方向（同碰撞体边）
                func drawLightEdge(
                    a: vec3, b: vec3, color: (real, real, real, real))=> void
                {
                    let ab = b - a;
                    let len = ab->length;
                    if (len < 0.0001)
                        return;
                    drawSolid(
                        a, gizmoEdgeRotation(ab), (len, len, len) as vec3,
                        GIZMO_LINE_X, color);
                }

                // 手柄：面向调试摄像机、屏幕像素恒定大小，激活时染黄；
                // shape 区分形状顶点（菱形）与阴影偏移（方块）
                func drawLightHandle(
                    pos: vec3,
                    active: bool,
                    shape: option<vertex>,
                    color: (real, real, real, real))=> void
                {
                    let world_per_pixel = gizmoWorldPerPixel(
                        camera_entity, debug_camera_trans,
                        debug_view_proj, pos, fb_rsize);
                    let size = COLLIDER_HANDLE_SIZE_PX * world_per_pixel;
                    drawSolid(
                        pos, billboard_rot, (size, size, size) as vec3,
                        shape,
                        active ? GIZMO_COLOR_HOVER | color);
                }

                do try!{
                    try! selected_euid = self.m_selected_entity_id;
                    try! selected_entity = self->findEntityByEuid(selected_euid);

                    // 形状线框与顶点手柄（Range/BlockShadow，无形状
                    // 组件时跳过，偏移把手仍可显示）
                    match (getLightShapeOutlines(selected_entity))
                    {
                        none?;
                        value(outlines_info)?
                        {
                            let kind = outlines_info.0;
                            let rings = outlines_info.1;
                            let strengths = outlines_info.2;

                            let base_color = (kind == LightShapeKind::RANGE)
                                ? LIGHT2D_RANGE_GIZMO_COLOR
                                | LIGHT2D_BLOCK_GIZMO_COLOR;

                            for (let mut r = 0; r < rings->len; r += 1)
                            {
                                let ring = rings[r];
                                if (ring->len < 2)
                                    continue;
                                let mut color = base_color;
                                // 范围光按环强度调制线框亮度（遮挡体强度固定 1）
                                if (kind == LightShapeKind::RANGE && r < strengths->len)
                                {
                                    let s = mathf::clamp(strengths[r], 0., 1.) * 0.7 + 0.3;
                                    color = (
                                        base_color.0 * s, base_color.1 * s,
                                        base_color.2 * s, base_color.3);
                                }
                                if (!layer_active)
                                    color = dimColor(
                                        color, GIZMO_CONTEXT_WIRE_ALPHA);
                                for (let mut i = 0; i + 1 < ring->len; i += 1)
                                    drawLightEdge(ring[i], ring[i + 1], color);
                                // 仅范围光的环按闭合环绘制
                                if (kind == LightShapeKind::RANGE && ring->len > 2)
                                    drawLightEdge(ring[ring->len - 1], ring[0], color);
                            }

                            // 为选中实体绘制顶点手柄（仅光源层激活时）
                            if (layer_active)
                            {
                                match (getLightShapeHandles(selected_entity))
                                {
                                    none?;
                                    value(handles_info)?
                                    {
                                        let handles = handles_info.1;
                                        for (let mut i = 0; i < handles->len; i += 1)
                                        {
                                            let handle_color =
                                                (any_active && i != active_handle)
                                                ? dimColor(
                                                    COLLIDER_HANDLE_COLOR,
                                                    GIZMO_INACTIVE_HANDLE_ALPHA)
                                                | COLLIDER_HANDLE_COLOR;
                                            drawLightHandle(
                                                handles[i], i == active_handle,
                                                GIZMO_DIAMOND, handle_color);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 阴影计算点偏移把手（Light2D::ShadowOffset）：实体
                    // 原点到阴影计算点的连线（偏移为零时把手与原点重合、
                    // 不画线）与阴影计算点处的把手方块，拖拽编辑
                    // ShadowOffset.offset；仅光源层激活时绘制
                    if (layer_active)
                    {
                        match (getShadowOffsetHandle(selected_entity))
                        {
                            none?;
                            value(p)?
                            {
                                try! trans =
                                    selected_entity->towoo::get_component:<Transform::Translation>();
                                let origin = trans->get_global_pos;

                                let is_active =
                                    active_handle == LIGHT2D_HANDLE_SHADOW_OFFSET;
                                let line_color = is_active
                                    ? GIZMO_COLOR_HOVER
                                    | (any_active
                                        ? dimColor(
                                            LIGHT2D_SHADOW_OFFSET_GIZMO_COLOR,
                                            GIZMO_INACTIVE_HANDLE_ALPHA)
                                        | LIGHT2D_SHADOW_OFFSET_GIZMO_COLOR);
                                if ((p - origin)->length > 0.0001)
                                    drawLightEdge(origin, p, line_color);
                                drawLightHandle(
                                    p, is_active, DEFAULT_SQUARE_SHAPE,
                                    LIGHT2D_SHADOW_OFFSET_GIZMO_COLOR);
                            }
                        }
                    }
                    return_value!;
                };
                return_value!;
            };
            
            // 绘制粒子发射器编辑 gizmo（仅选中实体）：
            // 发射形状线框（球=三向大圆 / 圆=XY 平面圆 / 盒=六面边环）、
            // 主发射方向箭头（轴线段 + 箭头锥，尖端为方向手柄）与散布
            // 角环（过箭头尖端、垂直主方向，半径 = 箭头长 * tan(半散布
            // 角)），及可拖拽手柄（形状手柄 / 方向手柄 / 散布把手）。
            // 仅粒子层激活时绘制手柄与方向/散布 gizmo，其他层只保留
            // 淡化形状线框作背景。2D（正交）模式下与视线平行的形状
            // 手柄投影成一点且无法拖拽，不绘制（与 updateParticleGizmo
            // 的悬停剔除同口径）。
            do try!{
                try! debug_camera_trans =
                    camera_entity->towoo::get_component:<Transform::Translation>();
                let (fbw, fbh) = fb->size();
                let fb_rsize = (fbw as real, fbh as real) as vec2;
                let debug_view_proj = camera_projection->get_view_proj_mat;
                let billboard_rot = debug_camera_trans->get_global_rot;
                let is_2d = isDebugCamera2DMode(camera_entity);

                let layer_active =
                    self.m_gizmo_active_layer == GizmoLayer::PARTICLE
                    || self.m_gizmo_active_layer == GizmoLayer::ALL
                    || self.m_particle_dragging;
                let active_handle = self.m_particle_dragging
                    ? self.m_particle_drag_handle
                    | self.m_particle_hover_handle;
                let any_active = active_handle != GIZMO_HANDLE_NONE;
                
                // 单条形状边：单位 X 轴线段旋到 ab 方向（同碰撞体边）
                func drawParticleEdge(
                    a: vec3, b: vec3, color: (real, real, real, real))=> void
                {
                    let ab = b - a;
                    let len = ab->length;
                    if (len < 0.0001)
                        return;
                    drawSolid(
                        a, gizmoEdgeRotation(ab), (len, len, len) as vec3,
                        GIZMO_LINE_X, color);
                }
                
                // 手柄：面向调试摄像机、屏幕像素恒定大小，激活时染黄；
                // shape 区分形状手柄（三角形）与方向/散布手柄
                func drawParticleHandle(
                    pos: vec3,
                    active: bool,
                    shape: option<vertex>,
                    color: (real, real, real, real))=> void
                {
                    let world_per_pixel = gizmoWorldPerPixel(
                        camera_entity, debug_camera_trans,
                        debug_view_proj, pos, fb_rsize);
                    let size = COLLIDER_HANDLE_SIZE_PX * world_per_pixel;
                    drawSolid(
                        pos, billboard_rot, (size, size, size) as vec3,
                        shape,
                        active ? GIZMO_COLOR_HOVER | color);
                }
                
                do try!{
                    try! selected_euid = self.m_selected_entity_id;
                    try! selected_entity = self->findEntityByEuid(selected_euid);
                    try! emitter =
                        selected_entity->towoo::get_component:<Particle::Emitter>();
                    try! frame = particleFrame(selected_entity);
                        
                    // ---- 发射形状线框（各环按闭合环绘制；点发射无环） ----
                    match (getParticleShapeOutline(selected_entity))
                    {
                        none?;
                        value((_, rings))?
                        {
                            let mut outline_color = PARTICLE_GIZMO_COLOR;
                            if (!layer_active)
                                outline_color = dimColor(
                                    outline_color, GIZMO_CONTEXT_WIRE_ALPHA);
                            for (let mut r = 0; r < rings->len; r += 1)
                            {
                                let ring = rings[r];
                                if (ring->len < 2)
                                    continue;
                                for (let mut i = 0; i + 1 < ring->len; i += 1)
                                    drawParticleEdge(
                                        ring[i], ring[i + 1], outline_color);
                                if (ring->len > 2)
                                    drawParticleEdge(
                                        ring[ring->len - 1], ring[0],
                                        outline_color);
                            }
                        }
                    }

                    if (layer_active)
                    {
                        // 形状手柄
                        match (getParticleShapeHandles(selected_entity))
                        {
                            none?;
                            value(handles_info)?
                            {
                                let handles = handles_info.1;
                                for (let mut i = 0; i < handles->len; i += 1)
                                {
                                    if (is_2d && gizmoAxisHiddenIn2D(
                                            frame.1 * gizmoUnitAxis(
                                                particleHandleAxis(handles_info.0, i))))
                                        continue;
                                    let handle_color =
                                        (any_active && i != active_handle)
                                        ? dimColor(
                                            COLLIDER_HANDLE_COLOR,
                                            GIZMO_INACTIVE_HANDLE_ALPHA)
                                        | COLLIDER_HANDLE_COLOR;
                                    drawParticleHandle(
                                        handles[i], i == active_handle,
                                        GIZMO_TRIANGLE, handle_color);
                                }
                            }
                        }
                        
                        // ---- 方向箭头（轴线段 + 箭头锥，沿主方向） ----
                        let (dir, len) = getParticleArrow(frame, emitter);
                        let arrow_scale = (len, len, len) as vec3;
                        let arrow_rot = gizmoEdgeRotation(dir);
                        let direction_active =
                            active_handle == PARTICLE_HANDLE_DIRECTION;
                        let arrow_color = direction_active
                            ? GIZMO_COLOR_HOVER
                            | (any_active
                                ? dimColor(
                                    PARTICLE_DIRECTION_GIZMO_COLOR,
                                    GIZMO_INACTIVE_HANDLE_ALPHA)
                                | PARTICLE_DIRECTION_GIZMO_COLOR);
                        drawSolid(
                            frame.0, arrow_rot, arrow_scale,
                            GIZMO_LINE_X, arrow_color);
                        drawSolid(
                            frame.0, arrow_rot, arrow_scale,
                            GIZMO_CONE_X, arrow_color);
                        drawParticleHandle(
                            frame.0 + dir * len,
                            direction_active,
                            DEFAULT_SQUARE_SHAPE,
                            PARTICLE_DIRECTION_GIZMO_COLOR);

                        // ---- 散布角环（过箭头尖端、垂直主方向） ----
                        let (ring, hp) = getParticleSpreadRing(
                            frame.0, dir, len, emitter.spread_angle->get);
                        let spread_active =
                            active_handle == PARTICLE_HANDLE_SPREAD;
                        let ring_color = spread_active
                            ? GIZMO_COLOR_HOVER
                            | (any_active
                                ? dimColor(
                                    PARTICLE_SPREAD_GIZMO_COLOR,
                                    GIZMO_INACTIVE_HANDLE_ALPHA)
                                | PARTICLE_SPREAD_GIZMO_COLOR);
                        for (let mut i = 0; i < ring->len; i += 1)
                            drawParticleEdge(
                                ring[i], ring[(i + 1) % ring->len], ring_color);
                        drawParticleHandle(
                            hp, spread_active, GIZMO_DIAMOND,
                            PARTICLE_SPREAD_GIZMO_COLOR);
                    }
                    return_value!;
                };
                return_value!;
            };
            
            return_value!;
        };
    }

    // 当前悬停手柄的屏幕说明：只在视口悬停（且未悬停工具栏）时显示。
    // 标签与激活层/手柄编号同源，便于区分层内相邻或重合的手柄。
    protected func drawGizmoHoverLabel(
        self: WorldEditorViewport,
        hovered: bool)=> void
    {
        if (!hovered)
            return;

        let mut label = "";
        if (self.m_gizmo_active_layer == GizmoLayer::ALL)
        {
            // 全部模式同一时刻只有一个层赢得悬停（按 粒子 > 光源 >
            // 碰撞体 > 变换 让位），标签取赢得悬停的那一层
            if (self.m_particle_hover_handle != GIZMO_HANDLE_NONE
                || self.m_particle_dragging)
                label = self->particleGizmoHandleLabel();
            else if (self.m_light_hover_handle != GIZMO_HANDLE_NONE
                || self.m_light_dragging)
                label = self->lightGizmoHandleLabel();
            else if (self.m_collider_hover_handle != GIZMO_HANDLE_NONE
                || self.m_collider_dragging)
                label = self->colliderGizmoHandleLabel();
            else
                label = self->transformGizmoHandleLabel();
        }
        else if (self.m_gizmo_active_layer == GizmoLayer::TRANSFORM)
            label = self->transformGizmoHandleLabel();
        else if (self.m_gizmo_active_layer == GizmoLayer::COLLIDER)
            label = self->colliderGizmoHandleLabel();
        else if (self.m_gizmo_active_layer == GizmoLayer::LIGHT2D)
            label = self->lightGizmoHandleLabel();
        else if (self.m_gizmo_active_layer == GizmoLayer::PARTICLE)
            label = self->particleGizmoHandleLabel();

        if (label == "")
            return;

        let mouse = GetMousePos();
        do GetWindowDrawList()->AddText(
            (mouse.0 + 14., mouse.1 - 20.),
            GIZMO_LABEL_COLOR,
            label);
    }
    
    // 绘制半透明的世界坐标网格，输入为覆盖整个屏幕的 NDC 四边形，
    // shader 内按像素重建视线再与网格平面求交；网格密度、颜色与距离
    // 衰减均在 shader 中定义。3D 模式铺在 XZ 地面（y=0，WorldGrid），
    // 2D（正交）模式立在 xOy 平面（z=0，WorldGrid2D）。
    // 视线重建与 towoo::ray::from 一致：直接把 Camera::Projection 的
    // 逆投影矩阵交给 shader，无需手动推算 tan半FOV / 正交可视半宽高。
    protected func drawWorldGrid(
        camera_entity: entity,
        camera_projection: Camera::Projection,
        rend_chain: command_buffer)=> void
    {
        do try!{
            try! camera_trans =
                camera_entity->towoo::get_component:<Transform::Translation>();
            try! shader_instance = isDebugCamera2DMode(camera_entity)
                ? WORLD_GRID_2D
                | WORLD_GRID;
            try! shape_instance = FULLSCREEN_NDC_QUAD;
            
            let rot = camera_trans->get_global_rot;
            let pos = camera_trans->get_global_pos;
            
            // 与 ray::from 的 orth 参数一致：无透视投影组件即按正交处理
            let is_ortho =
                camera_entity->towoo::get_component:<Camera::PerspectiveProjection>()->is_none;
                
            let right = rot * ((1., 0., 0.) as vec3);
            let up = rot * ((0., 1., 0.) as vec3);
            let forward = rot * ((0., 0., 1.) as vec3);
            
            let draw_action = rend_chain->draw(shader_instance, shape_instance);
            draw_action->set_uniform_mat4x4(
                shader_instance, "JE_GRID_INV_PROJ",
                camera_projection->get_inv_proj_mat as raw mat4);
            draw_action->set_uniform(shader_instance, "JE_GRID_IS_ORTHO", is_ortho ? 1. | 0.);
            draw_action->set_uniform(shader_instance, "JE_GRID_CAM_POS", (pos[0], pos[1], pos[2]));
            draw_action->set_uniform(shader_instance, "JE_GRID_CAM_RIGHT", (right[0], right[1], right[2]));
            draw_action->set_uniform(shader_instance, "JE_GRID_CAM_UP", (up[0], up[1], up[2]));
            draw_action->set_uniform(shader_instance, "JE_GRID_CAM_FORWARD", (forward[0], forward[1], forward[2]));
            return_value!;
        };
    }
}
