// 世界编辑器视口 —— 实体拾取与右键菜单。
// 渲染实体的射线拾取（循环选中）、实体图标 gizmo 的屏幕命中、
// 右键生命周期（点击 vs 拖拽分流）与实体上下文菜单，
// 以及选中状态/实体选择器的对外访问接口。

import woo::std;

import je;
import je::ecs;
import je::gui;
import je::internal;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::iterator;
import pkg::try;
import pkg::worst;

import builtin::editor::Editor::Action::DestroyEntity;
import builtin::editor::Editor::ComponentPresets;
import builtin::editor::Editor::EntityClipboard;

import Definition;
import CameraControl;
import GizmoMath;
import WindowLifecycle;

using std;

using je;
using je::gui;
using iterator;

using JEEditor::Editor::Action;
using JEEditor::Editor::ComponentPresets;
using JEEditor::Editor::EntityClipboard;

namespace JEEditor::Editor::WorldEditorViewport
{
    protected func sendMouseClickToChoiceEntityRequest(self: WorldEditorViewport, camera_ray: towoo::ray)
    {
        // 收集所有被射线命中的实体，并记录命中距离。
        let mut hits = []mut: vec<mut (real, entity::internal::euid_t)>;

        for (let e : self.m_selectable_entity_selector)
        {
            // 摄像机/2D 光源实体不参与渲染射线拾取（由图标 gizmo 的
            // 点击拾取负责）
            if (isCameraEntity(e) || isLight2DEntity(e))
                continue;

            let result = camera_ray->intersect(
                e->towoo::get_component:<Transform::Translation>->unwrap,
                e->towoo::get_component:<Renderer::Shape>,
                true,
            );

            if (result->is_value)
            {
                hits->add(mut (
                        (result->unwrap - camera_ray->origin)->length,
                        e->internal::get_entity_uid->or(0h as entity::internal::euid_t)));
            }
        }

        // 射线未命中任何实体：清空当前选中。
        if (hits->empty)
        {
            self.m_selected_entity_id = option::none;
            return;
        }

        // 按命中距离由近及远排序。
        sort_in_place(hits, \(da, _), (db, _) = da < db;);

        // 每次点击沿“由近及远”的顺序循环选中下一个实体；
        // 若当前选中实体不在本次命中列表中，则选中最近的实体。
        let mut next_index = 0;
        match (self.m_selected_entity_id)
        {
            value(current_uid)?
            {
                for (let mut i = 0; i < hits->len; i += 1)
                {
                    if (hits[i].1 == current_uid)
                    {
                        next_index = (i + 1) % hits->len;
                        break;
                    }
                }
            }
            none?;
        }
        self.m_selected_entity_id = option::value(hits[next_index].1);
    }

    // 右键点击的射线拾取：已选实体在命中列表中时保持其选中（右键作用于
    // 选中的实体，被部分遮挡时依然有效），否则选中最近的命中实体；
    // 未命中返回 none 且不改变当前选中（右键空白处不应清空选中）。
    protected func pickEntityForContextMenu(
        self: WorldEditorViewport,
        camera_ray: towoo::ray)=> option<entity::internal::euid_t>
    {
        let mut hits = []mut: vec<mut (real, entity::internal::euid_t)>;

        for (let e : self.m_selectable_entity_selector)
        {
            // 摄像机/2D 光源实体不参与渲染射线拾取（由图标 gizmo 的
            // 点击拾取负责）
            if (isCameraEntity(e) || isLight2DEntity(e))
                continue;

            let result = camera_ray->intersect(
                e->towoo::get_component:<Transform::Translation>->unwrap,
                e->towoo::get_component:<Renderer::Shape>,
                true,
            );

            if (result->is_value)
            {
                hits->add(mut (
                        (result->unwrap - camera_ray->origin)->length,
                        e->internal::get_entity_uid->or(0h as entity::internal::euid_t)));
            }
        }

        if (hits->empty)
            return option::none;

        // 按命中距离由近及远排序。
        sort_in_place(hits, \(da, _), (db, _) = da < db;);

        // 已选实体在命中列表中：菜单作用于它。
        match (self.m_selected_entity_id)
        {
            none?;
            value(current)?
            {
                for (let (_, euid) : hits)
                {
                    if (euid == current)
                        return option::value(current);
                }
            }
        }

        // 否则选中并作用于最近的命中实体。
        return option::value(hits[0].1);
    }

    // 鼠标位置命中的实体图标 gizmo（摄像机/2D 光源，返回实体 EUID）：
    // 命中按到图标中心的距离由近及远排序；cycle 为真时沿用实体拾取的
    // “循环选中下一个”规则，否则已选中的实体在命中列表中时保持其选中
    //（右键菜单语义）。
    protected func pickIconGizmo(
        self: WorldEditorViewport,
        mouse: vec2,
        cycle: bool)=> option<entity::internal::euid_t>
    {
        let mut hits = []mut: vec<mut (real, entity::internal::euid_t)>;

        for (let (euid, center, half) : self.m_icon_gizmo_rects)
        {
            let dist = (mouse - center)->length;
            if (dist <= half)
                hits->add(mut (dist, euid));
        }

        if (hits->empty)
            return option::none;

        // 按到图标中心的距离由近及远排序。
        sort_in_place(hits, \(da, _), (db, _) = da < db;);

        let mut next_index = 0;
        match (self.m_selected_entity_id)
        {
            none?;
            value(current)?
            {
                for (let mut i = 0; i < hits->len; i += 1)
                {
                    if (hits[i].1 == current)
                    {
                        next_index = cycle ? ((i + 1) % hits->len) | i;
                        break;
                    }
                }
            }
        }
        return option::value(hits[next_index].1);
    }

    // 每帧重建实体图标 gizmo（摄像机/2D 光源）的屏幕命中矩形
    //（Translation 位置投影到屏幕，半径 = 图标半边长 + 手柄命中余量）
    // 与悬停状态；位于调试摄像机身后的实体不参与命中。
    protected func updateIconGizmos(
        self: WorldEditorViewport,
        debug_camera: option<entity>,
        hovered: bool,
        viewport_rect: option<(ImVec2, ImVec2)>)=> void
    {
        self.m_icon_gizmo_rects->clear();
        self.m_icon_gizmo_hover = option::none;

        do try!{
            try! camera_entity = debug_camera;
            try! camera_trans =
                camera_entity->towoo::get_component:<Transform::Translation>();
            try! camera_proj =
                camera_entity->towoo::get_component:<Camera::Projection>();
            try! (rect_min, rect_max) = viewport_rect;

            let rmin = rect_min as vec2;
            let rsize = rect_max as vec2 - rect_min as vec2;
            if (rsize[0] <= 0. || rsize[1] <= 0.)
                return_value!;

            let view_proj = camera_proj->get_view_proj_mat;
            let cam_pos = camera_trans->get_global_pos;
            let cam_forward =
                camera_trans->get_global_rot * ((0., 0., 1.) as vec3);

            // 把选择器内全部实体的 Translation 位置登记为命中矩形，
            // icon_size_px 为对应图标的屏幕边长（像素）
            func addIconRects(selector: entity_selector, icon_size_px: real)=> void
            {
                for (let e : selector)
                {
                    do try!{
                        try! trans =
                            e->towoo::get_component:<Transform::Translation>();
                        try! euid = e->internal::get_entity_uid;

                        let pos = trans->get_global_pos;
                        if ((pos - cam_pos)->dot(cam_forward) <= 0.)
                            return_value!;

                        self.m_icon_gizmo_rects->add(mut (
                            euid,
                            gizmoWorldToScreen(view_proj, pos, rmin, rsize),
                            icon_size_px * 0.5 + GIZMO_HIT_PX));
                        return_value!;
                    };
                }
            }

            addIconRects(self.m_camera_entity_selector, CAMERA_GIZMO_ICON_SIZE_PX);
            addIconRects(self.m_point_light2d_entity_selector, LIGHT2D_GIZMO_ICON_SIZE_PX);
            addIconRects(self.m_range_light2d_entity_selector, LIGHT2D_GIZMO_ICON_SIZE_PX);
            addIconRects(self.m_parallel_light2d_entity_selector, LIGHT2D_GIZMO_ICON_SIZE_PX);

            if (hovered
                && !self.m_is_look_active
                && !self.m_is_pan_active
                && !self.m_is_orbit_active)
            {
                self.m_icon_gizmo_hover =
                    self->pickIconGizmo(GetMousePos() as vec2, false);
            }
            return_value!;
        };
    }

    // 视口右键的生命周期：记录按下起点（供环视的延迟激活使用，须先于
    // updateCameraControl 调用），并在松开时按位移分流——位移不超过
    // RMB_CLICK_MAX_DRAG_PX 视为点击：命中实体（渲染实体或摄像机/
    // 2D 光源图标）时选中该实体并在鼠标处弹出上下文菜单（内容与实体
    // 列表一致，见 drawEntityContextMenuItems）；点击空白处则弹出仅含
    // “粘贴”的菜单（run 中的 VIEWPORT_BLANK_CONTEXT_MENU_ID）。
    protected func updateViewportRightClick(
        self: WorldEditorViewport,
        debug_camera: option<entity>,
        hovered: bool,
        viewport_rect: option<(ImVec2, ImVec2)>)=> void
    {
        // 记录右键按下起点与“按下发生在视口内”标记。
        if (hovered && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Right))
        {
            self.m_rmb_press_pos = GetMousePos();
            self.m_rmb_press_in_viewport = true;
        }

        // 未在视口内按下 / 按住（环视）中：不处理。
        if (!self.m_rmb_press_in_viewport
            || IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Right))
            return;
        self.m_rmb_press_in_viewport = false;

        // 位移超过阈值：这是一次拖拽环视，不弹菜单。
        let drag = GetMousePos() as vec2 - self.m_rmb_press_pos as vec2;
        if (drag->length > RMB_CLICK_MAX_DRAG_PX)
            return;

        match (viewport_rect)
        {
            none?;
            value((rect_min, rect_max))?
            {
                do try!{
                    try! camera_entity = debug_camera;
                    try! trans = camera_entity->towoo::get_component:<Transform::Translation>();
                    try! proj = camera_entity->towoo::get_component:<Camera::Projection>();

                    // 摄像机/2D 光源实体：命中其图标 gizmo 时直接选中
                    //（右键菜单作用于它），不走渲染实体的射线拾取
                    match (self->pickIconGizmo(GetMousePos() as vec2, false))
                    {
                        value(icon_euid)?
                        {
                            self.m_selected_entity_id = option::value(icon_euid);
                            OpenPopup(VIEWPORT_ENTITY_CONTEXT_MENU_ID);
                        }
                        none?
                        {
                            let mouse_diff = GetMousePos() as vec2 - rect_min as vec2;
                            let viewport_size = rect_max as vec2 - rect_min as vec2;
                            let (vpx, vpy) =
                                ((mouse_diff / viewport_size) - (0.5, 0.5) as vec2) * 2.;

                            // 命中渲染实体：选中并弹实体菜单；未命中
                            //（空白处）：保持当前选中不变，弹出仅含
                            //“粘贴”的空白菜单
                            let picked_euid = self->pickEntityForContextMenu(
                                towoo::ray::from(
                                    trans, proj, (vpx, -vpy) as vec2,
                                    camera_entity->towoo::get_component:<Camera::PerspectiveProjection>->is_none));

                            match (picked_euid)
                            {
                                value(euid)?
                                {
                                    self.m_selected_entity_id = option::value(euid);
                                    OpenPopup(VIEWPORT_ENTITY_CONTEXT_MENU_ID);
                                }
                                none?
                                    OpenPopup(VIEWPORT_BLANK_CONTEXT_MENU_ID);
                            }
                        }
                    }

                    return_value!;
                };
            }
        }
    }

    // 实体右键菜单内容（视口与实体列表共用，两处由各自的弹出逻辑调用）。
    // paste_at_camera_front：菜单中“粘贴”是否把实体生成在调试摄像机
    // 前方——视口内调用传 true；实体列表保持快照原位置行为传 false
    public func drawEntityContextMenuItems(
        self: WorldEditorViewport,
        e: entity,
        paste_at_camera_front: bool)=> void
    {
        // 常用组件组合子菜单：点击即把该组合内实体缺少的组件整组添加
        if (BeginMenu("添加常用组件"))
        {
            ComponentPresets::showAddPresetMenu(self, e);
            defer EndMenu();
        }

        // 复制实体到剪贴板（快照不含 EUID），可在各处空白区域粘贴出
        // 拥有全新 EUID 的新实体；粘贴出的新实体与本实体没有关联，
        // 菜单放在这里只是提供入口
        if (MenuItem("复制"))
            EntityClipboard::copy(e);

        let mut paste_spawn_pos = option::none: option<vec3>;
        if (paste_at_camera_front)
            paste_spawn_pos = self->getSpawnPosInFrontOfCamera();
        EntityClipboard::showPasteMenuItemAt(self, paste_spawn_pos);

        if (MenuItem("销毁"))
        {
            // 使用 Action 机制发布销毁实体的指令
            self->doAction(DestroyEntity::try_create(e)->unwrap);
        }
    }

    protected func findEntityByEuid(
        self: WorldEditorViewport, euid: entity::internal::euid_t)=> option<entity>
    {
        for (let e : self.m_selectable_entity_selector)
        {
            match (e->internal::get_entity_uid)
            {
                none?;
                value(entity_uid)?
                    if (entity_uid == euid)
                        return option::value(e);
            }
        }
        return option::none;
    }

    // 按调试 EUID 在“全部实体”（实体列表所见范围，不含 Editor::Invisible）
    // 中反查实体；视口已关闭时返回 none。与 findEntityByEuid（可拾取实体
    // 范围）不同：供预设体保存这类以实体列表为出发点的流程在跨帧后
    // 重新取得实体实例（entity 句柄不允许跨帧持有）。
    public func findListedEntityByEuid(
        self: WorldEditorViewport, euid: entity::internal::euid_t)=> option<entity>
    {
        if (!self->isCurrentViewportAvailable)
            return option::none;

        for (let e : self.m_all_entity_selector)
        {
            match (e->internal::get_entity_uid)
            {
                none?;
                value(entity_uid)?
                    if (entity_uid == euid)
                        return option::value(e);
            }
        }
        return option::none;
    }

    // 把世界坐标换算为实体的局部坐标（LocalPosition 空间）。
    // 没挂 LocalToParent 时实体即变换根，局部坐标就是世界坐标，原样返回；
    // 挂了 LocalToParent 的实体：其 parent_uid 指向父的 Anchor.uid，在
    // 锚点父实体选择器（Translation+Anchor）里按 uid 反查父实体，用父
    // Translation 缓存的世界变换（存活实体由变换系统逐帧级联合成，含
    // 祖先链）按合成公式 world = parent_rot * local + parent_pos 逆解：
    // local = parent_rot⁻¹ * (world - parent_pos)；位置合成不传递缩放
    //（translation system 的约定），无需考虑父的 scale。
    // 不能用 Translation::set_global_pos——它靠实体自身的旧世界变换
    // 反推父变换，刚创建的实体还没有。
    // 挂了父但父不在这世界里（锚点反查不到，如跨世界粘贴；此时变换
    // 系统对其 Translation 停止更新）时返回 none：局部空间无从确定，
    // 由调用方保持数据原值。
    public func worldToLocalPos(
        self: WorldEditorViewport,
        e: entity,
        world_pos: vec3)=> option<vec3>
    {
        match (e->towoo::get_component:<Transform::LocalToParent>)
        {
            // 无父：局部坐标即世界坐标
            none?
                return option::value(world_pos);
            value(l2p)?
                return or(option::none: option<vec3>) <| try!{
                    // member 取值是直接量（非 option），uuid 为 string 别名
                    let parent_uid = l2p.parent_uid->get;

                    // 反查锚点 uid 匹配的父实体；父必然挂 Translation
                    //（无 Translation 的锚点实体无法参与变换系统解析），
                    // 选择器已保证
                    try! parent = (self.m_anchor_parent_entity_selector->iter
                        |> filter(\p = p->towoo::get_component:<Transform::Anchor>
                            ->unwrap.uid->get == parent_uid;)
                        |> collect->get(0));
                    try! parent_trans =
                        parent->towoo::get_component:<Transform::Translation>();

                    return_value! option::value(
                        parent_trans->get_global_rot->inverse
                            * (world_pos - parent_trans->get_global_pos));
                };
        }
    }

    // 按父锚点 uid 反查挂它的实体（即 uid 主人的父实体）：遍历锚点父
    // 实体选择器（Translation+Anchor，含编辑器内部实体——与变换系统
    // 的锚点解析范围一致）。供 worldToLocalPos、挂接防环
    //（isAncestorOf）等使用。
    public func findEntityByAnchorUid(
        self: WorldEditorViewport, anchor_uid_to_find: string)=> option<entity>
    {
        for (let e : self.m_anchor_parent_entity_selector)
        {
            match (e->internal::get_anchor_uid)
            {
                none?;
                value(entity_anchor_uid)?
                    if (entity_anchor_uid == anchor_uid_to_find)
                        return option::value(e);
            }
        }
        return option::none;
    }

    // 判断 ancestor 是否为 e 的祖先（沿 e 的父链向上走，不含 e 自身；
    // 链断——某层父的锚点反查不到——即止，与变换系统“父缺失则停更”
    // 的口径一致）。步数上限仅防御坏数据父链成环（正常挂接经
    // AttachEntity 防环不会成环）。
    public func isAncestorOf(
        self: WorldEditorViewport, ancestor: entity, e: entity)=> bool
    {
        let mut current = e;
        for (let mut i = 0; i < 100000; i += 1)
        {
            match (current->internal::get_parent_anchor_uid)
            {
                // 没挂 LocalToParent：到根了
                none?
                    return false;
                value(parent_uid)?
                    match (self->findEntityByAnchorUid(parent_uid))
                    {
                        // 父锚点找不到主人：链断
                        none?
                            return false;
                        value(parent)?
                        {
                            if (std::is_same(parent, ancestor))
                                return true;
                            current = parent;
                        }
                    }
            }
        }
        return false;
    }

    // ==========================

    public func getEntitySelector(self: WorldEditorViewport)
    {
        return self.m_all_entity_selector;
    }

    public func getSelectedEntityId(self: WorldEditorViewport)
    {
        return self.m_selected_entity_id;
    }

    public func setSelectedEntityId(self: WorldEditorViewport, id: option<entity::internal::euid_t>)=> void
    {
        self.m_selected_entity_id = id;
    }
}
