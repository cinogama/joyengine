// 世界编辑器视口 —— 世界保存/重命名/重开与调试系统管理。
// 世界落盘（saveWorldTo 是编辑器中唯一入口）、另存为流程、重命名/
// 路径重定向的“重建窗口”逻辑，以及“调试执行/导出时才启用”的
// 运行时系统列表管理。

import pkg::std;

import je;
import je::ecs;
import je::gui;
import je::internal;
import je::typeinfo;
import je::audio;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::fsys;
import pkg::interface;
import pkg::toml;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;
import builtin::editor::GUI::Forms::AskBox;
import builtin::editor::GUI::Statebar;

import builtin::editor::Editor::Saving::World;
import builtin::editor::Editor::Practice;
import builtin::editor::Editor::Project;
import builtin::editor::Editor::DebugRun;
import builtin::editor::Editor::ResourcePath;

import Definition;
import WindowLifecycle;
import EditorState;

using std;

using je;
using je::gui;
using fsys;

using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Forms;
using JEEditor::GUI::Statebar;

namespace JEEditor::Editor::WorldEditorViewport
{
    // ==========================
    //  系统管理
    // ==========================

    public func getRuntimeSystems(self: WorldEditorViewport)=> array<typeinfo>
    {
        return self.m_runtime_systems->to_array();
    }

    // 系统是否已通过 add_system 加入世界（立即启用，编辑器内正在运行）；
    // 以类型名比较，避免类型热重载后 typeinfo 句柄不一致。
    public func hasWorldSystem(self: WorldEditorViewport, systype: typeinfo)=> bool
    {
        for (let added : self.m_world_instance->internal::get_all_systems)
        {
            if (added->name == systype->name)
                return true;
        }
        return false;
    }

    // 系统是否在“调试执行/导出时才启用”的列表中
    public func hasRuntimeSystem(self: WorldEditorViewport, systype: typeinfo)=> bool
    {
        for (let added : self.m_runtime_systems)
        {
            if (added->name == systype->name)
                return true;
        }
        return false;
    }

    // 添加一个“调试执行/导出时才启用”的系统；已存在时保持不变（幂等）
    public func addRuntimeSystem(self: WorldEditorViewport, systype: typeinfo)=> void
    {
        if (self->hasRuntimeSystem(systype))
            return;
        self.m_runtime_systems->add(systype);
    }

    // 移除一个“调试执行/导出时才启用”的系统；不存在时保持不变（幂等）
    public func removeRuntimeSystem(self: WorldEditorViewport, systype: typeinfo)=> void
    {
        let remaining = self.m_runtime_systems->to_array()
            ->forall(\added = added->name != systype->name;);

        self.m_runtime_systems->clear();
        for (let added : remaining)
            self.m_runtime_systems->add(added);
    }

    // 把“调试执行/导出时才启用”的系统加入当前世界执行（开始调试运行
    // 流程第 ③ 步；世界此刻应处于暂停态，恢复运行由 DebugRun 的协程进行）
    public func addRuntimeSystemsToWorld(self: WorldEditorViewport)=> void
    {
        for (let systype : self.m_runtime_systems)
            do self.m_world_instance->add_system(systype);
    }

    public func getName(self: WorldEditorViewport)=> string
    {
        return self.m_name;
    }

    public func getSavingPath(self: WorldEditorViewport)=> option<path_t>
    {
        return self.m_saving_path;
    }

    // ==========================
    //  世界缓存路径（World::Path）
    // ==========================

    // 世界文件对应的派生缓存路径：世界级缓存固定为 <world>.je4cache，
    // 以运行时资源路径（@/...）形式交给 World::Path 组件（导出后可经镜像解析）。
    public func worldCachePathForSaving(path: path_t)=> string
    {
        return ResourcePath::toRuntimeResourcePath(path) + ".je4cache";
    }

    // 更新世界内已有 World::Path 实体指向的缓存路径（世界改名/另存后）；
    // 不存在时不创建。返回是否找到并更新。
    public func syncWorldPath(w: world, cache_path: string)=> bool
    {
        let mut updated = false;

        for (let e : w->internal::get_all_entities())
        {
            match (e->towoo::get_component:<World::Path>())
            {
                none?;
                value(c)?
                {
                    updated = true;
                    do c.cache_path->set(cache_path);
                }
            }
        }

        return updated;
    }

    // 保证世界内存在指向 world_path 对应缓存的 World::Path 实体：已有则
    // 更新，没有则新建。该实体是编辑器/引擎内部实体（带 Editor::Invisible，
    // 不显示在实体列表、不随世界存档）：缓存路径属于世界文件的派生信息，
    // 加载世界时创建；缓存不存在/不使用缓存时由音频等子系统自行回退。
    public func ensureWorldPathComponent(w: world, world_path: path_t)=> bool
    {
        let cache_path = worldCachePathForSaving(world_path);

        for (let e : w->internal::get_all_entities())
        {
            match (e->towoo::get_component:<World::Path>())
            {
                none?;
                value(c)?
                {
                    do c.cache_path->set(cache_path);
                    return true;
                }
            }
        }

        match (w->add_entity([
                World::Path::type::typeinfo,
                Editor::Invisible::type::typeinfo,
            ]))
        {
            none?
            {
                logerr("Failed to create World::Path entity.");
                return false;
            }
            value(e)?
            {
                do e->internal::set_name("WorldPath");
                do e->towoo::get_component:<World::Path>()
                    ->unwrap.cache_path->set(cache_path);

                // 实体随下一次世界更新落实；烘焙后的重载发生在其后，
                // 因此音频系统能读到该实体
                return true;
            }
        }
    }

    // 世界加载/重建时创建/更新 World::Path 内部实体。不判断缓存是否存在：
    // 缓存读取交给各子系统（音频侧由 je_cache_file_load 判定并在缺失时回退）。
    public func attachWorldPath(w: world, world_path: option<path_t>)=> void
    {
        match (world_path)
        {
            none?;
            value(p)?
                do ensureWorldPathComponent(w, p);
        }
    }

    // 把世界序列化并写入 path；失败时弹错误对话框并返回 false。
    // 编辑器中世界落盘的唯一入口。
    public func saveWorldTo(self: WorldEditorViewport, path: path_t)=> bool
    {
        // 运行期临时视口不提供保存：其编辑属于运行期临场调整，随停止
        // 运行一并丢弃
        if (self.m_is_runtime_editing)
            return false;

        // 冻结期间世界已暂停等待重建，不应落盘（Ctrl+S 等入口由此拦截）；
        // 调试运行（含停止过渡）期间同样不落盘：运行中的世界状态属于
        // 游戏逻辑，不应覆盖编辑现场
        if (isWorldsFrozen() || DebugRun::isDebugRunActive())
            return false;

        // 世界可能另存/重命名到新路径：已有的 World::Path 内部实体先指向
        // 本次落盘路径对应的缓存（该实体不存档，缓存路径只是运行时状态）
        do syncWorldPath(
            self.m_world_instance, worldCachePathForSaving(path));

        match (toml::save(
                JEEditor::Saving::World::save(
                    self.m_world_instance, self.m_name,
                    self->getRuntimeSystems(), false), path))
        {
            err(msg)?
            {
                MsgBox::err(
                    "保存失败", F"保存世界到 \"{path->to_string()}\" 失败：{msg}");
                return false;
            }
            ok(_)?
            {
                // 已落盘：清除编辑历史的未保存标记（见 Practice::markSaved）
                self.m_action_history->markSaved();

                // 世界级缓存以世界文件 CRC 为键：落盘后旧缓存已失效，
                // 通知音频系统重新读取缓存/回退实时环境
                je::audio::environment::reload(self.m_world_instance);

                // 在独立作用域中先取出字符串：闭包按创建时的值捕获文本，
                // 之后每帧由 Statebar 调用绘制保存成功提示。
                let name = self.m_name;
                let path_str = path->to_string();
                Statebar::showState(3.) <| func(){
                    Text(F"世界 \"{name}\" 已保存到 \"{path_str}\"");
                };
                return true;
            }
        }
    }

    // 快捷键保存（Ctrl+S）：已保存过的世界直接写回原路径；
    // 尚未保存过的世界没有目标目录，提示改用拖拽图标到资源管理器的保存流程。
    protected func saveByShortcut(self: WorldEditorViewport)=> void
    {
        // 运行期临时视口不支持保存：编辑内容随停止运行一并丢弃
        if (self.m_is_runtime_editing)
        {
            MsgBox::msg(
                "保存", "调试运行的临时视口不支持保存，编辑内容随停止运行丢弃");
            return;
        }

        match (self.m_saving_path)
        {
            value(path)?
                do self->saveWorldTo(path);
            none?
                MsgBox::msg(
                    "保存",
                    F"世界 \"{self.m_name}\" 尚未保存到文件中，请拖动视口顶部的图标到资源管理器以保存");
        }
    }

    // 保存全部（主菜单“文件”→“保存全部”）：把所有已保存到文件的世界
    // 视口写回原路径，每个世界的成功提示/错误对话框由 saveWorldTo 负责。
    // 尚未保存到文件的世界没有目标路径，无法自动落盘，弹窗列出名称提示
    // 改用拖拽视口顶部图标的保存流程；运行期临时视口没有保存语义，不参与。
    public func saveAllWorlds()=> void
    {
        let unsaved_names = []mut: vec<string>;

        for (let viewport : getAllViewports())
        {
            // 运行期临时视口：编辑内容随停止运行丢弃，没有保存入口
            if (viewport.m_is_runtime_editing)
                continue;

            match (viewport->getSavingPath())
            {
                value(path)?
                    do viewport->saveWorldTo(path);
                none?
                    unsaved_names->add(viewport->getName());
            }
        }

        if (unsaved_names->len == 0)
            return;

        let mut unsaved_list = "";
        for (let name : unsaved_names)
            unsaved_list += F"\n  {name}";

        MsgBox::msg(
            "保存全部",
            F"以下世界尚未保存到文件中，请拖动其视口顶部的图标到资源管理器以保存：{unsaved_list}");
    }

    // saveAllWorlds 的可失败版本：保存所有有路径的视口，任一保存失败
    // 返回 false（无路径的新世界不参与，导出扫描本身只包含已保存文件）。
    public func saveAllWorldsChecked()=> bool
    {
        for (let viewport : getAllViewports())
        {
            if (viewport.m_is_runtime_editing)
                continue;

            match (viewport->getSavingPath())
            {
                none?;
                value(path)?
                {
                    if (!viewport->saveWorldTo(path))
                        return false;
                }
            }
        }
        return true;
    }

    // 主菜单“文件 → 保存”入口：保存当前聚焦的世界视口（与视口内
    // Ctrl+S 的行为一致；未聚焦任何视口时提示）。
    public func saveFocusedWorld()=> void
    {
        match (getLastFocused())
        {
            none?
                MsgBox::msg("保存", "当前没有聚焦的世界视口");
            value(viewport)?
                viewport->saveByShortcut();
        }
    }

    // 手动烘焙当前视口世界的音频环境（写入 <world>.je4cache 的
    // audio_environment）。房间由 Audio::ReverbZone 表示，门洞由
    // Audio::Portal 表示；不读取 tilemap。
    public func bakeAudioEnvironment(self: WorldEditorViewport)=> void
    {
        if (self.m_is_runtime_editing)
        {
            MsgBox::msg("烘焙音频环境", "调试运行的临时视口不支持烘焙");
            return;
        }

        if (isWorldsFrozen() || DebugRun::isDebugRunActive())
        {
            MsgBox::err(
                "烘焙音频环境", "当前正处于调试运行或冻结状态，请先结束运行");
            return;
        }

        match (self->getSavingPath())
        {
            none?
                MsgBox::err(
                    "烘焙音频环境",
                    "请先保存世界：音频环境会写入 <世界文件>.je4cache");
            value(path)?
            {
                // World::Path 实体是内部实体（不存档）：烘焙前保证它存在并
                // 指向 <world>.je4cache，烘焙后的重载才能读到新缓存
                if (!ensureWorldPathComponent(
                        self.m_world_instance, path))
                {
                    MsgBox::err("烘焙音频环境", "无法创建 World::Path 实体");
                    return;
                }

                // sidecar 以世界文件 CRC 为键，先落盘保证两者一致
                if (!self->saveWorldTo(path))
                    return;

                if (je::audio::environment::bake(
                        self.m_world_instance, path->to_string()))
                {
                    Statebar::showState(3.) <| func(){
                        Text("音频环境已烘焙");
                    };
                }
                else
                    MsgBox::err("烘焙音频环境", "烘焙失败，请查看日志");
            }
        }
    }

    // 主菜单“工具 → 烘焙当前世界音频环境”入口
    public func bakeFocusedWorld()=> void
    {
        match (getLastFocused())
        {
            none?
                MsgBox::msg("烘焙音频环境", "当前没有聚焦的世界视口");
            value(viewport)?
                viewport->bakeAudioEnvironment();
        }
    }

    // 以新的名称/保存路径重建本视口（沿用当前世界实例与未保存的修改）。
    // 重建成功时把编辑历史（m_action_history）迁移到新视口以保持撤销/重做连续，
    // 再以 CLOSE_BUT_KEEP_WORLD 关闭旧视口；窗口创建失败时返回 false。
    protected func reopenWith(
        self: WorldEditorViewport,
        new_name: string,
        new_path: option<path_t>)=> bool
    {
        // 运行期临时视口不支持重命名/另存/路径重定向（重建窗口无意义）
        if (self.m_is_runtime_editing)
            return false;

        // 冻结期间不允许重建窗口（重命名/另存/路径重定向一并失败），
        // 待解冻后重试；调试运行（含停止过渡）期间同样不允许
        if (isWorldsFrozen() || DebugRun::isDebugRunActive())
            return false;

        // 重命名/另存/路径重定向后，World::Path 内部实体按新路径同步：
        // 资源管理器重命名世界文件时会一并移动 <world>.je4cache，
        // 再让音频系统按新路径重新读取缓存（缓存缺失时自行回退实时环境）
        match (new_path)
        {
            value(p)?
            {
                do attachWorldPath(
                    self.m_world_instance, option::value(p));
                je::audio::environment::reload(self.m_world_instance);
            }
            none?;
        }
            
        // 重建窗口沿用当前世界实例与未保存的修改；同时把编辑器状态
        //（摄像机位姿/编辑模式）搬到新视口，避免重命名/另存后视角与模式复位
        let new_viewport = create(
            self.m_world_instance, new_name, new_path, self->getRuntimeSystems(),
            option::value(self->dumpEditorStateToml()));

        // 在尝试重新打开之前，暂时先从 Project 中移除这个窗口
        do self.m_saving_path->> \p = Project::worldClose(p);;

        match (Windows::show(new_viewport))
        {
            none?
            {
                // 重命名失败了，重新加回来
                do self.m_saving_path->> \p = Project::worldOpen(p);;
                return false;
            }
            value(_)?
            {
                new_viewport.m_action_history = self.m_action_history;
                self.m_close = CloseRequest::CLOSE_BUT_KEEP_WORLD;
                return true;
            }
        }
    }

    public func dropAndRename(self: WorldEditorViewport, new_name: string)=> void
    {
        if (self->isCurrentViewportAvailable && self.m_name != new_name)
        {
            if (!self->reopenWith(new_name, self.m_saving_path))
            {
                MsgBox::err(
                    "重命名失败", "重命名世界失败，存在同名的未保存世界");

                if (!self.m_saving_path->is_none)
                    // 这种情况通常情况下不应该发生
                    logerr("Failed to rename world: duplicated opened world?");
            }
        }
    }

    // 保存世界成功后，以新的保存路径重开本视口（沿用重命名的“重建窗口”逻辑），
    // 使窗口标题中的保存路径立即生效。
    public func dropAndSaveAs(self: WorldEditorViewport, new_path: path_t)=> void
    {
        if (self->isCurrentViewportAvailable && self.m_saving_path->is_none)
        {
            if (!self->reopenWith(self.m_name, option::value(new_path)))
                MsgBox::err(
                    "保存失败", "世界已写入文件，但以新的保存路径重开视口失败：存在使用该路径的世界视口");
        }
    }

    // 资源管理器中重命名世界文件后调用：把视口的保存路径重定向到新路径。
    // 沿用首次保存的“重建窗口”逻辑（保留世界实例、未保存的修改与编辑历史），
    // 关闭旧视口并以新路径重开，确保窗口标题与后续保存路径立即匹配重命名后的文件。
    public func dropAndRetargetPath(self: WorldEditorViewport, new_path: path_t)=> void
    {
        if (!self->isCurrentViewportAvailable)
            return;

        match (self.m_saving_path)
        {
            none?;
            value(old_path)?
            {
                // 名称未变化时无需重开视口（窗口标题不会改变）
                if (old_path == new_path)
                    return;

                if (!self->reopenWith(self.m_name, option::value(new_path)))
                    MsgBox::err(
                        "重命名失败", "文件已重命名，但以新路径重开视口失败：存在使用该路径的世界视口");
            }
        }
    }

    // 另存为流程（原资源管理器 requestSaveWorld）：弹输入框要文件名 →
    // 已存在则确认覆盖 → 写盘 → 以新保存路径重开视口。
    // on_saved 在写盘成功后回调（供资源管理器刷新文件缓存）。
    public func requestSaveAs(
        self: WorldEditorViewport, target_dir: path_t, on_saved: ()=> void)=> void
    {
        func saveTo(dst: path_t)=> void
        {
            // 对话框等待期间视口可能已被关闭
            if (!self->isCurrentViewportAvailable)
                return;

            if (self->saveWorldTo(dst))
            {
                do on_saved();
                self->dropAndSaveAs(dst);
            }
        }

        func saveWorldAs(file_name: string)=> void
        {
            if (file_name->len == 0)
            {
                MsgBox::err("保存失败", "文件名不能为空");
                return;
            }

            // 未带后缀时自动补全 .je4world
            let full_name = file_name->end_with(".je4world")
                ? file_name
                | F"{file_name}.je4world";

            let dst = target_dir / full_name;

            if (isfile(dst))
            {
                // 已存在同名文件时弹出覆盖确认
                do AskBox::show(
                        "保存", F"目录中已存在 \"{full_name}\"，确认覆盖吗？")
                    ->onYes(\= saveTo(dst););
            }
            else
                saveTo(dst);
        }

        do InputBox::show(
                "保存世界", "请输入保存的文件名：", F"{self.m_name}.je4world")
            ->then(saveWorldAs);
    }

    public func getWorld(self: WorldEditorViewport)=> world
    {
        return self.m_world_instance;
    }
}
