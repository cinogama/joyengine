// 世界编辑器视口 —— 所有世界的冻结/恢复。
// 用于需要在“世界不被步进”的前提下执行的场合（例如重载原生模块）：
// 先进入冻结（锁定）状态使所有视口创建操作失败，从 universe 枚举所有
// 世界，把各自的世界快照与编辑器上下文（有视口的附带，无视口的仅世界
// 数据）存入 SavedEditorWorldContext 单例的 m_frozen_saved 槽位，暂停所有
// 世界实例（保留不关闭），关闭全部视口窗口，再执行 job，最后用快照重建
// 世界、为有编辑器上下文的条目重建视口窗口并解除冻结。
//
// 快照带 eid（save 的 save_eid 传 true）：重建后实体沿用原调试 EUID，
// 编辑历史（撤销/重做）与选中态迁移到重建的视口上依然有效。
// 调试摄像机带 Editor::Invisible，不被存档，重建视口的世界经
// ensureDebugCamera 重建；其位姿与视口编辑模式经 dumpEditorStateToml
// 跨冻结保留。
//
// 快照的采集（collectAllWorldSavedContexts）与世界的重建
//（rebuildWorldsFromSavedEntries）同时服务于调试运行（DebugRun）：
// 两者各持 SavedEditorWorldContext 的一个独立槽位（m_frozen_saved /
// m_play_saved），互不覆盖——调试运行期间模块/ToWoo 依然会经本文件的
// 冻结机制更新世界。
//
// 冻结/恢复的实际工作在协程中进行：世界关闭后实际销毁在下一个逻辑
// 更新生效，须让出帧再重建（避免新旧世界短暂共存导致 eid 撞号）；
// 期间 isWorldsFrozen / isWorldsFrozenEngaged 保持守卫（见 Definition）。

import pkg::std;

import je;
import je::ecs;
import je::gui;
import je::typeinfo;

import pkg::toml;

import builtin::editor::GUI::Windows;

import builtin::editor::Editor::Saving::World;
import builtin::editor::Editor::DebugRun;
import builtin::editor::Editor::Project;

import builtin::editor::Singleton;
import builtin::editor::Singleton::Universe;

import Definition;
import WindowLifecycle;
import WorldOpen;
import WorldSaving;
import EditorState;
import SavedEditorWorldContext;

using std;
using je;
using je::gui;
using toml;

using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::Singleton;

namespace JEEditor::Editor::WorldEditorViewport
{
    // ==========================
    //  快照采集
    // ==========================

    // 采集视口世界的已保存上下文：世界快照（save_eid = true，保住实体
    // EUID 以延续选中态与编辑历史）与编辑器上下文（重建视口所需的全部
    // 状态）。冻结（freezeAllWorlds）与调试运行（DebugRun）共用此入口。
    public func dumpWorldSavedContext(self: WorldEditorViewport)=> WorldSavedContext
    {
        return WorldSavedContext{
            m_world_data = JEEditor::Saving::World::save(
                self.m_world_instance,
                self.m_name,
                self->getRuntimeSystems(),
                true),

            m_editor = option::value(EditorContext{
                m_editor_state = self->dumpEditorStateToml(),
                m_saving_path = self.m_saving_path,
                m_action_history = self.m_action_history,
                m_selected_entity_id = self.m_selected_entity_id,
            }),
        };
    }

    // 采集无对应视口世界的已保存上下文：仅世界快照（此类世界的系统均已
    // add_system 加入世界，随快照的 "systems" 一并保存与恢复；name 对
    // 恢复端无意义，置空）
    func dumpBareWorldSavedContext(w: world)=> WorldSavedContext
    {
        return WorldSavedContext{
            m_world_data = JEEditor::Saving::World::save(w, "", [], true),
            m_editor = option::none,
        };
    }

    // 从 universe 枚举所有世界采集快照条目：有对应视口的世界附带编辑器
    // 上下文，无视口的仅世界数据。返回 (条目数组, 聚焦视口所在条目下标)。
    func collectAllWorldSavedContexts()=> (array<WorldSavedContext>, option<int>)
    {
        let saved = []mut: vec<WorldSavedContext>;
        let mut focused_index = option::none: option<int>;

        for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
        {
            match (findWorldEditorViewport(w))
            {
                value(vp)?
                {
                    match (s_last_focusd_world_view)
                    {
                        value(focused)?
                            if (std::is_same(focused, vp))
                                focused_index = option::value(saved->len);
                        none?;
                    }
                    saved->add(vp->dumpWorldSavedContext());
                }
                none?
                    saved->add(dumpBareWorldSavedContext(w));
            }
        }

        return (saved->to_array, focused_index);
    }

    // ==========================
    //  冻结 / 恢复
    // ==========================

    // 关闭全部世界视口窗口（保留各世界实例不关闭）：先从注册表移除并从
    // Project 的已打开世界记账移除（重建视口时 onCreate 会重新登记，避免
    // 其 map insert 断言失败），再以 CLOSE_BUT_KEEP_WORLD 请求程序化关闭。
    // 窗口须在非沉浸的一帧里泵到 run 才会真正关闭（调用方负责时序，见
    // DebugRun::startDebugRun）。
    public func closeAllViewportWindows()=> void
    {
        for (let vp : getAllViewports())
        {
            do s_world_viewports->remove(vp.m_world_instance);
            do vp.m_saving_path->> \p = Project::worldClose(p);;
            vp.m_close = CloseRequest::CLOSE_BUT_KEEP_WORLD;
        }
        s_last_focusd_world_view = option::none;
    }

    // 冻结生效的实际工作（协程体，不含让出帧）：采集快照入 m_frozen_saved、
    // 暂停所有世界实例（保留不关闭：模块重载期间不可继续步进）、关闭全部
    // 视口窗口
    func engageAllWorldsFreeze()=> void
    {
        let (saved, focused_index) = collectAllWorldSavedContexts();
        s_frozen_last_focused_index = focused_index;

        Singleton::apply:<SavedEditorWorldContext>(
            func(s){
                if (s.m_frozen_saved->is_value)
                    logerr("engageAllWorldsFreeze: m_frozen_saved 槽位非空，旧快照被覆盖");
                s.m_frozen_saved = option::value(saved);
            });

        for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
            do w->set_enable(false);

        closeAllViewportWindows();
    }

    // 启动冻结协程：等待恢复过渡与停止运行过渡结束后再执行冻结工作。
    // 停止运行过渡期间世界正处于关闭/重建中，不能采集；而停止流程等待的
    // 是“冻结已生效”（isWorldsFrozenEngaged），此处的等待不会与其互锁。
    func launchFreezeEngagement()=> void
    {
        s_worlds_freeze_in_progress = true;
        launch_coroutine(func(){
                while (s_worlds_restore_in_progress)
                    yield();

                while (DebugRun::isDebugRunActive() && !DebugRun::isDebugRunning())
                    yield();

                engageAllWorldsFreeze();

                s_worlds_freeze_in_progress = false;
                s_worlds_frozen_engaged = true;
            });
    }

    // 进入冻结状态并冻结所有世界（由 FreezeWorldsTodo::onCreate 调用）。
    // isWorldsFrozen 立即为真（计数先行）；实际采集在冻结协程中进行，
    // FreezeWorldsTodo 的 job 线程经 isWorldsFreezeTransitionInProgress
    // 等待其完成后再启动。
    public func freezeAllWorlds()=> void
    {
        s_worlds_frozen += 1;
        if (s_worlds_frozen > 1)
            return;

        launchFreezeEngagement();
    }

    // 引用计数 -1；仅最后一次调用（计数 1→0）启动恢复协程，嵌套恢复到此
    // 才真正生效。恢复协程期间 isWorldsFrozen 经恢复过渡标志保持为真，
    // 直至世界与视口重建完成。
    public func restoreAllWorlds()=> void
    {
        if (s_worlds_frozen == 0)
        {
            logerr("restoreAllWorlds: 冻结计数已为 0，忽略多余的恢复请求");
            return;
        }

        s_worlds_frozen -= 1;
        if (s_worlds_frozen > 0)
            return;

        s_worlds_restore_in_progress = true;
        launch_coroutine(func(){
                // 注意此处不等待 s_worlds_freeze_in_progress：恢复期间到来的
                // 新冻结请求恰以其为等待条件，互相等待会死锁。恢复仅由
                // FreezeWorldsTodo::onClose 触发，模态窗口至少存活 5+ 帧
                //（等待帧数 + job），采集 1~2 帧内完成，受理中的冻结不可能
                // 撞上恢复启动
                //
                // 关闭现存所有世界（模块重载后的旧实例已陈旧；实际销毁在
                // 下一逻辑更新生效，让出帧后再重建，避免新旧世界短暂共存
                // 导致 eid 撞号）
                for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
                    do w->close;
                yield();

                // 先在单例锁内取出快照条目并清空槽位，锁外再重建：
                // 重建会访问 universe / 窗口系统等其他单例，嵌套 apply
                // 会触发 singleton 包的锁序检查
                let entries = mutable::create(
                    option::none: option<array<WorldSavedContext>>);
                Singleton::apply:<SavedEditorWorldContext>(
                    func(saved){
                        match (saved.m_frozen_saved)
                        {
                            none?
                                logerr("restoreAllWorlds: m_frozen_saved 槽位为空，无世界可恢复");
                            value(saved_entries)?
                                entries->set(option::value(saved_entries));
                        }
                        saved.m_frozen_saved = option::none;
                    });

                let mut focused = option::none: option<WorldEditorViewport>;
                match (entries->get)
                {
                    value(saved_entries)?
                        focused = rebuildWorldsFromSavedEntries(
                            saved_entries, s_frozen_last_focused_index);
                    none?;
                }
                s_frozen_last_focused_index = option::none;
                s_last_focusd_world_view = focused;

                s_worlds_frozen_engaged = false;
                s_worlds_restore_in_progress = false;
            });
    }

    // ==========================
    //  调试运行（DebugRun）侧支持
    // ==========================

    // 开始调试运行：把当前宇宙所有世界的上下文（有视口的带编辑器上下文）
    // 存入 SavedEditorWorldContext 的 m_play_saved 槽位并记录聚焦条目。
    // 各视口“调试执行”系统的加入、世界的暂停与视口窗口的关闭由全局编排
    //（Editor::DebugRun::startDebugRun）负责。
    public func saveAllWorldsForDebugRun()=> void
    {
        let (saved, focused_index) = collectAllWorldSavedContexts();
        s_play_last_focused_index = focused_index;

        Singleton::apply:<SavedEditorWorldContext>(
            func(s){
                if (s.m_play_saved->is_value)
                    logerr("saveAllWorldsForDebugRun: m_play_saved 槽位非空，旧快照被覆盖");
                s.m_play_saved = option::value(saved);
            });
    }

    // 终止调试运行：关闭当前宇宙中所有世界（运行中被游戏逻辑改动的世界
    // 与运行期新建的世界一并关闭，恢复到运行前快照；实际销毁在下一逻辑
    // 更新生效，其后需让出帧再 restoreAllWorldsFromDebugRun）
    public func closeAllWorldsForDebugRunStop()=> void
    {
        for (let w : Singleton::Universe::getUniverse()->get_all_worlds)
            do w->close;
    }

    // 用调试运行前保存的快照重建世界与视口（不挂运行时系统，回到编辑态）
    // 并清空 m_play_saved 槽位；含让出帧的编排见 Editor::DebugRun::stopDebugRun
    public func restoreAllWorldsFromDebugRun()=> void
    {
        // 先在单例锁内取出快照条目并清空槽位，锁外再重建：重建会访问
        // universe / 窗口系统等其他单例，嵌套 apply 会触发 singleton 包的
        // 锁序检查。含让出帧的编排见 Editor::DebugRun::stopDebugRun
        let entries = mutable::create(
            option::none: option<array<WorldSavedContext>>);
        Singleton::apply:<SavedEditorWorldContext>(
            func(saved){
                match (saved.m_play_saved)
                {
                    none?
                        logerr("restoreAllWorldsFromDebugRun: m_play_saved 槽位为空，无世界可恢复");
                    value(saved_entries)?
                        entries->set(option::value(saved_entries));
                }
                saved.m_play_saved = option::none;
            });

        let mut focused = option::none: option<WorldEditorViewport>;
        match (entries->get)
        {
            value(saved_entries)?
                focused = rebuildWorldsFromSavedEntries(
                    saved_entries, s_play_last_focused_index);
            none?;
        }
        s_play_last_focused_index = option::none;
        s_last_focusd_world_view = focused;
    }

    // ==========================
    //  世界与视口重建
    // ==========================

    // 用已保存的条目在当前 universe 上重建世界：逐条 Saving::World::restore；
    // 有编辑器上下文的条目额外重建调试摄像机并创建对应的视口窗口（名字
    // 取自快照，编辑器状态交视口首帧应用，编辑历史与选中态直接迁移）；
    // 无编辑器上下文的仅重建世界（不注入调试摄像机）。返回应恢复聚焦的
    // 视口（focused_index 命中的条目；无则 none）。
    func rebuildWorldsFromSavedEntries(
        entries: array<WorldSavedContext>,
        focused_index: option<int>)=> option<WorldEditorViewport>
    {
        let mut focused = option::none: option<WorldEditorViewport>;

        for (let mut i = 0; i < entries->len; i += 1)
        {
            let ctx = entries[i];
            let (w, runtime_system_names) = Saving::World::restore(
                Singleton::Universe::getUniverse(), ctx.m_world_data);

            // “调试执行/导出时才启用”的系统以类型名随快照保存（采集时句柄
            // 尚有效），期间模块可能重载使旧句柄悬空，按名重新解析装回；
            // 类型未装载（模块卸载或装载失败）时跳过并记日志
            let runtime_systems = []mut: vec<typeinfo>;
            for (let tname : runtime_system_names)
            {
                match (typeinfo::load(tname))
                {
                    none?
                        logerr(F"Failed to load system type `{tname}`, skipped.");
                    value(systype)?
                        runtime_systems->add(systype);
                }
            }

            match (ctx.m_editor)
            {
                none?
                    w->set_enable(true);
                value(editor)?
                {
                    ensureDebugCamera(w);
                    w->set_enable(true);

                    let name = Saving::World::getName(ctx.m_world_data)
                        ->or("world");
                    let vp = create(w, name, editor.m_saving_path,
                        runtime_systems->to_array,
                        option::value(editor.m_editor_state));

                    match (Windows::show(vp))
                    {
                        none?
                            logerr(F"重建世界视口失败：\"{name}\"");
                        value(_)?
                        {
                            // 迁移编辑历史与选中态：快照带 eid，euid 延续，
                            // 引用 euid 的历史与选中态在新世界上依然有效
                            vp.m_action_history = editor.m_action_history;
                            vp.m_selected_entity_id = editor.m_selected_entity_id;

                            match (focused_index)
                            {
                                value(idx)?
                                    if (idx == i)
                                        focused = option::value(vp);
                                none?;
                            }
                        }
                    }
                }
            }
        }

        return focused;
    }
}
