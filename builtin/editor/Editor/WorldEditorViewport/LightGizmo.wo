// 世界编辑器视口 —— 2D 光源形状 gizmo（编辑手柄）交互。
// 选中带 Light2D::Range / Light2D::BlockShadow 的实体时（无需模式开关）
// 显示形状线框与可拖拽顶点手柄：范围为光的多层同心环多边形
//（layer-major：positions 为 [ilayer * m_point_count + ipoint]，每环一个
// 强度），遮挡体为闭合多边形环（默认数据以首尾重复同一点显式闭合）。
// 拖拽在形状平面（实体 Z 轴为法线）内进行，命中点换算回形状局部坐标
// 后直接写回组件 shape 成员；拖拽结束值有变化时发布可撤销的
// ModifyComponentMember（与变换游标/碰撞体手柄同一套撤销机制）。
// 另有阴影计算点偏移把手（Light2D::ShadowOffset，挂载组件即显示，点
// 光源无形状线框时也可用）：把手位于偏移后的阴影计算点（光照本身仍
// 从实体 Translation 位置渲染），拖拽把命中点逆变换回实体局部空间
//（旋转的逆，不受 local_scale 影响）写回 ShadowOffset.offset，撤销
// 机制同上。
// 线框与手柄的绘制见 GizmoDrawing.wo，几何换算复用本文件的纯函数
// 与 GizmoMath.wo。与碰撞体不同：光源形状几何随实体 local_scale
// 缩放（渲染系统 object2world 口径），且仅选中实体时绘制。

import pkg::std;

import je;
import je::ecs;
import je::gui;
import je::internal;
import je::typeinfo;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::try;

import builtin::editor::Editor::Action::ModifyComponentMember;

import Definition;
import GizmoMath;
import EntityPicking;
import TransformGizmo;
import UIGizmo;

using std;

using je;
using je::gui;

using JEEditor::Editor::Action;

namespace JEEditor::Editor::WorldEditorViewport
{
    // ==================== 几何辅助（交互与绘制共用） ====================

    // 光源形状框架：形状局部坐标 -> 世界坐标的变换。与渲染系统口径
    // 一致（object2world = transform(world_pos, world_rot, local_scale)），
    // scale 取实体 local_scale 的 xy 分量，形状几何按它乘入各顶点。
    //（光照本身从实体 Translation 位置渲染，形状框架即光源原点，
    // 不受 Light2D::ShadowOffset 影响）
    protected func lightFrame(e: entity)=> option<(vec3, quat, vec2)>
    {
        return or(option::none: option<(vec3, quat, vec2)>) <| try!{
            try! trans = e->towoo::get_component:<Transform::Translation>();
            let scale = trans->get_local_scale;
            return_value! option::value((
                trans->get_global_pos,
                trans->get_global_rot,
                (scale[0], scale[1]) as vec2));
        };
    }

    // 形状局部坐标 -> 世界坐标（local_scale 乘入各分量）
    protected func lightShapeToWorld(
        center: vec3, rotation: quat, scale: vec2, local: vec2)=> vec3
    {
        return center + rotation * (
            (local[0] * scale[0], local[1] * scale[1], 0.) as vec3);
    }

    // 世界坐标（形状平面内）-> 组件局部坐标（除回 local_scale），
    // 供拖拽写回组件值使用；scale 过小时按符号保留极小值避免除零
    protected func lightWorldToLocal(
        center: vec3, rotation: quat, scale: vec2, world: vec3)=> vec2
    {
        let local = rotation->inverse * (world - center);
        let mut sx = scale[0];
        if (mathf::abs(sx) < 0.0001)
            sx = (sx < 0.) ? -0.0001 | 0.0001;
        let mut sy = scale[1];
        if (mathf::abs(sy) < 0.0001)
            sy = (sy < 0.) ? -0.0001 | 0.0001;
        return (local[0] / sx, local[1] / sy) as vec2;
    }

    // 两点是否重合（判定遮挡环“首尾重复同一点”的显式闭合约定）
    protected func lightSamePoint(a: vec2, b: vec2)=> bool
    {
        return mathf::abs(a[0] - b[0]) + mathf::abs(a[1] - b[1]) < 0.00001;
    }

    // 阴影计算点偏移把手（Light2D::ShadowOffset，组件存在时才有）：
    // 位于偏移后的阴影计算点（global_pos + global_rot * offset，随实体
    // 旋转、不受 local_scale 影响；光照本身仍从 Translation 渲染），
    // 拖拽写回 ShadowOffset.offset（实体局部空间）；无该组件时为 none
    protected func getShadowOffsetHandle(e: entity)=> option<vec3>
    {
        return or(option::none: option<vec3>) <| try!{
            try! off = e->towoo::get_component:<Light2D::ShadowOffset>();
            try! trans = e->towoo::get_component:<Transform::Translation>();
            return_value! option::value(
                trans->get_global_pos + trans->get_global_rot * off.offset->get);
        };
    }

    // 选中实体光源形状的（种类, 手柄世界坐标列表）；无形状组件时为
    // none。手柄含义按种类：Range=各环全部顶点（索引与 m_positions
    // 的 layer-major 扁平序一致）；BlockShadow=多边形各顶点
    protected func getLightShapeHandles(
        e: entity)=> option<(LightShapeKind, array<vec3>)>
    {
        return or(option::none: option<(LightShapeKind, array<vec3>)>) <| try!{
            try! frame = lightFrame(e);

            match (e->towoo::get_component:<Light2D::Range>())
            {
                value(range)?
                {
                    let pts = []mut: vec<vec3>;
                    for (let p : range.shape->get.m_positions)
                        pts->add(lightShapeToWorld(frame.0, frame.1, frame.2, p));
                    return_value! option::value(
                        (LightShapeKind::RANGE, pts->to_array));
                }
                none?;
            }

            match (e->towoo::get_component:<Light2D::BlockShadow>())
            {
                value(block)?
                {
                    let pts = []mut: vec<vec3>;
                    for (let p : block.shape->get as array<vec2>)
                        pts->add(lightShapeToWorld(frame.0, frame.1, frame.2, p));
                    return_value! option::value(
                        (LightShapeKind::BLOCK_SHADOW, pts->to_array));
                }
                none?;
            }

            return_value! option::none: option<(LightShapeKind, array<vec3>)>;
        };
    }

    // 光源形状线框（世界坐标）：(种类, 各闭合环顶点表, 各环强度)。
    // Range=每环一表（首尾不重复，绘制时闭合），强度取 m_strength
    // 供线框按强度调制亮度；BlockShadow=单环多边形，仅依次连接相邻
    // 顶点、不加隐式闭合边（与渲染 TRIANGLESTRIP 语义一致，闭合由
    // 数据以首尾重复同一点显式表达），强度固定 1。
    protected func getLightShapeOutlines(
        e: entity)=> option<(LightShapeKind, array<array<vec3>>, array<real>)>
    {
        return or(option::none: option<(LightShapeKind, array<array<vec3>>, array<real>)>) <| try!{
            try! frame = lightFrame(e);

            match (e->towoo::get_component:<Light2D::Range>())
            {
                value(range)?
                {
                    let shape = range.shape->get;
                    let pc = shape.m_point_count;
                    let rings = []mut: vec<array<vec3>>;
                    let strengths = []mut: vec<real>;
                    for (let mut l = 0; l < shape.m_strength->len; l += 1)
                    {
                        let ring = []mut: vec<vec3>;
                        for (let mut p = 0; p < pc; p += 1)
                        {
                            let idx = l * pc + p;
                            if (idx >= shape.m_positions->len)
                                break;
                            ring->add(lightShapeToWorld(
                                frame.0, frame.1, frame.2, shape.m_positions[idx]));
                        }
                        rings->add(ring->to_array);
                        strengths->add(shape.m_strength[l]);
                    }
                    return_value! option::value(
                        (LightShapeKind::RANGE, rings->to_array, strengths->to_array));
                }
                none?;
            }

            match (e->towoo::get_component:<Light2D::BlockShadow>())
            {
                value(block)?
                {
                    let ring = []mut: vec<vec3>;
                    for (let p : block.shape->get as array<vec2>)
                        ring->add(lightShapeToWorld(frame.0, frame.1, frame.2, p));
                    return_value! option::value((
                        LightShapeKind::BLOCK_SHADOW,
                        [ring->to_array],
                        [1.]));
                }
                none?;
            }

            return_value! option::none:
                option<(LightShapeKind, array<array<vec3>>, array<real>)>;
        };
    }

    // ==================== 交互（悬停 / 拖拽 / 撤销） ====================

    // 每帧更新光源编辑手柄状态：光源层激活时，选中带 Range/BlockShadow
    // 的实体显示形状手柄、带 Light2D::ShadowOffset 的实体显示阴影计算点
    // 偏移把手（可直接拖拽，点光源无形状线框时偏移把手仍可用）。本函数
    // 只由 WindowLifecycle 在光源层激活（或拖拽收尾）时调用；其他层不
    // 运行，避免与碰撞体/粒子/变换手柄叠加。松开左键结束拖拽并提交
    // 撤销记录；拖拽中按鼠标射线应用编辑；否则做屏幕空间悬停检测，
    // 悬停手柄上按下左键开始拖拽。
    protected func updateLightGizmo(
        self: WorldEditorViewport,
        debug_camera: option<entity>,
        hovered: bool,
        rect_min: ImVec2,
        rect_size: ImVec2)=> void
    {
        self.m_light_hover_handle = GIZMO_HANDLE_NONE;

        // 松开左键时结束拖拽并提交撤销记录
        if (self.m_light_dragging
            && !IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Left))
        {
            self->finishLightDrag();
            self.m_light_dragging = false;
            self.m_light_drag_handle = GIZMO_HANDLE_NONE;
        }

        // UI 编辑视口缩放期间让位：本手柄的世界→屏幕映射不感知视口
        // 缩放，缩放下显示/命中会错位（zoom==1 时行为不变）
        if (self->uiEditingActive() && self.m_ui_view_zoom != 1.)
            return;

        if (self.m_selected_entity_id->is_none)
            return;

        do try!{
            try! camera_entity = debug_camera;
            try! camera_trans =
                camera_entity->towoo::get_component:<Transform::Translation>();
            try! camera_proj =
                camera_entity->towoo::get_component:<Camera::Projection>();
            try! selected_euid = self.m_selected_entity_id;
            try! selected_entity = self->findEntityByEuid(selected_euid);

            let rmin = rect_min as vec2;
            let rsize = rect_size as vec2;
            if (rsize[0] <= 0. || rsize[1] <= 0.)
                return_value!;

            let mouse = GetMousePos() as vec2;

            // 拖拽进行中：按当前鼠标射线应用编辑
            if (self.m_light_dragging)
            {
                self.m_light_hover_handle = self.m_light_drag_handle;

                let mouse_local = (mouse - rmin) / rsize;
                let mouse_ndc = (mouse_local - (0.5, 0.5) as vec2) * 2.;
                let mouse_ray = towoo::ray::from(
                    camera_trans, camera_proj,
                    (mouse_ndc[0], -mouse_ndc[1]) as vec2,
                    camera_entity->towoo::get_component:<Camera::PerspectiveProjection>->is_none);

                self->applyLightDrag(
                    selected_entity, mouse_ray->origin, mouse_ray->direction);
                return_value!;
            }

            if (!(hovered
                && !self.m_is_look_active
                && !self.m_is_pan_active
                && !self.m_is_orbit_active
                // 变换游标/碰撞体/粒子手柄拖拽进行中时由其接管
                && !self.m_gizmo_dragging
                && !self.m_collider_dragging
                && !self.m_particle_dragging
                // 全部模式下粒子层先运行且绘制在最上层，悬停时让位
                && self.m_particle_hover_handle == GIZMO_HANDLE_NONE))
                return_value!;

            // 悬停检测：手柄世界坐标投影到屏幕，取距离最近者。形状
            // 手柄（Range/BlockShadow，无形状组件时跳过）与阴影计算点
            // 偏移把手一并参与最近者竞争
            let view_proj = camera_proj->get_view_proj_mat;
            let mut best = GIZMO_HANDLE_NONE;
            let mut best_dist = GIZMO_POINT_HIT_PX;

            // 偏移把手分派只看手柄编号，kind 仅形状手柄使用（选中实体
            // 无形状组件时以 RANGE 占位，不会被读到）
            let mut drag_kind = LightShapeKind::RANGE;
            match (getLightShapeHandles(selected_entity))
            {
                none?;
                value(handles_info)?
                {
                    drag_kind = handles_info.0;
                    let handles = handles_info.1;
                    for (let mut i = 0; i < handles->len; i += 1)
                    {
                        let d = (mouse - gizmoWorldToScreen(
                                view_proj, handles[i], rmin, rsize))->length;
                        if (d < best_dist)
                        {
                            best_dist = d;
                            best = i;
                        }
                    }
                }
            }

            match (getShadowOffsetHandle(selected_entity))
            {
                none?;
                value(p)?
                {
                    let d = (mouse - gizmoWorldToScreen(
                            view_proj, p, rmin, rsize))->length;
                    if (d < best_dist)
                    {
                        best_dist = d;
                        best = LIGHT2D_HANDLE_SHADOW_OFFSET;
                    }
                }
            }

            self.m_light_hover_handle = best;

            // 悬停手柄上按下左键：开始拖拽
            if (self.m_light_hover_handle != GIZMO_HANDLE_NONE
                && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Left))
            {
                self->beginLightDrag(
                    selected_entity, selected_euid,
                    drag_kind, self.m_light_hover_handle);
            }

            return_value!;
        };
    }

    // 开始一次手柄拖拽：捕获形状平面与撤销用旧值，条件不满足时放弃
    protected func beginLightDrag(
        self: WorldEditorViewport,
        selected_entity: entity,
        selected_euid: entity::internal::euid_t,
        kind: LightShapeKind,
        handle: int)=> void
    {
        do try!{
            try! frame = lightFrame(selected_entity);

            // 偏移把手直接编辑 Light2D::ShadowOffset.offset；形状手柄
            // 编辑 shape 成员（undo_component 依形状种类而定）
            let mut undo_component = "";
            let mut undo_member = "";
            if (handle == LIGHT2D_HANDLE_SHADOW_OFFSET)
            {
                undo_component = "Light2D::ShadowOffset";
                undo_member = "offset";
            }
            else
            {
                undo_component = (kind == LightShapeKind::RANGE)
                    ? "Light2D::Range"
                    | "Light2D::BlockShadow";
                undo_member = "shape";
            }

            try! old_value = serializeMemberValue(
                selected_entity, undo_component, undo_member);

            self.m_light_dragging = true;
            self.m_light_drag_handle = handle;
            self.m_light_drag_euid = selected_euid;
            self.m_light_drag_kind = kind;
            // 拖拽平面：形状所在平面（实体 Z 轴为法线），拖拽期间冻结
            self.m_light_drag_center = frame.0;
            self.m_light_drag_normal = frame.1 * ((0., 0., 1.) as vec3);
            self.m_light_drag_undo_component = undo_component;
            self.m_light_drag_undo_member = undo_member;
            self.m_light_drag_undo_old_value = old_value;
            return_value!;
        };
    }

    // 拖拽进行中：鼠标射线与拖拽平面求交，命中点换算回组件局部坐标
    // 后仅替换被拖顶点写回组件值（框架取当前帧的，实体移动中拖拽
    // 仍跟随）
    protected func applyLightDrag(
        self: WorldEditorViewport,
        selected_entity: entity,
        ray_origin: vec3,
        ray_dir: vec3)=> void
    {
        do try!{
            // 鼠标射线与拖拽平面求交
            try! hit = gizmoRayPlaneHit(
                ray_origin, ray_dir,
                self.m_light_drag_normal,
                self.m_light_drag_center);

            let handle = self.m_light_drag_handle;

            // 偏移把手：命中点逆变换回实体局部空间（旋转的逆，与渲染
            // shadow_pos + world_rot * offset 口径互逆，不涉及 local_scale）
            // 写回 ShadowOffset.offset；拖拽平面以实体 Z 轴为法线，平面内
            // 命中点的局部 z 恒等于起始值，offset.z 在拖拽中保持不变。
            // 旋转取当前帧的，实体移动中拖拽仍跟随
            if (handle == LIGHT2D_HANDLE_SHADOW_OFFSET)
            {
                try! off =
                    selected_entity->towoo::get_component:<Light2D::ShadowOffset>();
                try! trans =
                    selected_entity->towoo::get_component:<Transform::Translation>();
                let local = trans->get_global_rot->inverse
                    * (hit - trans->get_global_pos);
                off.offset->set(local);
                return_value!;
            }

            if (self.m_light_drag_kind == LightShapeKind::RANGE)
            {
                try! range =
                    selected_entity->towoo::get_component:<Light2D::Range>();
                try! frame = lightFrame(selected_entity);

                let shape = range.shape->get;
                if (handle < 0 || handle >= shape.m_positions->len)
                    return_value!;

                let np = lightWorldToLocal(frame.0, frame.1, frame.2, hit);
                let newpos = []mut: vec<vec2>;
                for (let mut i = 0; i < shape.m_positions->len; i += 1)
                    newpos->add((i == handle) ? np | shape.m_positions[i]);
                range.shape->set(Light2D::Range::light_shape{
                    m_point_count = shape.m_point_count,
                    m_strength = shape.m_strength,
                    m_positions = newpos->to_array,
                });
            }
            else
            {
                try! block =
                    selected_entity->towoo::get_component:<Light2D::BlockShadow>();
                try! frame = lightFrame(selected_entity);

                let pts = block.shape->get as array<vec2>;
                if (handle < 0 || handle >= pts->len)
                    return_value!;

                let np = lightWorldToLocal(frame.0, frame.1, frame.2, hit);
                // 遮挡环常以“首尾重复同一点”显式闭合，拖拽端点时同步
                // 另一端保持闭合
                let closed_pair = pts->len > 1
                    && lightSamePoint(pts[0], pts[pts->len - 1]);
                let newpts = []mut: vec<vec2>;
                for (let mut i = 0; i < pts->len; i += 1)
                {
                    let use_np = (i == handle)
                        || (closed_pair && handle == 0 && i == pts->len - 1)
                        || (closed_pair && handle == pts->len - 1 && i == 0);
                    newpts->add(use_np ? np | pts[i]);
                }
                block.shape->set(
                    newpts->to_array as Light2D::BlockShadow::block_mesh);
            }
            return_value!;
        };
    }

    // 结束拖拽：值有变化时发布一条可撤销的 Action
    protected func finishLightDrag(self: WorldEditorViewport)=> void
    {
        if (self.m_light_drag_undo_old_value == "")
            return;

        do try!{
            try! selected_entity = self->findEntityByEuid(self.m_light_drag_euid);
            let new_value = serializeMemberValue(
                selected_entity,
                self.m_light_drag_undo_component,
                self.m_light_drag_undo_member)->or("");

            if (new_value != "" && new_value != self.m_light_drag_undo_old_value)
                self->doAction(ModifyComponentMember::create(
                        self.m_light_drag_euid,
                        self.m_light_drag_undo_component,
                        self.m_light_drag_undo_member,
                        self.m_light_drag_undo_old_value,
                        new_value));
            return_value!;
        };
    }

    // 当前悬停/拖拽的光源手柄说明（供视口悬停标签使用）
    protected func lightGizmoHandleLabel(self: WorldEditorViewport)=> string
    {
        let handle = self.m_light_dragging
            ? self.m_light_drag_handle
            | self.m_light_hover_handle;
        if (handle == GIZMO_HANDLE_NONE)
            return "";
        if (handle == LIGHT2D_HANDLE_SHADOW_OFFSET)
            return "光源阴影偏移";

        return or("光源形状顶点") <| try!{
            try! selected_entity = self->getSelectedEntity();
            try! info = getLightShapeHandles(selected_entity);
            let prefix = (info.0 == LightShapeKind::RANGE)
                ? "范围光顶点"
                | "遮挡体顶点";
            return_value! F"{prefix} {handle + 1}";
        };
    }
}
