// 世界编辑器视口 —— 视口覆盖 UI。
// 绘制在视口左上角的变换游标工具栏（模式/参考系/2D 模式/锁定鼠标/
// 2D 光照开关；UI 编辑模式下仅保留“锁定编辑”开关）与左下角的
// 未保存修改标记。

import pkg::std;

import je;
import je::ecs;
import je::gui;
import je::towoo;
import je::towoo::types;
import je::towoo::components;

import builtin::editor::Editor::Practice;

import Definition;
import CameraControl;
import EntityPicking;
import UIGizmo;

using std;

using je;
using je::gui;

namespace JEEditor::Editor::WorldEditorViewport
{
    // 在视口左上角绘制变换游标工具栏，编辑层选择显示在右下角；
    // 返回工具栏（含编辑层行）是否被悬停
    protected func drawGizmoToolbar(
        self: WorldEditorViewport,
        debug_camera: option<entity>,
        rect_min: ImVec2,
        rect_max: ImVec2)=> bool
    {
        // UI 编辑模式（选中 UI 元素）：隐藏变换游标工具栏，保持视口干净
        //（移动/旋转/缩放选项对 UI 手柄无意义，2D 模式等视口开关亦
        // 不在 UI 编辑中显示），仅保留“锁定编辑”开关与视口缩放控件
        //（滚轮缩放/中键平移的显式入口，见 updateUIViewNavigation）——
        // 锁定时手柄不悬停不拖拽、点击仅做 UI 空间选取（浏览层级零误操作）
        if (self->uiEditingActive())
        {
            SetCursorScreenPos((rect_min.0 + 8., rect_min.1 + 8.));

            let mut toolbar_hovered = false;

            match (CheckBox("锁定编辑", self.m_ui_edit_locked))
            {
                none?;
                value(v)? self.m_ui_edit_locked = v;
            }
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                do SetTooltip(
                    "锁定 UI 手柄编辑：移动/缩放/旋转手柄不响应，点击仅选取元素");
            }

            // 视口缩放：+/- 步进（锚点=可见窗口中心）、当前倍率、重置。
            // 滚轮以鼠标为锚缩放、中键拖拽平移、F 聚焦选中元素
            let mut zoom_ctrl_hovered = false;
            SameLine();
            if (Button("-"))
                self->uiZoomStep(1. / UI_VIEW_TOOL_STEP);
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                zoom_ctrl_hovered = true;
            }
            SameLine();
            if (Button("+"))
                self->uiZoomStep(UI_VIEW_TOOL_STEP);
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                zoom_ctrl_hovered = true;
            }
            SameLine();
            Text(F"{(self.m_ui_view_zoom * 100.) as int}%");
            SameLine();
            if (Button("重置视图"))
            {
                self.m_ui_view_zoom = 1.;
                self.m_ui_view_offset = (0., 0.) as vec2;
            }
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                zoom_ctrl_hovered = true;
            }
            if (zoom_ctrl_hovered)
                do SetTooltip(
                    "视口缩放：滚轮以鼠标为锚缩放，中键拖拽平移，F 聚焦选中元素");

            return toolbar_hovered;
        }

        SetCursorScreenPos((rect_min.0 + 8., rect_min.1 + 8.));

        let mut toolbar_hovered = false;

        // 模式按钮只切换平移/旋转/缩放；编辑层由下方“全部/变换/…”行
        // 独立控制，W/E/R 不改变编辑层
        if (RadioButton("移动", self.m_gizmo_mode == GizmoMode::TRANSLATE))
            self.m_gizmo_mode = GizmoMode::TRANSLATE;
        if (IsItemHovered())
            toolbar_hovered = true;
        SameLine();

        if (RadioButton("旋转", self.m_gizmo_mode == GizmoMode::ROTATE))
            self.m_gizmo_mode = GizmoMode::ROTATE;
        if (IsItemHovered())
            toolbar_hovered = true;
        SameLine();

        if (RadioButton("缩放", self.m_gizmo_mode == GizmoMode::SCALE))
            self.m_gizmo_mode = GizmoMode::SCALE;
        if (IsItemHovered())
            toolbar_hovered = true;
        SameLine();

        // 缩放只支持 Local，处于缩放模式时不提供 Global 选项
        if (self.m_gizmo_mode == GizmoMode::SCALE)
        {
            do RadioButton("Local", true);
            if (IsItemHovered())
                toolbar_hovered = true;
        }
        else
        {
            if (RadioButton("Local", self.m_gizmo_space == GizmoSpace::LOCAL))
                self.m_gizmo_space = GizmoSpace::LOCAL;
            if (IsItemHovered())
                toolbar_hovered = true;
            SameLine();

            if (RadioButton("Global", self.m_gizmo_space == GizmoSpace::GLOBAL))
                self.m_gizmo_space = GizmoSpace::GLOBAL;
            if (IsItemHovered())
                toolbar_hovered = true;
        }

        SameLine();

        // 编辑器摄像机的 2D（正交）模式开关：切换透视/正交投影；
        // 切到 2D 时旋转归零，操作变为中键平移 + 滚轮缩放，
        // 见 setDebugCamera2DMode 与 updateCameraControl 的注释。
        match (debug_camera)
        {
            none?;
            value(camera)?
            {
                match (CheckBox("2D 模式", isDebugCamera2DMode(camera)))
                {
                    none?;
                    value(v)?
                        self->setDebugCamera2DMode(camera, v);
                }
                if (IsItemHovered())
                {
                    toolbar_hovered = true;
                    do SetTooltip(
                        "切换编辑器摄像机透视/正交投影（2D 模式下旋转归零，右键/中键平移，Ctrl+滚轮缩放，滚轮调深度）");
                }
            }
        }

        SameLine();

        // 右键环视时是否锁定鼠标（虚拟机等环境下建议关闭；每个世界视口独立记忆）
        match (CheckBox("锁定鼠标", self.m_lock_mouse_on_look))
        {
            none?;
            value(v)?
                self.m_lock_mouse_on_look = v;
        }
        if (IsItemHovered())
            toolbar_hovered = true;

        SameLine();

        // 调试游走摄像机的 2D 光照模式（开/关）：开 = 摄像机走延迟光照
        // 渲染路径，关 = 回到直接渲染；组件增删见 setDebugCameraLight2DEnabled。
        // 需要世界正在运行 Graphic::DeferLight2DGraphicPipelineSystem 才会生效。
        match (debug_camera)
        {
            none?;
            value(camera)?
            {
                match (CheckBox("2D 光照", isDebugCameraLight2DEnabled(camera)))
                {
                    none?;
                    value(v)?
                        setDebugCameraLight2DEnabled(camera, v);
                }
                if (IsItemHovered())
                {
                    toolbar_hovered = true;
                    do SetTooltip(
                        "开启后调试摄像机以 2D 延迟光照渲染（需要世界正在运行 Graphic::DeferLight2DGraphicPipelineSystem）");
                }
            }
        }

        // ---- 编辑层选择（第二行） ----
        // 选中实体带有组件编辑手柄时提供层切换。全部模式同时绘制并
        // 响应变换、碰撞体、光源与粒子手柄（后绘制者优先）；单层模式
        // 只显示对应家族，其余层保留淡化线框。0-4 可直接切换。
        let selected_entity = self->getSelectedEntity();
        let mut has_collider_layer = false;
        let mut has_light_layer = false;
        let mut has_particle_layer = false;
        match (selected_entity)
        {
            none?;
            value(e)?
            {
                has_collider_layer = hasPhysics2DCollider(e);
                has_light_layer =
                    e->towoo::get_component:<Light2D::Range>->is_value
                    || e->towoo::get_component:<Light2D::BlockShadow>->is_value
                    || e->towoo::get_component:<Light2D::ShadowOffset>->is_value;
                has_particle_layer =
                    e->towoo::get_component:<Particle::Emitter>->is_value;
            }
        }

        if (has_collider_layer || has_light_layer || has_particle_layer)
        {
            // 右下角显示编辑层：按实际文本/按钮宽度估算整行宽度后右对齐。
            // 估算略偏大，宁可留一点间隙也不越过右边界；视口过窄时钳制
            // 到左内边距，允许向右溢出。
            let layer_text =
                F"编辑层（当前：{gizmoLayerLabel(self.m_gizmo_active_layer)}）";
            let mut row_width = CalcTextSize(layer_text).0;
            row_width +=
                10. + GetFrameHeight() + 5. + CalcTextSize("全部").0;
            row_width +=
                10. + GetFrameHeight() + 5. + CalcTextSize("变换").0;
            if (has_collider_layer)
                row_width +=
                    10. + GetFrameHeight() + 5. + CalcTextSize("碰撞体").0;
            if (has_light_layer)
                row_width +=
                    10. + GetFrameHeight() + 5. + CalcTextSize("光源").0;
            if (has_particle_layer)
                row_width +=
                    10. + GetFrameHeight() + 5. + CalcTextSize("粒子").0;

            let mut row_x = rect_max.0 - 8. - row_width;
            if (row_x < rect_min.0 + 8.)
                row_x = rect_min.0 + 8.;
            let row_y = rect_max.1 - 8. - GetFrameHeight();
            SetCursorScreenPos((row_x, row_y));

            TextDisabled(layer_text);
            SameLine();

            if (RadioButton("全部", self.m_gizmo_layer == GizmoLayer::ALL))
                self.m_gizmo_layer = GizmoLayer::ALL;
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                do SetTooltip(
                    "同时显示变换、碰撞体、光源与粒子手柄（0，可能重叠）");
            }
            SameLine();

            if (RadioButton("变换", self.m_gizmo_layer == GizmoLayer::TRANSFORM))
                self.m_gizmo_layer = GizmoLayer::TRANSFORM;
            if (IsItemHovered())
            {
                toolbar_hovered = true;
                do SetTooltip("只显示完整变换游标（1）");
            }

            if (has_collider_layer)
            {
                SameLine();
                if (RadioButton("碰撞体", self.m_gizmo_layer == GizmoLayer::COLLIDER))
                    self.m_gizmo_layer = GizmoLayer::COLLIDER;
                if (IsItemHovered())
                {
                    toolbar_hovered = true;
                    do SetTooltip("只显示碰撞体线框与编辑手柄（2）");
                }
            }

            if (has_light_layer)
            {
                SameLine();
                if (RadioButton("光源", self.m_gizmo_layer == GizmoLayer::LIGHT2D))
                    self.m_gizmo_layer = GizmoLayer::LIGHT2D;
                if (IsItemHovered())
                {
                    toolbar_hovered = true;
                    do SetTooltip("只显示光源形状顶点与阴影偏移手柄（3）");
                }
            }

            if (has_particle_layer)
            {
                SameLine();
                if (RadioButton("粒子", self.m_gizmo_layer == GizmoLayer::PARTICLE))
                    self.m_gizmo_layer = GizmoLayer::PARTICLE;
                if (IsItemHovered())
                {
                    toolbar_hovered = true;
                    do SetTooltip("只显示发射形状、方向与散布角手柄（4）");
                }
            }
        }

        return toolbar_hovered;
    }

    // 未保存修改标记：自上次保存后执行过编辑动作（doAction/撤销/重做）时，
    // 在视口左下角显示一个小圆点（与关闭确认的判定一致，见 onPreClose）。
    // 返回标记区域是否被悬停（悬停时应抑制视口内的点击选取）。
    protected func drawUnsavedMark(
        self: WorldEditorViewport, rect_min: ImVec2, rect_max: ImVec2)=> bool
    {
        // 运行期临时视口没有“未保存”概念，不绘制
        if (self.m_is_runtime_editing)
            return false;

        if (!self.m_action_history->isDirty && self.m_saving_path->is_value)
            return false;

        let line_h = GetFrameHeight();

        // 不可见按钮仅用于在左下角占位并获得悬停判定
        SetCursorScreenPos((rect_min.0 + 8., rect_max.1 - 8. - line_h));
        do InvisibleButton("##unsaved_mark", (line_h, line_h));
        let hovered = IsItemHovered();
        if (hovered)
            do SetTooltip("存在未保存的修改");

        let (dot_rect_min, dot_rect_max) = GetItemRect();
        GetWindowDrawList()->AddCircleFilled(
            ((dot_rect_min.0 + dot_rect_max.0) * 0.5,
                (dot_rect_min.1 + dot_rect_max.1) * 0.5),
            line_h * 0.22,
            (240, 200, 80, 255));

        return hovered;
    }
}
