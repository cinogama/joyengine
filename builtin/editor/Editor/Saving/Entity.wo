import woo::std;

import je;
import je::ecs;
import je::internal;
import je::typeinfo;
import je::towoo::components;

import pkg::toml;
import pkg::try;

import builtin::gaming::Saving::Entity;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::Editor::ResourcePath;

using je;
using toml;
using JEEditor::Editor;
using JEEditor::GUI::Forms;

namespace JEEditor::Saving::Entity
{
    public func save(e: entity)=> Toml
    {
        let toml = JEGaming::Saving::Entity::save(e);

        toml->set("name", e->internal::name);

        return toml;
    }

    // 预设体完整数据：save_full + 实体名 + Transform 三组件抹除，供
    // save_prefab / update_prefab 复用。预设体不固化局部变换：这三个
    // 组件只记录存在（空表）而不保存成员值。还原时空表照常构造组件
    // 并保留默认值；派生实体的实际变换在 prefab 差异保存中以成员级
    // 差异完整记录，apply 展开时逐成员写入空表，合并不受影响。变体
    // 保存在抹除之后做差异：父预设体的这三张表同为空表，变体不会
    // 引入变换成员差异。
    func _prefab_full(e: entity)=> Toml
    {
        let toml = JEGaming::Saving::Entity::save_full(e);

        toml->set("name", e->internal::name);

        match (toml->get("components"))
        {
            none?;
            value(components_dat)?
                for (let ctype_name : [
                    "Transform::LocalPosition",
                    "Transform::LocalRotation",
                    "Transform::LocalScale",
                    "Transform::Anchor"])
                {
                    if (components_dat->contains(ctype_name))
                        components_dat->set(ctype_name, new_table());
                }
        }

        return toml;
    }

    // 保存预设体（落盘预设体文件 .je4entity 专用，见 Browser.wo 的
    // savePrefabEntityTo），dst 为落盘路径。未挂预设体时输出完整数据；
    // 已挂预设体且 dst 不是该预设体源文件时，输出相对该预设体的变体
    //（差异 + "prefab" 键，与普通实体的差异保存同构）；覆盖预设体
    // 源文件本体时仍输出完整数据。
    public func save_prefab(e: entity, dst: string)=> Toml
    {
        let toml = _prefab_full(e);

        // 已挂预设体的实体再次保存 = 旧预设体的变体。路径不区分大小写
        // 地比对：dst 与源文件相同（覆盖本体）时若仍写成变体，文件会
        // 指向自身，load 的递归展开将无限循环，此时退回完整数据更新
        // 预设体本体；误判为相同仅损失变体关系，代价可接受。
        match (e->internal::get_prefab_path())
        {
            none?;
            value(prefab_path)?
            {
                let dst_runtime = ResourcePath::toRuntimeResourcePath(dst);
                if (prefab_path->len > 0
                    && prefab_path->lower != dst_runtime->lower)
                {
                    let diff_dat_may_none = try!{
                        try! prefab_dat =
                            JEGaming::Saving::Entity::load(prefab_path);

                        let diff_dat =
                            JEGaming::Saving::Entity::diff(toml, prefab_dat);
                        diff_dat->set("prefab", prefab_path);

                        return_value! diff_dat;
                    };

                    match (diff_dat_may_none)
                    {
                        value(diff_dat)?
                            return diff_dat;
                        none?
                            // 尽管无法读取父预设体数据，依然保留派生关系
                            toml->set("prefab", prefab_path);
                    }
                }
            }
        }

        return toml;
    }

    // 更新到预设（检视面板右键「更新到预设」）：把实体当前数据写回
    // 直属预设体文件本体。直属预设体文件自身是其他预设体的变体
    //（原始内容带 "prefab" 键）时保持变体关系：与父预设体做差异、
    // 记录父路径，只更新直属文件，不修改父预设体；非变体则更新为
    // 完整数据。判定变体必须解析直属文件的原始内容——load 会递归
    // 展开变体链并抹掉 "prefab" 键。返回待落盘的数据；实体未挂预设
    // 体时返回 none，由调用方报错。
    public func update_prefab(e: entity)=> option<Toml>
    {
        let prefab_path = e->internal::get_prefab_path()->or("");
        if (prefab_path->len == 0)
            return option::none;

        let toml = _prefab_full(e);

        // 直属文件不可读取时无从判定变体关系，按非变体更新为完整
        // 数据（覆盖重建该文件）
        let parent_may = try!{
            try! content = file::readall(prefab_path);
            try! dat = parse(content)->okay;
            try! parent_path = dat->get("prefab")=>> \v = v->as_string;;

            return_value! parent_path;
        };

        match (parent_may)
        {
            none? return option::value(toml);
            value(parent_path)?
            {
                let diff_may = try!{
                    try! parent_dat =
                        JEGaming::Saving::Entity::load(parent_path);

                    let diff_dat =
                        JEGaming::Saving::Entity::diff(toml, parent_dat);
                    diff_dat->set("prefab", parent_path);

                    return_value! diff_dat;
                };

                match (diff_may)
                {
                    // 父预设体不可读时无法计算差异，退回完整数据会
                    // 静默丢失变体关系；与 save_prefab 一致，仍保留
                    // 派生关系，load 展开时会按完整差异记录尽力还原
                    none?
                    {
                        toml->set("prefab", parent_path);
                        return option::value(toml);
                    }
                    value(diff_dat)?
                        return option::value(diff_dat);
                }
            }
        }
    }

    // 把实体与预设体共有组件的成员值合并进预设体数据 prefab_dat：
    // 只覆盖 prefab_dat 已有组件中实体侧记录的成员，不新增/移除组件，
    // 也不删除成员。实体侧数据来自 _prefab_full：Transform 三组件与
    // Anchor 在其中被抹成空表，空表没有可合并的成员，预设体里这些
    // 组件的记录原样保留（预设体不固化局部变换，与 update_prefab 的
    // 抹除约定一致）。
    func _merge_shared_component_values(prefab_dat: Toml, entity_dat: Toml)
    {
        match (prefab_dat->get("components"))
        {
            none?;
            value(prefab_components)?
                match (entity_dat->get("components"))
                {
                    none?;
                    value(entity_components)?
                        for (let (ctype, ecomp_dat) : entity_components->as_table->or({}))
                        {
                            match (prefab_components->get(ctype))
                            {
                                none?;
                                value(pcomp_dat)?
                                    for (let (mname, mval) : ecomp_dat->as_table->or({}))
                                        pcomp_dat->set(mname, mval);
                            }
                        }
                }
        }
    }

    // 更新数据到预设（检视面板右键「更新数据到预设」）：不改变直属
    // 预设体文件的组件配置——不新增/移除组件（实体独有的组件不写入
    // 预设体，预设体独有的组件原样保留），名称/贴图/着色器/模型也
    // 不动，仅把双方共有组件的成员值更新为实体当前值。共有性按变体
    // 展开后的完整数据判定：直属文件是变体（原始内容带 "prefab" 键，
    // 判定方式同 update_prefab）时，以展开后的完整数据为基底合并，
    // 再与父预设体重新做差异、保持 "prefab" 键，只重写直属文件本体，
    // 不修改父预设体。基底不可读（直属文件无法解析或父预设体无法
    // 读取）时弹窗报错并返回 none；实体未挂预设体时 logerr 并返回
    // none。
    public func update_prefab_data(e: entity)=> option<Toml>
    {
        let prefab_path = e->internal::get_prefab_path()->or("");
        if (prefab_path->len == 0)
        {
            logerr("更新数据到预设：实体未挂预设体");
            return option::none;
        }

        // 直属文件的原始内容：变体判定与共有组件判定都以它为基准
        //（load 会递归展开变体链并抹掉 "prefab" 键，不能直接用，同
        // update_prefab）
        let raw_may = try!{
            try! content = file::readall(prefab_path);
            try! raw_dat = parse(content)->okay;

            return_value! raw_dat;
        };

        if (raw_may->is_none)
        {
            MsgBox::err("更新数据到预设",
                F"无法读取预设体 \"{prefab_path}\"，更新中止");
            return option::none;
        }
        let raw_dat = raw_may->unwrap;
        let entity_dat = _prefab_full(e);

        // 非变体：直属文件本身就是完整数据，直接在其上合并共有组件值
        let parent_path_may = raw_dat->get("prefab")=>> \v = v->as_string;;
        if (parent_path_may->is_none)
        {
            _merge_shared_component_values(raw_dat, entity_dat);
            return option::value(raw_dat);
        }

        // 变体：只更新直属文件本体。父预设体不可读时无法计算差异，
        // 弹窗报错并中止（不做降级写盘，避免静默丢失部分更新）
        let parent_path = parent_path_may->unwrap;
        let parent_dat_may = JEGaming::Saving::Entity::load(parent_path);
        if (parent_dat_may->is_none)
        {
            MsgBox::err("更新数据到预设",
                F"无法读取父预设体 \"{parent_path}\"，变体 \"{prefab_path}\" 的更新中止");
            return option::none;
        }

        // 基底取「直属预设体按变体展开后的完整数据」（父预设体 + 直属
        // 差异），与上面的父预设体数据各自独立加载：Toml 的 get 取到的
        // 是内部表的引用，共享同一棵树会让合并成员时写穿差异基准
        let merged_may = JEGaming::Saving::Entity::load(prefab_path);
        if (merged_may->is_none)
        {
            MsgBox::err("更新数据到预设",
                F"无法展开预设体 \"{prefab_path}\"，更新中止");
            return option::none;
        }

        let merged = merged_may->unwrap;
        _merge_shared_component_values(merged, entity_dat);

        // 与父预设体重新做差异、保持变体关系（同 update_prefab）
        let diff_dat =
            JEGaming::Saving::Entity::diff(merged, parent_dat_may->unwrap);
        diff_dat->set("prefab", parent_path);
        return option::value(diff_dat);
    }

    public func restore(w: world, edat: Toml)=> entity
    {
        // 挂预设体的实体保存为相对预设体的差异数据（带 "prefab" 键）：
        // 还原前加载预设体并应用差异，展开为完整数据，并把重建出的
        // 实体重新挂回预设体（保持派生关系，此后保存仍按差异记录）。
        // 预设体读取失败时退回差异数据尽力还原，且不保留派生关系
        let mut restore_dat = edat;
        let mut prefab_path = option::none: option<string>;

        match (edat->get("prefab")=>> \v = v->as_string;)
        {
            none?;
            value(p_path)?
            {
                let expanded = try!{
                    try! prefab_dat =
                        JEGaming::Saving::Entity::load(p_path);

                    JEGaming::Saving::Entity::apply(prefab_dat, edat);

                    return_value! prefab_dat;
                };

                match (expanded)
                {
                    none?
                        logerr(F"还原实体：无法读取预设体 \"{p_path}\"，按差异数据尽力还原");
                    value(full_dat)?
                    {
                        // 序列化产物不含 Editor:: 组件，而 set_prefab_path
                        // 需要 Editor::Prefab 组件存在：往起始组件集合补
                        // 一张空表，由通用还原随实体构造
                        match (full_dat->get("components"))
                        {
                            value(components_dat)?
                                components_dat->set(
                                    Editor::Prefab::type::typeinfo->name,
                                    new_table());
                            none?
                                logerr("还原实体：实体数据缺少 components 表");
                        }

                        restore_dat = full_dat;
                        prefab_path = option::value(p_path);
                    }
                }
            }
        }

        let e = JEGaming::Saving::Entity::restore(w, restore_dat);

        if (prefab_path->is_value)
            e->internal::set_prefab_path(prefab_path->unwrap);

        match (edat->get("name")=>> \v = v->as_string;)
        {
            none?;
            value(name)?
                e->internal::set_name(name);
        }

        return e;
    }
}
