namespace JEEditor::Editor
{
    using WorldEditorViewport = struct{
        m_close: mut CloseRequest,
        
        m_world_instance: world,
        
        // World context:
        m_name: string,
        
        m_runtime_systems: vec<typeinfo>,
        m_saving_path: option<path_t>,
        
        // Editor context:
        m_editor_walk_camera_frame_buffer: mut option<graphic::framebuffer>,
        m_fb_pending_size: mut ImVec2,
        m_fb_settle_counter: mut int,
        
        // Camera control state:
        m_last_time: mut real,
        m_is_look_active: mut bool,
        m_is_pan_active: mut bool,
        m_is_orbit_active: mut bool,
        m_orbit_pivot: mut vec3,
        m_orbit_distance: mut real,
        m_rotation_x: mut quat,
        m_rotation_y: mut quat,
    }
    {
        let TRASNLATION_SYSTEM_TYPE =
            typeinfo::load("Translation::TranslationUpdatingSystem")->unwrap;
        let DEFAULT_GRAPHIC_SYSTEM_TYPE =
            typeinfo::load("Graphic::UnlitGraphicPipelineSystem")->unwrap;
            
        // 拖拽缩放窗口时 content 尺寸每帧都在变化；等待尺寸连续稳定这么多帧后
        // 再重建摄像机 framebuffer，避免在拖拽过程中频繁分配 GPU 资源。
        let FRAMEBUFFER_RESIZE_SETTLE_FRAMES = 30;
        
        // ---- 摄像机游走参数 ----
        let CAMERA_MOVE_SPEED = 8.;
        let CAMERA_FAST_MOVE_MULTIPLIER = 3.;
        let CAMERA_LOOK_SENSITIVITY = 0.15;
        let CAMERA_ORBIT_SENSITIVITY = 0.3;
        let CAMERA_PAN_SENSITIVITY = 0.01;
        let CAMERA_WHEEL_DOLLY = 5.;
        let CAMERA_PITCH_LIMIT = 88.;
        let CAMERA_DEFAULT_ORBIT_DISTANCE = 10.;
        let CAMERA_MIN_ORTHO_SCALE = 0.05;
        
        enum CloseRequest
        {
            NORMALLY,
            CLOSE_BUT_KEEP_WORLD,
        }
        
        let s_world_viewports = {}mut: map<world, WorldEditorViewport>;
        let mut s_last_focusd_world_view = option::none: option<WorldEditorViewport>;
        
        func create(w: world, name: string, path: option<path_t>)=> WorldEditorViewport
            where require!(WorldEditorViewport: IWindows);
        {
            // 注意：按照设计，WorldEditorViewport 的生命周期应当比 world 实例更长
            //      因此，世界实例的释放将由 WorldEditorViewport 在 onClose 时执行
            return WorldEditorViewport{
                m_close = mut CloseRequest::NORMALLY,
                
                m_world_instance = w,
                
                m_name = name,
                m_runtime_systems = []mut,
                m_saving_path = path,
                
                m_editor_walk_camera_frame_buffer = mut option::none,
                m_fb_pending_size = mut (0., 0.),
                m_fb_settle_counter = mut 0,
                
                // Camera control state:
                m_last_time = mut 0.,
                m_is_look_active = mut false,
                m_is_pan_active = mut false,
                m_is_orbit_active = mut false,
                m_orbit_pivot = mut (0., 0., 0.) as vec3,
                m_orbit_distance = mut CAMERA_DEFAULT_ORBIT_DISTANCE,
                m_rotation_x = mut quat::ident,
                m_rotation_y = mut quat::ident,
            };
        }
        
        func isCurrentViewportAvailable(self: WorldEditorViewport)
        {
            match (s_world_viewports->get(self.m_world_instance))
            {
                none?;
                value(wv)?
                    return std::is_same(wv, self);
            }
            return false;
        }
        
        public func onCreate(self: WorldEditorViewport)=> void
        {
            s_world_viewports->set(self.m_world_instance, self);
        }
        public func onClose(self: WorldEditorViewport)=> void
        {
            if (self.m_is_look_active)
                input::set_lock_mouse(false);
                
            match (s_last_focusd_world_view)
            {
                none?;
                value(v)?
                    if (std::is_same(v, self))
                        s_last_focusd_world_view = option::none;
            }
            
            if (self.m_close != CloseRequest::CLOSE_BUT_KEEP_WORLD
                && self->isCurrentViewportAvailable)
            {
                do s_world_viewports->remove(self.m_world_instance);
                self.m_world_instance->close;
            }
        }
        public func getTitle(self: WorldEditorViewport)=> string
        {
            let saving_path = self.m_saving_path->> \p = p->to_string;;
            
            return F"世界视口：{self.m_name}##{saving_path->or(":<unsaved>")}";
        }
        public func getMenu(self: WorldEditorViewport)=> option<Menu>
        {
            func inputForRenamingWorld()=> void
            {
                InputBox::show("新世界名", "请输入新的世界名称", self.m_name)
                    -> then(
                        func(new_name)
                        {
                            self->dropAndRename(new_name);
                        });
            }
            
            return option::value <|
                Menu::create("")
                    -> subMenu("编辑")
                    ->  subItem("重命名", inputForRenamingWorld)
                    ->  endItem
                    -> endMenu
                    ;
        }
        public func getSizeConstraints(_: WorldEditorViewport)=> SizeConstraints
        {
            return SizeConstraints::Limited(((320., 240.), (4096., 4096.)));
        }
        
        public func run(self: WorldEditorViewport)=> bool
        {
            if (IsWindowFocused())
                s_last_focusd_world_view = option::value(self);
                
            self->updateWalkCameraFramebuffer();
            
            let mut viewport_hovered = false;
            
            match (self.m_editor_walk_camera_frame_buffer=>>\fb = fb->attachment(0);)
            {
                none?
                {
                    TextDisabled("（没有有效的渲染结果，等待重新创建……）");
                }
                value(fbtex)?
                {
                    let (w, h) = GetContentRegionAvail();
                    ImageSize(fbtex, w, h);
                    viewport_hovered = IsItemHovered();
                }
            }
            
            let now = time();
            let dt = mathf::clamp(now - self.m_last_time, 0., 0.1);
            self.m_last_time = now;
            self->updateCameraControl(dt, viewport_hovered);
            
            return self.m_close == CloseRequest::NORMALLY;
        }
        
        // 根据 GetContentRegionAvail 自动创建/重建摄像机 framebuffer；
        // 若窗口尺寸仍在变化（正在拖拽缩放），则等待尺寸稳定后再更新。
        func updateWalkCameraFramebuffer(self: WorldEditorViewport)=> void
        {
            let debug_cameras = self.m_world_instance->internal::get_all_entities([
                    Camera::RendToFramebuffer::type::typeinfo,
                    Editor::Invisible::type::typeinfo,
                ]);
                
            if (debug_cameras->empty)
                // 未找到调试摄像机，跳过本轮更新
                return;
                
            let avail = GetContentRegionAvail();
            let target_w = avail.0 as int;
            let target_h = avail.1 as int;
            
            // 尺寸退化（窗口折叠/尚未布局）时跳过。
            if (target_w <= 0 || target_h <= 0)
                return;
                
            // 当前 framebuffer 已与目标尺寸一致，则无需重建。
            match (self.m_editor_walk_camera_frame_buffer)
            {
                none?;
                value(fb)?
                {
                    let (cw, ch) = fb->size();
                    if (cw == target_w && ch == target_h)
                    {
                        self.m_fb_settle_counter = 0;
                        return;
                    }
                }
            }
            
            // 尺寸不一致（或尚无 framebuffer）：仅在尺寸连续稳定若干帧后重建，
            // 避免拖拽过程中每帧都重新分配。
            if (avail.0 != self.m_fb_pending_size.0
                || avail.1 != self.m_fb_pending_size.1)
            {
                self.m_fb_pending_size = avail;
                self.m_fb_settle_counter = 0;
            }
            self.m_fb_settle_counter += 1;
            
            if (self.m_fb_settle_counter < FRAMEBUFFER_RESIZE_SETTLE_FRAMES)
                return;
                
            // 尺寸已稳定，按目标尺寸（重新）创建 framebuffer。
            match (graphic::framebuffer::create(
                    target_w, target_h,
                    [graphic::framebuffer::color_format::RGBA as int],
                    true))
            {
                none?;
                value(fb)?
                {
                    self.m_editor_walk_camera_frame_buffer = option::value(fb);
                    
                    let r2b = debug_cameras[0]->towoo::get_component:<Camera::RendToFramebuffer>->unwrap;
                    r2b->set(self.m_editor_walk_camera_frame_buffer);
                }
            }
        }
        
        // 根据输入控制编辑器摄像机（三维/二维游走）。
        // 操作方式参考 Unity / Blender 等编辑器视口：
        //
        //   三维（透视）摄像机：
        //     鼠标右键拖拽       — 自由环视（FPS 风格，锁定鼠标）
        //     右键 + WASD        — 前后左右移动
        //     右键 + Q / E       — 下 / 上移动
        //     右键 + Shift       — 加速移动
        //     鼠标中键拖拽       — 屏幕平面平移
        //     鼠标滚轮           — 沿视线方向推拉
        //     Alt + 左键拖拽     — 围绕焦点轨道旋转
        //     Alt + 滚轮         — 调整轨道距离（推拉焦点）
        //
        //   二维（正交）摄像机：
        //     鼠标中键拖拽       — 屏幕平面平移
        //     鼠标滚轮           — 缩放（调整正交 scale）
        //
        func updateCameraControl(self: WorldEditorViewport, dt: real, hovered: bool)=> void
        {
            let cameras = self.m_world_instance->internal::get_all_entities([
                    Camera::RendToFramebuffer::type::typeinfo,
                    Editor::Invisible::type::typeinfo,
                ]);
                
            if (cameras->empty)
                return;
                
            let cam = cameras[0];
            let posOpt = cam->towoo::get_component:<Transform::LocalPosition>;
            let rotOpt = cam->towoo::get_component:<Transform::LocalRotation>;
            
            if (posOpt->is_none || rotOpt->is_none)
                return;
                
            let pos = posOpt->unwrap;
            let rot = rotOpt->unwrap;
            
            match (cam->towoo::get_component:<Camera::PerspectiveProjection>)
            {
                value(_)?
                    self->controlPerspectiveCamera(pos, rot, dt, hovered);
                none?
                    match (cam->towoo::get_component:<Camera::OrthoProjection>)
                    {
                        value(ortho)?
                            self->controlOrthoCamera(pos, rot, ortho, hovered);
                        none?;
                    }
            }
        }
        
        func controlPerspectiveCamera(
            self: WorldEditorViewport,
            pos: Transform::LocalPosition,
            rot: Transform::LocalRotation,
            dt: real,
            hovered: bool)=> void
        {
            let curPos = pos.pos->get;
            let curRot = rot.rot->get;
            
            let forward = curRot * ((0., 0., 1.) as vec3);
            let right = curRot * ((1., 0., 0.) as vec3);
            let up = curRot * ((0., 1., 0.) as vec3);
            let worldUp = (0., 1., 0.) as vec3;
            
            // ---- 激活 / 停止各项操作 ----
            if (hovered)
            {
                if (IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Right))
                {
                    self.m_is_look_active = true;
                    input::set_lock_mouse(true);
                }
                if (IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Middle))
                    self.m_is_pan_active = true;
            }
            
            if (!IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Right))
            {
                if (self.m_is_look_active)
                {
                    self.m_is_look_active = false;
                    input::set_lock_mouse(false);
                }
            }
            if (!IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Middle))
                self.m_is_pan_active = false;
                
            let (mdx, mdy) = GetMouseDeltaPos();
            let wheel = GetMouseWheel();
            let wv = wheel.1;
            
            let mut newPos = curPos;
            let mut newRot = curRot;
            let mut changed = false;
            
            // ---- 自由环视（右键拖拽）----
            if (self.m_is_look_active)
            {
                self.m_rotation_x *= quat::euler(mdy * CAMERA_LOOK_SENSITIVITY, 0., 0.);
                self.m_rotation_y *=quat::euler(0., mdx * CAMERA_LOOK_SENSITIVITY, 0.);
                newRot = self.m_rotation_x * self.m_rotation_y;
                changed = true;
            }
            
            // ---- WASD / QE 飞行（右键按住时）----
            if (self.m_is_look_active)
            {
                let speed = CAMERA_MOVE_SPEED
                    * (IsKeyDown(ImGuiKey::ImGuiKey_LeftShift)
                        ? CAMERA_FAST_MOVE_MULTIPLIER | 1.)
                    * dt;
                    
                let mf = (IsKeyDown(ImGuiKey::ImGuiKey_W) ? 1. | 0.)
                    - (IsKeyDown(ImGuiKey::ImGuiKey_S) ? 1. | 0.);
                let mr = (IsKeyDown(ImGuiKey::ImGuiKey_D) ? 1. | 0.)
                    - (IsKeyDown(ImGuiKey::ImGuiKey_A) ? 1. | 0.);
                let mu = (IsKeyDown(ImGuiKey::ImGuiKey_E) ? 1. | 0.)
                    - (IsKeyDown(ImGuiKey::ImGuiKey_Q) ? 1. | 0.);
                    
                if (mf != 0. || mr != 0. || mu != 0.)
                {
                    newPos = newPos + forward * (mf * speed);
                    newPos = newPos + right * (mr * speed);
                    newPos = newPos + worldUp * (mu * speed);
                    changed = true;
                }
            }
            
            // ---- 平移（中键拖拽）----
            if (self.m_is_pan_active)
            {
                newPos = newPos + right * (mdx * CAMERA_PAN_SENSITIVITY);
                newPos = newPos - up * (mdy * CAMERA_PAN_SENSITIVITY);
                changed = true;
            }
            
            // ---- 滚轮缩放 ----
            if (hovered && wv != 0.)
            {
                if (self.m_is_orbit_active)
                {
                    self.m_orbit_distance = mathf::clamp(
                        self.m_orbit_distance * (1. - wv * 0.1),
                        0.1, 10000.);
                    let toCam = newPos - self.m_orbit_pivot;
                    let dist = toCam->length;
                    if (dist > 0.0001)
                        newPos = self.m_orbit_pivot + toCam->unit * self.m_orbit_distance;
                    changed = true;
                }
                else
                {
                    newPos = newPos + forward * (wv * CAMERA_WHEEL_DOLLY);
                    changed = true;
                }
            }
            
            if (changed)
            {
                pos.pos->set(newPos);
                rot.rot->set(newRot);
            }
        }
        
        func controlOrthoCamera(
            self: WorldEditorViewport,
            pos: Transform::LocalPosition,
            rot: Transform::LocalRotation,
            ortho: Camera::OrthoProjection,
            hovered: bool)=> void
        {
            let curPos = pos.pos->get;
            let curRot = rot.rot->get;
            
            let right = curRot * ((1., 0., 0.) as vec3);
            let up = curRot * ((0., 1., 0.) as vec3);
            
            if (hovered && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Middle))
                self.m_is_pan_active = true;
            if (!IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Middle))
                self.m_is_pan_active = false;
                
            let (mdx, mdy) = GetMouseDeltaPos();
            let wheel = GetMouseWheel();
            let wv = wheel.1;
            
            let mut newPos = curPos;
            let mut moved = false;
            
            if (self.m_is_pan_active)
            {
                let scale = ortho.scale->get;
                let panFactor = scale * CAMERA_PAN_SENSITIVITY;
                newPos = newPos + right * (mdx * panFactor);
                newPos = newPos - up * (mdy * panFactor);
                moved = true;
            }
            
            if (hovered && wv != 0.)
            {
                let scale = ortho.scale->get;
                ortho.scale->set(mathf::clamp(
                        scale * (1. - wv * 0.1),
                        CAMERA_MIN_ORTHO_SCALE, 10000.));
            }
            
            if (moved)
                pos.pos->set(newPos);
        }
        
        // ==========================
        
        public func getRuntimeSystems(self: WorldEditorViewport)=> array<typeinfo>
        {
            return self.m_runtime_systems->to_array();
        }
        
        public func getName(self: WorldEditorViewport)=> string
        {
            return self.m_name;
        }
        
        public func getSavingPath(self: WorldEditorViewport)=> option<path_t>
        {
            return self.m_saving_path;
        }
        
        public func dropAndRename(self: WorldEditorViewport, new_name: string)=> void
        {
            if (self->isCurrentViewportAvailable && self.m_name != new_name)
            {
                match (Windows::show(create(self.m_world_instance, new_name, self.m_saving_path)))
                {
                    none?
                    {
                        MsgBox::err(
                            "重命名失败", "重命名世界失败，存在同名的未保存世界");
                            
                        if (!self.m_saving_path->is_none)
                            // 这种情况通常情况下不应该发生
                            logerr("Failed to rename world: duplicated opened world?");
                    }
                    value(_)?
                        self.m_close = CloseRequest::CLOSE_BUT_KEEP_WORLD;
                }
            }
        }
        
        // ==========================
        
        public func findWorldEditorViewport(w: world)
        {
            return s_world_viewports->get(w);
        }
        
        public func getLastFocused()
        {
            return s_last_focusd_world_view;
        }
        
        public func createNewWorldToEdit()
        {
            let new_world = world::create(
                Inspector::Universe::UniverseCtx::instance()->getUniverse());
                
            // Create default graphic pipe line.
            do new_world->add_system(DEFAULT_GRAPHIC_SYSTEM_TYPE);
            do new_world->add_system(TRASNLATION_SYSTEM_TYPE);
            
            // Create editor camera.
            do new_world->add_entity([
                    Transform::Translation::type::typeinfo,
                    Transform::LocalPosition::type::typeinfo,
                    Transform::LocalRotation::type::typeinfo,
                    Transform::LocalToWorld::type::typeinfo,
                    Camera::Projection::type::typeinfo,
                    Camera::PerspectiveProjection::type::typeinfo,
                    Camera::RendToFramebuffer::type::typeinfo,
                    Camera::Clear::type::typeinfo,
                    Editor::Invisible::type::typeinfo,
                ]);
                
            let e = new_world->add_entity([
                    Transform::Translation::type::typeinfo,
                    Transform::LocalPosition::type::typeinfo,
                    Transform::LocalRotation::type::typeinfo,
                    Transform::LocalToWorld::type::typeinfo,
                    Renderer::Shaders::type::typeinfo,
                    Renderer::Shape::type::typeinfo,
                ]);
                
            e->towoo::get_component:<Transform::LocalPosition>->unwrap.pos->set(
                (0., 0., 1.) as vec3);
                
            let e2 = new_world->add_entity([
                    Transform::Translation::type::typeinfo,
                    Transform::LocalPosition::type::typeinfo,
                    Transform::LocalRotation::type::typeinfo,
                    Transform::LocalToWorld::type::typeinfo,
                    Renderer::Shaders::type::typeinfo,
                    Renderer::Shape::type::typeinfo,
                ]);
                
            e2->towoo::get_component:<Transform::LocalPosition>->unwrap.pos->set(
                (0., 1.5, 1.) as vec3);
                
            new_world->set_enable(true);
            
            for (let mut i = 0;; i += 1)
            {
                match (Windows::show(
                        create(
                            new_world,
                            i == 0 ? "New world" | F"New world {i + 1}",
                            option::none)))
                {
                    none?;
                    value(_)?
                        break;
                }
            }
        }
    }
}
