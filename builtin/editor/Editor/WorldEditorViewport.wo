import woo::std;

import je;
import je::ecs;
import je::graphic;
import je::gui;
import je::typeinfo;

import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::fsys;
import pkg::interface;
import pkg::worst;
import pkg::iterator;
import pkg::try;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Menu;
import builtin::editor::GUI::Icons;
import builtin::editor::GUI::Drag;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;

import builtin::editor::Inspector::World;
import builtin::editor::Inspector::Universe;

using std;

using je;
using je::gui;
using je::graphic;
using fsys;

using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Drag;
using JEEditor::GUI::Forms;
using JEEditor::GUI::Icons;

namespace JEEditor::Editor
{
    using WorldEditorViewport = struct{
        m_close: mut CloseRequest,
        
        m_world_instance: world,
        
        // World context:
        m_name: string,
        
        m_runtime_systems: vec<typeinfo>,
        m_saving_path: option<path_t>,
        
        // Editor context:
        m_editor_walk_camera_frame_buffer: mut option<graphic::framebuffer>,
    }
    {
        let TRASNLATION_SYSTEM_TYPE =
            typeinfo::load("Translation::TranslationUpdatingSystem")->unwrap;
        let DEFAULT_GRAPHIC_SYSTEM_TYPE =
            typeinfo::load("Graphic::UnlitGraphicPipelineSystem")->unwrap;
            
        enum CloseRequest
        {
            NORMALLY,
            CLOSE_BUT_KEEP_WORLD,
        }
        
        let s_world_viewports = {}mut: map<world, WorldEditorViewport>;
        let mut s_last_focusd_world_view = option::none: option<WorldEditorViewport>;
        
        func create(w: world, name: string, path: option<path_t>)=> WorldEditorViewport
            where require!(WorldEditorViewport: IWindows);
        {
            // 注意：按照设计，WorldEditorViewport 的生命周期应当比 world 实例更长
            //      因此，世界实例的释放将由 WorldEditorViewport 在 onClose 时执行
            return WorldEditorViewport{
                m_close = mut CloseRequest::NORMALLY,
                
                m_world_instance = w,
                
                m_name = name,
                m_runtime_systems = []mut,
                m_saving_path = path,
                
                m_editor_walk_camera_frame_buffer = mut option::none,
            };
        }
        
        func isCurrentViewportAvailable(self: WorldEditorViewport)
        {
            match (s_world_viewports->get(self.m_world_instance))
            {
                none?;
                value(wv)?
                    return std::is_same(wv, self);
            }
            return false;
        }
        
        public func onCreate(self: WorldEditorViewport)=> void
        {
            s_world_viewports->set(self.m_world_instance, self);
        }
        public func onClose(self: WorldEditorViewport)=> void
        {
            match (s_last_focusd_world_view)
            {
                none?;
                value(v)?
                    if (std::is_same(v, self))
                        s_last_focusd_world_view = option::none;
            }
            
            if (self.m_close != CloseRequest::CLOSE_BUT_KEEP_WORLD
                && self->isCurrentViewportAvailable)
            {
                do s_world_viewports->remove(self.m_world_instance);
                self.m_world_instance->close;
            }
        }
        public func getTitle(self: WorldEditorViewport)=> string
        {
            let saving_path = self.m_saving_path->> \p = p->to_string;;
            
            return F"世界视口：{self.m_name}##{saving_path->or(":<unsaved>")}";
        }
        public func getMenu(self: WorldEditorViewport)=> option<Menu>
        {
            func inputForRenamingWorld()=> void
            {
                InputBox::show("新世界名", "请输入新的世界名称", self.m_name)
                    -> then(
                        func(new_name)
                        {
                            self->dropAndRename(new_name);
                        });
            }
            
            return option::value <|
                Menu::create("")
                    -> subMenu("编辑")
                    ->  subItem("重命名", inputForRenamingWorld)
                    ->  endItem
                    -> endMenu
                    ;
        }
        public func getSizeConstraints(_: WorldEditorViewport)=> SizeConstraints
        {
            return SizeConstraints::Limited(((320., 240.), (4096., 4096.)));
        }
        
        public func run(self: WorldEditorViewport)=> bool
        {
            if (IsWindowFocused())
                s_last_focusd_world_view = option::value(self);
                
            match (self.m_editor_walk_camera_frame_buffer)
            {
                none?
                {
                    TextDisabled("（没有有效的渲染结果，等待重新创建……）");
                }
                value(_)?
                {
                    let (w, h) = GetContentRegionAvail();
                    ImageSize(Icons::FILE->unwrap, w, h);
                }
            }
            
            return self.m_close == CloseRequest::NORMALLY;
        }
        
        // ==========================
        
        public func getRuntimeSystems(self: WorldEditorViewport)=> array<typeinfo>
        {
            return self.m_runtime_systems->to_array();
        }
        
        public func getName(self: WorldEditorViewport)=> string
        {
            return self.m_name;
        }
        
        public func getSavingPath(self: WorldEditorViewport)=> option<path_t>
        {
            return self.m_saving_path;
        }
        
        public func dropAndRename(self: WorldEditorViewport, new_name: string)=> void
        {
            if (self->isCurrentViewportAvailable && self.m_name != new_name)
            {
                match (Windows::show(create(self.m_world_instance, new_name, self.m_saving_path)))
                {
                    none?
                    {
                        MsgBox::err(
                            "重命名失败", "重命名世界失败，存在同名的未保存世界");
                            
                        if (!self.m_saving_path->is_none)
                            // 这种情况通常情况下不应该发生
                            logerr("Failed to rename world: duplicated opened world?");
                    }
                    value(_)?
                        self.m_close = CloseRequest::CLOSE_BUT_KEEP_WORLD;
                }
            }
        }
        
        // ==========================
        
        public func findWorldEditorViewport(w: world)
        {
            return s_world_viewports->get(w);
        }
        
        public func getLastFocused()
        {
            return s_last_focusd_world_view;
        }
        
        public func createNewWorldToEdit()
        {
            let new_world = world::create(
                Inspector::Universe::UniverseCtx::instance()->getUniverse());
                
            // Create default graphic pipe line.
            do new_world->add_system(DEFAULT_GRAPHIC_SYSTEM_TYPE);
            do new_world->add_system(TRASNLATION_SYSTEM_TYPE);
            
            // Create editor camera.
            do new_world->add_entity([
                    Transform::Translation::type::typeinfo,
                    Transform::LocalPosition::type::typeinfo,
                    Transform::LocalRotation::type::typeinfo,
                    Transform::LocalToWorld::type::typeinfo,
                    Camera::Projection::type::typeinfo,
                    Camera::PerspectiveProjection::type::typeinfo,
                    Camera::RendToFramebuffer::type::typeinfo,
                    Editor::Invisible::type::typeinfo,
                ]);
                
            let e = new_world->add_entity([
                    Transform::Translation::type::typeinfo,
                    Transform::LocalPosition::type::typeinfo,
                    Transform::LocalRotation::type::typeinfo,
                    Transform::LocalToWorld::type::typeinfo,
                    Renderer::Shaders::type::typeinfo,
                    Renderer::Shape::type::typeinfo,
                ]);
                
            e->towoo::get_component:<Transform::LocalPosition>->unwrap.pos->set(
                (0., 0., 1.) as vec3);
                
            new_world->set_enable(true);
            
            for (let mut i = 0;; i += 1)
            {
                match (Windows::show(
                        create(
                            new_world,
                            i == 0 ? "New world" | F"New world {i + 1}",
                            option::none)))
                {
                    none?;
                    value(_)?
                        break;
                }
            }
        }
    }
}
