import pkg::std;

import je::ecs;

import builtin::editor::GUI::Menu;
import builtin::editor::GUI::Forms::AskBox;

import Browser;
import EntityList;
import LogBrowser;
import SystemList;
import Material;
import ReplConsole;
import WorldEditorViewport;
import Inspector;
import DebugRun;
import Project;
import About;
import ExportProject;
import OpenWorld;
import SystemShell;
import Diagnostics;
import ShaderUpdater;
import Shutdown;

import builtin::editor::Singleton::Universe;

using std;
using JEEditor::GUI::Forms;

namespace JEEditor::Editor::MainMenu
{
    using GUI;

    // “开始运行”可用条件：未在运行/停止过渡、未冻结、宇宙中至少有一个世界
    func canStartDebugRun()=> bool
    {
        if (DebugRun::isDebugRunActive())
            return false;
        if (WorldEditorViewport::isWorldsFrozen())
            return false;
        return Singleton::Universe::getUniverse()->get_all_worlds->len > 0;
    }

    // “保存/保存全部”可用条件：未在运行/停止过渡、未冻结（冻结/调试运行
    // 期间世界不落盘，见 WorldEditorViewport::saveWorldTo 的拦截）
    func canSaveAllWorlds()=> bool
    {
        if (DebugRun::isDebugRunActive())
            return false;
        if (WorldEditorViewport::isWorldsFrozen())
            return false;
        return true;
    }

    // “导出项目”可用条件：未在运行/停止过渡、未冻结。导出会以 RELEASE
    // 重新编译模块并写 .export，冻结期间（世界暂停等待重建）不应插入。
    func canExportProject()=> bool
    {
        if (DebugRun::isDebugRunActive())
            return false;
        if (WorldEditorViewport::isWorldsFrozen())
            return false;
        return true;
    }

    // 退出编辑器：与窗口关闭按钮走同一套确认与收尾流程
    //（Shutdown 会依次请求所有窗口关闭，并把编辑器状态写入 Tombs）
    func requestExit()
    {
        do AskBox::show(
                "退出编辑器",
                "退出前请确认已保存修改。JoyEngine 将依次关闭所有编辑器窗口，继续退出？")
            ->onYes(func(){
                    Shutdown::editorShutdownRequest(
                        Singleton::Universe::getUniverse());
                });
    }

    public func registerMainMenu()
    {
        let engineMainMenu = Menu::create("")
            -> subMenu("JoyEngine")
            ->  subItem("关于 JoyEngine", About::showAbout)
            ->      endItem
            ->  separator()
            ->  subItem("退出编辑器", requestExit)
            ->      endItem
            ->  endMenu
            -> subMenu("文件")
            ->  subItem("新建世界", WorldEditorViewport::createNewWorldToEdit)
            ->      endItem
            ->  subItem("打开世界...", OpenWorld::showOpenWorld)
            ->      endItem
            ->  separator()
            ->  subItem("保存", WorldEditorViewport::saveFocusedWorld)
            ->      enableWhen(canSaveAllWorlds)
            ->      endItem
            ->  subItem("保存全部", WorldEditorViewport::saveAllWorlds)
            ->      enableWhen(canSaveAllWorlds)
            ->      shortCut("Ctrl+Shift+S")
            ->      endItem
            ->  separator()
            ->  subItem("导出项目...", \= ExportProject::showExportProject();)
            ->      enableWhen(canExportProject)
            ->      endItem
            ->  endMenu
            -> subMenu("视图")
            ->  subItem("项目资源管理器",
                func()
                {
                    if (Browser::isBrowserExist())
                        Browser::closeBrowser();
                    else
                        Browser::showBrowser();
                })
            ->      checkWhen(Browser::isBrowserExist)
            ->      endItem
            ->  subItem("日志浏览器",
                func()
                {
                    if (LogBrowser::isLogBrowserExist())
                        LogBrowser::closeLogBrowser();
                    else
                        LogBrowser::showLogBrowser();
                })
            ->      checkWhen(LogBrowser::isLogBrowserExist)
            ->      endItem
            ->  subItem("实体列表",
                func()
                {
                    if (EntityList::isEntityListExist())
                        EntityList::closeEntityList();
                    else
                        EntityList::showEntityList();
                })
            ->      checkWhen(EntityList::isEntityListExist)
            ->      endItem
            ->  subItem("系统列表",
                func()
                {
                    if (SystemList::isSystemListExist())
                        SystemList::closeSystemList();
                    else
                        SystemList::showSystemList();
                })
            ->      checkWhen(SystemList::isSystemListExist)
            ->      endItem
            ->  subItem("检视面板",
                func()
                {
                    if (Inspector::isInspectorExist())
                        Inspector::closeInspector();
                    else
                        Inspector::showInspector();
                })
            ->      checkWhen(EntityList::isEntityListExist)
            ->      endItem
            ->  subItem("材质编辑器",
                func()
                {
                    if (Material::isMaterialExist())
                        Material::closeMaterial();
                    else
                        Material::showMaterial();
                })
            ->      checkWhen(Material::isMaterialExist)
            ->      endItem
            ->  subItem("Woolang REPL",
                func()
                {
                    if (ReplConsole::isReplConsoleExist())
                        ReplConsole::closeReplConsole();
                    else
                        ReplConsole::showReplConsole();
                })
            ->      checkWhen(ReplConsole::isReplConsoleExist)
            ->      endItem
            ->  endMenu
            -> subMenu("编辑")
            ->  subItem("更新类型 & 编辑器", Project::updateEditorTypes)
            ->      endItem
            ->  subItem("重新编译 ToWoo", Project::recompileAllToWoo)
            ->      endItem
            ->  endMenu
            -> subMenu("运行")
            ->  subItem("开始运行", \= do DebugRun::startDebugRun();)
            ->      enableWhen(canStartDebugRun)
            ->      shortCut("Shift+F5")
            ->      endItem
            ->  endMenu
            -> subMenu("工具")
            ->  subItem("在资源管理器中打开项目目录", SystemShell::revealProjectDir)
            ->      endItem
            ->  subItem("在 VSCode 中打开项目", SystemShell::openProjectInVSCode)
            ->      endItem
            ->  separator()
            ->  subItem("更新全部着色器", ShaderUpdater::updateAll)
            ->      endItem
            ->  subItem("复制诊断信息", Diagnostics::copyDiagnosticInfo)
            ->      endItem
            ->  endMenu
            -> subMenu("帮助")
            ->  subItem("关于 JoyEngine", About::showAbout)
            ->      endItem
            ->  endMenu
            ;

        Menu::registerMainMenu(engineMainMenu);
    }
}
