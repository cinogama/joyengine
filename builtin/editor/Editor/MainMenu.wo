import builtin::editor::GUI::Menu;

import Browser;
import EntityList;
import LogBrowser;
import ReplConsole;
import WorldEditorViewport;

namespace JEEditor::Editor::MainMenu
{
    using GUI;
    
    public func registerMainMenu()
    {
        let engineMainMenu = Menu::create("")
            -> subMenu("JoyEngine")
            ->  endMenu
            -> subMenu("文件")
            ->  endMenu
            -> subMenu("视图")
            ->  subItem("项目资源管理器",
                func()
                {
                    if (Browser::isBrowserExist())
                        Browser::closeBrowser();
                    else
                        Browser::showBrowser();
                })
            ->      checkWhen(Browser::isBrowserExist)
            ->      endItem
            ->  subItem("实体列表",
                func()
                {
                    if (EntityList::isEntityListExist())
                        EntityList::closeEntityList();
                    else
                        EntityList::showEntityList();
                })
            ->      checkWhen(EntityList::isEntityListExist)
            ->      endItem
            ->  subItem("日志浏览器",
                func()
                {
                    if (LogBrowser::isLogBrowserExist())
                        LogBrowser::closeLogBrowser();
                    else
                        LogBrowser::showLogBrowser();
                })
            ->      checkWhen(LogBrowser::isLogBrowserExist)
            ->      endItem
            ->  subItem("Woolang REPL",
                func()
                {
                    if (ReplConsole::isReplConsoleExist())
                        ReplConsole::closeReplConsole();
                    else
                        ReplConsole::showReplConsole();
                })
            ->      checkWhen(ReplConsole::isReplConsoleExist)
            ->      endItem
            ->  endMenu
            -> subMenu("编辑")
            ->  subItem("新建世界", WorldEditorViewport::createNewWorldToEdit)
            ->      endItem
            ->  endMenu
            -> subMenu("工具")
            ->  endMenu
            -> subMenu("帮助")
            ->  endMenu
            ;
            
        Menu::registerMainMenu(engineMainMenu);
    }
}
