import pkg::std;

import je;
import je::gui;
import je::internal;

import pkg::interface;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Theme;

using std;
using je;
using je::gui;
using JEEditor::GUI;
using JEEditor::GUI::Windows;

namespace JEEditor::Editor
{
    // 一条日志的展示缓存。日志到达时一次性算好展示行与小写消息：
    // 缓冲可能有上万条，若每帧重绘时再拼接字符串/转小写，会随日志量
    // 线性放大每帧的 CPU 开销。
    using LogEntry = struct{
        public m_level: internal::loglevel,
        public m_message: string,
        public m_lower: string,
        public m_line: string,
    };
    
    // 日志浏览器
    // je::internal::getlogs(钩子) 是“排空式”接口：每次调用只返回该钩子自上次调用以来新增的日志。
    // 因此这里维护一个本地累积缓冲 m_logs，每帧排空 getlogs() 追加进去，
    // 并提供过滤、着色、自动滚动与上限裁剪。
    using LogBrowser = struct{
        m_close: mut bool,
        m_hook: handle,
        
        // 本地累积的日志缓冲（getlogs 每次只返回增量）
        m_logs: vec<LogEntry>,
        
        // 等级过滤开关
        m_show_normal: mut bool,
        m_show_info: mut bool,
        m_show_warning: mut bool,
        m_show_error: mut bool,
        m_show_fatal: mut bool,
        
        // 文本过滤
        m_filter: mut string,
        
        // 滚动与计数
        m_auto_scroll: mut bool,
        m_last_count: mut int,    // 上一帧缓冲长度，用于检测新日志到达
        
        // 过滤后的计数缓存：只在日志到达或过滤条件变化时重算，
        // 不随重绘逐帧遍历整个缓冲
        m_count_total: mut int,
        m_count_shown: mut int,
        m_count_dirty: mut bool,
    }
    {
        // 缓冲上限：超过则只保留最近的 MAX_LOGS 条，避免无界增长
        let MAX_LOGS = 10000;
        
        let mut s_logbrowser_singleton = option::none: option<LogBrowser>;
        public func isLogBrowserExist()
        {
            return s_logbrowser_singleton->is_value;
        }
        public func showLogBrowser()
        {
            do show(create());
        }
        public func closeLogBrowser()
        {
            match (s_logbrowser_singleton)
            {
                none?;
                value(inst)?
                    inst->close();
            }
        }
        
        public func create()=> LogBrowser
            where require!(LogBrowser: IWindows);
        {
            return LogBrowser{
                m_close = mut false,
                m_hook = internal::hooklog(),
                m_logs = []mut as vec<LogEntry>,
                m_show_normal = mut true,
                m_show_info = mut true,
                m_show_warning = mut true,
                m_show_error = mut true,
                m_show_fatal = mut true,
                m_filter = mut "",
                m_auto_scroll = mut true,
                m_last_count = mut 0,
                m_count_total = mut 0,
                m_count_shown = mut 0,
                m_count_dirty = mut true,
            };
        }
        
        func close(self: LogBrowser)
        {
            self.m_close = true;
        }
        public func getTitle(_: LogBrowser)=> string
        {
            return "日志浏览器";
        }
        public func getSizeConstraints(_: LogBrowser)=> SizeConstraints
        {
            return SizeConstraints::Limited(((420., 200.), (4096., 4096.)));
        }
        public func onCreate(self: LogBrowser)=> void
        {
            s_logbrowser_singleton = option::value(self);
        }
        public func onClose(_: LogBrowser)=> void
        {
            s_logbrowser_singleton = option::none;
        }
        public func onDestroy(self: LogBrowser)
        {
            internal::unhooklog(self.m_hook);
        }
        // 排空 getlogs() 的增量日志到本地缓冲，并在超限时裁剪。
        // 展示行在此处格式化（一次性），计数标脏延迟到绘制前重算。
        func drainLogs(self: LogBrowser)=> void
        {
            let mut appended = false;
            for (let (lvl, msg) : internal::getlogs(self.m_hook))
            {
                self.m_logs->add(LogEntry{
                        m_level = lvl,
                        m_message = msg,
                        m_lower = msg->lower,
                        m_line = F"[{levelName(lvl)}] {msg}",
                    });
                appended = true;
            }
                
            let cur = self.m_logs->len;
            if (cur > MAX_LOGS)
                self.m_logs->copy_from(self.m_logs->sub(cur - MAX_LOGS));
                
            if (appended)
                self.m_count_dirty = true;
        }
        
        func levelShown(self: LogBrowser, lvl: internal::loglevel)=> bool
        {
            if (lvl == internal::loglevel::NORMAL)
                return self.m_show_normal;
            if (lvl == internal::loglevel::INFO)
                return self.m_show_info;
            if (lvl == internal::loglevel::WARNING)
                return self.m_show_warning;
            if (lvl == internal::loglevel::ERROR)
                return self.m_show_error;
            return self.m_show_fatal;
        }
        
        func levelName(lvl: internal::loglevel)=> string
        {
            if (lvl == internal::loglevel::NORMAL)
                return "NORMAL";
            if (lvl == internal::loglevel::INFO)
                return "INFO";
            if (lvl == internal::loglevel::WARNING)
                return "WARN";
            if (lvl == internal::loglevel::ERROR)
                return "ERROR";
            return "FATAL";
        }
        
        func levelColor(lvl: internal::loglevel)=> Color32RGBA
        {
            if (lvl == internal::loglevel::NORMAL)
                return Theme::TEXT;
            if (lvl == internal::loglevel::INFO)
                return Theme::INFO;
            if (lvl == internal::loglevel::WARNING)
                return Theme::WARNING;
            if (lvl == internal::loglevel::ERROR)
                return Theme::DANGER;
            return (255, 70, 70, 255);
        }
        
        func matchesFilter(self: LogBrowser, entry: LogEntry)=> bool
        {
            if (self.m_filter->len == 0)
                return true;
            return entry.m_lower->find(self.m_filter->lower)->is_value;
        }
        
        // 统计满足过滤条件的日志数量: (总数, 可见数)
        func countVisible(self: LogBrowser)=> (int, int)
        {
            let mut total = 0;
            let mut shown = 0;
            for (let entry : self.m_logs)
            {
                total += 1;
                if (self->levelShown(entry.m_level) && self->matchesFilter(entry))
                    shown += 1;
            }
            return (total, shown);
        }
        
        func copyVisible(self: LogBrowser)=> void
        {
            let mut buf = "";
            for (let entry : self.m_logs)
            {
                if (self->levelShown(entry.m_level) && self->matchesFilter(entry))
                    buf = buf + entry.m_line + "\n";
            }
            SetClipboardText(buf);
        }
        
        public func run(self: LogBrowser)=> bool
        {
            self->drainLogs();
            
            // 计数只在日志到达/过滤条件变化时重算
            if (self.m_count_dirty)
            {
                let (total, shown) = self->countVisible();
                self.m_count_total = total;
                self.m_count_shown = shown;
                self.m_count_dirty = false;
            }
            
            self->drawToolbar(self.m_count_total, self.m_count_shown);
            Separator();
            
            let avail = GetContentRegionAvail();
            let list_flags = WindowsAttribute::ImGuiWindowFlags_HorizontalScrollbar;
            if (BeginChildSizeFlags("##LogList", avail.0, avail.1, list_flags))
                self->drawLogs();
            EndChild();
            
            return !self.m_close;
        }
        
        func drawToolbar(self: LogBrowser, total: int, shown: int)=> void
        {
            // 第一行：视图操作 + 自动滚动 + 统计。破坏性的“清除”用
            // 幽灵按钮，避免和常用操作抢注意力。
            if (Theme::ghostButton("清除", (0., 0.)))
            {
                self.m_logs->clear();
                self.m_count_dirty = true;
            }
            SameLine();
            if (Theme::ghostButton("复制全部", (0., 0.)))
                self->copyVisible();
            SameLine();
            match (CheckBox("自动滚动##lb_autoscroll", self.m_auto_scroll))
            {
                none?;
                value(v)?
                    self.m_auto_scroll = v;
            }
            
            Theme::toolbarSeparator();
            Theme::statText(F"共 {total} 条 / 显示 {shown} 条");
            
            // 第二行：等级筛选芯片（颜色即语义）+ 文本搜索。芯片激活时
            // 用等级色浅底，一眼能看出当前过滤了哪些等级。
            let mut changed = false;
            if (Theme::levelChip("正常##lb_n", self.m_show_normal,
                    levelColor(internal::loglevel::NORMAL)))
            {
                self.m_show_normal = !self.m_show_normal;
                changed = true;
            }
            SameLine();
            if (Theme::levelChip("信息##lb_i", self.m_show_info,
                    levelColor(internal::loglevel::INFO)))
            {
                self.m_show_info = !self.m_show_info;
                changed = true;
            }
            SameLine();
            if (Theme::levelChip("警告##lb_w", self.m_show_warning,
                    levelColor(internal::loglevel::WARNING)))
            {
                self.m_show_warning = !self.m_show_warning;
                changed = true;
            }
            SameLine();
            if (Theme::levelChip("错误##lb_e", self.m_show_error,
                    levelColor(internal::loglevel::ERROR)))
            {
                self.m_show_error = !self.m_show_error;
                changed = true;
            }
            SameLine();
            if (Theme::levelChip("致命##lb_f", self.m_show_fatal,
                    levelColor(internal::loglevel::FATAL)))
            {
                self.m_show_fatal = !self.m_show_fatal;
                changed = true;
            }
            if (changed)
                self.m_count_dirty = true;
            
            // 第三行：搜索单独成行，保证面板收窄到 420px 时等级芯片
            // 与输入框不会互相挤压
            Spacing();
            Text("搜索:");
            SameLine();
            PushItemWidth(220.);
            match (InputText("##LogFilter", self.m_filter))
            {
                none?;
                value(s)?
                {
                    self.m_filter = s;
                    self.m_count_dirty = true;
                }
            }
            PopItemWidth();
        }
        
        func drawLogs(self: LogBrowser)=> void
        {
            PushTextWrapPos(0.);
            defer PopTextWrapPos();
            
            let mut drew_any = false;
            for (let entry : self.m_logs)
            {
                if (self->levelShown(entry.m_level) && self->matchesFilter(entry))
                {
                    drew_any = true;
                    TextColored(levelColor(entry.m_level), entry.m_line);
                }
            }
            
            if (!drew_any)
                Theme::emptyState("暂无匹配的日志",
                    "引擎输出、警告与错误会实时出现在这里。");
                
            // 自动滚动：当有新日志到达时，将视图钉在底部
            let cur_count = self.m_logs->len;
            if (self.m_auto_scroll && cur_count != self.m_last_count && drew_any)
                SetScrollHereY(1.);
            self.m_last_count = cur_count;
            
            // 右键上下文菜单
            if (BeginPopupContextWindow())
            {
                defer EndPopup();

                if (MenuItem("复制全部可见日志"))
                    self->copyVisible();
                if (MenuItem("清除"))
                {
                    self.m_logs->clear();
                    self.m_count_dirty = true;
                }
            }
        }
    }
}
