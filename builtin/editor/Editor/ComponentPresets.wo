    // 粒子模拟查询要求 Renderer::Shape（写入公告板网格），渲染还需
    // Shaders / Textures2D（粒子纹理绑在 Textures2D 的 pass 0）
    public let PARTICLE_EMITTER_COMPONENTS = [
        "Particle::Emitter", "Renderer::Shape", "Renderer::Shaders",
        "Renderer::Textures2D",
    ];

    // 常用组件组合表：(分组标题, [(组合名, [组件类型全名...])...])
    public let s_component_presets = [
