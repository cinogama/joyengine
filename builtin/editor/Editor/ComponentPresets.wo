    // 组合内组件名拼接为悬停提示文本（顿号分隔）
    public func presetTipText(cnames: array<string>)=> string
    {
        let mut tip = "";
        for (let cname : cnames)
            tip = (tip->len == 0) ? cname | F"{tip}、{cname}";
        return tip;
    }
}
