            ("UI变换", UI_TRANSFORM_COMPONENTS),
        ]),
        ("渲染", [
            ("基本渲染", BASE_RENDERER_COMPONENTS),
            // 文本由 UI 管线逐字直接绘制，但 UI 渲染查询把 Renderer::Shaders
            // 列为必需组件（缺 Shaders 的文本实体不会被绘制）；这里一并挂上
            //（着色器内容随后由用户在材质面板指定，如 UIText.shader），
            // 可选挂 Renderer::Color 作整段色调
            ("UI文本", [
                "UserInterface::Element", "UserInterface::WorldLayout",
                "UserInterface::Text", "Renderer::Shaders"]),
            ("动画播放器", ["Animation::Animator"]),
            ("粒子发射器", PARTICLE_EMITTER_COMPONENTS),
        ]),
        ("2D光照", [
            ("点光源", LIGHT2D_POINT_COMPONENTS),
            ("范围光源", LIGHT2D_RANGE_COMPONENTS),
            ("平行光源", LIGHT2D_PARALLEL_COMPONENTS),
            ("常用阴影", LIGHT2D_SHADOW_COMMON_COMPONENTS),
        ]),
        ("摄像机", [
            ("透视相机", CAMERA_PERSPECTIVE_COMPONENTS),
