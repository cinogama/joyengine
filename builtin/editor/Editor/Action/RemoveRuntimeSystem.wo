import woo::std;

import je;
import je::ecs;
import je::typeinfo;

import pkg::interface;
import pkg::try;

import builtin::editor::Editor::WorldEditorViewport;

import IAction;

using je;

namespace JEEditor::Editor::Action
{
    // 从 WorldEditorViewport 的调试系统列表（m_runtime_systems）中移除系统；
    // undo 时重新加回列表。
    // 只保存系统类型名，redo/undo 执行时再通过 typeinfo::load 加载，
    // 避免 typeinfo 句柄在类型热重载等情况下失效。
    protected using RemoveRuntimeSystem = struct{
        m_system_type_name: string,
    }
    {
        public func create(systype: typeinfo)=> RemoveRuntimeSystem
            where require!(RemoveRuntimeSystem: IAction);
        {
            return RemoveRuntimeSystem{
                m_system_type_name = systype->name,
            };
        }

        // 系统已不在调试系统列表中时视为成功（幂等）
        public func redo(self: RemoveRuntimeSystem, w: WorldEditorViewport)=> bool
        {
            match (typeinfo::load(self.m_system_type_name))
            {
                none? return false;
                value(systype)?
                {
                    do w->removeRuntimeSystem(systype);
                    return true;
                }
            }
        }

        // 系统已在调试系统列表中时视为成功（幂等）
        public func undo(self: RemoveRuntimeSystem, w: WorldEditorViewport)=> bool
        {
            match (typeinfo::load(self.m_system_type_name))
            {
                none? return false;
                value(systype)?
                {
                    do w->addRuntimeSystem(systype);
                    return true;
                }
            }
        }

        public func describe(self: RemoveRuntimeSystem)=> string
        {
            return F"移除调试系统 {self.m_system_type_name}";
        }
    }
}
