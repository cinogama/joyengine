import woo::std;

import je;
import je::ecs;
import je::internal;
import je::typeinfo;
import je::towoo;
import je::towoo::types;
import je::towoo::components;

import pkg::toml;
import pkg::try;
import pkg::interface;

import builtin::editor::Editor::Saving::Entity;
import builtin::editor::Editor::WorldEditorViewport;

import IAction;

using je;
using toml;
using JEEditor::Saving;

namespace JEEditor::Editor::Action
{
    using FullEntityContent = struct{
        m_eid: mut option<EuidT>,
        m_entity_content: Toml,
    }
    {
        alias EuidT = entity::internal::euid_t;
        
        // 从活的实体做全量快照（销毁实体等需要完整还原内容的场合）
        func try_create(e: entity)
        {
            try! eid = e->internal::get_entity_uid;
            return_value! FullEntityContent{
                m_eid = mut option::value(eid),
                m_entity_content = Entity::save(e),
            };
        }
        
        // 只按组件类型构造：不依赖活的实体，组件成员由 ECS 默认构造
        // （成员表留空即默认值）；EUID 延迟到动作首次落实时分配并回填
        func try_create_with_types(ctypes: array<typeinfo>)=> FullEntityContent
        {
            let components_dat = new_table();
            for (let ctype : ctypes)
                components_dat->set(ctype->name, new_table());
                
            // Editor::EntityId 必须包含在起始组件集合里：当前帧事后新增的
            // 组件 get 不到，而 get_entity_uid 依赖 get component；放进起始
            // 集合后，原生侧构造该组件时即分配有效的调试 EUID
            components_dat->set(
                Editor::EntityId::type::typeinfo->name, new_table());
                
            let entity_dat = new_table();
            entity_dat->set("components", components_dat);
            
            return FullEntityContent{
                m_eid = mut option::none,
                m_entity_content = entity_dat,
            };
        }

        // 从既有实体数据（复制到剪贴板的实体快照等）构造：快照不含
        // Editor:: 组件（save 跳过），补上空的 Editor::EntityId 让原生侧
        // 构造时分配全新的调试 EUID（同 try_create_with_types）；
        // 挂预设体的差异数据由还原端展开并挂回预设体（见
        // Saving::Entity::restore）；m_eid 保持 none，动作首次落实时回填
        func try_create_with_content(entity_content: Toml)=> FullEntityContent
        {
            let content = entity_content->clone();

            match (content->get("components"))
            {
                value(components_dat)?
                    components_dat->set(
                        Editor::EntityId::type::typeinfo->name,
                        new_table());
                none?
                {
                    // 差异数据（挂预设体且与预设体完全一致的实体快照）
                    // 没有 components 键，这是合法形态：补建空表并加上
                    // Editor::EntityId——还原端展开差异数据时（apply）会
                    // 把它并入预设体的组件集合，由原生侧构造时分配全新
                    // 的调试 EUID
                    let components_dat = new_table();
                    components_dat->set(
                        Editor::EntityId::type::typeinfo->name,
                        new_table());
                    content->set("components", components_dat);
                }
            }

            return FullEntityContent{
                m_eid = mut option::none,
                m_entity_content = content,
            };
        }
        
        // 实体名快照；快照未记录名字时返回空串
        public func entity_name(self: FullEntityContent)=> string
        {
            return (self.m_entity_content->get("name")=>> \v = v->as_string;)->or("");
        }
    }
    
    protected using CreateEntity = struct{
        m_content: FullEntityContent,
        // 生成点（世界坐标）：落实（redo）时写入新实体
        // Transform::LocalPosition 的 pos；none = 不干预位置
        //（组件默认值/快照原位置）。构造时固定，撤销重做保持一致
        m_spawn_pos: option<vec3>,
    }
    {
        public func try_create(new_created: entity)=> option<CreateEntity>
            where require!(CreateEntity: IAction);
        {
            return try!{
                try! full_entity_content = FullEntityContent::try_create(new_created);
                return_value! CreateEntity{
                    m_content = full_entity_content,
                    m_spawn_pos = option::none,
                };
            } catch! {
                logerr("传入的实体应当有对应的 EUID，请检查创建/销毁的实体流程");
            };
        }
        // 按组件类型直接构造可撤销的“创建实体”动作：实体与 EUID 均由
        // 动作首次落实（redo）时创建/分配，调用方无需也不应预先创建实体
        public func try_create_with_types(ctypes: array<typeinfo>)=> CreateEntity
            where require!(CreateEntity: IAction);
        {
            return CreateEntity{
                m_content = FullEntityContent::try_create_with_types(ctypes),
                m_spawn_pos = option::none,
            };
        }
        // 同 try_create_with_types，但落实时把新实体的
        // Transform::LocalPosition 放到 spawn_pos（编辑器“新建实体放到
        // 摄像机前方”用，见 WorldEditorViewport 的
        // getSpawnPosInFrontOfCamera）
        public func try_create_with_types_at(
            ctypes: array<typeinfo>,
            spawn_pos: option<vec3>)=> CreateEntity
            where require!(CreateEntity: IAction);
        {
            return CreateEntity{
                m_content = FullEntityContent::try_create_with_types(ctypes),
                m_spawn_pos = spawn_pos,
            };
        }
        // 从既有实体数据（复制到剪贴板的实体快照）构造可撤销的“创建
        // 实体”动作：EUID 由动作首次落实时新分配，粘贴出的实体与源
        // 实体拥有不同的 EUID
        public func try_create_with_content(entity_content: Toml)=> CreateEntity
            where require!(CreateEntity: IAction);
        {
            return CreateEntity{
                m_content = FullEntityContent::try_create_with_content(
                    entity_content),
                m_spawn_pos = option::none,
            };
        }
        // 同 try_create_with_content，但落实时把新实体的
        // Transform::LocalPosition 放到 spawn_pos（视口内“粘贴到摄像机
        // 前方”用）；组件集合中没有该组件的实体无从放置，保持数据原值
        public func try_create_with_content_at(
            entity_content: Toml,
            spawn_pos: option<vec3>)=> CreateEntity
            where require!(CreateEntity: IAction);
        {
            return CreateEntity{
                m_content = FullEntityContent::try_create_with_content(
                    entity_content),
                m_spawn_pos = spawn_pos,
            };
        }
        public func redo(self: CreateEntity, w: WorldEditorViewport)=> bool
        {
            let e = Entity::restore(w->getWorld(), self.m_content.m_entity_content);
            let mut entity_id = self.m_content.m_eid;
            
            match (entity_id)
            {
                // 首次落实：Editor::EntityId 已包含在起始组件集合中，原生侧
                // 构造时即分配调试 EUID，读取并回填到动作里，供撤销定位
                // 与后续重做复用
                none?
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?
                        {
                            logerr(
                                "创建实体：起始组件集合中的 Editor::EntityId 未分配 EUID");
                            // 销毁刚创建的实体再报失败：Practice 对失败的
                            // 动作会推迟一帧重试，留着它会重复创建出多个
                            // 无 EUID 的泄漏实体
                            do e->close;
                            return false;
                        }
                        value(eid)?
                            self.m_content.m_eid = entity_id := option::value(eid);
                    }
                }
                // 撤销后的重做：以记录的 EUID 还原，保持实体标识稳定
                value(eid)?
                    e->internal::unsafe::set_entity_uid(eid);
            }

            // 生成点（世界坐标）：写入新实体的局部位置。LocalPosition
            // 属于起始组件集合时随实体构造已生效，同帧可取（同
            // Editor::EntityId 的读取时机）。挂 LocalToParent 的实体
            //（粘贴快照保留了源实体的父子关系，副本会挂到源实体的父下）
            // 须先换算到父锚点的局部空间，否则局部坐标被当成世界坐标
            // 写入会偏掉（见 getLocalPosUnderParentAnchor）；父不在本
            // 世界时无从换算，保持快照原值。实体没有 LocalPosition
            // 组件则无从放置，同样保持数据原值
            match (self.m_spawn_pos)
            {
                none?;
                value(spawn_pos)?
                    match (e->towoo::get_component:<Transform::LocalPosition>)
                    {
                        none?;
                        value(local_pos)?
                            match (w->getLocalPosUnderParentAnchor(
                                    e, spawn_pos))
                            {
                                none?;
                                value(local_spawn_pos)?
                                    local_pos.pos->set(local_spawn_pos);
                            }
                    }
            }

            // 选中新实体，便于立刻在检视面板中编辑
            do w->setSelectedEntityId(entity_id);

            return true;
        }
        public func undo(self: CreateEntity, w: WorldEditorViewport)=> bool
        {
            match (self.m_content.m_eid)
            {
                // 尚未落实过的动作无从定位实体
                none?
                    return false;
                value(target_eid)?
                {
                    for (let e : w->getEntitySelector())
                    {
                        match (e->internal::get_entity_uid)
                        {
                            none?;
                            value(eid)?
                                if (eid == target_eid)
                                {
                                    e->close;
                                    return true;
                                }
                        }
                    }
                    return false;
                }
            }
        }
        
        public func describe(self: CreateEntity)=> string
        {
            let name = self.m_content->entity_name();
            if (name == "")
                return "创建实体";
            return F"创建实体 {name}";
        }
    }
}
