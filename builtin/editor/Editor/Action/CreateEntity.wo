import woo::std;

import je;
import je::ecs;
import je::internal;
import je::typeinfo;
import je::towoo::components;

import pkg::toml;
import pkg::try;
import pkg::interface;

import builtin::editor::Editor::Saving::Entity;
import builtin::editor::Editor::WorldEditorViewport;

import IAction;

using je;
using toml;
using JEEditor::Saving;

namespace JEEditor::Editor::Action
{
    using FullEntityContent = struct{
        m_eid: mut option<EuidT>,
        m_entity_content: Toml,
    }
    {
        alias EuidT = entity::internal::euid_t;

        // 从活的实体做全量快照（销毁实体等需要完整还原内容的场合）
        func try_create(e: entity)
        {
            try! eid = e->internal::get_entity_uid;
            return_value! FullEntityContent{
                m_eid = mut option::value(eid),
                m_entity_content = Entity::save(e),
            };
        }

        // 只按组件类型构造：不依赖活的实体，组件成员由 ECS 默认构造
        // （成员表留空即默认值）；EUID 延迟到动作首次落实时分配并回填
        func try_create_with_types(ctypes: array<typeinfo>)=> FullEntityContent
        {
            let components_dat = new_table();
            for (let ctype : ctypes)
                components_dat->set(ctype->name, new_table());

            // Editor::EntityId 必须包含在起始组件集合里：当前帧事后新增的
            // 组件 get 不到，而 get_entity_uid 依赖 get component；放进起始
            // 集合后，原生侧构造该组件时即分配有效的调试 EUID
            components_dat->set(
                Editor::EntityId::type::typeinfo->name, new_table());

            let entity_dat = new_table();
            entity_dat->set("components", components_dat);

            return FullEntityContent{
                m_eid = mut option::none,
                m_entity_content = entity_dat,
            };
        }

        // 实体名快照；快照未记录名字时返回空串
        public func entity_name(self: FullEntityContent)=> string
        {
            return (self.m_entity_content->get("name")=>> \v = v->as_string;)->or("");
        }
    }

    protected using CreateEntity = struct{
        m_content: FullEntityContent,
    }
    {
        public func try_create(new_created: entity)=> option<CreateEntity>
            where require!(CreateEntity: IAction);
        {
            return try!{
                try! full_entity_content = FullEntityContent::try_create(new_created);
                return_value! CreateEntity{
                    m_content = full_entity_content,
                };
            } catch! {
                logerr("传入的实体应当有对应的 EUID，请检查创建/销毁的实体流程");
            };
        }
        // 按组件类型直接构造可撤销的“创建实体”动作：实体与 EUID 均由
        // 动作首次落实（redo）时创建/分配，调用方无需也不应预先创建实体
        public func try_create_with_types(ctypes: array<typeinfo>)=> CreateEntity
            where require!(CreateEntity: IAction);
        {
            return CreateEntity{
                m_content = FullEntityContent::try_create_with_types(ctypes),
            };
        }
        public func redo(self: CreateEntity, w: WorldEditorViewport)=> bool
        {
            let e = Entity::restore(w->getWorld(), self.m_content.m_entity_content);

            match (self.m_content.m_eid)
            {
                // 首次落实：Editor::EntityId 已包含在起始组件集合中，原生侧
                // 构造时即分配调试 EUID，读取并回填到动作里，供撤销定位
                // 与后续重做复用
                none?
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?
                        {
                            logerr(
                                "创建实体：起始组件集合中的 Editor::EntityId 未分配 EUID");
                            return false;
                        }
                        value(eid)?
                            self.m_content.m_eid = option::value(eid);
                    }
                }
                // 撤销后的重做：以记录的 EUID 还原，保持实体标识稳定
                value(eid)?
                    e->internal::unsafe::set_entity_uid(eid);
            }

            // 选中新实体，便于立刻在检视面板中编辑
            do w->setSelectedEntityId(e->internal::get_entity_uid);
            return true;
        }
        public func undo(self: CreateEntity, w: WorldEditorViewport)=> bool
        {
            match (self.m_content.m_eid)
            {
                // 尚未落实过的动作无从定位实体
                none?
                    return false;
                value(target_eid)?
                {
                    for (let e : w->getEntitySelector())
                    {
                        match (e->internal::get_entity_uid)
                        {
                            none?;
                            value(eid)?
                                if (eid == target_eid)
                                {
                                    e->close;
                                    return true;
                                }
                        }
                    }
                    return false;
                }
            }
        }

        public func describe(self: CreateEntity)=> string
        {
            let name = self.m_content->entity_name();
            if (name == "")
                return "创建实体";
            return F"创建实体 {name}";
        }
    }
}
