import woo::std;

import je;
import je::ecs;
import je::internal;
import je::typeinfo;

import pkg::interface;
import pkg::try;

import builtin::editor::Editor::WorldEditorViewport;

import IAction;

using je;

namespace JEEditor::Editor::Action
{
    protected using ModifyComponentMember = struct{
        m_eid: entity::internal::euid_t,
        // 只保存组件类型名，redo/undo 执行时再通过 typeinfo::load 加载，
        // 避免 typeinfo 句柄在类型热重载等情况下失效。
        m_component_type_name: string,
        m_member_name: string,
        // 以 dynamic_parser 序列化形式保存的成员旧值/新值
        m_old_value: string,
        m_new_value: string,
    }
    {
        public func create(
            eid: entity::internal::euid_t,
            component_type_name: string,
            member_name: string,
            old_value: string,
            new_value: string)=> ModifyComponentMember
            where require!(ModifyComponentMember: IAction);
        {
            return ModifyComponentMember{
                m_eid = eid,
                m_component_type_name = component_type_name,
                m_member_name = member_name,
                m_old_value = old_value,
                m_new_value = new_value,
            };
        }
        
        func restoreMemberValue(
            w: WorldEditorViewport,
            eid: entity::internal::euid_t,
            component_type_name: string,
            member_name: string,
            dat: string)=> bool
        {
            return or(false) <| try!{
                for (let e : w->getEntitySelector())
                {
                    match (e->internal::get_entity_uid)
                    {
                        none?;
                        value(ueid)?
                        {
                            if (ueid != eid)
                                continue;
                                
                            // 类型名可能已失效（类型被卸载等），加载失败则本次操作失败
                            try! component_type = typeinfo::load(component_type_name);
                            
                            try! component_instance = e->get_component(component_type);
                            try! (member_type, member_addr) = component_instance->get_member(member_name);
                            
                            return_value! towoo::unsafe::dynamic_parser::restore(
                                member_type, member_addr, dat);
                        }
                    }
                }
                // 没有找到 euid 对应的实体……
                return_value! false;
            };
            
        }
        public func redo(self: ModifyComponentMember, w: WorldEditorViewport)=> bool
        {
            return restoreMemberValue(
                w, self.m_eid, self.m_component_type_name, self.m_member_name, self.m_new_value);
        }
        public func undo(self: ModifyComponentMember, w: WorldEditorViewport)=> bool
        {
            return restoreMemberValue(
                w, self.m_eid, self.m_component_type_name, self.m_member_name, self.m_old_value);
        }
        public func describe(self: ModifyComponentMember)=> string
        {
            return F"修改组件成员 {self.m_component_type_name}.{self.m_member_name}";
        }
    }
}
