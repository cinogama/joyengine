import woo::std;

import je;
import je::ecs;
import je::internal;
import je::typeinfo;

import pkg::interface;
import pkg::iterator;
import pkg::try;

import builtin::editor::Editor::WorldEditorViewport;

import IAction;

using je;
using iterator;

namespace JEEditor::Editor::Action
{
    // 一次为实体添加一组组件（如“常用组合”整组添加），undo 时一并移除。
    // 只保存组件类型名，redo/undo 执行时再通过 typeinfo::load 加载，
    // 避免 typeinfo 句柄在类型热重载等情况下失效（同 AddComponent）。
    protected using AddComponentBatch = struct{
        m_eid: entity::internal::euid_t,
        m_component_type_names: array<string>,
    }
    {
        public func try_create(e: entity, ctypes: array<typeinfo>)=> option<AddComponentBatch>
            where require!(AddComponentBatch: IAction);
        {
            return try!{
                try! eid = e->internal::get_entity_uid;
                let type_names = ctypes->iter
                    |> map(\ctype = ctype->name;)
                    |> collect;
                return_value! AddComponentBatch{
                    m_eid = eid,
                    m_component_type_names = type_names,
                };
            } catch! {
                logerr("传入的实体应当有对应的 EUID，请检查组件添加的流程");
            };
        }

        // 组件已存在时视为成功（幂等），避免撤销/重做交错时重复添加；
        // 任一类型名失效则视为失败（该步无法完整落实）
        public func redo(self: AddComponentBatch, w: WorldEditorViewport)=> bool
        {
            for (let e : w->getEntitySelector())
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(ueid)?
                        if (ueid == self.m_eid)
                        {
                            for (let cname : self.m_component_type_names)
                            {
                                match (typeinfo::load(cname))
                                {
                                    none? return false;
                                    value(ctype)?
                                        if (e->get_component(ctype)->is_none)
                                            do e->add_component(ctype);
                                }
                            }
                            return true;
                        }
                }
            }
            return false;
        }

        // 组件已不存在时视为成功（幂等）
        public func undo(self: AddComponentBatch, w: WorldEditorViewport)=> bool
        {
            for (let e : w->getEntitySelector())
            {
                match (e->internal::get_entity_uid)
                {
                    none?;
                    value(ueid)?
                        if (ueid == self.m_eid)
                        {
                            for (let cname : self.m_component_type_names)
                            {
                                match (typeinfo::load(cname))
                                {
                                    none? return false;
                                    value(ctype)?
                                        if (e->get_component(ctype)->is_value)
                                            do e->remove_component(ctype);
                                }
                            }
                            return true;
                        }
                }
            }
            return false;
        }

        public func describe(self: AddComponentBatch)=> string
        {
            return F"添加组件组合（{self.m_component_type_names->len} 个组件）";
        }
    }
}
