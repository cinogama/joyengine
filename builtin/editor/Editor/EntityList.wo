import woo::std;

import je;
import je::internal;
import je::ecs;
import je::gui;
import je::typeinfo;
import je::towoo;
import je::towoo::components;

import pkg::interface;
import pkg::iterator;
import pkg::worst;

import builtin::editor::GUI::Windows;

import WorldEditorViewport;
import Action::CreateEntity;

using iterator;
using je;
using je::gui;
using JEEditor::GUI::Windows;
using JEEditor::Editor::Action;

namespace JEEditor::Editor
{
    using EntityList = struct{
        m_close: mut bool,
    }
    {
        let mut s_entitylist_singleton = option::none: option<EntityList>;

        // “新建实体”弹窗的状态；实体列表面板是单例，用模块级状态即可。
        // 勾选记录保存组件类型名而非 typeinfo 句柄，
        // 避免句柄在类型热重载等情况下失效（同 AddComponent 的做法）
        let mut s_new_entity_filter = "";
        let mut s_new_entity_focus = false;
        let mut s_new_entity_selected = map::create:<string, bool>(0);

        // “新建实体”弹窗的常用组件组合表：(分组标题, [(组合名, [组件类型全名...])...])。
        // 组件名与 je::towoo::components 中的注册名保持一致；组合只负责
        // 整组勾选/取消，若日后组件改名或被删除，失效类型会在创建时被
        // createNewEntity 的 typeinfo::load 过滤跳过，不影响其余部分
        let s_component_presets = [
            ("变换", [
                ("一般变换", [
                    "Transform::LocalPosition", "Transform::LocalRotation",
                    "Transform::LocalScale", "Transform::LocalToWorld",
                    "Transform::Translation"]),
                ("UI变换", [
                    "UserInterface::Origin", "UserInterface::Absolute",
                    "UserInterface::Relatively", "Transform::Translation"]),
            ]),
            ("渲染", [
                ("基本渲染", [
                    "Renderer::Shape", "Renderer::Shaders",
                    "Renderer::Textures"]),
                ("帧动画", ["Animation::FrameAnimation"]),
            ]),
            ("2D光照", [
                ("点光源", [
                    "Light2D::Point", "Light2D::Gain",
                    "Light2D::ShadowBuffer"]),
                ("范围光源", [
                    "Light2D::Range", "Light2D::Gain",
                    "Light2D::ShadowBuffer"]),
                ("平行光源", [
                    "Light2D::Parallel", "Light2D::Gain",
                    "Light2D::ShadowBuffer"]),
                ("常用阴影", [
                    "Light2D::ShapeShadow", "Light2D::BlockShadow",
                    "Light2D::SelfShadow"]),
            ]),
            ("摄像机", [
                ("透视相机", [
                    "Camera::Projection", "Camera::PerspectiveProjection",
                    "Camera::Viewport", "Camera::FrustumCulling"]),
                ("正交相机", [
                    "Camera::Projection", "Camera::OrthoProjection",
                    "Camera::Viewport", "Camera::FrustumCulling"]),
                ("仅UI投影", ["Camera::Projection"]),
                ("光照后处理", [
                    "Light2D::CameraPostPass", "Renderer::Shaders"]),
            ]),
            ("2D物理", [
                ("静态刚体", [
                    "Physics2D::Rigidbody", "Physics2D::Collider::Box"]),
                ("动力学刚体", [
                    "Physics2D::Rigidbody", "Physics2D::DynamicBody",
                    "Physics2D::Collider::Box", "Physics2D::Density",
                    "Physics2D::Friction"]),
                ("高速动力学", [
                    "Physics2D::Rigidbody", "Physics2D::DynamicBody",
                    "Physics2D::Bullet", "Physics2D::Collider::Box",
                    "Physics2D::Density", "Physics2D::Friction"]),
                ("运动学刚体", [
                    "Physics2D::Rigidbody", "Physics2D::KinematicBody",
                    "Physics2D::Collider::Box"]),
                ("触发器", [
                    "Physics2D::Rigidbody", "Physics2D::Collider::Box",
                    "Physics2D::IsTrigger"]),
                ("物理场景", ["Physics2D::Scene"]),
            ]),
            ("音频", [
                ("音源", ["Audio::Source", "Audio::Playing"]),
                ("音频监听器", ["Audio::Listener"]),
            ]),
        ];

        public func isEntityListExist()
        {
            return s_entitylist_singleton->is_value;
        }
        public func showEntityList()
        {
            do show(create());
        }
        public func closeEntityList()
        {
            match (s_entitylist_singleton)
            {
                none?;
                value(entitylist_instance)?
                    entitylist_instance->close();
            }
        }
        
        func create()=> EntityList
            where require!(EntityList: IWindows);
        {
            return EntityList{
                m_close = mut false,
            };
        }
        func close(self: EntityList)
        {
            self.m_close = true;
        }
        public func onCreate(self: EntityList)=> void
        {
            s_entitylist_singleton = option::value(self);
        }
        public func onClose(_: EntityList)=> void
        {
            s_entitylist_singleton = option::none;
        }
        public func getTitle(_: EntityList)=> string
        {
            return "实体列表";
        }
        public func getSizeConstraints(_: EntityList)=> SizeConstraints
        {
            return SizeConstraints::Limited(((300., 200.), (400., 4096.)));
        }
        func showEntityContextMenu(world_view: WorldEditorViewport, e: entity)
        {
            if (BeginPopupContextItem())
            {
                world_view->drawEntityContextMenuItems(e);
                defer EndPopup();
            }
        }
        func showEntitiesInWorld(world_view: WorldEditorViewport)
        {
            let entity_selector = world_view->getEntitySelector();
            
            let entities = entity_selector->iter
                |> filter(\e = e->towoo::get_component:<Editor::Invisible>->is_none;)
                |> map(\e = (e, e->internal::get_entity_uid);)
                |> collect_as_mut
                ;
                
            std::sort_in_place(
                entities,
                \(_, lid), (_, rid) = lid->or(ZERO) < rid->or(ZERO)
                    where ZERO = 0h as entity::internal::euid_t
                    ;);
                    
            let current_selected_entity_id = world_view->getSelectedEntityId();
            
            for (let (i, (e, euid)) : entities->iter |> enumerate)
            {
                let mut entity_name = e->internal::name;
                if (entity_name == "")
                    entity_name = "<匿名实体>";
                    
                let is_selected = current_selected_entity_id->is_value
                    && euid->is_value
                    && current_selected_entity_id->unwrap == euid->unwrap;
                    
                // 点击实体项可选中对应实体
                let clicked = SelectableSelected(
                    F"{entity_name}##{i}", is_selected);
                if (clicked && euid->is_value)
                    world_view->setSelectedEntityId(euid);
                    
                // 右键打开实体上下文菜单（菜单内容与视口右键菜单共用）
                showEntityContextMenu(world_view, e);
            }
        }
        // 将 "Transform::LocalPosition" 拆为 ("Transform", "LocalPosition")，
        // 不带命名空间的类型名返回 ("", 原名)。
        func splitTypeName(cname: string)=> (string, string)
        {
            let sep_pos = cname->find("::")->or(-1);
            if (sep_pos < 0)
                return ("", cname);
            return (cname->sub_len(0, sep_pos), cname->sub(sep_pos + 2));
        }
        // 组合内组件是否已全部勾选（同时用作按钮高亮与切换方向判定）
        func isPresetAllSelected(cnames: array<string>)=> bool
        {
            let mut all_selected = true;
            for (let cname : cnames)
            {
                if (!s_new_entity_selected->contains(cname))
                    all_selected = false;
            }
            return all_selected;
        }
        // 整组已勾选时再点一次整组取消，否则补齐勾选缺失的组件；
        // 与下方候选列表的勾选状态始终互通
        func togglePreset(cnames: array<string>)=> void
        {
            if (isPresetAllSelected(cnames))
            {
                for (let cname : cnames)
                    do s_new_entity_selected->remove(cname);
            }
            else
            {
                for (let cname : cnames)
                    s_new_entity_selected->set(cname, true);
            }
        }
        // “常用组合”菜单：分组为一级子菜单，子项即预设，整组勾选的项
        // 高亮显示，点击切换整组；悬停提示该组合会勾选的全部组件。
        // 点击子项只收起子菜单以上的弹窗层，菜单与外层“新建实体”弹窗
        // 保持打开，可连续挑选多个组合
        func showComponentPresetMenu()=> void
        {
            for (let (group_title, presets) : s_component_presets)
            {
                if (BeginMenu(group_title))
                {
                    defer EndMenu();
                    for (let (preset_name, cnames) : presets)
                    {
                        if (SelectableSelected(F"{preset_name}##preset_{preset_name}",
                                isPresetAllSelected(cnames)))
                            togglePreset(cnames);

                        if (IsItemHovered())
                        {
                            let mut tip = "";
                            for (let cname : cnames)
                                tip = (tip->len == 0) ? cname | F"{tip}、{cname}";
                            do SetTooltip(tip);
                        }
                    }
                }
            }
        }
        // 按勾选的组件发布可撤销的 CreateEntity 操作：实体与调试 EUID 均由
        // 动作首次落实（redo）时创建/分配（redo 会选中新实体），调用方不再
        // 预创建实体，避免动作落实时二次创建。组件类型名在发布时才通过
        // typeinfo::load 解析，失效的类型会被跳过；全部失效时拒绝发布。
        func createNewEntity(wctx: WorldEditorViewport)=> void
        {
            let selected_ctypes = s_new_entity_selected->keys->iter
                |> filter_map(\cname = typeinfo::load(cname);)
                |> collect;
            if (selected_ctypes->len == 0)
            {
                logerr("新建实体：勾选的组件类型均已失效");
                return;
            }

            wctx->doAction(CreateEntity::try_create_with_types(selected_ctypes));
            CloseCurrentPopup();
        }
        // “新建实体”弹窗：搜索过滤 + 常用组合一键整组勾选 + 按命名空间
        // 分组的组件候选，自由勾选组合若干组件后确认创建；不允许一个
        // 组件都不选。
        func showNewEntityPicker(wctx: WorldEditorViewport)=> void
        {
            // 弹窗大小由内容自适应；若控件用 -1 占满宽度，弹窗自身没有
            // 可参考的实宽，会塌缩成细条，因此这里给控件显式像素宽度
            let picker_width = 300.;
            let preset_button_width = 92.;

            // 搜索框与“常用组合”按钮同排，合计宽度与下方列表对齐
            SetNextItemWidth(picker_width - preset_button_width - 8.);
            if (s_new_entity_focus)
            {
                SetKeyboardFocusHere(0);
                s_new_entity_focus = false;
            }
            match (InputText("##new_entity_filter", s_new_entity_filter))
            {
                none?;
                value(new_filter)?
                    s_new_entity_filter = new_filter;
            }

            SameLine();
            if (ButtonSize("常用组合", (preset_button_width, 0.)))
                OpenPopup("##component_preset_menu");
            if (BeginPopup("##component_preset_menu"))
            {
                showComponentPresetMenu();
                defer EndPopup();
            }

            let filter_lower = s_new_entity_filter->lower;
            let has_filter = filter_lower->len > 0;

            // 候选为全部已注册组件，排除编辑器内部组件（Editor::*）以及
            // 不匹配搜索词的组件（按含命名空间的全名匹配）
            let candidates = typeinfo::get_all_components_types()
                ->forall(\ctype = !ctype->name->begin_with("Editor::") &&
                            (!has_filter ||
                                ctype->name->lower->find(filter_lower)->is_value);)
                |> std::sort(\l, r = l->name < r->name;);

            // 列表高度固定为约 8 行，避免候选过多时撑爆弹窗
            if (BeginListBox("##new_entity_candidates", picker_width,
                    GetFrameHeightWithSpacing() * 8.))
            {
                // 与检视面板一致的命名空间分组标题
                let mut last_namespace = "";
                for (let ctype : candidates)
                {
                    let cname = ctype->name;
                    let (ns, short_name) = splitTypeName(cname);
                    if (ns != last_namespace)
                    {
                        if (ns != "")
                            SeparatorText(ns);
                        last_namespace = ns;
                    }

                    match (CheckBox(F"{short_name}##new_{cname}",
                            s_new_entity_selected->contains(cname)))
                    {
                        none?;
                        value(checked)?
                        {
                            if (checked)
                                s_new_entity_selected->set(cname, true);
                            else
                                do s_new_entity_selected->remove(cname);
                        }
                    }
                }
                if (candidates->len == 0)
                    TextDisabled("（没有匹配的组件）");

                EndListBox();
            }

            // 空实体没有保留意义：一个组件都没勾选时禁用创建按钮
            BeginDisabled(s_new_entity_selected->len == 0);
            if (ButtonSize("创建", (picker_width, 0.)))
                createNewEntity(wctx);
            EndDisabled();

            if (s_new_entity_selected->len == 0)
                TextDisabled("（至少勾选一个组件才能创建）");
            else
                Text(F"已勾选 {s_new_entity_selected->len} 个组件");
        }
        public func run(self: EntityList)=> bool
        {
            match (WorldEditorViewport::getLastFocused())
            {
                none?
                    TextDisabled("（没有待编辑的世界）");
                value(wctx)?
                {
                    showEntitiesInWorld(wctx);

                    Spacing();
                    if (ButtonSize("新建实体", (-1., 0.)))
                    {
                        // 每次打开弹窗都复位搜索词与勾选，并将焦点设到搜索框
                        s_new_entity_filter = "";
                        s_new_entity_focus = true;
                        s_new_entity_selected->clear();
                        OpenPopup("##new_entity_picker");
                    }

                    if (BeginPopup("##new_entity_picker"))
                    {
                        showNewEntityPicker(wctx);
                        defer EndPopup();
                    }
                }
            }
            return !self.m_close;
        }
        
    // ===============
    }
}
