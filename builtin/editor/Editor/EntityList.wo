import woo::std;

import je::internal;
import je::ecs;
import je::gui;
import je::towoo;
import je::towoo::components;

import pkg::interface;
import pkg::iterator;
import pkg::worst;

import builtin::editor::GUI::Windows;

import WorldEditorViewport;

using iterator;
using je;
using je::gui;
using JEEditor::GUI::Windows;

namespace JEEditor::Editor
{
    using EntityList = struct{
        m_close: mut bool,
    }
    {
        let mut s_entitylist_singleton = option::none: option<EntityList>;
        public func isEntityListExist()
        {
            return s_entitylist_singleton->is_value;
        }
        public func showEntityList()
        {
            do show(create());
        }
        public func closeEntityList()
        {
            match (s_entitylist_singleton)
            {
                none?;
                value(entitylist_instance)?
                    entitylist_instance->close();
            }
        }
        
        func create()=> EntityList
            where require!(EntityList: IWindows);
        {
            return EntityList{
                m_close = mut false,
            };
        }
        func close(self: EntityList)
        {
            self.m_close = true;
        }
        public func onCreate(self: EntityList)=> void
        {
            s_entitylist_singleton = option::value(self);
        }
        public func onClose(_: EntityList)=> void
        {
            s_entitylist_singleton = option::none;
        }
        public func getTitle(_: EntityList)=> string
        {
            return "实体列表";
        }
        public func getSizeConstraints(_: EntityList)=> SizeConstraints
        {
            return SizeConstraints::Limited(((300., 200.), (400., 4096.)));
        }
        func showEntityContextMenu(e: entity)
        {
            if (BeginPopupContextItem())
            {
                if (MenuItem("销毁"))
                {
                    e->close;
                }
                
                defer EndPopup();
            }
        }
        func showEntitiesInWorld(world_view: WorldEditorViewport)
        {
            let entity_selector = world_view->getEntitySelector();
            
            let entities = entity_selector->iter
                |> filter(\e = e->towoo::get_component:<Editor::Invisible>->is_none;)
                |> map(\e = (e, e->internal::get_entity_uid);)
                |> collect_as_mut
                ;
                
            std::sort_in_place(
                entities,
                \(_, lid), (_, rid) = lid->or(ZERO) < rid->or(ZERO)
                    where ZERO = 0h as entity::internal::euid_t
                    ;);
                    
            let current_selected_entity_id = world_view->getSelectedEntityId();
            
            for (let (i, (e, euid)) : entities->iter |> enumerate)
            {
                let mut entity_name = e->internal::name;
                if (entity_name == "")
                    entity_name = "<匿名实体>";
                    
                let is_selected = current_selected_entity_id->is_value
                    && euid->is_value
                    && current_selected_entity_id->unwrap == euid->unwrap;
                    
                // 点击实体项可选中对应实体
                let clicked = SelectableSelected(
                    F"{entity_name}##{i}", is_selected);
                if (clicked && euid->is_value)
                    world_view->setSelectedEntityId(euid);
                    
                // 右键打开实体上下文菜单（内容暂留空）
                showEntityContextMenu(e);
            }
        }
        public func run(self: EntityList)=> bool
        {
            match (WorldEditorViewport::getLastFocused())
            {
                none?
                    TextDisabled("（没有待编辑的世界）");
                value(wctx)?
                {
                    showEntitiesInWorld(wctx);
                }
            }
            return !self.m_close;
        }
        
    // ===============
    }
}
