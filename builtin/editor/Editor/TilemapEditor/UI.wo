// 瓦片地图编辑器 —— 工具栏与整体布局。
// 地图模式：上工具栏 + 左调色板 + 中画布 + 右属性 + 底部图层；
// 图集模式：左调色板 + 右图集设置。

import pkg::std;

import je;
import je::gui;
import je::tilemap;

import pkg::fsys;
import pkg::math;

import DataModel;
import EditorState;
import Palette;
import Canvas;
import Tools;
import LayerPanel;
import PropertyPanel;

using std;
using je;
using je::gui;
using je::tilemap;
using fsys;
using math;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    func toolbar_button(state: EditorState, t: tool)=> void
    {
        let pressed = Button(F"{tool::name(t)}##tool{t as int}");
        if (state.m_tool == t)
        {
            // 当前工具：画个下划线指示
            let (rmin, rmax) = GetItemRect();
            do GetWindowDrawList()->AddRect(
                rmin, (rmax[0], rmax[1] + 2.), (110, 200, 255, 255), 2.);
        }
        if (pressed)
            state.m_tool = t;
        SameLine();
    }

    public func draw_toolbar(state: EditorState, ctx: TilemapContext)=> void
    {
        do toolbar_button(state, tool::PENCIL);
        do toolbar_button(state, tool::ERASER);
        do toolbar_button(state, tool::RECT);
        do toolbar_button(state, tool::FILL);
        do toolbar_button(state, tool::EYEDROPPER);

        if (Button("撤销"))
            do state->undo();
        SameLine();
        if (Button("重做"))
            do state->redo();
        SameLine();
        if (Button("适应窗口"))
            do reset_view(state);

        // 状态文本
        SameLine();
        let (w, h, tile_px, layer_count) = ctx.m_map->size();
        let (lname, _, _) = ctx.m_map->get_layer(state.m_layer);
        if (Button("调整尺寸"))
        {
            // 打开弹窗时以当前尺寸初始化输入框
            state.m_resize_w = w;
            state.m_resize_h = h;
            do OpenPopup("##resize_map_popup");
        }
        SameLine();
        do Text(F"{w}×{h} @ {tile_px}px | 图层{state.m_layer + 1}/{layer_count}「{lname}」"
            + (state.m_dirty ? " | 未保存" | ""));
        do draw_resize_map_popup(state, ctx);
    }

    // 地图尺寸输入钳制（与引擎上限一致：1..65536）
    func clamp_map_dim(v: int)=> int
    {
        if (v < 1)
            return 1;
        if (v > 65536)
            return 65536;
        return v;
    }

    // 调整地图尺寸弹窗：左上角对齐保留原格子，缩小尺寸时越界格内容
    // 与逐格属性覆盖被丢弃。属结构性操作不进撤销栈；且旧撤销命令的
    // cellkey（x + y*宽）随宽度失效，应用时须清空撤销栈。
    func draw_resize_map_popup(state: EditorState, ctx: TilemapContext)=> void
    {
        if (BeginPopup("##resize_map_popup"))
        {
            let (_, _, tile_px, _) = ctx.m_map->size();
            do Text("调整地图尺寸");
            match (InputInt("宽（格）", state.m_resize_w))
            {
                value(v)? state.m_resize_w = clamp_map_dim(v);
                none?;
            }
            match (InputInt("高（格）", state.m_resize_h))
            {
                value(v)? state.m_resize_h = clamp_map_dim(v);
                none?;
            }
            do TextDisabled(F"瓦片像素 {tile_px} 创建后不可修改；"
                + "缩小尺寸时越界格内容与逐格属性将被丢弃，且无法撤销");
            if (Button("应用"))
            {
                let (w, h, _, _) = ctx.m_map->size();
                if (state.m_resize_w != w || state.m_resize_h != h)
                {
                    do ctx.m_map->resize(state.m_resize_w, state.m_resize_h);
                    state.m_undo->clear();
                    state.m_dirty = true;
                }
                do CloseCurrentPopup();
            }
            SameLine();
            if (Button("取消"))
                do CloseCurrentPopup();
            do EndPopup();
        }
    }

    public func render_main(state: EditorState)=> void
    {
        let avail = GetContentRegionAvail();

        // 图集模式：仅调色板 + 图集设置（无地图上下文）
        if (state.m_tileset_only->is_value)
        {
            if (BeginChildSize("##tm_left", 380., avail[1]))
                do draw_palette(state, option::none);
            EndChild();
            SameLine();
            if (BeginChildSize("##tm_right", GetContentRegionAvail()[0], 0.))
                do draw_tileset_settings(state, option::none);
            EndChild();
            return;
        }

        // 地图模式：上下文必在（与 m_tileset_only 恒互补）
        match (state.m_context)
        {
            none? { }
            value(ctx)?
            {
                do render_map_layout(state, ctx);
            }
        }
    }

    func render_map_layout(state: EditorState, ctx: TilemapContext)=> void
    {
        let avail = GetContentRegionAvail();

        // 工具栏（整宽）
        do draw_toolbar(state, ctx);

        let bottom_h = 128.;
        let left_w = 320.;
        let right_w = 340.;
        let mut center_w = avail[0] - left_w - right_w - 12.;
        if (center_w < 200.) center_w = 200.;
        let body_h = GetContentRegionAvail()[1] - bottom_h;

        // 左：调色板
        if (BeginChildSize("##tm_left", left_w, body_h))
            do draw_palette(state, option::value(ctx));
        EndChild();
        SameLine();

        // 中：画布
        if (BeginChildSize("##tm_center", center_w, body_h))
            do draw_canvas(state, ctx);
        EndChild();
        SameLine();

        // 右：属性
        if (BeginChildSize("##tm_right", right_w, body_h))
            do draw_properties(state, ctx);
        EndChild();

        // 底：图层
        if (BeginChildSize("##tm_bottom", GetContentRegionAvail()[0], 0.))
            do draw_layers(state, ctx);
        EndChild();
    }
}
