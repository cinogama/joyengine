// 瓦片地图编辑器 —— 属性面板。
// 地图编辑器的页签：
//   格子属性：悬停格子的属性取值链展示与逐格覆盖编辑；
//   瓦片：选中瓦片的名称/通行性/法线/自动拼接类型/默认属性（写回图集
//     文档；调色板框选多格时通行性/法线/自动拼接/默认属性批量应用）；
//   图层样式：活动图层的专属着色器、附加纹理通道与 uniform 变量；
//   图集设置：地图的图集引用管理。
// 图集编辑器的页签：
//   瓦片：选中瓦片的名称/通行性/法线/自动拼接类型/默认属性（同上，
//     调色板拖动框选可批量设置）；
//   图集设置：图集名称、源纹理（含附加层级）与属性 schema。

import pkg::std;

import je;
import je::gui;
import je::graphic;
import je::towoo;
import je::towoo::types;
import je::tilemap;

import pkg::fsys;
import pkg::iterator;
import pkg::worst;

import builtin::editor::GUI::Drag;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;
import builtin::editor::GUI::Widgets;

import builtin::editor::Editor::Browser;
import builtin::editor::Editor::ResourcePath;

import DataModel;
import EditorState;
import Palette;

using std;
