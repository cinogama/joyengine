using JEEditor::GUI::Widgets;
using JEEditor::Editor::ResourcePath;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    // 属性类型名（下标与 je::tilemap::property_type 枚举值一致）
    public let PROPERTY_TYPE_NAMES = ["bool", "string", "int", "float", "vec2", "vec3", "vec4"];

    // 按取值链解析某格属性并格式化为显示字符串（无值/类型不符 → 「无值」）
    func format_resolved_property(tmap: Tilemap, layer: int, x: int, y: int,
        name: string, ptype: int)=> string
    {
        let no_value = "「无值」";
        if (ptype == property_type::BOOL as int)
        {
            match (tmap->get_property_bool(layer, x, y, name))
            {
                value(v)? { return v ? "true" | "false"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::INT as int)
        {
            match (tmap->get_property_int(layer, x, y, name))
            {
                value(v)? { return F"{v}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::FLOAT as int)
        {
            match (tmap->get_property_real(layer, x, y, name))
            {
                value(v)? { return F"{v}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::STRING as int)
        {
            match (tmap->get_property_string(layer, x, y, name))
            {
                value(v)? { return v; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::VEC2 as int)
        {
            match (tmap->get_property_vec2(layer, x, y, name))
            {
                value((a, b))? { return F"{a}, {b}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::VEC3 as int)
        {
            match (tmap->get_property_vec3(layer, x, y, name))
            {
                value((a, b, c))? { return F"{a}, {b}, {c}"; }
                none? { return no_value; }
            }
        }
        match (tmap->get_property_vec4(layer, x, y, name))
        {
            value((a, b, c, d))? { return F"{a}, {b}, {c}, {d}"; }
            none? { return no_value; }
        }
        return no_value;
    }

    // 图集 schema 默认值的显示字符串（无此属性/类型不符 → 「无值」）
    func format_schema_default(ts_id: tilemap::Tileset, name: string, ptype: int)=> string
    {
        let no_value = "「无值」";
        if (ptype == property_type::BOOL as int)
        {
            match (ts_id->property_default_bool(name))
            {
                value(v)? { return v ? "true" | "false"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::INT as int)
        {
            match (ts_id->property_default_int(name))
            {
                value(v)? { return F"{v}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::FLOAT as int)
        {
            match (ts_id->property_default_real(name))
            {
                value(v)? { return F"{v}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::STRING as int)
        {
            match (ts_id->property_default_string(name))
            {
                value(v)? { return v; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::VEC2 as int)
        {
            match (ts_id->property_default_vec2(name))
            {
                value((a, b))? { return F"{a}, {b}"; }
                none? { return no_value; }
            }
        }
        else if (ptype == property_type::VEC3 as int)
        {
            match (ts_id->property_default_vec3(name))
            {
                value((a, b, c))? { return F"{a}, {b}, {c}"; }
                none? { return no_value; }
            }
        }
        match (ts_id->property_default_vec4(name))
        {
            value((a, b, c, d))? { return F"{a}, {b}, {c}, {d}"; }
            none? { return no_value; }
        }
        return no_value;
    }

    public func draw_properties(state: EditorState, ctx: TilemapContext)=> void
    {
        if (BeginTabBar("##prop_tabs"))
        {
            if (state.m_tileset_only->is_none)
            {
                if (BeginTabItem("格子属性"))
                {
                    if (BeginChildSize("##cell_props", GetContentRegionAvail()[0], 0.))
                        do draw_cell_properties(state, ctx);
                    EndChild();
                    do EndTabItem();
                }
            }

            if (BeginTabItem("瓦片"))
            {
                if (BeginChildSize("##tile_props", GetContentRegionAvail()[0], 0.))
                    do draw_tile_panel(state, option::value(ctx));
                EndChild();
                do EndTabItem();
            }

            if (state.m_tileset_only->is_none)
            {
                if (BeginTabItem("图层样式"))
                {
                    if (BeginChildSize("##layer_style", GetContentRegionAvail()[0], 0.))
                        do draw_layer_style(state, ctx);
                    EndChild();
                    do EndTabItem();
                }
            }
            if (BeginTabItem("图集设置"))
            {
                if (BeginChildSize("##tileset_props", GetContentRegionAvail()[0], 0.))
                    do draw_tileset_settings(state, option::value(ctx));
                EndChild();
                do EndTabItem();
            }
            do EndTabBar();
        }
    }

    // ---- 图层样式：逐层着色器 + 附加纹理 + uniform ----

    // JE_ 前缀的 uniform 是引擎内部渲染变量，不在此展示（与材质面板一致）
    func isInternalUniformName(uname: string)=> bool
    {
        return uname->begin_with("JE_");
    }

    // 样式着色器实例的来源路径（显示/提示用；内置或源码创建的实例无路径）
    func layer_shader_display_path(shader_inst: option<shader>)=> string
    {
        match (shader_inst)
        {
            none? { return ""; }
            value(s)?
            {
                match (s->path())
                {
                    value(p)? { return p; }
                    none? { return ""; }
                }
            }
        }
        return "";
    }

    // “选择着色器”菜单当前展示的快照：目录完整路径 → 组内 .shader 文件
    //（按路径排序）；每次点击选择按钮时重新扫描工作目录
    let mut s_style_shader_groups = map::create:<string, array<fsys::path_t>>(0);

    func scan_style_shader_groups()=> map<string, array<fsys::path_t>>
    {
        let groups = map::create:<string, array<fsys::path_t>>(0);
        for (let p : recursive_walk(workpath()) |> iter_result
            |> filter(\p = isfile(p)
                && string::lower(extension(p)) == ".shader";)
            |> collect
            |> sort(\l, r = l->to_string() < r->to_string();))
        {
            let dir = parent(p)->to_string();
            groups->set(dir, groups->get_or(dir, []: array<fsys::path_t>)->append(p));
        }
        return groups;
    }

    // 指定图层着色器：加载独立实例交给图层样式（uniform 值写在该实例上，
    // 渲染侧直接使用它；每层各持一份实例，各层 uniform 互不影响）
    func try_set_layer_shader(state: EditorState, ctx: TilemapContext, path: fsys::path_t)=> void
    {
        if (string::lower(extension(path)) != ".shader")
        {
            do MsgBox::err("设置着色器失败", F"`{path}` 不是着色器文件（.shader）");
            return;
        }
        let runtime_path = ResourcePath::toRuntimeResourcePath(path);
        match (shader::load(option::none, runtime_path))
        {
            value(sh)?
            {
                do ctx.m_map->set_layer_shader(state.m_layer, option::value(sh));
                state.m_dirty = true;
            }
            none?
                do MsgBox::err("设置着色器失败",
                    F"无法加载着色器 `{runtime_path}`，请检查文件内容");
        }
    }

    // “选择着色器”弹出菜单：工作目录根下的文件平铺在顶层，其余目录按
    // 相对路径展开为子菜单（与材质面板的选择菜单同款交互）
    func show_style_shader_menu(state: EditorState, ctx: TilemapContext)=> void
    {
        if (s_style_shader_groups->keys->len == 0)
        {
            do MenuItemEnabled("（工作目录下没有 .shader 文件）", false);
            return;
        }

        let root_dir = workpath()->to_string();
        for (let dir : s_style_shader_groups->keys |> sort(\l, r = l < r;))
        {
            let files = s_style_shader_groups->get(dir)->unwrap;

            if (dir == root_dir)
            {
                for (let p : files)
                {
                    if (MenuItem(filename(p)))
                        do try_set_layer_shader(state, ctx, p);
                }
                continue;
            }

            let mut disp = dir;
            match (relative(normalize(dir), workpath()))
            {
                ok(rel)? disp = rel;
                err(_)?;
            }
            if (BeginMenu(disp))
            {
                defer EndMenu();
                for (let p : files)
                {
                    if (MenuItem(filename(p)))
                        do try_set_layer_shader(state, ctx, p);
                }
            }
        }
    }

    // 渲染并编辑一个样式 uniform：类型按着色器声明，当前值读自图层样式
    // 持有的着色器实例（get_uniforms 返回实例当前值），修改直接写回该
    // 实例（渲染侧下一帧应用，保存文档时随样式落盘）
    func draw_style_uniform_row(state: EditorState, sinst: shader,
        uname: string, declared: shader::uniform_variable)=> void
    {
        let tag = F"##layer_style_uniform_{uname}";

        // 标量整数（InputInt）的步进按钮绘制在输入框之外，预留右侧空间
        let mut step_reserve = 0.;
        match (declared)
        {
            integer(_)? step_reserve = 56.;
            _?;
        }
        do beginMemberRow(uname, option::none: option<Color32RGBA>, step_reserve);

        match (declared)
        {
            integer(v)?
            {
                match (InputInt(tag, v))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            integer2(v)?
            {
                match (InputInt2(tag, v.0, v.1))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            integer3(v)?
            {
                match (InputInt3(tag, v.0, v.1, v.2))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            integer4(v)?
            {
                match (InputInt4(tag, v.0, v.1, v.2, v.3))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            float(v)?
            {
                match (InputFloat(tag, v))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            float2(v)?
            {
                match (InputFloat2(tag, v.0, v.1))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            float3(v)?
            {
                match (InputFloat3(tag, v.0, v.1, v.2))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            float4(v)?
            {
                match (InputFloat4(tag, v.0, v.1, v.2, v.3))
                {
                    value(nv)?
                    {
                        do sinst->set_uniform(uname, nv);
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            color((v1, v2, v3, v4))?
            {
                // 存储值为线性颜色，选择器以 sRGB 显示并写回线性值。
                let display = ((v1, v2, v3, v4) as color)->to_srgb;
                match (ColorEdit4(tag, display as raw vec4)
                    ->> \picked = color::from_srgb(picked as vec4)->to_linear;)
                {
                    value((n1, n2, n3, n4))?
                    {
                        do sinst->set_uniform_color(uname, (n1, n2, n3, n4));
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
            texture(pass_id)?
            {
                // 采样器类型的 uniform 采样指定通道的纹理（通道在下方
                // 纹理通道区编辑），这里只展示它采样的通道
                do TextDisabled(F"采样纹理通道 {pass_id}");
            }
            _?
                do TextDisabled("（不支持的 uniform 类型）");
        }
    }

    func draw_style_uniforms(state: EditorState, sinst: shader)=> void
    {
        let uniforms = sinst->get_uniforms;

        let mut names = []: array<string>;
        for (let (uname, _) : uniforms)
        {
            if (!isInternalUniformName(uname))
                names = names->append(uname);
        }
        names = names |> sort(\l, r = l < r;);

        if (names->len == 0)
        {
            do TextDisabled("（没有可编辑的 uniform 变量）");
            return;
        }

        for (let mut i = 0; i < names->len; i += 1)
        {
            let uname = names[i];
            do draw_style_uniform_row(state, sinst, uname,
                uniforms->get(uname)->unwrap);
            if (i + 1 < names->len)
                memberSeparator();
        }
    }

    func isTextureFile(path: fsys::path_t)=> bool
    {
        // 与资源浏览器/材质面板的纹理扩展名列表保持一致
        static let texture_exts = {
            [".png"] = true,
            [".jpg"] = true,
            [".jpeg"] = true,
            [".bmp"] = true,
            [".tga"] = true,
            [".tif"] = true,
            [".tiff"] = true,
            [".gif"] = true,
            [".webp"] = true,
            [".hdr"] = true,
            [".exr"] = true,
            [".dds"] = true,
            [".ico"] = true,
            [".pvr"] = true,
            [".ktx"] = true,
            [".psd"] = true,
        };
        return texture_exts->contains(string::lower(extension(path)));
    }

    // 绑定某槽位纹理：加载纹理实例交给图层样式（渲染侧直接使用该实例）
    func try_set_layer_texture(state: EditorState, tmap: tilemap::Tilemap, layer: int,
        slot: int, path: fsys::path_t)=> void
    {
        if (slot < 1)
        {
            do MsgBox::err("绑定纹理失败", "通道 0 保留给图集源纹理");
            return;
        }
        if (!isTextureFile(path))
        {
            do MsgBox::err("绑定纹理失败", F"`{path}` 不是纹理文件");
            return;
        }
        let runtime_path = ResourcePath::toRuntimeResourcePath(path);
        match (texture2d::load(option::none, runtime_path))
        {
            value(tex)?
            {
                do tmap->set_layer_texture(layer, slot, option::value(tex));
                state.m_dirty = true;
            }
            none?
                do MsgBox::err("绑定纹理失败",
                    F"无法加载纹理 `{runtime_path}`，请检查文件内容");
        }
    }

    // 纹理通道卡片：通道清单 = 着色器声明的采样通道 ∪ 已配置的槽位，
    // 用户无需手动指定通道号；槽 0 恒为图集源纹理（引擎绑定，只读）
    func draw_style_channels(state: EditorState, ctx: TilemapContext, sinst: shader)=> void
    {
        let tmap = ctx.m_map;
        let layer = state.m_layer;

        // 通道号 → 采样它的 uniform 名列表
        let channels = map::create:<int, array<string>>(0);
        for (let (uname, uvar) : sinst->get_uniforms)
        {
            if (isInternalUniformName(uname))
                continue;
            match (uvar)
            {
                texture(pass)?
                {
                    let refs = channels->get_or(pass, []: array<string>);
                    do channels->set(pass, refs->append(uname));
                }
                _?;
            }
        }

        let tcount = tmap->layer_texture_count(layer);
        let mut passes = channels->keys;
        for (let mut ti = 0; ti < tcount; ti += 1)
        {
            let (slot, _) = tmap->layer_texture(layer, ti);
            if (!channels->contains(slot))
                passes = passes->append(slot);
        }
        // 槽 0（图集源纹理）恒定展示（array 无 contains，显式探查）
        let mut has_zero = false;
        for (let p : passes)
        {
            if (p == 0)
                has_zero = true;
        }
        if (!has_zero)
            passes = passes->append(0);
        passes = passes |> sort(\l, r = l < r;);

        // 图集层级占用的通道：地图引用的各图集源纹理附加层级（extras）
        // 的 pass——分片会把它们的数组纹理绑到这些通道，后写覆盖同槽的
        // 2D 绑定（与数组覆盖默认 pass 0 的语义一致）
        let atlas_passes = []mut: vec<int>;
        for (let ts_opt : ctx.m_tileset_ids)
        {
            match (ts_opt)
            {
                none?;
                value(ts)?
                {
                    for (let mut si = 0; si < ts->source_count(); si += 1)
                        for (let mut k = 0; k < ts->source_extra_count(si); k += 1)
                        {
                            let (epass, _) = ts->source_extra_info(si, k);
                            let mut taken = false;
                            for (let ap : atlas_passes)
                            {
                                if (ap == epass)
                                    taken = true;
                            }
                            if (!taken)
                                do atlas_passes->add(epass);
                        }
                }
            }
        }
        // 收集完毕后不再改动，零拷贝视为 array 供下方遍历
        let atlas_pass_arr = atlas_passes;

        for (let pass : passes)
        {
            // 该通道当前绑定的纹理实例（未配置 → none）
            let mut bound = option::none: option<texture2d>;
            for (let mut ti = 0; ti < tcount; ti += 1)
            {
                let (slot, tex) = tmap->layer_texture(layer, ti);
                if (slot == pass)
                    bound = tex;
            }

            // 悬停提示：绑定路径 + 采样引用 + 操作说明，每项一行
            //（内置/非文件纹理无路径）
            let mut tips = []: array<string>;
            match (bound)
            {
                value(t)?
                {
                    match (t->path())
                    {
                        value(p)? tips = tips->append(p);
                        none? tips = tips->append("（非文件纹理，无路径）");
                    }
                }
                none?;
            }
            match (channels->get(pass))
            {
                none? tips = tips->append("（未被任何着色器采样）");
                value(refs)?
                {
                    for (let ref_name : refs |> sort(\l, r = l < r;))
                        tips = tips->append(F"采样于 {ref_name}");
                }
            }
            for (let ap : atlas_pass_arr)
            {
                if (ap == pass)
                    tips = tips->append("该通道被图集层级纹理占用（图集数组绑定优先生效）");
            }

            let card_h = 36.;
            let (row_start, content_x) =
                beginCardRow(F"##layer_style_tex_{pass}", card_h);

            if (pass == 0)
            {
                tips = tips->append("图集源纹理（引擎自动绑定，只读）");
                if (IsItemHovered())
                    do SetTooltip(tips->reduce(\l, r = l + "\n" + r;)->unwrap);

                setCursorX(content_x);
                setCursorY(row_start.1 + (card_h - GetTextLineHeight()) * 0.5);
                do Text("通道 0");
                SameLine();
                do TextDisabled("图集源纹理（只读）");
                endCardRow(row_start, card_h);
                continue;
            }

            tips = tips->append("拖动纹理文件到此处绑定/替换纹理");
            if (IsItemHovered())
                do SetTooltip(tips->reduce(\l, r = l + "\n" + r;)->unwrap);

            match (JEEditor::GUI::Drag::AcceptDrag:<FilePayload>())
            {
                none?;
                value(payload)?
                    do try_set_layer_texture(state, tmap, layer, pass, payload->path);
            }

            let (rcx, _) = GetCursorPos();
            let right_x = rcx + GetContentRegionAvail().0;

            setCursorX(content_x);
            setCursorY(row_start.1 + (card_h - GetTextLineHeight()) * 0.5);
            do Text(F"通道 {pass}");
            SameLine();
            match (bound)
            {
                none? do TextDisabled("（未绑定纹理）");
                value(t)?
                {
                    match (t->path())
                    {
                        value(p)? do TextDisabled(filename(normalize(p)));
                        none? do TextDisabled("（非文件纹理）");
                    }
                }
            }

            setCursorX(right_x - 30.);
            setCursorY(row_start.1 + (card_h - GetFrameHeight()) * 0.5);
            if (ButtonSize(F"×##layer_style_tex_del_{pass}", (26., 0.)))
            {
                do tmap->set_layer_texture(layer, pass, option::none);
                state.m_dirty = true;
            }
            if (IsItemHovered())
                do SetTooltip("解绑该通道的纹理");
            endCardRow(row_start, card_h);
        }
    }

    // “图层样式”页签主体：编辑活动图层（图层面板选中的层）的渲染样式。
    // uniform 值直接写在文档持有的着色器实例上，渲染侧使用同一实例，
    // 编辑即时生效，保存文档时随图层样式落盘（JE_ 内置变量除外）
    public func draw_layer_style(state: EditorState, ctx: TilemapContext)=> void
    {
        let tmap = ctx.m_map;
        let layer = state.m_layer;
        let shader_inst = tmap->layer_shader(layer);
        let shader_path = layer_shader_display_path(shader_inst);

        // 着色器卡片：文件名直显，整行是拖放命中区，行尾选择/清除
        let card_h = 36.;
        let (row_start, content_x) = beginCardRow("##layer_style_shader_card", card_h);
        if (IsItemHovered())
        {
            if (shader_path->len != 0)
                do SetTooltip(F"{shader_path}\n拖动 .shader 文件到此处替换");
            else
                do SetTooltip("拖动 .shader 文件到此处指定该图层的着色器");
        }
        match (JEEditor::GUI::Drag::AcceptDrag:<FilePayload>())
        {
            none?;
            value(payload)? do try_set_layer_shader(state, ctx, payload->path);
        }

        let (rcx, _) = GetCursorPos();
        let right_x = rcx + GetContentRegionAvail().0;
        setCursorX(content_x);
        setCursorY(row_start.1 + (card_h - GetTextLineHeight()) * 0.5);
        do Text("着色器");
        SameLine();
        if (shader_path->len == 0)
        {
            // 无路径的实例（内置/源码创建）只提示已指定，不给假路径
            match (shader_inst)
            {
                none? do TextDisabled("（未指定）");
                value(_)? do TextDisabled("（非文件着色器）");
            }
        }
        else
            do Text(filename(normalize(shader_path)));

        SetCursorPos((right_x - 62., row_start.1 + (card_h - GetFrameHeight()) * 0.5));
        if (ButtonSize("选择…##layer_style_shader_pick", (58., 0.)))
        {
            s_style_shader_groups = scan_style_shader_groups();
            OpenPopup("##layer_style_shader_menu");
        }
        if (IsItemHovered())
            do SetTooltip("从工作目录选择 .shader 文件");

        if (shader_inst->is_value)
        {
            SameLine();
            if (ButtonSize("×##layer_style_shader_clear", (26., 0.)))
            {
                do tmap->set_layer_shader(layer, option::none);
                state.m_dirty = true;
            }
            if (IsItemHovered())
                do SetTooltip("清除图层着色器（该层不再按样式着色）");
        }
        endCardRow(row_start, card_h);

        if (BeginPopup("##layer_style_shader_menu"))
        {
            defer EndPopup();
            show_style_shader_menu(state, ctx);
        }

        do TextDisabled("着色器只取图层样式，不回落根实体或内置默认");
        Spacing();

        match (shader_inst)
        {
            none? return;
            value(sinst)?
            {
                SeparatorText("Uniform 变量");
                do draw_style_uniforms(state, sinst);
                Spacing();
                SeparatorText("纹理通道");
                if (IsItemHovered())
                    do SetTooltip("采样通道由着色器的 uniform 声明");
                do draw_style_channels(state, ctx, sinst);
            }
        }
    }

    // 图集编辑器右侧面板：选中瓦片 / 图集设置
    public func draw_tileset_properties(state: EditorState)=> void
    {
        if (BeginTabBar("##ts_prop_tabs"))
        {
            if (BeginTabItem("瓦片"))
            {
                if (BeginChildSize("##ts_tile_props", GetContentRegionAvail()[0], 0.))
                    do draw_tile_panel(state, option::none);
                EndChild();
                do EndTabItem();
            }
            if (BeginTabItem("图集设置"))
            {
                if (BeginChildSize("##ts_props", GetContentRegionAvail()[0], 0.))
                    do draw_tileset_settings(state, option::none);
                EndChild();
                do EndTabItem();
            }
            do EndTabBar();
        }
    }

    // ---- 瓦片：选中瓦片的通行性/自动拼接类型/默认属性 ----
    // 瓦片属于图集文档：地图编辑器里的修改同样写进共享的图集实例，
    // 保存地图时一并保存被修改的图集（见 Window.wo）。

    // 记录一次图集内容修改（地图模式同时登记该图集待保存）
    func note_tileset_edit(state: EditorState, ts_id: tilemap::Tileset)=> void
    {
        state.m_dirty = true;
        if (state.m_tileset_only->is_none)
            do state->mark_tileset_dirty(ts_id);
    }

    // ===== 批量设置瓦片属性 =====
    // 瓦片面板里的通行性/法线/自动拼接/默认属性对当前框选内的全部瓦片
    // 生效（图集编辑器里拖动框选，地图编辑器里即画笔块；无框选时退化为
    // 单块）。名称只写锚点瓦片——批量重名没有意义。
    //
    // 框选内的瓦片 id（行优先）；框选不属于该图集/当前源时退化为空，
    // 由调用方回落到 m_palette_tile。
    func selected_tile_ids(state: EditorState, ts_id: tilemap::Tileset)
        => vec<int>
    {
        let mut ids = []mut: vec<int>;
        if (state->stamp_ready())
        {
            match (state.m_stamp_ts)
            {
                value(owner)?
                {
                    if (owner == ts_id
                        && state.m_stamp_source == state.m_palette_source)
                    {
                        for (let mut y = state.m_stamp_top;
                            y < state.m_stamp_top + state.m_stamp_h; y += 1)
                        {
                            for (let mut x = state.m_stamp_left;
                                x < state.m_stamp_left + state.m_stamp_w; x += 1)
                            {
                                let tid = ts_id->tile_id_at(
                                    state.m_stamp_source, x, y);
                                if (tid > 0)
                                    do ids->add(tid);
                            }
                        }
                    }
                }
                none?;
            }
        }
        if (ids->len == 0 && state.m_palette_tile > 0)
            do ids->add(state.m_palette_tile);
        return ids;
    }

    func batch_set_walkable(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, walkable: bool)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_walkable(tid, walkable ? 1 | 0);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_kind(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, kind: int)=> void
    {
        let mut any = false;
        for (let tid : ids)
            if (ts_id->set_tile_kind(tid, kind))
                any = true;
        if (any)
            do note_tileset_edit(state, ts_id);
    }
    func batch_set_normal(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, x: real, y: real, z: real)=> void
    {
        let mut any = false;
        for (let tid : ids)
            if (ts_id->set_tile_normal(tid, x, y, z))
                any = true;
        if (any)
            do note_tileset_edit(state, ts_id);
    }
    // 把框选内每块倾斜法线的 z 分量翻到指定半球（保留各块的方位）；
    // 与屏幕平行的法线保持不变，半球由后续编辑/预设决定
    func batch_flip_normal(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, back: bool)=> void
    {
        let mut any = false;
        for (let tid : ids)
        {
            let (x, y, z) = ts_id->tile_normal(tid);
            if (mathf::abs(z) > 0.001)
            {
                let want = back ? mathf::abs(z) | -mathf::abs(z);
                if (want != z)
                {
                    do ts_id->set_tile_normal(tid, x, y, want);
                    any = true;
                }
            }
        }
        if (any)
            do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_bool(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<bool>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_bool(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_int(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<int>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_int(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_real(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<real>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_real(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_string(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<string>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_string(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_vec2(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<(real, real)>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_vec2(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_vec3(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string, value: option<(real, real, real)>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_vec3(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }
    func batch_set_prop_vec4(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, name: string,
        value: option<(real, real, real, real)>)=> void
    {
        for (let tid : ids)
            do ts_id->set_tile_property_vec4(tid, name, value);
        do note_tileset_edit(state, ts_id);
    }

    // ---- 瓦片法线编辑 ----
    // s_normal_snap：拖拽时吸附（优先盘面格点：中心 / 45° 倾斜环 / 盘缘，
    // 各 8 方位；其次 8 根方位轴，轴吸附保持倾斜量）；s_normal_back 是
    // 法线与屏幕平行（nz≈0）时默认使用的半球，法线明显倾斜时半球由
    // 法线自身的 z 符号决定。
    let mut s_normal_snap = true;
    let mut s_normal_back = false;
    // 方向盘拖拽锁存的半球：按下瞬间决定，拖拽期间不随法线符号变化
    //（否则拖到盘缘 nz = 0 后半球判定可能来回切换，法线来回跳变）
    let mut s_dial_held = false;
    let mut s_dial_held_back = false;

    // 盘面坐标 (dx, dy)（单位圆盘，+y = 屏幕上）附近最近的格点方向。
    // 格点：中心（正对/背对摄像机）、45° 倾斜环与盘缘（与屏幕平行）
    // 各 8 个方位；threshold 为盘半径比例，超出范围返回 none。
    func snap_normal_dial_point(dx: real, dy: real, back: bool,
        threshold: real)=> option<(real, real, real)>
    {
        let mut best = threshold * threshold;
        let mut hit = false;
        let mut bx = 0.;
        let mut by = 0.;
        let mut bz = back ? 1. | -1.;

        // 中心格点：正对（背面模式下背对）摄像机
        let dc = dx * dx + dy * dy;
        if (dc <= best)
        {
            best = dc;
            hit = true;
        }

        let inner_z = back ? 0.70710678 | -0.70710678;
        for (let mut k = 0; k < 8; k += 1)
        {
            let ang = (k as real) * (mathf::PI / 4.);
            let ux = mathf::cos(ang);
            let uy = mathf::sin(ang);
            // 45° 倾斜环（投影半径 = sin45°）
            let ix = ux * 0.70710678;
            let iy = uy * 0.70710678;
            let di = (ix - dx) * (ix - dx) + (iy - dy) * (iy - dy);
            if (di < best)
            {
                best = di;
                hit = true;
                bx = ix;
                by = iy;
                bz = inner_z;
            }
            // 盘缘：与屏幕平面平行（90° 倾斜）
            let de = (ux - dx) * (ux - dx) + (uy - dy) * (uy - dy);
            if (de < best)
            {
                best = de;
                hit = true;
                bx = ux;
                by = uy;
                bz = 0.;
            }
        }
        return hit
            ? option::value((bx, by, bz))
            | option::none: option<(real, real, real)>;
    }

    // 吸附到 8 根方位轴（每 45°：上下左右 + 四个斜向）：角度在容差内
    // 时把方向投影到轴上，保持径向距离（即倾斜量）不变。
    func snap_normal_dial_axis(dx: real, dy: real)=> (real, real)
    {
        let len = mathf::sqrt(dx * dx + dy * dy);
        if (len < 0.0001)
            return (dx, dy);
        let step = mathf::PI / 4.;
        let ang = mathf::atan2(dy, dx);
        let mut best = ang;
        let mut best_diff = 999.;
        for (let mut k = -4; k <= 4; k += 1)
        {
            let target = (k as real) * step;
            let d = mathf::abs(ang - target);
            if (d < best_diff)
            {
                best_diff = d;
                best = target;
            }
        }
        // 6° 角度容差；容差外保持自由角度
        if (best_diff > 0.10471976)
            return (dx, dy);
        return (mathf::cos(best) * len, mathf::sin(best) * len);
    }

    // 法线半球盘：盘心 = 屏幕外侧 (0,0,-1)，盘缘 = 与屏幕平面平行
    // （nz = 0）。按住拖动时鼠标位置直接映射为法线：角度 = 屏幕平面内的
    // 方位，半径 = 偏离屏幕法线的倾斜量（拖出盘外按盘缘夹取）。back 为
    // true 时盘心变为屏幕内侧 (0,0,1)，用于编辑背向法线。盘面同时作为
    // 预览：高光按法线的屏幕投影偏移，做出受该方向光照的球面观感；
    // 方位手柄指出方位（背向时改用琥珀色）。snap 为 true 时拖拽吸附到
    // 盘面格点（中心 / 45° 环 / 盘缘）。返回被改动的单位法线。
    func draw_normal_dial(label: string, nx: real, ny: real, nz: real,
        back: bool, snap: bool, side: real)=> option<(real, real, real)>
    {
        let pos = GetCursorScreenPos();
        let half = side * 0.5;
        let center = (pos[0] + half, pos[1] + half);
        let pressed = InvisibleButton(label, (side, side));
        let active = IsItemActive();
        if (active && !s_dial_held)
        {
            s_dial_held = true;
            s_dial_held_back = back;
        }
        let use_back = active
            ? s_dial_held_back
            | (pressed ? s_dial_held_back | back);
        if (!active)
            s_dial_held = false;

        let snap_threshold = 0.18;
        let mut result = option::none: option<(real, real, real)>;
        if (pressed || active)
        {
            let (mx, my) = GetMousePos();
            let mut dx = (mx - center[0]) / half;
            let mut dy = -(my - center[1]) / half;
            let len = mathf::sqrt(dx * dx + dy * dy);
            if (len > 1.)
            {
                // 拖出盘外：夹到盘缘（法线变为与屏幕平行）
                dx = dx / len;
                dy = dy / len;
            }
            else if (len < 0.02)
            {
                // 圆心附近吸附正对摄像机，避免拖动时抖出杂散方位
                dx = 0.;
                dy = 0.;
            }
            let mut rest = 1. - dx * dx - dy * dy;
            if (rest < 0.) rest = 0.;
            let mut nz_new = use_back
                ? mathf::sqrt(rest)
                | -mathf::sqrt(rest);
            // 吸附（可关闭）：优先格点，其次 8 根方位轴（轴吸附保持倾斜量）
            if (snap)
            {
                let mut on_point = false;
                match (snap_normal_dial_point(dx, dy, use_back, snap_threshold))
                {
                    value((sx, sy, sz))?
                    {
                        dx = sx;
                        dy = sy;
                        nz_new = sz;
                        on_point = true;
                    }
                    none?;
                }
                if (!on_point)
                {
                    let (ax, ay) = snap_normal_dial_axis(dx, dy);
                    dx = ax;
                    dy = ay;
                }
            }
            if (dx != nx || dy != ny || nz_new != nz)
                result = option::value((dx, dy, nz_new));
        }

        // ---- 预览：伪球面高光 + 盘缘 + 格点 + 方位手柄 ----
        let dl = GetWindowDrawList();
        let radius = half - 1.;
        let text_c = GetStyleColor(ImGuiCol::ImGuiCol_Text);
        let frame_c = GetStyleColor(ImGuiCol::ImGuiCol_FrameBg);
        let hot = pressed || active || IsItemHovered();
        // 背向（指向屏幕内）时手柄/盘缘改用琥珀色，与正面蓝盘区分
        let accent_f = use_back ? (1., 0.72, 0.35, 1.) | (0.42, 0.62, 0.95, 1.);
        // 悬停/拖拽时盘缘染强调色，提示此盘可拖动
        let ring_c = mixStyleColor(text_c, accent_f,
            hot ? 0.7 | 0., hot ? 190 | 82);
        let cross_c = mixStyleColor(text_c, text_c, 0., 30);
        let accent_c = mixStyleColor(text_c, accent_f, 0.7, 255);
        let bright_c = mixStyleColor(frame_c, text_c, 0.85, 255);
        // 格点颜色：开启吸附时更醒目；关闭时只作方位参考
        let dot_c = mixStyleColor(text_c, text_c, 0., snap ? 120 | 55);
        let ring45_c = mixStyleColor(text_c, text_c, 0., snap ? 34 | 20);
        // 斜向方位轴参考线：比水平/垂直十字更淡
        let axis_c = mixStyleColor(text_c, text_c, 0., snap ? 26 | 16);

        // 由暗到亮、沿法线屏幕投影偏移的一串同心圆 = 受该方向光照的球面
        for (let mut i = 0; i < 12; i += 1)
        {
            let t = (i as real) / 11.;
            let off = 0.66 * t;
            do dl->AddCircleFilled(
                (center[0] + nx * radius * off, center[1] - ny * radius * off),
                radius * (1. - 0.86 * t),
                mixStyleColor(frame_c, text_c, 0.08 + 0.74 * t, 255));
        }
        do dl->AddCircle(center, radius, ring_c, 1.);

        // 8 根方位轴（吸附参考）：水平/垂直稍亮，四个斜向更淡
        for (let mut k = 0; k < 8; k += 1)
        {
            let ang = (k as real) * (mathf::PI / 4.);
            let ux = mathf::cos(ang);
            let uy = mathf::sin(ang);
            do dl->AddLine(center,
                (center[0] + ux * radius, center[1] - uy * radius),
                k % 2 == 0 ? cross_c | axis_c, 1.);
        }

        // 预制格点：中心、45° 倾斜环、盘缘（与屏幕平行），各 8 方位
        do dl->AddCircle(center, radius * 0.70710678, ring45_c, 1.);
        do dl->AddCircleFilled(center, 2.5, dot_c);
        for (let mut k = 0; k < 8; k += 1)
        {
            let ang = (k as real) * (mathf::PI / 4.);
            let ux = mathf::cos(ang);
            let uy = mathf::sin(ang);
            do dl->AddCircleFilled(
                (center[0] + ux * radius * 0.70710678,
                 center[1] - uy * radius * 0.70710678), 2.5, dot_c);
            do dl->AddCircleFilled(
                (center[0] + ux * radius, center[1] - uy * radius),
                2.5, dot_c);
        }
        // 悬停时高亮鼠标附近的格点，提示松开后会吸附到该点
        if (snap && IsItemHovered())
        {
            let (mx, my) = GetMousePos();
            let hdx = (mx - center[0]) / half;
            let hdy = -(my - center[1]) / half;
            match (snap_normal_dial_point(hdx, hdy, use_back, snap_threshold))
            {
                value((sx, sy, _))?
                {
                    do dl->AddCircleFilled(
                        (center[0] + sx * radius, center[1] - sy * radius),
                        4.5, accent_c);
                }
                none?;
            }
        }

        let hx = center[0] + nx * radius;
        let hy = center[1] - ny * radius;
        if (nx * nx + ny * ny > 0.0004)
        {
            do dl->AddLine(center, (hx, hy), accent_c, 2.);
            do dl->AddCircleFilled((hx, hy), 5., accent_c);
        }
        do dl->AddCircleFilled(center, 3., bright_c);
        return result;
    }

    // 法线方向的一句话描述（配合方向盘预览阅读）
    func normal_direction_label(nx: real, ny: real, nz: real)=> string
    {
        if (mathf::sqrt(nx * nx + ny * ny) < 0.02)
            return nz > 0.
                ? "屏幕内（背对摄像机）"
                | "屏幕外（正对摄像机）";

        let ang = mathf::atan2(ny, nx) * mathf::RAD2DEG;
        let mut sector = "右";
        if (ang >= 22.5 && ang < 67.5)
            sector = "右上";
        else if (ang >= 67.5 && ang < 112.5)
            sector = "上";
        else if (ang >= 112.5 && ang < 157.5)
            sector = "左上";
        else if (ang >= 157.5 || ang < -157.5)
            sector = "左";
        else if (ang >= -157.5 && ang < -112.5)
            sector = "左下";
        else if (ang >= -112.5 && ang < -67.5)
            sector = "下";
        else if (ang < -22.5)
            sector = "右下";

        // 倾斜角 = 从屏幕外法线起算的夹角；背面法线从屏幕内法线起算，
        // 即同样显示"倾斜 45°"而不是 135°。归一化后的分量是 float 近似
        // 值（0.7071068），acos 会算出 44.999…/89.999…，须四舍五入，
        // 否则整度截断会显示成 44°/89°。
        let mut polar = -nz;
        if (polar < -1.) polar = -1.;
        if (polar > 1.) polar = 1.;
        let mut tilt_deg = mathf::acos(polar) * mathf::RAD2DEG;
        if (nz > 0.)
            tilt_deg = 180. - tilt_deg;
        let tilt = (tilt_deg + 0.5) as int;
        // 正面/背面半球都可能出现；背向（nz > 0）单独说明，避免与
        // 盘心（屏幕外）混淆
        return nz > 0.02
            ? F"{sector}，背向倾斜 {tilt}°"
            | F"{sector}，倾斜 {tilt}°";
    }

    public func draw_tile_panel(state: EditorState,
        ctx: option<TilemapContext>)=> void
    {
        let ts_doc = palette_tileset_doc(state, ctx);
        match (ts_doc)
        {
            none? { do TextDisabled("没有可用的图集文档"); return; }
            value(ts_id)?
            {
                let tid = state.m_palette_tile;
                let (src, ix, iy, walkable) = ts_id->tile_info(tid);
                let mut same_owner = false;
                match (state.m_palette_tile_ts)
                {
                    value(owner)? same_owner = owner == ts_id;
                    none?;
                }
                if (tid <= 0 || src < 0 || !same_owner)
                {
                    do TextDisabled("在左侧调色板点选一个瓦片以编辑");
                    do TextDisabled("瓦片的通行性、属性与自动拼接类型属于图集文档");
                    return;
                }

                let name = ts_id->tile_name(tid);
                let kind = ts_id->tile_kind(tid);
                // 批量编辑范围：调色板框选（无框选即单块）
                let ids = selected_tile_ids(state, ts_id);
                let batch = ids->len > 1;

                do Text(F"瓦片 #{tid}（源 {src + 1}，格 {ix},{iy}）");
                if (state.m_tileset_only->is_none)
                    do TextDisabled("瓦片的通行性/属性属于图集文档；保存地图时会一并保存引用图集");
                else
                    do TextDisabled("瓦片的通行性/属性属于本图集文档，保存图集（Ctrl+S）写回");
                if (batch)
                {
                    do TextColored((255, 196, 96, 255),
                        F"批量编辑：框选 {ids->len} 块瓦片");
                    do TextDisabled("通行性/法线/自动拼接/默认属性应用到全部；名称只改锚点");
                }
                do Separator();

                match (InputText(batch
                        ? "名称（仅锚点）##tile_name"
                        | "名称##tile_name", name))
                {
                    value(s)?
                    {
                        if (ts_id->set_tile_name(tid, s))
                            do note_tileset_edit(state, ts_id);
                    }
                    none?;
                }
                match (CheckBox("可通行##tile_walk", walkable != 0))
                {
                    value(b)? do batch_set_walkable(state, ts_id, ids, b);
                    none?;
                }

                do SeparatorText("法线");
                let (nx, ny, nz) = ts_id->tile_normal(tid);

                // 半球跟随当前法线；法线与屏幕平行（nz≈0）时沿用上次选择
                let mut back = s_normal_back;
                if (mathf::abs(nz) > 0.001)
                    back = nz > 0.;

                // 旋转手柄 + 球面预览：按住盘面拖动即旋转法线
                let avail_w = GetContentRegionAvail()[0];
                let dial = avail_w > 132. ? 132. | avail_w;
                let dial_pos = GetCursorScreenPos();
                do SetCursorScreenPos(
                    (dial_pos[0] + (avail_w - dial) * 0.5, dial_pos[1]));
                match (draw_normal_dial("##tile_normal_dial", nx, ny, nz,
                        back, s_normal_snap, dial))
                {
                    value(n)?
                        do batch_set_normal(state, ts_id, ids, n.0, n.1, n.2);
                    none?;
                }
                let caption = normal_direction_label(nx, ny, nz);
                let cap_w = CalcTextSize(caption)[0];
                let cap_pos = GetCursorScreenPos();
                if (avail_w > cap_w)
                    do SetCursorScreenPos(
                        (cap_pos[0] + (avail_w - cap_w) * 0.5, cap_pos[1]));
                do TextDisabled(caption);
                do PushTextWrapPos(0.);
                do TextDisabled("拖动圆盘旋转：圆心 = 屏幕外，盘缘 = 与屏幕平行。");
                do TextDisabled("开启「吸附」时对准中心 / 45° / 90° 格点与 8 根方位轴。");
                do TextDisabled("法线参与网格顶点生成；自动拼接格整格共享锚点瓦片的法线。");
                do PopTextWrapPos();

                // 吸附开关与半球开关（背面 = 法线指向屏幕内）
                match (CheckBox("吸附##tile_normal_snap", s_normal_snap))
                {
                    value(v)? s_normal_snap = v;
                    none?;
                }
                if (IsItemHovered())
                    do SetTooltip("拖动圆盘时吸附到中心 / 45° / 90° 格点与 8 根方位轴");
                do SameLine();
                match (CheckBox("背面##tile_normal_back", back))
                {
                    value(v)?
                    {
                        s_normal_back = v;
                        do batch_flip_normal(state, ts_id, ids, v);
                    }
                    none?;
                }
                if (IsItemHovered())
                    do SetTooltip("法线指向屏幕内（背对摄像机）；平面内法线保持原有方位");

                // 精确数值（方向盘之外的直接输入）
                match (InputFloat3("##tile_normal", nx, ny, nz))
                {
                    value(n)?
                        do batch_set_normal(state, ts_id, ids, n.0, n.1, n.2);
                    none?;
                }

                do SeparatorText("自动拼接");
                let kinds = ["普通瓦片", "四象限(XP条带)", "blob47", "四象限(VX 2x3块)"];
                match (ListBoxSelect("##tile_kind_edit", kinds, kind))
                {
                    value(k)? do batch_set_kind(state, ts_id, ids, k);
                    none?;
                }
                if (kind == tilemap::tile_kind::PLAIN as int)
                    do TextDisabled("普通瓦片：整块绘制，不解析邻接");
                else if (is_quadrant_kind(kind))
                {
                    do TextDisabled("锚点 = 本瓦片；四象限占用锚点起 2×3 格，");
                    do TextDisabled("请确认这些格子在源纹理中属于同一块自动图块素材。");
                }
                else if (kind == tilemap::tile_kind::BLOB47 as int)
                {
                    do TextDisabled("默认布局：锚点起行优先连续 47 格；");
                    let vn = ts_id->tile_variant_count(tid);
                    if (vn == 0)
                        do TextDisabled("当前使用默认布局（无显式变体）");
                    else
                    {
                        do Text(F"显式变体 {vn} 项（按 47 变体序的瓦片 id）");
                        if (Button("清空显式变体"))
                        {
                            do ts_id->tile_clear_variants(tid);
                            do note_tileset_edit(state, ts_id);
                        }
                    }
                }
                do TextDisabled("地图中按自动拼接绘制时，用画笔的「自动图块」视图选中本瓦片。");

                let pcount = ts_id->property_count();
                if (pcount > 0)
                {
                    do SeparatorText("默认属性");
                    for (let mut i = 0; i < pcount; i += 1)
                    {
                        let (pname, ptype) = ts_id->property_info(i);
                        do draw_tile_default_editor(state, ts_id, ids, tid, pname, ptype);
                    }
                }
                else
                    do TextDisabled("图集尚未定义属性 schema");
            }
        }
    }

    // ---- 格子属性：取值链展示 + 覆盖编辑 ----
    func draw_cell_properties(state: EditorState, ctx: TilemapContext)=> void
    {
        match (state.m_hover_cell)
        {
            none? { do TextDisabled("把鼠标移到画布格子上查看属性"); return; }
            value((x, y))?
            {
                do Text(F"格子 ({x}, {y})，图层 {state.m_layer}");
                do Separator();

                // 该格所在瓦片的图集 schema（跨全部引用图集并集展示）
                let ts_count = ctx.m_map->tileset_count();
                let mut shown_any = false;
                for (let mut tsi = 0; tsi < ts_count; tsi += 1)
                {
                    let ts_doc = ctx->tileset_id(tsi);
                    if (ts_doc->is_none)
                        continue;
                    let ts_id = ts_doc->unwrap();
                    let pcount = ts_id->property_count();
                    for (let mut pi = 0; pi < pcount; pi += 1)
                    {
                        let (pname, ptype) = ts_id->property_info(pi);
                        if (!shown_any)
                        {
                            do TextDisabled("逐格覆盖（留空 = 用默认值）：");
                            shown_any = true;
                        }
                        do draw_one_property_editor(state, ctx, x, y, pname, ptype);
                    }
                }
                if (!shown_any)
                    do TextDisabled("图集未定义任何属性 schema");
                else
                {
                    do Separator();
                    let v = ctx.m_map->get_tile(state.m_layer, x, y);
                    if (v == 0)
                        do TextDisabled("空格子");
                    else
                    {
                        let w = ctx.m_map->walkable(x, y);
                        do Text(w ? "通行性：可通行" | "通行性：不可通行");
                    }
                }
            }
        }
    }

    // 单条属性：覆盖值编辑器 + 当前生效值显示。值按 schema 类型化
    //存取（类型与实际存储不符时读写失败，编辑器不会产生错型写入）
    func draw_one_property_editor(state: EditorState, ctx: TilemapContext,
        x: int, y: int, name: string, ptype: int)=> void
    {
        let doc_id = ctx.m_map;
        let layer = state.m_layer;
        let tag = F"##cellprop_{name}";

        // ---- bool ----
        if (ptype == property_type::BOOL as int)
        {
            match (doc_id->get_cell_property_bool(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        // 进入覆盖：以当前生效值初始化
                        let mut init = false;
                        match (doc_id->get_property_bool(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_bool(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_bool(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (CheckBox(tag, cur))
                    {
                        value(b)?
                        {
                            do doc_id->set_cell_property_bool(layer, x, y, name,
                                option::value(b));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- int ----
        if (ptype == property_type::INT as int)
        {
            match (doc_id->get_cell_property_int(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        let mut init = 0;
                        match (doc_id->get_property_int(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_int(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_int(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (InputInt(tag, cur))
                    {
                        value(v)?
                        {
                            do doc_id->set_cell_property_int(layer, x, y, name,
                                option::value(v));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- float ----
        if (ptype == property_type::FLOAT as int)
        {
            match (doc_id->get_cell_property_real(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        let mut init = 0.;
                        match (doc_id->get_property_real(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_real(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_real(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (InputFloat(tag, cur))
                    {
                        value(v)?
                        {
                            do doc_id->set_cell_property_real(layer, x, y, name,
                                option::value(v));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- string ----
        if (ptype == property_type::STRING as int)
        {
            match (doc_id->get_cell_property_string(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        let mut init = "";
                        match (doc_id->get_property_string(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_string(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_string(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (InputText(tag, cur))
                    {
                        value(s)?
                        {
                            do doc_id->set_cell_property_string(layer, x, y, name,
                                option::value(s));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- vec2 ----
        if (ptype == property_type::VEC2 as int)
        {
            match (doc_id->get_cell_property_vec2(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        let mut init = (0., 0.);
                        match (doc_id->get_property_vec2(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_vec2(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value((ca, cb))?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_vec2(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (InputFloat2(tag, ca, cb))
                    {
                        value((a, b))?
                        {
                            do doc_id->set_cell_property_vec2(layer, x, y, name,
                                option::value((a, b)));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- vec3 ----
        if (ptype == property_type::VEC3 as int)
        {
            match (doc_id->get_cell_property_vec3(layer, x, y, name))
            {
                none?
                {
                    if (Button(F"+##ov_{name}"))
                    {
                        let mut init = (0., 0., 0.);
                        match (doc_id->get_property_vec3(layer, x, y, name))
                        {
                            value(r)? { init = r; }
                            none?;
                        }
                        do doc_id->set_cell_property_vec3(layer, x, y, name,
                            option::value(init));
                        state.m_dirty = true;
                    }
                    SameLine();
                    do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                    do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
                }
                value((ca, cb, cc))?
                {
                    do Text(name);
                    SameLine();
                    if (Button(F"清除##ov_{name}"))
                    {
                        do doc_id->set_cell_property_vec3(layer, x, y, name, option::none);
                        state.m_dirty = true;
                    }
                    SameLine();
                    match (InputFloat3(tag, ca, cb, cc))
                    {
                        value((a, b, c))?
                        {
                            do doc_id->set_cell_property_vec3(layer, x, y, name,
                                option::value((a, b, c)));
                            state.m_dirty = true;
                        }
                        none?;
                    }
                }
            }
            return;
        }

        // ---- vec4 ----
        match (doc_id->get_cell_property_vec4(layer, x, y, name))
        {
            none?
            {
                if (Button(F"+##ov_{name}"))
                {
                    let mut init = (0., 0., 0., 0.);
                    match (doc_id->get_property_vec4(layer, x, y, name))
                    {
                        value(r)? { init = r; }
                        none?;
                    }
                    do doc_id->set_cell_property_vec4(layer, x, y, name,
                        option::value(init));
                    state.m_dirty = true;
                }
                SameLine();
                do Text(F"{name} = {format_resolved_property(doc_id, layer, x, y, name, ptype)}");
                do SetTooltip(F"类型 {PROPERTY_TYPE_NAMES[ptype]}，点击 + 设置逐格覆盖");
            }
            value((ca, cb, cc, cd))?
            {
                do Text(name);
                SameLine();
                if (Button(F"清除##ov_{name}"))
                {
                    do doc_id->set_cell_property_vec4(layer, x, y, name, option::none);
                    state.m_dirty = true;
                }
                SameLine();
                match (InputFloat4(tag, ca, cb, cc, cd))
                {
                    value((a, b, c, d))?
                    {
                        do doc_id->set_cell_property_vec4(layer, x, y, name,
                            option::value((a, b, c, d)));
                        state.m_dirty = true;
                    }
                    none?;
                }
            }
        }
    }

    // ---- 图集设置入口：地图模式只管理引用；图集内容编辑在图集编辑器 ----
    public func draw_tileset_settings(state: EditorState,
        ctx: option<TilemapContext>)=> void
    {
        if (state.m_tileset_only->is_none)
        {
            do draw_tileset_references(state, ctx->unwrap());
            do Separator();
            do TextDisabled("瓦片本身的通行性、属性与自动拼接类型在「瓦片」页编辑；");
            do TextDisabled("源纹理/属性 schema 的编辑请双击图集文件，在");
            do TextDisabled("图集编辑器的「图集设置」中进行。");
            return;
        }
        do draw_tileset_content(state, state.m_tileset_only->unwrap());
    }

    // ---- 地图对图集的引用管理 ----
    // 图集(.je4tileset)是独立文件，地图须显式引用（引用表随 .je4tilemap
    // 保存）。此处列出引用并支持添加/移除；添加弹窗扫描项目内的
    // .je4tileset 文件供选择，也接受手动输入路径。
    func draw_tileset_references(state: EditorState, ctx: TilemapContext)=> void
    {
        do Text("引用的图集：");
        let ref_count = ctx.m_map->tileset_count();
        if (ref_count == 0)
            do TextDisabled("（未引用任何图集，地图无法绘制瓦片）");
        for (let mut i = 0; i < ref_count; i += 1)
        {
            let ref_path = ctx.m_map->tileset_path(i);
            do PushIDInt(i);
            do Text(F"[{i}] {ref_path}");
            SameLine();
            if (Button("取消引用"))
            {
                do ctx.m_map->remove_tileset(i);
                // 引用表下标变化，已有画笔块（值里编码了图集下标）失效
                do state->clear_stamp();
                state.m_dirty = true;
            }
            do PopID();
        }
        if (Button("+ 引用图集"))
        {
            // 打开弹窗时扫描项目内的 .je4tileset
            state.m_found_tilesets->clear();
            for (let p : recursive_walk(workpath()) |> iter_result
                |> filter(\p = isfile(p)
                    && string::lower(extension(p)) == ".je4tileset";)
                |> collect
                |> sort(\l, r = l->to_string() < r->to_string();))
            {
                do state.m_found_tilesets->add(
                    ResourcePath::toRuntimeResourcePath(p));
            }
            do OpenPopup("##add_tileset_ref_popup");
        }
        do draw_add_tileset_ref_popup(state, ctx);
        do Separator();
    }

    func draw_add_tileset_ref_popup(state: EditorState, ctx: TilemapContext)=> void
    {
        if (BeginPopup("##add_tileset_ref_popup"))
        {
            do Text("项目中的图集（点击引用）：");
            if (state.m_found_tilesets->len == 0)
                do TextDisabled("未在项目中找到 .je4tileset");
            for (let found : state.m_found_tilesets)
            {
                if (SelectableSelected(F"{found}##found", false))
                {
                    match (ctx.m_map->add_tileset(found))
                    {
                        value(idx)?
                        {
                            state.m_palette_tileset = idx;
                            state.m_palette_source = 0;
                            do state->clear_stamp();
                            state.m_dirty = true;
                            do CloseCurrentPopup();
                        }
                        none?;
                    }
                }
            }
            do Separator();
            match (InputText("手动路径", state.m_add_ref_path))
            {
                value(s)? state.m_add_ref_path = s;
                none?;
            }
            if (Button("按路径引用"))
            {
                match (ctx.m_map->add_tileset(state.m_add_ref_path))
                {
                    value(idx)?
                    {
                        state.m_palette_tileset = idx;
                        state.m_palette_source = 0;
                        state.m_add_ref_path = "";
                        do state->clear_stamp();
                        state.m_dirty = true;
                        do CloseCurrentPopup();
                    }
                    none? do MsgBox::err("引用失败",
                        F"无法打开图集 \"{state.m_add_ref_path}\"，请检查路径");
                }
            }
            SameLine();
            if (Button("取消"))
                do CloseCurrentPopup();
            do EndPopup();
        }
    }

    // ---- 图集设置：名称/源纹理（含附加层级）/属性 schema ----
    func draw_tileset_content(state: EditorState, ts_id: tilemap::Tileset)=> void
    {

        // 名称
        match (InputText("图集名称", ts_id->name()))
        {
            value(s)?
            {
                do ts_id->set_name(s);
                state.m_dirty = true;
            }
            none?;
        }
        do Separator();

        // 源纹理
        do Text("源纹理：");
        let src_count = ts_id->source_count();
        for (let mut i = 0; i < src_count; i += 1)
        {
            let (path, _, xc, yc) = ts_id->source_info(i);
            do PushIDInt(i);
            if (TreeNode(F"源 {i}：{filename(normalize(path))}（{xc}×{yc} 格）"))
            {
                defer TreePop();
                do draw_source_extras(state, ts_id, i, path);
            }
            SameLine();
            if (Button("移除源"))
            {
                do ts_id->remove_source(i);
                state.m_dirty = true;
            }
            do PopID();
        }
        match (InputText("纹理路径(@/..)", state.m_new_source_path))
        {
            value(s)? state.m_new_source_path = s;
            none?;
        }
        match (InputInt("瓦片像素", state.m_new_source_tilepx))
        {
            value(v)? state.m_new_source_tilepx = v < 1 ? 1 | v;
            none?;
        }
        if (Button("添加源纹理"))
        {
            match (ts_id->add_source(
                state.m_new_source_path, state.m_new_source_tilepx))
            {
                value(idx)?
                {
                    state.m_palette_source = idx;
                    state.m_dirty = true;
                }
                none? do MsgBox::err("添加失败",
                    "无法加载该纹理，请检查路径（如 @/resource/tileset.png）与瓦片像素");
            }
        }
        do Separator();

        // 属性 schema（瓦片通行性/自动拼接类型/默认属性在「瓦片」页编辑）
        do draw_schema_editing(state, ts_id);
    }

    // 某源最小未占用的层级通道号（>= 1；新增层级的默认通道）
    func suggest_extra_pass(ts_id: tilemap::Tileset, source_idx: int)=> int
    {
        for (let mut guess = 1; guess < 64; guess += 1)
        {
            let mut used = false;
            for (let mut k = 0; k < ts_id->source_extra_count(source_idx); k += 1)
            {
                let (epass, _) = ts_id->source_extra_info(source_idx, k);
                if (epass == guess)
                    used = true;
            }
            if (!used)
                return guess;
        }
        return 64;
    }

    // 源纹理的附加层级编辑：主纹理固定通道 0，层级各占一个 >= 1 的
    // 通道（如法线图集常用通道 1），与主纹理共用瓦片网格
    func draw_source_extras(state: EditorState, ts_id: tilemap::Tileset,
        source_idx: int, main_path: string)=> void
    {
        do TextDisabled(F"主纹理（通道 0）：{main_path}");

        let extra_count = ts_id->source_extra_count(source_idx);
        if (extra_count == 0)
            do TextDisabled("（无附加层级纹理，如法线图集可在下方添加）");
        for (let mut k = 0; k < extra_count; k += 1)
        {
            let (epass, epath) = ts_id->source_extra_info(source_idx, k);
            do PushIDInt(k);
            match (InputInt("通道", epass))
            {
                value(v)?
                {
                    if (v < 1)
                        do MsgBox::err("修改通道失败",
                            "通道 0 保留给图集主纹理，层级通道须 >= 1");
                    else if (!ts_id->set_source_extra_pass(source_idx, k, v))
                        do MsgBox::err("修改通道失败",
                            F"通道 {v} 已被该源的其他层级占用");
                    else
                        state.m_dirty = true;
                }
                none?;
            }
            SameLine();
            do Text(epath);
            SameLine();
            if (Button("×"))
            {
                do ts_id->remove_source_extra(source_idx, k);
                state.m_dirty = true;
            }
            if (IsItemHovered())
                do SetTooltip("移除该层级纹理");
            do PopID();
        }

        do Separator();
        let sug_pass = suggest_extra_pass(ts_id, source_idx);
        match (InputText("层级纹理路径(@/..)",
            state.m_new_extra_path->get_or(source_idx, "")))
        {
            value(s)? do state.m_new_extra_path->set(source_idx, s);
            none?;
        }
        match (InputInt("通道##extra_add_pass",
            state.m_new_extra_pass->get_or(source_idx, sug_pass)))
        {
            value(v)? do state.m_new_extra_pass->set(source_idx, v < 1 ? 1 | v);
            none?;
        }
        if (Button("添加层级纹理"))
        {
            if (!ts_id->add_source_extra(source_idx,
                state.m_new_extra_path->get_or(source_idx, ""),
                state.m_new_extra_pass->get_or(source_idx, sug_pass)))
                do MsgBox::err("添加失败",
                    "无法添加层级纹理：请检查路径、纹理可加载且尺寸与主纹理网格相符；同一源内通道须唯一");
            else
            {
                state.m_dirty = true;
                do state.m_new_extra_path->set(source_idx, "");
            }
        }
        if (IsItemHovered())
            do SetTooltip(
                "层级与主纹理共用瓦片网格，按指定通道展开为数组纹理供着色器采样（采样声明如 texture2darray::uniform(通道)）");
    }

    // 按所选类型添加属性（默认值取类型零值）；返回新属性下标
    func add_schema_property(ts_id: tilemap::Tileset, name: string, ptype: int)=> option<int>
    {
        if (ptype == property_type::BOOL as int)
            return ts_id->add_property_bool(name, option::none: option<bool>);
        if (ptype == property_type::INT as int)
            return ts_id->add_property_int(name, option::none: option<int>);
        if (ptype == property_type::FLOAT as int)
            return ts_id->add_property_real(name, option::none: option<real>);
        if (ptype == property_type::STRING as int)
            return ts_id->add_property_string(name, option::none: option<string>);
        if (ptype == property_type::VEC2 as int)
            return ts_id->add_property_vec2(name, option::none: option<(real, real)>);
        if (ptype == property_type::VEC3 as int)
            return ts_id->add_property_vec3(name, option::none: option<(real, real, real)>);
        return ts_id->add_property_vec4(name, option::none: option<(real, real, real, real)>);
    }

    func draw_schema_editing(state: EditorState, ts_id: tilemap::Tileset)=> void
    {
        do Text("属性 schema（作用于整个图集）：");
        let pcount = ts_id->property_count();
        for (let mut i = 0; i < pcount; i += 1)
        {
            let (pname, ptype) = ts_id->property_info(i);
            do PushIDInt(i);
            do Text(F"{pname} : {PROPERTY_TYPE_NAMES[ptype]} = {format_schema_default(ts_id, pname, ptype)}");
            SameLine();
            if (Button("删除"))
            {
                do ts_id->remove_property(pname);
                state.m_dirty = true;
            }
            do PopID();
        }
        match (InputText("属性名", state.m_new_prop_name))
        {
            value(s)? state.m_new_prop_name = s;
            none?;
        }
        match (ListBoxSelect("##prop_type", PROPERTY_TYPE_NAMES, state.m_new_prop_type))
        {
            value(t)? state.m_new_prop_type = t;
            none?;
        }
        if (Button("+ 添加属性"))
        {
            if (state.m_new_prop_name != "")
            {
                match (add_schema_property(ts_id, state.m_new_prop_name,
                        state.m_new_prop_type))
                {
                    value(_)?
                    {
                        state.m_new_prop_name = "";
                        state.m_dirty = true;
                    }
                    none? do MsgBox::err("添加失败", "同名属性已存在");
                }
            }
        }
    }

    // 瓦片默认属性一行：无值时 + 按钮（类型零值），有值时控件 + 清除。
    // 显示值读自锚点瓦片；写入对框选内的全部瓦片生效。脏标记统一经
    // note_tileset_edit（地图模式同时登记图集待保存）
    func draw_tile_default_editor(state: EditorState, ts_id: tilemap::Tileset,
        ids: vec<int>, tile_id: int, name: string, ptype: int)=> void
    {
        do PushIDStr(name);
        if (ptype == property_type::BOOL as int)
        {
            match (ts_id->get_tile_property_bool(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_bool(state, ts_id, ids, name, option::value(false));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_bool(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (CheckBox("##def", cur))
                    {
                        value(b)? do batch_set_prop_bool(state, ts_id, ids, name, option::value(b));
                        none?;
                    }
                }
            }
        }
        else if (ptype == property_type::INT as int)
        {
            match (ts_id->get_tile_property_int(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_int(state, ts_id, ids, name, option::value(0));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_int(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputInt("##def", cur))
                    {
                        value(v)? do batch_set_prop_int(state, ts_id, ids, name, option::value(v));
                        none?;
                    }
                }
            }
        }
        else if (ptype == property_type::FLOAT as int)
        {
            match (ts_id->get_tile_property_real(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_real(state, ts_id, ids, name, option::value(0.));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_real(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputFloat("##def", cur))
                    {
                        value(v)? do batch_set_prop_real(state, ts_id, ids, name, option::value(v));
                        none?;
                    }
                }
            }
        }
        else if (ptype == property_type::STRING as int)
        {
            match (ts_id->get_tile_property_string(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_string(state, ts_id, ids, name, option::value(""));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value(cur)?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_string(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputText("##def", cur))
                    {
                        value(s)? do batch_set_prop_string(state, ts_id, ids, name, option::value(s));
                        none?;
                    }
                }
            }
        }
        else if (ptype == property_type::VEC2 as int)
        {
            match (ts_id->get_tile_property_vec2(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_vec2(state, ts_id, ids, name, option::value((0., 0.)));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value((ca, cb))?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_vec2(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputFloat2("##def", ca, cb))
                    {
                        value((a, b))? do batch_set_prop_vec2(state, ts_id, ids, name, option::value((a, b)));
                        none?;
                    }
                }
            }
        }
        else if (ptype == property_type::VEC3 as int)
        {
            match (ts_id->get_tile_property_vec3(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_vec3(state, ts_id, ids, name, option::value((0., 0., 0.)));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value((ca, cb, cc))?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_vec3(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputFloat3("##def", ca, cb, cc))
                    {
                        value((a, b, c))? do batch_set_prop_vec3(state, ts_id, ids, name, option::value((a, b, c)));
                        none?;
                    }
                }
            }
        }
        else
        {
            match (ts_id->get_tile_property_vec4(tile_id, name))
            {
                none?
                {
                    if (Button("+"))
                        do batch_set_prop_vec4(state, ts_id, ids, name, option::value((0., 0., 0., 0.)));
                    SameLine();
                    do Text(F"{name}（默认）");
                }
                value((ca, cb, cc, cd))?
                {
                    do Text(name);
                    SameLine();
                    if (Button("清除"))
                        do batch_set_prop_vec4(state, ts_id, ids, name, option::none);
                    SameLine();
                    match (InputFloat4("##def", ca, cb, cc, cd))
                    {
                        value((a, b, c, d))? do batch_set_prop_vec4(state, ts_id, ids, name, option::value((a, b, c, d)));
                        none?;
                    }
                }
            }
        }
        do PopID();
    }
}
