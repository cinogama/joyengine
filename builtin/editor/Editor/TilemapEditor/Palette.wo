// 瓦片地图编辑器 —— 瓦片调色板。
// 图集的每个源纹理格都是一块瓦片：左栏直接展示图集网格，点击即选中
// 该格为画笔（无需注册）；按住左键拖动则框选 N×M 矩形，作为多格
// 画笔在画布上整块绘制。"自动图块"视图列出自动拼接类型非普通的
// 瓦片（原来的"地形"），点击按自动拼接绘制。图集编辑器使用同一套
// 网格视图，点选瓦片后在右侧编辑其通行性/属性/自动拼接类型。

import pkg::std;

import je;
import je::gui;
import je::graphic;
import je::tilemap;

import pkg::fsys;
import pkg::math;

import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;

import DataModel;
import EditorState;

using std;
using je;
using je::gui;
using je::graphic;
using je::tilemap;
using fsys;
using math;
using JEEditor::GUI::Forms;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    // ==================== 画笔选择与 UV 工具 ====================

    // 自动拼接类型的显示名
    public func tile_kind_name(kind: int)=> string
    {
        if (kind == tilemap::tile_kind::PLAIN as int)
            return "普通";
        if (kind == tilemap::tile_kind::RPGMAKER as int)
            return "四象限(XP)";
        if (kind == tilemap::tile_kind::BLOB47 as int)
            return "blob47";
        if (kind == tilemap::tile_kind::RPGMAKER_VX as int)
            return "四象限(VX)";
        return "?";
    }

    // 是否四象限类自动图块（XP 条带 / VX 2x3 块，均按 2x3 块对齐与覆盖）
    public func is_quadrant_kind(kind: int)=> bool
    {
        return kind == tilemap::tile_kind::RPGMAKER as int
            || kind == tilemap::tile_kind::RPGMAKER_VX as int;
    }

    // 画笔值编码所用的"图集下标"：地图模式取当前调色板图集页签；
    // 图集编辑模式无地图（画笔不可用），固定 0
    func brush_tileset_index(state: EditorState)=> int
    {
        return state.m_tileset_only->is_value ? 0 | state.m_palette_tileset;
    }

    // 选中某图集格为画笔；auto = 按自动拼接类型绘制（负值），
    // 否则按原样绘制（正值）
    public func select_tile_brush(state: EditorState, ts_id: tilemap::Tileset,
        source_idx: int, cx: int, cy: int, auto_mode: bool)=> void
    {
        let tid = ts_id->tile_id_at(source_idx, cx, cy);
        if (tid <= 0)
            return;
        state.m_palette_source = source_idx;
        state.m_palette_cell = option::value((cx, cy));
        state.m_palette_tile = tid;
        state.m_palette_tile_ts = option::value(ts_id);
        state.m_palette_auto = auto_mode;
        state.m_paint = auto_mode
            ? tilemap::auto_value(brush_tileset_index(state), tid)
            | tilemap::tile_value(brush_tileset_index(state), tid);
    }

    // 当前选中瓦片是否属于该图集文档（切换页签后旧选择自动失效）
    public func palette_tile_selected(state: EditorState,
        ts_id: tilemap::Tileset)=> bool
    {
        if (state.m_palette_tile <= 0)
            return false;
        match (state.m_palette_tile_ts)
        {
            value(owner)? return owner == ts_id;
            none? return false;
        }
        return false;
    }

    // 按瓦片 id 选中画笔（自动图块列表；锚点格由 tile_info 反查）。
    // 自动图块只按单格绘制，先收回已有框选，避免多格画笔残留
    func select_tile_brush_by_id(state: EditorState, ts_id: tilemap::Tileset,
        tid: int, auto_mode: bool)=> void
    {
        let (src, ix, iy, _) = ts_id->tile_info(tid);
        if (src < 0)
            return;
        do state->clear_stamp();
        do select_tile_brush(state, ts_id, src, ix, iy, auto_mode);
    }

    // 图集源纹理网格格的引擎空间 UV，供 AddImageUV 使用：
    // 返回 (左, 下, 右, 上)；引擎 v 向上增长而图像行向下增长，
    // 故 v = 1 - 图像行分数
    public func atlas_cell_uv(tex: texture2d, tile_px: int, ix: int, iy: int)
        => (real, real, real, real)
    {
        let (tw, th) = tex->size();
        let u0 = ix as real * tile_px as real / tw as real;
        let u1 = (ix + 1) as real * tile_px as real / tw as real;
        let v1 = 1.0 - iy as real * tile_px as real / th as real;
        let v0 = 1.0 - (iy + 1) as real * tile_px as real / th as real;
        return (u0, v0, u1, v1);
    }

    // 调色板当前图集的文档句柄（图集模式直接用编辑对象；地图模式取
    // 当前页签的引用解析结果；无可用图集返回 none）
    public func palette_tileset_doc(state: EditorState,
        ctx: option<TilemapContext>)=> option<tilemap::Tileset>
    {
        match (state.m_tileset_only)
        {
            value(ts)? { return option::value(ts); }
            none? { }
        }
        match (ctx)
        {
            value(c)?
            {
                let count = c.m_map->tileset_count();
                if (state.m_palette_tileset < 0 || state.m_palette_tileset >= count)
                    return option::none;
                return c->tileset_id(state.m_palette_tileset);
            }
            none? { return option::none; }
        }
    }

    // ==================== 调色板入口 ====================

    public func draw_palette(state: EditorState, ctx: option<TilemapContext>)=> void
    {
        match (ctx)
        {
            value(c)? do c->sync_tilesets();
            none? { }
        }

        if (state.m_tileset_only->is_value)
        {
            // ===== 图集编辑器：源纹理网格（点选瓦片，右侧编辑属性） =====
            match (palette_tileset_doc(state, ctx))
            {
                none? { do TextDisabled("图集文档不可用"); return; }
                value(ts_id)?
                {
                    let src_count = ts_id->source_count();
                    if (src_count == 0)
                    {
                        do TextDisabled("图集没有源纹理");
                        do TextDisabled("请在右侧「图集设置」中添加");
                        return;
                    }
                    if (state.m_palette_source >= src_count)
                        state.m_palette_source = 0;
                    do draw_source_selector(state, ts_id);
                    do draw_palette_layer_selector(state, ts_id);
                    if (BeginChildSizeFlags("##palette_grid",
                        GetContentRegionAvail()[0], 0.,
                        WindowsAttribute::ImGuiWindowFlags_NoMove))
                        do draw_tile_grid(state, ts_id, false);
                    EndChild();
                }
            }
            return;
        }

        // ===== 地图编辑器：图集页签 + 瓦片/自动图块两种画笔视图 =====
        match (ctx)
        {
            none? { }
            value(c)?
            {
                let ts_count = c.m_map->tileset_count();
                if (ts_count == 0)
                {
                    do TextDisabled("地图未引用任何图集");
                    do TextDisabled("请在右侧「图集设置」中添加");
                    return;
                }
                if (state.m_palette_tileset >= ts_count)
                    state.m_palette_tileset = ts_count - 1;
                if (BeginTabBar("##tileset_tabs"))
                {
                    for (let mut i = 0; i < ts_count; i += 1)
                    {
                        if (BeginTabItem(F"图集{i + 1}##ts{i}"))
                        {
                            if (state.m_palette_tileset != i)
                                do state->clear_stamp();
                            state.m_palette_tileset = i;
                            do EndTabItem();
                        }
                    }
                    do EndTabBar();
                }

                match (palette_tileset_doc(state, ctx))
                {
                    none? { do TextDisabled("图集文档不可用"); return; }
                    value(ts_id)?
                    {
                        let src_count = ts_id->source_count();
                        if (src_count == 0)
                        {
                            do TextDisabled("图集没有源纹理");
                            do TextDisabled("请双击图集文件在图集编辑器中添加");
                            return;
                        }
                        if (state.m_palette_source >= src_count)
                            state.m_palette_source = 0;
                        do draw_source_selector(state, ts_id);
                        // 画笔视图切换：瓦片网格 / 自动图块列表
                        if (BeginTabBar("##palette_mode"))
                        {
                            if (BeginTabItem("瓦片##palette_tiles"))
                            {
                                state.m_palette_mode = 0;
                                do draw_palette_layer_selector(state, ts_id);
                                if (BeginChildSizeFlags("##palette_grid",
                                    GetContentRegionAvail()[0], 0.,
                                    WindowsAttribute::ImGuiWindowFlags_NoMove))
                                    do draw_tile_grid(state, ts_id, true);
                                EndChild();
                                do EndTabItem();
                            }
                            if (BeginTabItem("自动图块##palette_auto"))
                            {
                                state.m_palette_mode = 1;
                                if (BeginChildSize("##palette_auto_list",
                                    GetContentRegionAvail()[0], 0.))
                                    do draw_auto_palette(state, ts_id);
                                EndChild();
                                do EndTabItem();
                            }
                            do EndTabBar();
                        }
                    }
                }
            }
        }
    }

    // 源纹理选择（多于一个源时显示）
    func draw_source_selector(state: EditorState, ts_id: tilemap::Tileset)=> void
    {
        let src_count = ts_id->source_count();
        if (src_count <= 1)
            return;
        let mut names = []mut: vec<string>;
        for (let mut i = 0; i < src_count; i += 1)
        {
            let (path, _, xc, yc) = ts_id->source_info(i);
            do names->add(F"源 {i + 1}：{filename(normalize(path))}（{xc}×{yc}）");
        }
        match (Combo("##palette_source", names->to_array,
            option::value(state.m_palette_source)))
        {
            value(sel)?
            {
                if (state.m_palette_source != sel)
                    do state->clear_stamp();
                state.m_palette_source = sel;
                state.m_palette_cell = option::none;
                state.m_palette_tile = 0;
                state.m_palette_layer = 0;
            }
            none?;
        }
    }

    // 网格预览层级：主纹理之外可切到各附加层级（如法线）
    func draw_palette_layer_selector(state: EditorState,
        ts_id: tilemap::Tileset)=> void
    {
        let extra_count = ts_id->source_extra_count(state.m_palette_source);
        if (extra_count > 0)
        {
            if (state.m_palette_layer > extra_count)
                state.m_palette_layer = 0;
            let mut layer_names = []mut: vec<string>;
            do layer_names->add("主纹理");
            for (let mut k = 0; k < extra_count; k += 1)
            {
                let (epass, epath) =
                    ts_id->source_extra_info(state.m_palette_source, k);
                do layer_names->add(
                    F"通道 {epass}：{filename(normalize(epath))}");
            }
            match (Combo("##palette_layer", layer_names->to_array,
                option::value(state.m_palette_layer)))
            {
                value(sel)? state.m_palette_layer = sel;
                none?;
            }
        }
        else
            state.m_palette_layer = 0;
    }

    // ==================== 瓦片网格视图 ====================

    // 全部自动图块（自动拼接类型非 PLAIN 的瓦片 id）
    public func collect_auto_tiles(ts_id: tilemap::Tileset)=> vec<int>
    {
        let out = []mut: vec<int>;
        let total = ts_id->tile_count();
        for (let mut i = 0; i < total; i += 1)
        {
            let tid = ts_id->tile_at_index(i);
            if (tid > 0 && ts_id->tile_kind(tid) != tilemap::tile_kind::PLAIN as int)
                do out->add(tid);
        }
        return out;
    }

    // 某源纹理网格视图（贴图 + 网格线 + 自动图块标记 + 交互选中）。
    // brush = true（地图编辑器）时点击即选为画笔；false（图集编辑器）
    // 时选为"当前编辑的瓦片"。两种模式都支持按住拖动框选矩形：
    // 地图编辑器里框选即多格画笔块，图集编辑器里框选用于批量编辑
    // 瓦片属性（见 PropertyPanel 的 selected_tile_ids）。
    public func draw_tile_grid(state: EditorState, ts_id: tilemap::Tileset,
        brush: bool)=> void
    {
        if (state.m_palette_source < 0
            || state.m_palette_source >= ts_id->source_count())
            return;
        let (tex_path, _, xc, yc) =
            ts_id->source_info(state.m_palette_source);
        // 预览层级贴图（0 = 主纹理；n = 第 n 条附加层级，共用网格）
        let mut display_path = tex_path;
        if (state.m_palette_layer > 0
            && state.m_palette_layer
                <= ts_id->source_extra_count(state.m_palette_source))
        {
            let (_, epath) = ts_id->source_extra_info(
                state.m_palette_source, state.m_palette_layer - 1);
            display_path = epath;
        }

        match (state->atlas_texture(display_path))
        {
            none? { do TextDisabled(F"纹理加载失败：{display_path}"); return; }
            value(tex)?
            {
                let (tw, th) = tex->size();
                let avail = GetContentRegionAvail();
                // 整张贴图缩放到面板宽度内（保持像素清晰由 NEAREST 采样保证）
                let scale = math::min(1., avail[0] / tw as real);
                do ImageSize(tex, tw as real * scale, th as real * scale);
                let (rect_min, rect_max) = GetItemRect();

                // 交互层：整张网格覆盖一个不可见按钮。Image 不是交互项，
                // 直接在上面按住拖动会被 ImGui 当成在窗口空白处拖动窗口
                //（ConfigWindowsMoveFromTitleBarOnly 缺省为 false），
                // 导致框选画笔时整个编辑器窗口跟着鼠标走。
                // 按钮取得 ActiveId 后，EndFrame 的移动窗口判定直接跳过。
                SetCursorScreenPos(rect_min);
                do InvisibleButton("##palette_grid_hit",
                    (rect_max[0] - rect_min[0], rect_max[1] - rect_min[1]));
                let item_hovered = IsItemHovered();

                // 格子像素按显示贴图尺寸/网格数推导（层级贴图分辨率可与
                // 主纹理不同，格子比例恒与网格一致）
                let cell_px = tw as real / xc as real * scale;
                if (cell_px < 3.)
                    return;

                do draw_atlas_grid_lines(rect_min, rect_max, cell_px, xc, yc);
                do draw_auto_tile_overlays(state, ts_id, rect_min, cell_px);
                // 地图编辑器：点击选画笔、拖动框选多格画笔；
                // 图集编辑器：只做悬停提示与点击选中
                if (brush)
                    do handle_atlas_brush_interaction(state, ts_id, rect_min,
                        cell_px, xc, yc, item_hovered);
                else
                    do handle_atlas_edit_interaction(state, ts_id, rect_min,
                        cell_px, xc, yc, item_hovered);
                do draw_atlas_selection(state, ts_id, rect_min, cell_px);
            }
        }
    }

    // 网格线（放大到可辨认时）
    func draw_atlas_grid_lines(rect_min: (real, real), rect_max: (real, real),
        cell_px: real, xc: int, yc: int)=> void
    {
        if (cell_px < 10.)
            return;
        let dl = GetWindowDrawList();
        for (let mut gx = 0; gx <= xc; gx += 1)
        {
            do dl->AddLine(
                (rect_min[0] + gx as real * cell_px, rect_min[1]),
                (rect_min[0] + gx as real * cell_px, rect_max[1]),
                (255, 255, 255, 36), 1.);
        }
        for (let mut gy = 0; gy <= yc; gy += 1)
        {
            do dl->AddLine(
                (rect_min[0], rect_min[1] + gy as real * cell_px),
                (rect_max[0], rect_min[1] + gy as real * cell_px),
                (255, 255, 255, 36), 1.);
        }
    }

    // 自动图块在网格上的标记：四象限类画出 2x3 块范围（这些格子的
    // 绘制由自动拼接接管），其余类型只标记锚点格
    func draw_auto_tile_overlays(state: EditorState, ts_id: tilemap::Tileset,
        rect_min: (real, real), cell_px: real)=> void
    {
        let dl = GetWindowDrawList();
        for (let tid : collect_auto_tiles(ts_id))
        {
            let (src, ix, iy, _) = ts_id->tile_info(tid);
            if (src != state.m_palette_source)
                continue;
            let x0 = rect_min[0] + ix as real * cell_px;
            let y0 = rect_min[1] + iy as real * cell_px;
            let kind = ts_id->tile_kind(tid);
            if (is_quadrant_kind(kind))
            {
                do dl->AddRectFilled((x0, y0),
                    (x0 + 2. * cell_px, y0 + 3. * cell_px),
                    (20, 24, 34, 90));
                do dl->AddRect((x0, y0),
                    (x0 + 2. * cell_px, y0 + 3. * cell_px),
                    (110, 200, 255, 120), 1.);
            }
            else
            {
                // blob47 / 其他：锚点格右上角三角标
                do dl->AddTriangleFilled(
                    (x0 + cell_px, y0),
                    (x0 + cell_px, y0 + cell_px * 0.45),
                    (x0 + cell_px * 0.55, y0),
                    (255, 190, 90, 200));
                do dl->AddRect((x0, y0), (x0 + cell_px, y0 + cell_px),
                    (255, 190, 90, 110), 1.);
            }
        }
    }

    // 悬停提示与描边：整块感知（四象限块内任意格都高亮整块并提示）
    func draw_atlas_hover_cell(state: EditorState, ts_id: tilemap::Tileset,
        cx: int, cy: int, rect_min: (real, real), cell_px: real,
        brush: bool)=> void
    {
        let dl = GetWindowDrawList();

        let tid = ts_id->tile_id_at(state.m_palette_source, cx, cy);
        if (tid > 0)
        {
            let (_, ix, iy, wk) = ts_id->tile_info(tid);
            let kind = ts_id->tile_kind(tid);
            let tname = ts_id->tile_name(tid);
            let shown = tname == "" ? F"瓦片 #{tid}" | tname;
            do dl->AddRect(
                (rect_min[0] + ix as real * cell_px,
                 rect_min[1] + iy as real * cell_px),
                (rect_min[0] + (ix + 1) as real * cell_px,
                 rect_min[1] + (iy + 1) as real * cell_px),
                (255, 255, 255, 220), 1.5);
            do SetTooltip(F"{shown} [{tile_kind_name(kind)}]"
                + (wk != 0 ? "：可通行" | "：不可通行")
                + (brush ? "，点击选为画笔，拖动框选多格画笔"
                    | "，点击编辑属性，拖动框选批量编辑"));
        }
    }

    // 图集格坐标夹取到网格内（框选拖动越界时按边界格继续）
    func clamp_grid_cell(v: int, n: int)=> int
    {
        if (v < 0)
            return 0;
        if (v >= n)
            return n - 1;
        return v;
    }

    // 以锚点格与当前格（含两端）更新画笔框选；矩形未变时不重建内容
    func update_stamp_box(state: EditorState, ts_id: tilemap::Tileset,
        ax: int, ay: int, bx: int, by: int)=> void
    {
        let left = math::min(ax, bx);
        let top = math::min(ay, by);
        let w = math::abs(ax - bx) + 1;
        let h = math::abs(ay - by) + 1;
        if (left == state.m_stamp_left && top == state.m_stamp_top
            && w == state.m_stamp_w && h == state.m_stamp_h
            && state.m_stamp_source == state.m_palette_source)
            return;
        do state->set_stamp_region(ts_id, state.m_palette_source,
            left, top, w, h, brush_tileset_index(state));
    }

    // 地图调色板网格交互：点击选中单格画笔，按住拖动框选 N×M 画笔块。
    // 框选期间鼠标移出网格也继续（按最近边界格夹取），松开提交；
    // 铅笔直接按框选结果落笔，无需切换工具。
    func handle_atlas_brush_interaction(state: EditorState,
        ts_id: tilemap::Tileset, rect_min: (real, real), cell_px: real,
        xc: int, yc: int, item_hovered: bool)=> void
    {
        let mouse = GetMousePos();
        let hx = ((mouse[0] - rect_min[0]) / cell_px) as int;
        let hy = ((mouse[1] - rect_min[1]) / cell_px) as int;
        let inside = hx >= 0 && hy >= 0 && hx < xc && hy < yc;

        if (inside)
            do draw_atlas_hover_cell(state, ts_id, hx, hy, rect_min, cell_px,
                true);

        if (item_hovered && inside
            && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Left))
        {
            // 按下：从该格开始框选（同时设为单格画笔）
            state.m_stamp_anchor = option::value((hx, hy));
            do state->set_stamp_region(ts_id, state.m_palette_source,
                hx, hy, 1, 1, brush_tileset_index(state));
            do select_tile_brush(state, ts_id, state.m_palette_source,
                hx, hy, false);
            return;
        }

        match (state.m_stamp_anchor)
        {
            value((ax, ay))?
            {
                if (IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Left))
                {
                    do update_stamp_box(state, ts_id, ax, ay,
                        clamp_grid_cell(hx, xc), clamp_grid_cell(hy, yc));
                }
                else if (IsMouseReleased(
                    ImGuiMouseButton::ImGuiMouseButton_Left))
                {
                    do update_stamp_box(state, ts_id, ax, ay,
                        clamp_grid_cell(hx, xc), clamp_grid_cell(hy, yc));
                    state.m_stamp_anchor = option::none;
                    // 框出多格后切到铅笔，落笔即为整块（单击不改变工具）
                    if (state->stamp_is_block())
                        state.m_tool = tool::PENCIL;
                }
                else
                {
                    // 窗口失焦/输入被系统抢走时松开事件会丢失，
                    // 放弃未完成的框选，避免下次点击沿用旧锚点
                    state.m_stamp_anchor = option::none;
                }
            }
            none?;
        }
    }

    // 图集编辑器网格交互：点击选中当前编辑的瓦片，拖动框选矩形用于
    // 批量编辑属性（复用画笔块的框选状态与描边；两个编辑器窗口各持
    // 独立的 EditorState，互不影响）。
    func handle_atlas_edit_interaction(state: EditorState,
        ts_id: tilemap::Tileset, rect_min: (real, real), cell_px: real,
        xc: int, yc: int, item_hovered: bool)=> void
    {
        let mouse = GetMousePos();
        let hx = ((mouse[0] - rect_min[0]) / cell_px) as int;
        let hy = ((mouse[1] - rect_min[1]) / cell_px) as int;
        let inside = hx >= 0 && hy >= 0 && hx < xc && hy < yc;

        if (inside)
            do draw_atlas_hover_cell(state, ts_id, hx, hy, rect_min, cell_px,
                false);

        if (item_hovered && inside
            && IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Left))
        {
            // 按下：从该格开始框选，同时设为当前编辑的瓦片（锚点）
            state.m_stamp_anchor = option::value((hx, hy));
            do state->set_stamp_region(ts_id, state.m_palette_source,
                hx, hy, 1, 1, brush_tileset_index(state));
            do select_tile_brush(state, ts_id, state.m_palette_source,
                hx, hy, false);
            return;
        }

        match (state.m_stamp_anchor)
        {
            value((ax, ay))?
            {
                if (IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Left))
                    do update_stamp_box(state, ts_id, ax, ay,
                        clamp_grid_cell(hx, xc), clamp_grid_cell(hy, yc));
                else if (IsMouseReleased(
                    ImGuiMouseButton::ImGuiMouseButton_Left))
                {
                    do update_stamp_box(state, ts_id, ax, ay,
                        clamp_grid_cell(hx, xc), clamp_grid_cell(hy, yc));
                    state.m_stamp_anchor = option::none;
                }
                else
                    state.m_stamp_anchor = option::none;
            }
            none?;
        }
    }

    // 选中态描边：画笔框选整块（蓝底+蓝框）或单格选中格（蓝框）；
    // 自动图块画笔选中时另画锚点块白框
    func draw_atlas_selection(state: EditorState, ts_id: tilemap::Tileset,
        rect_min: (real, real), cell_px: real)=> void
    {
        let dl = GetWindowDrawList();
        // 画笔框选优先于单格选中框（1×1 时两者重合）
        let mut stamp_shown = false;
        if (state->stamp_ready())
        {
            match (state.m_stamp_ts)
            {
                value(owner)?
                {
                    if (owner == ts_id
                        && state.m_stamp_source == state.m_palette_source)
                    {
                        let x0 = rect_min[0] + state.m_stamp_left as real * cell_px;
                        let y0 = rect_min[1] + state.m_stamp_top as real * cell_px;
                        let x1 = x0 + state.m_stamp_w as real * cell_px;
                        let y1 = y0 + state.m_stamp_h as real * cell_px;
                        do dl->AddRectFilled((x0, y0), (x1, y1),
                            (110, 200, 255, 40));
                        do dl->AddRect((x0, y0), (x1, y1),
                            (110, 200, 255, 255), 2.);
                        stamp_shown = true;
                    }
                }
                none?;
            }
        }
        if (!stamp_shown)
        {
            match (state.m_palette_cell)
            {
                value((sx, sy))?
                {
                    do dl->AddRect(
                        (rect_min[0] + sx as real * cell_px,
                         rect_min[1] + sy as real * cell_px),
                        (rect_min[0] + (sx + 1) as real * cell_px,
                         rect_min[1] + (sy + 1) as real * cell_px),
                        (110, 200, 255, 255), 2.);
                }
                none?;
            }
        }
        if (state.m_palette_auto && palette_tile_selected(state, ts_id))
        {
            let (src, ix, iy, _) = ts_id->tile_info(state.m_palette_tile);
            let kind = ts_id->tile_kind(state.m_palette_tile);
            if (src == state.m_palette_source)
            {
                let x0 = rect_min[0] + ix as real * cell_px;
                let y0 = rect_min[1] + iy as real * cell_px;
                if (is_quadrant_kind(kind))
                    do dl->AddRect((x0, y0),
                        (x0 + 2. * cell_px, y0 + 3. * cell_px),
                        (255, 255, 255, 255), 2.);
                else
                    do dl->AddRect((x0, y0), (x0 + cell_px, y0 + cell_px),
                        (255, 190, 90, 255), 2.);
            }
        }
    }

    // ==================== 自动图块列表（地图编辑器） ====================

    func draw_auto_palette(state: EditorState, ts_id: tilemap::Tileset)=> void
    {
        let auto_ids = collect_auto_tiles(ts_id);
        if (auto_ids->len == 0)
        {
            do TextDisabled("图集中没有自动图块。");
            do TextDisabled("在「瓦片」页选中一块瓦片，把它的自动拼接类型");
            do TextDisabled("改为四象限或 blob47 即可创建。");
            return;
        }
        let count = auto_ids->len;
        let cell = 40.;
        let avail_w = GetContentRegionAvail()[0];
        let per_row = math::max(1, (avail_w / cell) as int);
        let rows = (count + per_row - 1) / per_row;
        let mut slot = 0;
        for (let mut r = 0; r < rows; r += 1)
        {
            let n = math::min(per_row, count - slot);
            let pos = GetCursorScreenPos();
            do Dummy((n as real * cell, cell));
            let dl = GetWindowDrawList();
            let hovered = IsItemHovered();
            let clicked = IsItemClickedLeft();
            let mut hover_cx = option::none: option<int>;
            if (hovered)
            {
                let mouse = GetMousePos();
                hover_cx = option::value(((mouse[0] - pos[0]) / cell) as int);
            }
            for (let mut c = 0; c < n; c += 1)
            {
                let tid = auto_ids[slot + c];
                let (tname, k, s, ix, iy, _, _) = tile_info_full(ts_id, tid);
                let x0 = pos[0] + c as real * cell;
                let x1 = x0 + cell;
                // 图标 = 锚点孤块（该自动图块单独出现在地图中的样式）
                let mut drawn = false;
                if (s >= 0 && s < ts_id->source_count())
                {
                    let (tp, tpx, _, _) = ts_id->source_info(s);
                    match (state->atlas_texture(tp))
                    {
                        value(tex)?
                        {
                            let (u_l, v_b, u_r, v_t) = atlas_cell_uv(tex, tpx, ix, iy);
                            do dl->AddImageUV((x0, pos[1]), (x1, pos[1] + cell),
                                (u_l, v_b), (u_r, v_t), tex, (255, 255, 255, 255));
                            drawn = true;
                        }
                        none?;
                    }
                }
                if (!drawn)
                    do dl->AddRectFilled((x0, pos[1]), (x1, pos[1] + cell), (60, 60, 66, 255));
                let mut is_sel = state.m_palette_auto
                    && palette_tile_selected(state, ts_id)
                    && state.m_palette_tile == tid;
                if (is_sel)
                    do dl->AddRect((x0, pos[1]), (x1, pos[1] + cell), (255, 255, 255, 255), 2.);
                match (hover_cx)
                {
                    value(hc)?
                    {
                        if (c == hc)
                        {
                            do dl->AddRect((x0, pos[1]), (x1, pos[1] + cell),
                                (255, 255, 255, 220), 1.5);
                            do SetTooltip(F"{tname} [{tile_kind_name(k)}]：点击按自动拼接绘制");
                            if (clicked)
                                do select_tile_brush_by_id(state, ts_id, tid, true);
                        }
                    }
                    none?;
                }
            }
            slot += n;
        }

        // ---- 选中自动图块的连接预览 ----
        if (state.m_palette_auto && palette_tile_selected(state, ts_id)
            && ts_id->tile_kind(state.m_palette_tile) != tilemap::tile_kind::PLAIN as int)
        {
            do Separator();
            do Text("连接预览：");
            do draw_auto_preview(state, ts_id, state.m_palette_tile);
        }
    }

    // 取瓦片的完整信息（名称缺省时用 id 生成显示名）
    func tile_info_full(ts_id: tilemap::Tileset, tid: int)
        => (string, int, int, int, int, int, int)
    {
        let (src, ix, iy, wk) = ts_id->tile_info(tid);
        let name = ts_id->tile_name(tid);
        let shown = name == "" ? F"瓦片 #{tid}" | name;
        let kind = ts_id->tile_kind(tid);
        let vn = ts_id->tile_variant_count(tid);
        return (shown, kind, src, ix, iy, wk, vn);
    }

    // ==================== 自动图块连接预览 ====================

    // 取（或创建）某自动图块的连接预览地图（3x3 全铺该瓦片）。
    // 返回 none 表示不可用（图集尚未保存到磁盘或引用加入失败）。
    func auto_preview_map(state: EditorState, ts_id: tilemap::Tileset,
        tid: int)=> option<tilemap::Tilemap>
    {
        let doc_path = ts_id->doc_path();
        if (doc_path == "")
            return option::none;
        let key = F"{doc_path}#{tid}";
        for (let mut i = 0; i < state.m_preview_maps->len; i += 1)
        {
            match (state.m_preview_maps->get(i))
            {
                value((k, mid))?
                {
                    if (k == key)
                        return mid;
                }
                none?;
            }
        }
        match (tilemap::Tilemap::create(3, 3, 32))
        {
            none? { return option::none; }
            value(pm)?
            {
                let mut usable = option::none: option<tilemap::Tilemap>;
                match (pm->add_tileset(doc_path))
                {
                    value(idx)?
                    {
                        let tv = tilemap::auto_value(idx, tid);
                        for (let mut gy = 0; gy < 3; gy += 1)
                        {
                            for (let mut gx = 0; gx < 3; gx += 1)
                            {
                                do pm->set_tile(0, gx, gy, tv);
                            }
                        }
                        usable = option::value(pm);
                    }
                    none?;
                }
                // 即使引用失败也登记（none），避免每帧重试创建
                do state.m_preview_maps->add((key, usable));
                return usable;
            }
        }
    }

    // 自动图块连接预览：在隐藏 3x3 地图上铺满该瓦片并绘制中心区域，
    // 展示"周围都是同类"时的实际渲染效果。图集未保存时退化为锚点
    // 瓦片（孤块形态）图标。
    func draw_auto_preview(state: EditorState, ts_id: tilemap::Tileset,
        tid: int)=> void
    {
        let w = 96.;
        let h = 96.;
        let pm = auto_preview_map(state, ts_id, tid);

        let base = GetCursorScreenPos();
        do Dummy((w, h));
        let dl = GetWindowDrawList();

        if (pm->is_value)
        {
            let p = pm->unwrap();
            let cw = w / 3.;
            let ch = h / 3.;
            for (let mut gy = 0; gy < 3; gy += 1)
            {
                for (let mut gx = 0; gx < 3; gx += 1)
                {
                    let qn = p->cell_quad_count(0, gx, gy);
                    for (let mut q = 0; q < qn; q += 1)
                    {
                        match (p->cell_quad(0, gx, gy, q))
                        {
                            value((tp, u0, v0, u1, v1, qx, qy, qcols))?
                            {
                                match (state->atlas_texture(tp))
                                {
                                    value(tex)?
                                    {
                                        let sw = cw / qcols as real;
                                        let sh = ch / qcols as real;
                                        do dl->AddImageUV(
                                            (base[0] + gx as real * cw + qx as real * sw,
                                             base[1] + gy as real * ch + qy as real * sh),
                                            (base[0] + gx as real * cw + (qx + 1) as real * sw,
                                             base[1] + gy as real * ch + (qy + 1) as real * sh),
                                            (u0, v0), (u1, v1), tex, (255, 255, 255, 255));
                                    }
                                    none?;
                                }
                            }
                            none?;
                        }
                    }
                }
            }
            do dl->AddRect(base, (base[0] + w, base[1] + h), (255, 255, 255, 60), 1.);
            return;
        }

        // 图集未保存：退化为锚点孤块图标
        let (src, ix, iy, _) = ts_id->tile_info(tid);
        if (src >= 0 && src < ts_id->source_count())
        {
            let (tp, tpx, _, _) = ts_id->source_info(src);
            match (state->atlas_texture(tp))
            {
                value(tex)?
                {
                    let (u_l, v_b, u_r, v_t) = atlas_cell_uv(tex, tpx, ix, iy);
                    do dl->AddImageUV(base, (base[0] + w, base[1] + h),
                        (u_l, v_b), (u_r, v_t), tex, (255, 255, 255, 255));
                }
                none?;
            }
        }
        do dl->AddRect(base, (base[0] + w, base[1] + h), (255, 255, 255, 60), 1.);
    }
}
