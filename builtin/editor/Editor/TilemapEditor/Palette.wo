// 瓦片地图编辑器 —— 图集调色板。
// 左栏：图集页签（地图引用的每个 .je4tileset）-> 源纹理网格视图。
// 点击网格格：选中为画笔（普通瓦片，按需注册进瓦片表）；
// 下方地形列表选择自动图块画笔；"+" 从选中格新建地形。

import pkg::std;

import je;
import je::gui;
import je::graphic;
import je::tilemap;

import pkg::fsys;
import pkg::math;

import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;

import DataModel;
import EditorState;

using std;
using je;
using je::gui;
using je::graphic;
using je::tilemap;
using fsys;
using math;
using JEEditor::GUI::Forms;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    // 地形解析种类的显示名
    func terrain_kind_name(kind: int)=> string
    {
        if (kind == tilemap::terrain_kind::SINGLE as int)
            return "单块";
        if (kind == tilemap::terrain_kind::RPGMAKER as int)
            return "四象限(XP)";
        if (kind == tilemap::terrain_kind::BLOB47 as int)
            return "blob47";
        if (kind == tilemap::terrain_kind::RPGMAKER_VX as int)
            return "四象限(VX)";
        return "?";
    }

    // 调色板当前图集的文档句柄（无图集返回 0）
    public func palette_tileset_doc(state: EditorState, ctx: TilemapContext)=> int
    {
        if (state.m_tileset_only > 0)
            return state.m_tileset_only;
        let count = tilemap::tileset_count(ctx.m_map);
        if (state.m_palette_tileset < 0 || state.m_palette_tileset >= count)
            return 0;
        return ctx->tileset_id(state.m_palette_tileset);
    }

    public func draw_palette(state: EditorState, ctx: TilemapContext)=> void
    {
        do ctx->sync_tilesets();

        if (state.m_tileset_only > 0)
        {
            // ===== 图集编辑器：原始图块管理视图（源纹理/地形创建在此进行） =====
            let ts_id = palette_tileset_doc(state, ctx);
            if (ts_id <= 0)
            {
                do TextDisabled("图集文档不可用");
                return;
            }
            // ---- 源纹理选择 ----
            let src_count = tilemap::source_count(ts_id);
            if (src_count == 0)
            {
                do TextDisabled("图集没有源纹理");
                do TextDisabled("请在右侧「图集设置」中添加");
                return;
            }
            if (state.m_palette_source >= src_count)
                state.m_palette_source = 0;
            if (src_count > 1)
            {
                let mut names = []mut: vec<string>;
                for (let mut i = 0; i < src_count; i += 1)
                    do names->add(F"源纹理 {i + 1}");
                match (ListBoxSelectHeight("##palette_source", names->to_array,
                    state.m_palette_source, 3))
                {
                    value(sel)?
                    {
                        state.m_palette_source = sel;
                        state.m_palette_cell = option::none;
                    }
                    none?;
                }
            }
            if (BeginChildSize("##palette_grid", GetContentRegionAvail()[0], 0.))
            {
                do draw_palette_grid(state, ts_id);
            }
            EndChild();
            return;
        }

        // ===== 地图编辑器：纯地形调色板（RM 式，一个地形一格） =====
        let ts_count = tilemap::tileset_count(ctx.m_map);
        if (ts_count == 0)
        {
            do TextDisabled("地图未引用任何图集");
            do TextDisabled("请在右侧「图集设置」中添加");
            return;
        }
        if (state.m_palette_tileset >= ts_count)
            state.m_palette_tileset = ts_count - 1;
        if (BeginTabBar("##tileset_tabs"))
        {
            for (let mut i = 0; i < ts_count; i += 1)
            {
                if (BeginTabItem(F"图集{i + 1}##ts{i}"))
                {
                    state.m_palette_tileset = i;
                    do EndTabItem();
                }
            }
            do EndTabBar();
        }

        let ts_id = palette_tileset_doc(state, ctx);
        if (ts_id <= 0)
        {
            do TextDisabled("图集文档不可用");
            return;
        }

        do draw_terrain_cell_palette(state, ts_id);

        // ---- 选中自动图块的连接预览 ----
        if (palette_selected_is_auto(state, ts_id))
        {
            match (state.m_palette_terrain)
            {
                value(tid)?
                {
                    do Separator();
                    do Text("连接预览：");
                    do draw_terrain_preview(state, ts_id, tid);
                }
                none?;
            }
        }
    }

    // 当前选中的画笔是否为自动图块地形（VX/XP/blob）
    func palette_selected_is_auto(state: EditorState, ts_id: int)=> bool
    {
        match (state.m_palette_terrain)
        {
            value(t)?
            {
                let (_, k, _, _, _, _, _) = tilemap::terrain_info(ts_id, t);
                return k == 1 || k == 2 || k == 3;
            }
            none? { return false; }
        }
    }

    // 自动图块地形缩略选择行：VX/XP 显示整块缩略，blob47 显示锚点块
    // 地图编辑器的地形调色板：一个地形一格，按"自动图块 -> 单块"分区。
    // 原始 tileset 的查看与地形创建在图集编辑器中进行。
    func draw_terrain_cell_palette(state: EditorState, ts_id: int)=> void
    {
        let total = tilemap::terrain_count(ts_id);
        if (total == 0)
        {
            do TextDisabled("图集中没有地形，请在资源浏览器中双击图集文件，");
            do TextDisabled("在图集编辑器中添加源纹理并创建地形。");
            return;
        }
        let avail_w = GetContentRegionAvail()[0];
        let cell = 36.;
        let per_row = math::max(1, (avail_w / cell) as int);

        do Text("自动图块：");
        let mut col = 0;
        for (let mut t = 1; t <= total; t += 1)
        {
            let (_, k, _, _, _, _, _) = tilemap::terrain_info(ts_id, t);
            if (k == 0)
            {
                continue;
            }
            if (col % per_row != 0)
                do SameLine();
            do draw_terrain_cell(state, ts_id, t, cell);
            col += 1;
        }

        do Separator();
        do Text("单块：");
        let mut col2 = 0;
        for (let mut t = 1; t <= total; t += 1)
        {
            let (_, k, _, _, _, _, _) = tilemap::terrain_info(ts_id, t);
            if (k != 0)
            {
                continue;
            }
            if (col2 % per_row != 0)
                do SameLine();
            do draw_terrain_cell(state, ts_id, t, cell);
            col2 += 1;
        }
    }

    // 单个地形格子：一个地形一格。自动图块显示"完全连接"的内部填充
    // 外观（隐藏预览地图的中心格），单块显示其瓦片；图集未保存时
    // 自动图块回退为锚点孤块图标。
    func draw_terrain_cell(state: EditorState, ts_id: int, tid: int, cell: real)=> void
    {
        let (tname, k, s, ix, iy, _, _) = tilemap::terrain_info(ts_id, tid);
        let pos = GetCursorScreenPos();
        do Dummy((cell, cell));
        let dl = GetWindowDrawList();
        let mut is_sel = false;
        match (state.m_palette_terrain)
        {
            value(cur)? { is_sel = cur == tid; }
            none?;
        }
        let mut drawn = false;
        if (k >= 1)
        {
            let pm = terrain_preview_map(state, ts_id, tid);
            if (pm > 0)
            {
                // 中心格 = 完全连接的内部填充外观
                let qn = tilemap::cell_quad_count(pm, 0, 1, 1);
                for (let mut q = 0; q < qn; q += 1)
                {
                    match (tilemap::cell_quad(pm, 0, 1, 1, q))
                    {
                        value((tp, u0, v0, u1, v1, qx, qy, qcols))?
                        {
                            match (state->atlas_texture(tp))
                            {
                                value(tex)?
                                {
                                    let sw = cell / qcols as real;
                                    let sh = cell / qcols as real;
                                    do dl->AddImageUV(
                                        (pos[0] + qx as real * sw, pos[1] + qy as real * sh),
                                        (pos[0] + (qx + 1) as real * sw, pos[1] + (qy + 1) as real * sh),
                                        (u0, v0), (u1, v1), tex, (255, 255, 255, 255));
                                    drawn = true;
                                }
                                none?;
                            }
                        }
                        none?;
                    }
                }
            }
        }
        if (!drawn && s >= 0 && s < tilemap::source_count(ts_id))
        {
            let (tp, tpx, _, _) = tilemap::source_info(ts_id, s);
            match (state->atlas_texture(tp))
            {
                value(tex)?
                {
                    let (tw, th) = tex->size();
                    let u_l = ix as real * tpx as real / tw as real;
                    // AddImageUV 采样引擎 v（v=1-图像行/高），须换算
                    let v_t = 1.0 - iy as real * tpx as real / th as real;
                    let u_r = (ix + 1) as real * tpx as real / tw as real;
                    let v_b = 1.0 - (iy + 1) as real * tpx as real / th as real;
                    do dl->AddImageUV(pos, (pos[0] + cell, pos[1] + cell),
                        (u_l, v_b), (u_r, v_t), tex, (255, 255, 255, 255));
                }
                none?;
            }
        }
        do dl->AddRect(pos, (pos[0] + cell, pos[1] + cell), (255, 255, 255, 70), 1.);
        if (is_sel)
            do dl->AddRect(pos, (pos[0] + cell, pos[1] + cell), (255, 255, 255, 255), 2.);
        do SetTooltip(F"{tname} [{terrain_kind_name(k)}]：点击选择绘制");
        if (IsItemClickedLeft())
        {
            state.m_palette_terrain = option::value(tid);
            state.m_palette_cell = option::none;
            let ts_idx = state.m_tileset_only > 0
                ? 0 | state.m_palette_tileset;
            state.m_paint = tilemap::terrain_value(ts_idx, tid);
        }
    }

    // 取（或创建）某地形的连接预览地图（3x3 全铺该地形）。
    // 返回 0 表示不可用（图集尚未保存到磁盘）。
    func terrain_preview_map(state: EditorState, ts_id: int, tid: int)=> int
    {
        let doc_path = tilemap::tileset_doc_path(ts_id);
        if (doc_path == "")
            return 0;
        let key = F"{doc_path}#{tid}";
        for (let mut i = 0; i < state.m_preview_maps->len; i += 1)
        {
            match (state.m_preview_maps->get(i))
            {
                value((k, mid))?
                {
                    if (k == key)
                        return mid;
                }
                none?;
            }
        }
        let pm = tilemap::create_map(3, 3, 32);
        if (pm <= 0)
            return 0;
        let idx = tilemap::add_tileset(pm, doc_path);
        if (idx >= 0)
        {
            let tv = tilemap::terrain_value(idx, tid);
            for (let mut gy = 0; gy < 3; gy += 1)
            {
                for (let mut gx = 0; gx < 3; gx += 1)
                {
                    do tilemap::set_tile(pm, 0, gx, gy, tv);
                }
            }
        }
        // 即使引用失败也登记，避免每帧重试创建
        do state.m_preview_maps->add((key, pm));
        return idx >= 0 ? pm | 0;
    }

    // 地形连接预览：在隐藏 3x3 地图上铺满该地形并绘制中心区域，
    // 展示"周围都是同类地形"时的实际渲染效果。图集未保存时退化为
    // 锚点瓦片（孤块形态）图标。
    func draw_terrain_preview(state: EditorState, ts_id: int, tid: int)=> void
    {
        let w = 96.;
        let h = 96.;
        let pm = terrain_preview_map(state, ts_id, tid);

        let base = GetCursorScreenPos();
        do Dummy((w, h));
        let dl = GetWindowDrawList();

        if (pm > 0)
        {
            let cw = w / 3.;
            let ch = h / 3.;
            for (let mut gy = 0; gy < 3; gy += 1)
            {
                for (let mut gx = 0; gx < 3; gx += 1)
                {
                    let qn = tilemap::cell_quad_count(pm, 0, gx, gy);
                    for (let mut q = 0; q < qn; q += 1)
                    {
                        match (tilemap::cell_quad(pm, 0, gx, gy, q))
                        {
                            value((tp, u0, v0, u1, v1, qx, qy, qcols))?
                            {
                                match (state->atlas_texture(tp))
                                {
                                    value(tex)?
                                    {
                                        let sw = cw / qcols as real;
                                        let sh = ch / qcols as real;
                                        do dl->AddImageUV(
                                            (base[0] + gx as real * cw + qx as real * sw,
                                             base[1] + gy as real * ch + qy as real * sh),
                                            (base[0] + gx as real * cw + (qx + 1) as real * sw,
                                             base[1] + gy as real * ch + (qy + 1) as real * sh),
                                            (u0, v0), (u1, v1), tex, (255, 255, 255, 255));
                                    }
                                    none?;
                                }
                            }
                            none?;
                        }
                    }
                }
            }
            do dl->AddRect(base, (base[0] + w, base[1] + h), (255, 255, 255, 60), 1.);
        }
        else
        {
            let (_, _, src, ix, iy, _, _) = tilemap::terrain_info(ts_id, tid);
            if (src >= 0 && src < tilemap::source_count(ts_id))
            {
                let (tp, tpx, _, _) = tilemap::source_info(ts_id, src);
                match (state->atlas_texture(tp))
                {
                    value(tex)?
                    {
                        let (tw, th) = tex->size();
                        let u_l = ix as real * tpx as real / tw as real;
                        // 同上：AddImageUV 采样引擎 v，须取 1-图像分数
                        let v_t = 1.0 - iy as real * tpx as real / th as real;
                        let u_r = (ix + 1) as real * tpx as real / tw as real;
                        let v_b = 1.0 - (iy + 1) as real * tpx as real / th as real;
                        do dl->AddImageUV(base, (base[0] + w, base[1] + h),
                            (u_l, v_b), (u_r, v_t), tex, (255, 255, 255, 255));
                    }
                    none?;
                }
            }
            do dl->AddRect(base, (base[0] + w, base[1] + h), (255, 255, 255, 60), 1.);
        }
    }


    // 源纹理网格视图（贴图 + 网格 + 交互选中）
    func draw_palette_grid(state: EditorState, ts_id: int)=> void
    {
        if (state.m_palette_source < 0
            || state.m_palette_source >= tilemap::source_count(ts_id))
            return;
        do Text("单块地形（点击选择绘制）与地形创建：");
        if (Button("+ 新建自动图块（点选图块后双击，或用此按钮）"))
        {
            if (state.m_palette_cell->is_value)
                do OpenPopup("##new_terrain_popup");
            else
                do MsgBox::err("缺少锚点", "请先在下方网格中点选一个格子（自动对齐 2x3 地形块）");
        }
        do draw_new_terrain_popup(state, ts_id);
        let (tex_path, tile_px, xc, yc) =
            tilemap::source_info(ts_id, state.m_palette_source);

        match (state->atlas_texture(tex_path))
        {
            none? { do TextDisabled(F"纹理加载失败：{tex_path}"); return; }
            value(tex)?
            {
                let (tw, th) = tex->size();
                let avail = GetContentRegionAvail();
                // 整张贴图缩放到面板宽度内（保持像素清晰由 NEAREST 采样保证）
                let scale = math::min(1., avail[0] / tw as real);
                let img_w = tw as real * scale;
                let img_h = th as real * scale;
                do ImageSize(tex, img_w, img_h);

                let (rect_min, rect_max) = GetItemRect();
                let cell_px = tile_px as real * scale;
                if (cell_px < 3.)
                    return;
                let dl = GetWindowDrawList();

                // 网格线
                if (cell_px >= 10.)
                {
                    for (let mut gx = 0; gx <= xc; gx += 1)
                    {
                        do dl->AddLine(
                            (rect_min[0] + gx as real * cell_px, rect_min[1]),
                            (rect_min[0] + gx as real * cell_px, rect_max[1]),
                            (255, 255, 255, 36), 1.);
                    }
                    for (let mut gy = 0; gy <= yc; gy += 1)
                    {
                        do dl->AddLine(
                            (rect_min[0], rect_min[1] + gy as real * cell_px),
                            (rect_max[0], rect_min[1] + gy as real * cell_px),
                            (255, 255, 255, 36), 1.);
                    }
                }

                // 已注册 VX/XP 地形块：常驻淡描边，提示可整块选择
                let terr_all = tilemap::terrain_count(ts_id);
                for (let mut t = 1; t <= terr_all; t += 1)
                {
                    let (_, k, s, bx, by, _, _) = tilemap::terrain_info(ts_id, t);
                    if (s == state.m_palette_source && (k == 1 || k == 3))
                    {
                        // 覆盖区变暗：这些格子的绘制由其所属自动图块接管
                        do dl->AddRectFilled(
                            (rect_min[0] + bx as real * cell_px,
                             rect_min[1] + by as real * cell_px),
                            (rect_min[0] + (bx + 2) as real * cell_px,
                             rect_min[1] + (by + 3) as real * cell_px),
                            (20, 24, 34, 110));
                        do dl->AddRect(
                            (rect_min[0] + bx as real * cell_px,
                             rect_min[1] + by as real * cell_px),
                            (rect_min[0] + (bx + 2) as real * cell_px,
                             rect_min[1] + (by + 3) as real * cell_px),
                            (110, 200, 255, 90), 1.);
                    }
                }

                // 悬停格 / 悬停地形块（RM 式整块感知）
                if (IsItemHovered())
                {
                    let mouse = GetMousePos();
                    let cx = ((mouse[0] - rect_min[0]) / cell_px) as int;
                    let cy = ((mouse[1] - rect_min[1]) / cell_px) as int;
                    if (cx >= 0 && cy >= 0 && cx < xc && cy < yc)
                    {
                        // 命中已注册地形块？
                        let mut hit_tid = 0;
                        let mut hit_name = "";
                        let mut hit_kind = 0;
                        let mut hit_bx = 0;
                        let mut hit_by = 0;
                        for (let mut t = 1; t <= terr_all; t += 1)
                        {
                            let (tname, k, s, bx, by, _, _) = tilemap::terrain_info(ts_id, t);
                            if (s == state.m_palette_source && (k == 1 || k == 3)
                                && cx >= bx && cx < bx + 2 && cy >= by && cy < by + 3)
                            {
                                hit_tid = t;
                                hit_name = tname;
                                hit_kind = k;
                                hit_bx = bx;
                                hit_by = by;
                            }
                        }

                        if (hit_tid > 0)
                        {
                            // 整块高亮 + 提示；点击选择地形进行绘制（RM 式）
                            let bx0 = rect_min[0] + hit_bx as real * cell_px;
                            let by0 = rect_min[1] + hit_by as real * cell_px;
                            do dl->AddRect((bx0, by0),
                                (bx0 + 2. * cell_px, by0 + 3. * cell_px),
                                (110, 200, 255, 230), 2.);
                            do SetTooltip(F"{hit_name} [{terrain_kind_name(hit_kind)}]：点击选择绘制");
                            if (IsItemClickedLeft())
                            {
                                state.m_palette_terrain = option::value(hit_tid);
                                state.m_palette_cell = option::none;
                                let ts_idx = state.m_tileset_only > 0
                                    ? 0 | state.m_palette_tileset;
                                state.m_paint = tilemap::terrain_value(ts_idx, hit_tid);
                            }
                        }
                        else
                        {
                            // 未注册格子：单格高亮；双击快速新建地形（锚点自动对齐块）
                            do dl->AddRect(
                                (rect_min[0] + cx as real * cell_px,
                                 rect_min[1] + cy as real * cell_px),
                                (rect_min[0] + (cx + 1) as real * cell_px,
                                 rect_min[1] + (cy + 1) as real * cell_px),
                                (255, 255, 255, 220), 1.5);
                            if (IsItemClickedLeft())
                            {
                                state.m_palette_cell = option::value((cx, cy));
                                // 优先选择该格的单块地形（新图集默认全格单块地形）
                                let mut st = 0;
                                let tc0 = tilemap::terrain_count(ts_id);
                                for (let mut t = 1; t <= tc0; t += 1)
                                {
                                    let (_, k2, s2, ix2, iy2, _, _) = tilemap::terrain_info(ts_id, t);
                                    if (k2 == 0 && s2 == state.m_palette_source
                                        && ix2 == cx && iy2 == cy)
                                        st = t;
                                }
                                if (st > 0)
                                {
                                    state.m_palette_terrain = option::value(st);
                                    let ts_idx = state.m_tileset_only > 0
                                        ? 0 | state.m_palette_tileset;
                                    state.m_paint = tilemap::terrain_value(ts_idx, st);
                                }
                                else
                                {
                                    // 旧图集没有单块地形：回退为普通瓦片
                                    state.m_palette_terrain = option::none;
                                    let tile_id = tilemap::add_tile(
                                        ts_id, state.m_palette_source, cx, cy, 1);
                                    if (tile_id > 0)
                                    {
                                        // 地图模式下使用地图内图集下标编码画笔值；
                                        // 图集模式（无地图）仅记录到 0 号图集
                                        let ts_idx = state.m_tileset_only > 0
                                            ? 0 | state.m_palette_tileset;
                                        state.m_paint = tilemap::tile_value(ts_idx, tile_id);
                                    }
                                }
                                // 双击检测：快速打开新建地形弹窗
                                let now = GetTime();
                                let mut dbl = false;
                                let (t0, lx, ly) = state.m_last_cell_click;
                                if (now - t0 < 0.45 && lx == cx && ly == cy)
                                {
                                    dbl = true;
                                    state.m_last_cell_click = (0., -1, -1);
                                }
                                else
                                    state.m_last_cell_click = (now, cx, cy);
                                if (dbl)
                                    do OpenPopup("##new_terrain_popup");
                            }
                        }
                    }
                }

                // 选中格高亮
                match (state.m_palette_cell)
                {
                    value((sx, sy))?
                    {
                        do dl->AddRect(
                            (rect_min[0] + sx as real * cell_px,
                             rect_min[1] + sy as real * cell_px),
                            (rect_min[0] + (sx + 1) as real * cell_px,
                             rect_min[1] + (sy + 1) as real * cell_px),
                            (110, 200, 255, 255), 2.);
                    }
                    none?;
                }

                // 选中地形的整块描边（RM 式白框）
                match (state.m_palette_terrain)
                {
                    value(tid)?
                    {
                        let (tn, k, s, bx, by, _, _) = tilemap::terrain_info(ts_id, tid);
                        do (tn, k);
                        if (s == state.m_palette_source && (k == 1 || k == 3))
                        {
                            do dl->AddRect(
                                (rect_min[0] + bx as real * cell_px,
                                 rect_min[1] + by as real * cell_px),
                                (rect_min[0] + (bx + 2) as real * cell_px,
                                 rect_min[1] + (by + 3) as real * cell_px),
                                (255, 255, 255, 255), 2.);
                        }
                    }
                    none?;
                }
            }
        }
    }

    // 新建地形弹窗：锚点 = 调色板选中格
    func draw_new_terrain_popup(state: EditorState, ts_id: int)=> void
    {
        if (BeginPopup("##new_terrain_popup"))
        {
            do Text("锚点：点选的格子（自动对齐 2x3 地形块）");
            let mut snap_x = 0;
            let mut snap_y = 0;
            match (state.m_palette_cell)
            {
                value((ax, ay))?
                {
                    snap_x = ax;
                    snap_y = ay;
                    if (state.m_new_terrain_kind == 1 || state.m_new_terrain_kind == 3)
                    {
                        snap_x = ax - ax % 2;
                        snap_y = ay - ay % 3;
                    }
                    if (snap_x != ax || snap_y != ay)
                        do Text(F"({ax}, {ay}) → 对齐到块锚点 ({snap_x}, {snap_y})");
                    else
                        do Text(F"({ax}, {ay})");
                }
                none? { do TextDisabled("未选中"); }
            }
            match (InputText("名称", state.m_new_terrain_name))
            {
                value(s)? state.m_new_terrain_name = s;
                none?;
            }
            let kinds = ["单块", "四象限(XP条带)", "blob47", "四象限(VX 2x3块)"];
            match (ListBoxSelect("##terrain_kind", kinds, state.m_new_terrain_kind))
            {
                value(k)? state.m_new_terrain_kind = k;
                none?;
            }
            match (CheckBox("可通行", state.m_new_terrain_walkable))
            {
                value(v)? state.m_new_terrain_walkable = v;
                none?;
            }
            do TextDisabled("XP条带：锚点右2x下3格（旧版格式）");
            do TextDisabled("VX块：锚点右2x下3格，右上2x2为内部填充");
            do TextDisabled("blob47：锚点起行优先47块（或显式变体表）");
            if (Button("创建"))
            {
                match (state.m_palette_cell)
                {
                    value((ax, ay))?
                    {
                        do (ax, ay);
                        let name = state.m_new_terrain_name == ""
                            ? "新地形" | state.m_new_terrain_name;
                        let tid = tilemap::add_terrain(ts_id, name, state.m_new_terrain_kind,
                            state.m_palette_source, snap_x, snap_y,
                            state.m_new_terrain_walkable ? 1 | 0);
                        if (tid > 0)
                        {
                            state.m_palette_terrain = option::value(tid);
                            let ts_idx = state.m_tileset_only > 0
                                ? 0 | state.m_palette_tileset;
                            state.m_paint = tilemap::terrain_value(ts_idx, tid);
                            do CloseCurrentPopup();
                        }
                        else
                            do MsgBox::err("创建失败", "无法创建地形（参数无效）");
                    }
                    none?;
                }
            }
            SameLine();
            if (Button("取消"))
                do CloseCurrentPopup();
            do EndPopup();
        }
    }
}
