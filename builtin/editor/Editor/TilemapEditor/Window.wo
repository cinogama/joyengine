// 瓦片地图/瓦片图集编辑器 —— 窗口实现与静态入口。
// 两类编辑器是相互独立的窗口（标题不同、各自唯一实例）：打开另一类
// 文件时新开/复用另一个窗口，互不抢占、互不影响编辑状态。同类文件
// 再次打开时重定向现有窗口（脏数据先询问保存）。关闭前有未保存修改
// 时经 onPreClose 否决并弹保存询问。保存走 je::tilemap 文档保存（写入
// .je4tilemap/.je4tileset 二进制文件）；未保存的修改在此之前已经实时
// 同步到世界实例。

import pkg::std;

import je;
import je::gui;
import je::tilemap;

import pkg::fsys;
import pkg::interface;

import builtin::editor::Singleton::Universe;

import builtin::editor::Editor::ResourcePath;
import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Menu;
import builtin::editor::GUI::Shortcut;
import builtin::editor::GUI::Forms::MsgBox;
import builtin::editor::GUI::Forms::InputBox;
import builtin::editor::GUI::Forms::AskBox;
import builtin::editor::GUI::Statebar;

import DataModel;
import EditorState;
import UI;

using std;
using je;
using je::gui;
using je::tilemap;
using fsys;
using JEEditor::Editor::ResourcePath;
using JEEditor::GUI;
using JEEditor::GUI::Windows;
using JEEditor::GUI::Forms;
using JEEditor::Singleton;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    // 地图/图集编辑器窗口各自单例（互相独立，互不抢占）
    let mut s_map_editor_singleton = option::none: option<TilemapEditorWindow>;
    let mut s_tileset_editor_singleton = option::none: option<TilesetEditorWindow>;

    // 从 .je4tilemap 文件打开地图编辑器
    public func openTilemapEditorFromFile(path: fsys::path_t)=> void
    {
        let res_path = fsys::normalize(ResourcePath::toRuntimeResourcePath(path));
        match (TilemapContext::open(res_path))
        {
            err(why)?
                do MsgBox::err("打开失败", why);
            ok(ctx)?
            {
                match (s_map_editor_singleton)
                {
                    none? do show(TilemapEditorWindow::create_map(ctx));
                    value(editor)? editor->retargetToMap(ctx);
                }
            }
        }
    }

    // 从 .je4tileset 文件打开图集编辑器（独立窗口，不影响地图编辑器）
    public func openTilesetEditorFromFile(path: fsys::path_t)=> void
    {
        let path_str = ResourcePath::toRuntimeResourcePath(path);
        match (tilemap::Tileset::open(path_str))
        {
            none?
                do MsgBox::err("打开失败", F"无法解析图集文件：{path_str}");
            value(ts)?
            {
                match (s_tileset_editor_singleton)
                {
                    none? do show(TilesetEditorWindow::create_tileset(ts));
                    value(editor)? editor->retargetToTileset(ts);
                }
            }
        }
    }

    // ===== 保存流程 =====
    // 保存地图：无路径（新建未保存）时先询问路径。保存成功（含异步询问
    // 路径后）才调用 after 继续后续流程（关闭窗口/切换文档）；
    // 失败或取消时不调用 —— 调用方保持现状即可。
    func try_save_map_then(state: EditorState, after: ()=>void)=> void
    {
        let ctx = state.m_context->unwrap();
        let path = ctx.m_path->to_string;
        if (path != "")
        {
            if (ctx->save_to(ctx.m_path))
            {
                state.m_dirty = false;
                do after();
                do Statebar::showState(3.) <| func()
                {
                    do Text(F"瓦片地图已保存：{path}");
                };
            }
            else
                do MsgBox::err("保存失败", F"无法写入文件：{path}");
            return;
        }
        do InputBox::show("保存瓦片地图", "请输入文件路径（如 @/resource/maps/scene1.je4tilemap）：",
                "@/resource/maps/newmap.je4tilemap")
            ->then(func(p)
                {
                    if (ctx->save_to(fsys::normalize(p)))
                    {
                        state.m_dirty = false;
                        do after();
                        do Statebar::showState(3.) <| func()
                        {
                            do Text(F"瓦片地图已保存：{p}");
                        };
                    }
                    else
                        do MsgBox::err("保存失败", F"无法写入文件：{p}");
                });
    }

    // 保存图集：规则同上
    func try_save_tileset_then(state: EditorState, after: ()=>void)=> void
    {
        let ts = state.m_tileset_only->unwrap();
        let cur_path = ts->doc_path();
        if (cur_path != "")
        {
            if (ts->save(cur_path))
            {
                state.m_dirty = false;
                do after();
                do Statebar::showState(3.) <| func()
                {
                    do Text(F"图集已保存：{cur_path}");
                };
            }
            else
                do MsgBox::err("保存失败", F"无法写入文件：{cur_path}");
            return;
        }
        do InputBox::show("保存图集", "请输入文件路径（如 @/resource/tilesets/grass.je4tileset）：",
                "@/resource/tilesets/new.je4tileset")
            ->then(func(p)
                {
                    if (ts->save(p))
                    {
                        state.m_dirty = false;
                        do after();
                        do Statebar::showState(3.) <| func()
                        {
                            do Text(F"图集已保存：{p}");
                        };
                    }
                    else
                        do MsgBox::err("保存失败", F"无法写入文件：{p}");
                });
    }

    // 保存（无后续动作）
    func try_save_map(state: EditorState)=> void
    {
        do try_save_map_then(state, func() { });
    }
    func try_save_tileset(state: EditorState)=> void
    {
        do try_save_tileset_then(state, func() { });
    }

    // ===== 保存询问（地图/图集两窗口共用的流程） =====
    // 切换文档前：脏数据先询问，选择“是”则保存成功后（含异步询问保存
    // 路径的情形）执行 after，取消/失败则保持现状；选择“否”直接执行
    func ask_save_then(state: EditorState, after: ()=>void,
        save_then: (EditorState, ()=>void)=>void)=> void
    {
        if (!state.m_dirty)
        {
            do after();
            return;
        }
        do AskBox::show("是否保存", "当前编辑尚未保存，是否保存？")
            ->onYes(func()
                {
                    do save_then(state, after);
                })
            ->onNo(func()
                {
                    do after();
                });
    }

    // 关闭窗口前：保存成功（含异步询问保存路径后）或选择不保存时才
    // 经 set_close 真正关闭
    func ask_save_then_close(state: EditorState, set_close: ()=>void,
        save_then: (EditorState, ()=>void)=>void)=> void
    {
        do AskBox::show("是否保存", "是否保存当前的修改？")
            ->onYes(func()
                {
                    do save_then(state, set_close);
                })
            ->onNo(func()
                {
                    do set_close();
                });
    }

    // ===== 地图编辑器窗口（唯一实例） =====
    using TilemapEditorWindow = struct{
        m_close: mut bool,
        m_state: mut EditorState,
    }
    {
        func create_map(context: TilemapContext)=> TilemapEditorWindow
            where require!(TilemapEditorWindow: IWindows);
        {
            return TilemapEditorWindow{
                m_close = mut false,
                m_state = mut EditorState::create(context),
            };
        }

        // 切换到另一张地图：脏数据先询问保存，保存完成后再重建编辑
        // 状态；关闭流程进行中则忽略（窗口即将销毁）
        func retargetToMap(self: TilemapEditorWindow, context: TilemapContext)=> void
        {
            if (self.m_close)
                return;
            let editor = self;
            do ask_save_then(editor.m_state,
                func()
                {
                    editor.m_state = EditorState::create(context);
                },
                try_save_map_then);
        }

        public func onCreate(self: TilemapEditorWindow)=> void
        {
            s_map_editor_singleton = option::value(self);
        }
        public func onClose(_: TilemapEditorWindow)=> void
        {
            s_map_editor_singleton = option::none;
        }
        public func getTitle(_: TilemapEditorWindow)=> string
        {
            return "瓦片地图编辑器";
        }
        public func getSizeConstraints(_: TilemapEditorWindow)=> SizeConstraints
        {
            return SizeConstraints::Limited(((1024., 600.), (4096., 4096.)));
        }
        // 菜单/快捷键实例仅随窗口创建构建一次（Windows::_show 每帧复用，
        // 见 GUI/Windows.wo），不能捕获创建时的 m_state 快照——retarget
        // 换文档后会作用于旧文档。须捕获窗口自身，触发时再读当前的
        // m_state（工具栏经 run 每帧取新状态，无此问题）。
        public func getMenu(self: TilemapEditorWindow)=> option<Menu>
        {
            let editor = self;
            return option::value <|
                Menu::create("")
                    -> subMenu("文件")
                    ->  subItem("保存", \= try_save_map(editor.m_state);)
                    ->  shortCut("Ctrl+S")
                    ->  endItem
                    ->  subItem("关闭", \= editor->requestClose();)
                    ->  endItem
                    -> endMenu
                    -> subMenu("编辑")
                    ->  subItem("撤销", \= editor.m_state->undo();)
                    ->  endItem
                    ->  subItem("重做", \= editor.m_state->redo();)
                    ->  endItem
                    -> endMenu
                    ;
        }
        public func getShortcut(self: TilemapEditorWindow)=> option<Shortcut>
        {
            let editor = self;
            return option::value <|
                Shortcut::begin()
                    ->shortCut(
                        [ImGuiKey::ImGuiMod_Ctrl, ImGuiKey::ImGuiKey_S],
                        \= try_save_map(editor.m_state);)
                    ->shortCut(
                        [ImGuiKey::ImGuiMod_Ctrl, ImGuiKey::ImGuiKey_Z],
                        \= editor.m_state->undo();)
                    ->shortCut(
                        [ImGuiKey::ImGuiMod_Ctrl, ImGuiKey::ImGuiKey_Y],
                        \= editor.m_state->redo();)
                    ->finish();
        }

        func requestClose(self: TilemapEditorWindow)=> void
        {
            if (!self.m_state.m_dirty || self.m_close)
            {
                self.m_close = true;
                return;
            }
            let editor = self;
            do ask_save_then_close(editor.m_state,
                func() { editor.m_close = true; },
                try_save_map_then);
        }
        public func onPreClose(self: TilemapEditorWindow)=> bool
        {
            if (self.m_close || !self.m_state.m_dirty)
                return true;
            let editor = self;
            do ask_save_then_close(editor.m_state,
                func() { editor.m_close = true; },
                try_save_map_then);
            return false;
        }

        public func run(self: TilemapEditorWindow)=> bool
        {
            do render_main(self.m_state);
            return !self.m_close;
        }
    }

    // ===== 图集编辑器窗口（唯一实例，独立于地图编辑器窗口） =====
    using TilesetEditorWindow = struct{
        m_close: mut bool,
        m_state: mut EditorState,
    }
    {
        func create_tileset(tileset_doc: tilemap::Tileset)=> TilesetEditorWindow
            where require!(TilesetEditorWindow: IWindows);
        {
            return TilesetEditorWindow{
                m_close = mut false,
                m_state = mut EditorState::create_tileset_only(tileset_doc),
            };
        }

        // 切换到另一个图集：脏数据先询问保存，保存完成后再重建编辑
        // 状态；关闭流程进行中则忽略（窗口即将销毁）
        func retargetToTileset(self: TilesetEditorWindow,
            tileset_doc: tilemap::Tileset)=> void
        {
            if (self.m_close)
                return;
            let editor = self;
            do ask_save_then(editor.m_state,
                func()
                {
                    editor.m_state = EditorState::create_tileset_only(tileset_doc);
                },
                try_save_tileset_then);
        }

        public func onCreate(self: TilesetEditorWindow)=> void
        {
            s_tileset_editor_singleton = option::value(self);
        }
        public func onClose(_: TilesetEditorWindow)=> void
        {
            s_tileset_editor_singleton = option::none;
        }
        public func getTitle(_: TilesetEditorWindow)=> string
        {
            return "瓦片图集编辑器";
        }
        public func getSizeConstraints(_: TilesetEditorWindow)=> SizeConstraints
        {
            return SizeConstraints::Limited(((760., 480.), (4096., 4096.)));
        }
        // 菜单/快捷键捕获窗口自身，触发时再读当前的 m_state（同上）
        public func getMenu(self: TilesetEditorWindow)=> option<Menu>
        {
            let editor = self;
            return option::value <|
                Menu::create("")
                    -> subMenu("文件")
                    ->  subItem("保存", \= try_save_tileset(editor.m_state);)
                    ->  shortCut("Ctrl+S")
                    ->  endItem
                    ->  subItem("关闭", \= editor->requestClose();)
                    ->  endItem
                    -> endMenu
                    ;
        }
        public func getShortcut(self: TilesetEditorWindow)=> option<Shortcut>
        {
            let editor = self;
            return option::value <|
                Shortcut::begin()
                    ->shortCut(
                        [ImGuiKey::ImGuiMod_Ctrl, ImGuiKey::ImGuiKey_S],
                        \= try_save_tileset(editor.m_state);)
                    ->finish();
        }

        func requestClose(self: TilesetEditorWindow)=> void
        {
            if (!self.m_state.m_dirty || self.m_close)
            {
                self.m_close = true;
                return;
            }
            let editor = self;
            do ask_save_then_close(editor.m_state,
                func() { editor.m_close = true; },
                try_save_tileset_then);
        }
        public func onPreClose(self: TilesetEditorWindow)=> bool
        {
            if (self.m_close || !self.m_state.m_dirty)
                return true;
            let editor = self;
            do ask_save_then_close(editor.m_state,
                func() { editor.m_close = true; },
                try_save_tileset_then);
            return false;
        }

        public func run(self: TilesetEditorWindow)=> bool
        {
            do render_tileset(self.m_state);
            return !self.m_close;
        }
    }
}
