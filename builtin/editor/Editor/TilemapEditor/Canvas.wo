// 瓦片地图编辑器 —— 地图画布。
// 以 ImGui 窗口绘制列表渲染全部可见图层（与实际渲染一致：普通瓦片整块、
// 四象限自动图块按象限拼合，数据来自 Tilemap::cell_quad），叠加网格、
// 悬停高亮、矩形预览与画笔块预览；开启突出选中层时其余图层整体压为
// 半透明。滚轮缩放（以鼠标为中心）、中键拖拽平移；左键绘制、右键清除。

import pkg::std;

import je;
import je::gui;
import je::tilemap;

import pkg::math;

import DataModel;
import EditorState;
import Palette;
import Tools;

using std;
using je;
using je::gui;
using je::tilemap;
using math;
using JEEditor::Editor::TilemapEditor;

namespace JEEditor::Editor::TilemapEditor
{
    public func draw_canvas(state: EditorState, ctx: TilemapContext)=> void
    {
        let avail = GetContentRegionAvail();
        if (avail[0] < 8. || avail[1] < 8.)
            return;

        let (w, h, tile_px, layer_count) = ctx.m_map->size();
        let pmin = GetCursorScreenPos();
        let pmax = (pmin[0] + avail[0], pmin[1] + avail[1]);
        let cellpx = tile_px as real * state.m_zoom;

        // 交互守卫：整块不可见按钮承接鼠标（避免拖动窗口）
        do InvisibleButton("##tm_canvas", avail);
        let hovered = IsItemHovered();
        let active = IsItemActive();

        // ---- 缩放（滚轮，以鼠标为锚）与平移（中键拖拽） ----
        let mouse = GetMousePos();
        if (hovered)
        {
            let wheel = GetMouseWheel();
            if (wheel[1] != 0.)
            {
                let old_zoom = state.m_zoom;
                let mut new_zoom = old_zoom * (wheel[1] > 0. ? 1.15 | 0.87);
                if (new_zoom < 0.05) new_zoom = 0.05;
                if (new_zoom > 16.) new_zoom = 16.;
                // 保持鼠标下的世界位置不动
                let wx = (mouse[0] - (pmin[0] + state.m_pan[0])) / (tile_px as real * old_zoom);
                let wy = (mouse[1] - (pmin[1] + state.m_pan[1])) / (tile_px as real * old_zoom);
                state.m_zoom = new_zoom;
                state.m_pan = (
                    mouse[0] - pmin[0] - wx * tile_px as real * new_zoom,
                    mouse[1] - pmin[1] - wy * tile_px as real * new_zoom);
            }
        }
        if (IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Middle) && (hovered || active))
        {
            let delta = GetMouseDeltaPos();
            state.m_pan = (state.m_pan[0] + delta[0], state.m_pan[1] + delta[1]);
        }

        let origin = (pmin[0] + state.m_pan[0], pmin[1] + state.m_pan[1]);

        // ---- 悬停格子 ----
        let mut hover_cell = option::none: option<(int, int)>;
        if (hovered)
        {
            let cx = ((mouse[0] - origin[0]) / cellpx) as int;
            let cy = ((mouse[1] - origin[1]) / cellpx) as int;
            if (cx >= 0 && cy >= 0 && cx < w && cy < h)
                hover_cell = option::value((cx, cy));
        }
        state.m_hover_cell = hover_cell;

        let dl = GetWindowDrawList();
        do dl->AddRectFilled(pmin, pmax, (26, 26, 30, 255));
        // 地图外区域压暗，突出地图范围
        do PushClipRect(pmin, pmax);
        do dl->AddRectFilled(
            origin,
            (origin[0] + w as real * cellpx, origin[1] + h as real * cellpx),
            (52, 52, 58, 255));

        // ---- 可见范围 ----
        let vis_x0 = math::max(0, ((pmin[0] - origin[0]) / cellpx) as int) - 1;
        let vis_y0 = math::max(0, ((pmin[1] - origin[1]) / cellpx) as int) - 1;
        let vis_x1 = math::min(w - 1, ((pmax[0] - origin[0]) / cellpx) as int + 1);
        let vis_y1 = math::min(h - 1, ((pmax[1] - origin[1]) / cellpx) as int + 1);

        // ---- 逐层绘制可见格子（含自动图块象限，与运行时一致） ----
        let draw_detail = cellpx >= 6.;
        if (draw_detail)
        {
            for (let mut layer = 0; layer < layer_count; layer += 1)
            {
                let (_, visible, _) = ctx.m_map->get_layer(layer);
                if (visible == 0)
                    continue;
                // 突出选中层：其余图层瓦片整体压为半透明（约 47% 不透明度）
                let mut tint = (255, 255, 255, 255);
                if (state.m_dim_other_layers && layer != state.m_layer)
                    tint = (255, 255, 255, 120);
                for (let mut y = vis_y0; y <= vis_y1; y += 1)
                {
                    for (let mut x = vis_x0; x <= vis_x1; x += 1)
                    {
                        let quad_count = ctx.m_map->cell_quad_count(layer, x, y);
                        if (quad_count <= 0)
                            continue;
                        let cell_min = (origin[0] + x as real * cellpx, origin[1] + y as real * cellpx);
                        let cell_max = (cell_min[0] + cellpx, cell_min[1] + cellpx);
                        for (let mut q = 0; q < quad_count; q += 1)
                        {
                            match (ctx.m_map->cell_quad(layer, x, y, q))
                            {
                                value((tex_path, u0, v0, u1, v1, qx, qy, qcols))?
                                {
                                    match (state->atlas_texture(tex_path))
                                    {
                                        value(tex)?
                                        {
                                            // cell_quad 返回引擎约定 UV：v0=件底、v1=件顶。
                                            // je_gui_draw_list_add_image_uv 绑定内部会交叉两角的
                                            // v（uvmin=(uv0.x,uv1.y)），期望第一角=左下、第二角=右上，
                                            // 因此这里必须按 (u0,v0)/(u1,v1) 自然顺序直传，不可交换。
                                            let sub_w = (cell_max[0] - cell_min[0]) / qcols as real;
                                            let sub_h = (cell_max[1] - cell_min[1]) / qcols as real;
                                            do dl->AddImageUV(
                                                (cell_min[0] + qx as real * sub_w,
                                                 cell_min[1] + qy as real * sub_h),
                                                (cell_min[0] + (qx + 1) as real * sub_w,
                                                 cell_min[1] + (qy + 1) as real * sub_h),
                                                (u0, v0), (u1, v1), tex, tint);
                                        }
                                        none?;
                                    }
                                }
                                none?;
                            }
                        }
                    }
                }
            }
        }

        // ---- 网格 ----
        if (cellpx >= 14.)
        {
            let grid_color = (70, 70, 78, 140);
            for (let mut x = vis_x0; x <= vis_x1 + 1; x += 1)
            {
                let gx = origin[0] + x as real * cellpx;
                do dl->AddLine((gx, math::max(pmin[1], origin[1] + vis_y0 as real * cellpx)),
                    (gx, math::min(pmax[1], origin[1] + (vis_y1 + 1) as real * cellpx)),
                    grid_color, 1.);
            }
            for (let mut y = vis_y0; y <= vis_y1 + 1; y += 1)
            {
                let gy = origin[1] + y as real * cellpx;
                do dl->AddLine((math::max(pmin[0], origin[0] + vis_x0 as real * cellpx), gy),
                    (math::min(pmax[0], origin[0] + (vis_x1 + 1) as real * cellpx), gy),
                    grid_color, 1.);
            }
        }

        // ---- 矩形工具预览 ----
        if (state.m_tool == tool::RECT)
        {
            match (state.m_rect_anchor)
            {
                value((ax, ay))?
                {
                    match (hover_cell)
                    {
                        value((hx, hy))?
                        {
                            let left = math::min(ax, hx);
                            let top = math::min(ay, hy);
                            let rw = (math::abs(ax - hx) + 1) as real * cellpx;
                            let rh = (math::abs(ay - hy) + 1) as real * cellpx;
                            // 右键拖出的矩形染红，提示将清除该范围
                            let erasing = IsMouseDown(
                                ImGuiMouseButton::ImGuiMouseButton_Right);
                            do dl->AddRect(
                                (origin[0] + left as real * cellpx, origin[1] + top as real * cellpx),
                                (origin[0] + left as real * cellpx + rw,
                                 origin[1] + top as real * cellpx + rh),
                                erasing ? (255, 110, 110, 240) | (90, 160, 255, 220),
                                2.);
                        }
                        none?;
                    }
                }
                none?;
            }
        }

        // ---- 画笔块预览：在悬停格处半透明绘制整个 N×M 块
        //（按住右键时染红，提示将清除该块） ----
        if (state.m_tool == tool::PENCIL && state->stamp_is_block())
        {
            let erasing = IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Right);
            match (hover_cell)
            {
                value(cell)?
                    do draw_stamp_preview(state, cell, origin, cellpx, erasing);
                none?;
            }
        }

        // ---- 悬停高亮与坐标 ----
        match (hover_cell)
        {
            value((hx, hy))?
            {
                do dl->AddRect(
                    (origin[0] + hx as real * cellpx, origin[1] + hy as real * cellpx),
                    (origin[0] + (hx + 1) as real * cellpx,
                     origin[1] + (hy + 1) as real * cellpx),
                    (255, 255, 255, 180), 1.5);
                do SetTooltip(F"({hx}, {hy})");
            }
            none?;
        }

        // ---- 地图边界 ----
        do dl->AddRect(
            origin,
            (origin[0] + w as real * cellpx, origin[1] + h as real * cellpx),
            (120, 120, 130, 200), 1.5);

        do PopClipRect();

        // ---- 笔划交互。左键绘制、右键清除；左键事件优先，两键同时
        // 按住时不会混写。左键沿用"画布子窗口聚焦时才响应"，避免与其他
        // 面板抢输入；右键不会改变 ImGui 焦点（焦点仍停在调色板等面板
        // 上），故只按悬停判定 ----
        let l_click = IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Left);
        let l_down = IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Left);
        let l_up = IsMouseReleased(ImGuiMouseButton::ImGuiMouseButton_Left);
        let r_click = IsMouseClicked(ImGuiMouseButton::ImGuiMouseButton_Right);
        let r_down = IsMouseDown(ImGuiMouseButton::ImGuiMouseButton_Right);
        let r_up = IsMouseReleased(ImGuiMouseButton::ImGuiMouseButton_Right);
        let l_event = l_click || l_down || l_up;
        let r_event = r_click || r_down || r_up;
        let focused = IsWindowFocused();
        if (hovered)
        {
            if (l_event && focused)
                do handle_canvas_input(state, ctx, hover_cell, false,
                    l_click, l_down && !l_click, l_up);
            else if (r_event && !l_event)
                do handle_canvas_input(state, ctx, hover_cell, true,
                    r_click, r_down && !r_click, r_up);
        }
        else
        {
            // 移出画布后抬起也要结束笔划/取消矩形
            if (l_up && focused)
                do handle_canvas_input(state, ctx, option::none, false,
                    false, false, true);
            else if (r_up)
                do handle_canvas_input(state, ctx, option::none, true,
                    false, false, true);
        }
    }

    // 画笔块预览：在悬停格处半透明绘制框选的 N×M 块（左上角对齐落笔点）。
    // 按图集原格原样绘制，预览与落笔结果一致（不解析自动拼接）；
    // 右键清除时染红并改用红框
    func draw_stamp_preview(state: EditorState, cell: (int, int),
        origin: (real, real), cellpx: real, erasing: bool)=> void
    {
        match (state.m_stamp_ts)
        {
            none?;
            value(ts)?
            {
                let (x0, y0) = cell;
                let sw = state.m_stamp_w;
                let sh = state.m_stamp_h;
                let dl = GetWindowDrawList();
                let tint = erasing ? (255, 120, 120, 170) | (255, 255, 255, 150);
                for (let mut dy = 0; dy < sh; dy += 1)
                {
                    for (let mut dx = 0; dx < sw; dx += 1)
                    {
                        match (tilemap::decode_value(
                            state.m_stamp_values[dy * sw + dx]))
                        {
                            value((_, tid, _))?
                            {
                                let (src, ix, iy, _) = ts->tile_info(tid);
                                if (src >= 0 && src < ts->source_count())
                                {
                                    let (tp, tpx, _, _) =
                                        ts->source_info(src);
                                    match (state->atlas_texture(tp))
                                    {
                                        value(tex)?
                                        {
                                            let (u0, v0, u1, v1) =
                                                atlas_cell_uv(tex, tpx, ix, iy);
                                            let px = origin[0]
                                                + (x0 + dx) as real * cellpx;
                                            let py = origin[1]
                                                + (y0 + dy) as real * cellpx;
                                            do dl->AddImageUV((px, py),
                                                (px + cellpx, py + cellpx),
                                                (u0, v0), (u1, v1), tex, tint);
                                        }
                                        none?;
                                    }
                                }
                            }
                            none?;
                        }
                    }
                }
                do dl->AddRect(
                    (origin[0] + x0 as real * cellpx,
                     origin[1] + y0 as real * cellpx),
                    (origin[0] + (x0 + sw) as real * cellpx,
                     origin[1] + (y0 + sh) as real * cellpx),
                    erasing ? (255, 110, 110, 240) | (255, 190, 90, 230), 2.);
            }
        }
    }

    // 视图重置：地图居中并选择合适缩放
    public func reset_view(state: EditorState)=> void
    {
        let (w, h, _, _) = state.m_context->unwrap().m_map->size();
        let avail = GetContentRegionAvail();
        if (w <= 0 || h <= 0 || avail[0] <= 0. || avail[1] <= 0.)
            return;
        let (_, _, tile_px, _) = state.m_context->unwrap().m_map->size();
        let mut zoom = math::min(
            (avail[0] - 32.) / (w as real * tile_px as real),
            (avail[1] - 32.) / (h as real * tile_px as real));
        if (zoom < 0.05) zoom = 0.05;
        if (zoom > 4.) zoom = 4.;
        state.m_zoom = zoom;
        state.m_pan = (
            (avail[0] - w as real * tile_px as real * zoom) / 2.,
            (avail[1] - h as real * tile_px as real * zoom) / 2.);
    }
}
