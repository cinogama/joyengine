import pkg::std;

import je;
import je::gui;
import je::audio;
import je::cache;

import pkg::fsys;
import pkg::interface;
import pkg::thread;
import pkg::toml;

import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Icons;
import builtin::editor::GUI::Theme;
import builtin::editor::GUI::Widgets;
import builtin::editor::GUI::Forms::MsgBox;

import ResourcePath;

using std;
using je;
using je::gui;
using fsys;
using toml;

using JEEditor::GUI;
using JEEditor::GUI::Forms;
using JEEditor::GUI::Windows;
using JEEditor::Editor::ResourcePath;

namespace JEEditor::Editor
{
    // 音频属性窗口：编辑音频的播放方式与缓存格式，写入 <音频路径>.je4audio
    //（TOML）。引擎加载音频时按音频文件与该源文件生成/复用音频缓存
    // <音频路径>.je4cache（载荷区 + 解码信息与配置文档）：
    //   流式播放 —— 按需解码并分块读取波形数据，适用于时长较长的音频
    //              （如背景音乐）；
    //   整段载入 —— 一次性解码进内存，适用于短促的音效（默认）；
    //   缓存格式 —— 波形数据在缓存中的编码：PCM 位深档（8/16位整数或
    //              32位浮点，无损）或压缩档（ADPCM / Vorbis，有损；
    //              Vorbis 可调质量）。源音频先解码再转换，任何编码的
    //              WAV 都能落成 OpenAL 可用的缓存。
    using AudioProperties = struct{
        m_path: path_t,
        m_runtime_path: string,
        m_streaming: mut bool,
        // 0 = i8，1 = i16，2 = f32，3 = ADPCM，4 = Vorbis
        m_format: mut int,
        m_quality: mut real,
        m_info: mut option<je::audio::buffer::buffer_data_t>,
        m_status: mut string,
        // 有尚未保存的改动：页脚在“已保存”提示的位置显示未保存提醒
        m_dirty: mut bool,
        // 缓存生成结果（后台线程写入，GUI 线程每帧轮询）；none = 进行中
        m_cache_ready: mutable<option<bool>>,
    }
    {
        public func create(path: path_t)=> AudioProperties
            where require!(AudioProperties: Windows::IWindows);
        {
            let runtime_path = ResourcePath::toRuntimeResourcePath(path);

            // 缓存生成（首次打开未缓存的长音频要整段解码）放在后台线程，
            // 打开窗口本身不做重活；完成后 GUI 线程做缓存命中的轻量加载
            // 取解码信息。
            let cache_ready = mutable::create(option::none: option<bool>);
            do thread::create(func(){
                    cache_ready->set <|
                        option::value <|
                            je::cache::generate_audio_cache(runtime_path);
                });

            return AudioProperties{
                m_path = path,
                m_runtime_path = runtime_path,
                m_streaming = mut loadStreaming(path),
                m_format = mut loadFormat(path),
                m_quality = mut loadQuality(path),
                m_info = mut option::none: option<je::audio::buffer::buffer_data_t>,
                m_status = mut "",
                m_dirty = mut false,
                m_cache_ready = cache_ready,
            };
        }
        // 读取 <音频路径>.je4audio 中保存的流式播放配置：属性源文件不存在、
        // 无法解析、键缺失或取值未知时按默认的整段载入处理（与引擎一致）。
        func loadStreaming(path: path_t)=> bool
        {
            let settings_path = normalize(path->to_string + ".je4audio");
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(root)?
                    {
                        match (root["streaming"]->as_bool)
                        {
                            value(flag)? return flag;
                            none?;
                        }
                    }
                    err(_)?;
                }
            }
            return false;
        }
        // 读取 <音频路径>.je4audio 中保存的缓存格式/压缩编码，归一到
        // 0 = i8、1 = i16、2 = f32、3 = ADPCM、4 = Vorbis：属性源文件不
        // 存在、键缺失或取值未知时按默认的 i8 处理。保存时会把当前选择
        // 写回，未知的取值随之被规范化。
        func loadFormat(path: path_t)=> int
        {
            let settings_path = normalize(path->to_string + ".je4audio");
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(root)?
                    {
                        match (root["codec"]->as_string)
                        {
                            value(name)?
                            {
                                if (name->lower == "adpcm")
                                    return 3;
                                if (name->lower == "vorbis")
                                    return 4;
                            }
                            none?;
                        }

                        match (root["format"]->as_string)
                        {
                            value(name)?
                            {
                                if (name->lower == "i16")
                                    return 1;
                                if (name->lower == "f32")
                                    return 2;
                            }
                            none?;
                        }
                    }
                    err(_)?;
                }
            }
            return 0;
        }
        // 读取 <音频路径>.je4audio 中保存的 Vorbis 压缩质量（缺省 0.5）。
        func loadQuality(path: path_t)=> real
        {
            let settings_path = normalize(path->to_string + ".je4audio");
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(root)?
                    {
                        match (root["quality"]->as_float)
                        {
                            value(quality)? return quality;
                            none?;
                        }
                        match (root["quality"]->as_int)
                        {
                            value(quality)? return quality as real;
                            none?;
                        }
                    }
                    err(_)?;
                }
            }
            return 0.5;
        }
        // 缓存格式选项（下标）对应的 TOML format 取值。
        func formatNameOf(index: int)=> string
        {
            if (index == 1 || index == 3)
                return "i16";
            if (index == 2 || index == 4)
                return "f32";
            return "i8";
        }
        // 缓存格式选项（下标）对应的 TOML codec 取值。
        func codecNameOf(index: int)=> string
        {
            if (index == 3)
                return "adpcm";
            if (index == 4)
                return "vorbis";
            return "none";
        }
        public func showAudioProperties(path: path_t)
        {
            do Windows::show(create(path));
        }
        public func getTitle(self: AudioProperties)=> string
        {
            // $ID 让多个音频的属性窗口可以同时打开（见 Windows::show）。
            return F"音频属性: {filename(self.m_path)} $ID";
        }
        public func getAttrib(_: AudioProperties)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                + WindowsAttribute::ImGuiWindowFlags_NoSavedSettings
                ;
        }
        public func getSizeConstraints(_: AudioProperties)=> SizeConstraints
        {
            return SizeConstraints::Limited(((460., 480.), (1000., 900.)));
        }
        // 把当前播放方式写入 <音频路径>.je4audio；属性源文件是唯一真相，
        // 校验码随之改变，引擎会在下次加载时重建音频缓存。失败时弹窗并
        // 返回 false。
        func saveSettings(self: AudioProperties)=> bool
        {
            let settings_path = normalize(self.m_path->to_string + ".je4audio");
            let mut root = toml::new_table();
            if (exist(settings_path))
            {
                match (toml::load(settings_path))
                {
                    ok(loaded)? root = loaded;
                    err(msg)?
                    {
                        do MsgBox::err("保存失败",
                            F"无法读取音频属性文件：{msg}");
                        return false;
                    }
                }
            }
            root->set("streaming", self.m_streaming);
            root->set("format", formatNameOf(self.m_format));
            root->set("codec", codecNameOf(self.m_format));
            root->set("quality", self.m_quality);

            match (toml::save(root, settings_path))
            {
                ok(_)? return true;
                err(msg)?
                {
                    do MsgBox::err("保存失败",
                        F"无法写入音频属性文件：{msg}");
                    return false;
                }
            }
        }
        // 任一设置被改动：标记未保存，并清掉上一次“已保存”的提示。
        func markDirty(self: AudioProperties)=> void
        {
            self.m_dirty = true;
            self.m_status = "";
        }
        // 音频信息卡片：深色底 + 细描边，键值两列对齐。行内容用绘制列表
        // 直接排版（先画底再画字），卡片高度由行数与行高算出，不依赖
        // ImGui 的控件布局。
        func drawInfoCard(rows: array<(string, string)>)=> void
        {
            let pad = 10.;
            let label_w = 78.;
            let row_step = GetTextLineHeight() + 3.;
            let card_h = pad * 2. + rows->len as real * row_step - 3.;

            let (sx, sy) = GetCursorScreenPos();
            let card_w = GetContentRegionAvail().0;
            let draw = GetWindowDrawList();
            draw->AddRectFilled((sx, sy), (sx + card_w, sy + card_h),
                Theme::CARD_BG);
            draw->AddRect((sx, sy), (sx + card_w, sy + card_h),
                Theme::BORDER, 1.);

            for (let mut i = 0; i < rows->len; i += 1)
            {
                let (label, value) = rows[i];
                let row_y = sy + pad + i as real * row_step;
                draw->AddText((sx + pad, row_y), Theme::TEXT_MUTED, label);
                draw->AddText((sx + pad + label_w, row_y), Theme::TEXT, value);
            }

            Dummy((card_w, card_h));
        }
        // 载入中的占位卡片：高度按信息行的最大行数预留。窗口只在创建的
        // 头两帧自适应尺寸，信息晚到若改变内容高度会永久留下滚动条，
        // 因此占位卡片与满载信息卡片同高（信息行更少时只是下方留白）。
        func drawLoadingCard()=> void
        {
            let pad = 10.;
            let card_h = pad * 2. + 5. * (GetTextLineHeight() + 3.) - 3.;

            let (start_x, start_y) = GetCursorPos();
            let (sx, sy) = GetCursorScreenPos();
            let card_w = GetContentRegionAvail().0;
            let draw = GetWindowDrawList();
            draw->AddRectFilled((sx, sy), (sx + card_w, sy + card_h),
                Theme::CARD_BG);
            draw->AddRect((sx, sy), (sx + card_w, sy + card_h),
                Theme::BORDER, 1.);

            // 加载动画在卡片内垂直居中
            let spinner_h = GetTextLineHeight();
            SetCursorPos((start_x + pad + 4., start_y + (card_h - spinner_h) * 0.5));
            Widgets::drawBusySpinner("正在读取音频信息……");

            // 复位到卡片起点后用占位项把布局推到卡片底边
            SetCursorPos((start_x, start_y));
            Dummy((card_w, card_h));
        }
        // 音频解码信息：缓存生成中显示占位卡片，读出后整理成信息卡片。
        func drawInfo(self: AudioProperties)=> void
        {
            match (self.m_cache_ready->get)
            {
                // 后台还在生成缓存：显示占位，完成后的下一帧填入信息
                none?
                {
                    do drawLoadingCard();
                    return;
                }
                value(cache_ok)?
                {
                    if (cache_ok && self.m_info->is_none)
                    {
                        // 缓存已就绪：这里的加载必然命中缓存，只有文件 IO
                        match (je::audio::buffer::load(self.m_runtime_path))
                        {
                            value(buf)?
                                self.m_info = option::value(buf->info());
                            none?;
                        }
                    }
                }
            }

            match (self.m_info)
            {
                none?
                    Theme::emptyState("无法读取音频信息",
                        "文件缺失、缓存不可用或格式不支持。");
                value(info)?
                {
                    let mut rows = []: array<(string, string)>;
                    rows = rows->append(("解码格式", formatName(info.format)));
                    rows = rows->append(("编码", codecDisplayName(info.codec)));
                    rows = rows->append(("采样率", F"{info.sample_rate} Hz"));
                    if (info.byte_rate > 0)
                    {
                        // 整数运算算到百分位秒，避免浮点显示精度问题。
                        let seconds = info.size / info.byte_rate;
                        let centis = (info.size % info.byte_rate) * 100 / info.byte_rate;
                        rows = rows->append(("时长", F"{seconds}.{centis} 秒"));
                        rows = rows->append(("解码大小", prettyByteSize(info.size)));
                    }
                    do drawInfoCard(rows);
                }
            }
        }
        // 播放方式二选一：整段载入 / 流式播放。用分段按钮直显两种模式，
        // 激活项带橙色浅底，下方说明当前模式的取舍。
        func drawStreaming(self: AudioProperties)=> void
        {
            let avail = GetContentRegionAvail().0;
            let seg_w = (avail - 8.) * 0.5;

            Theme::pushToolbarToggleStyle(!self.m_streaming);
            let load_all_clicked = ButtonSize("整段载入", (seg_w, 0.));
            Theme::popToolbarToggleStyle();

            SameLine();

            Theme::pushToolbarToggleStyle(self.m_streaming);
            let streaming_clicked = ButtonSize("流式播放", (seg_w, 0.));
            Theme::popToolbarToggleStyle();

            if (load_all_clicked && self.m_streaming)
            {
                self.m_streaming = false;
                self->markDirty();
            }
            if (streaming_clicked && !self.m_streaming)
            {
                self.m_streaming = true;
                self->markDirty();
            }

            // 当前方式的说明
            if (self.m_streaming)
                Widgets::hintText("按需分块读取波形数据：长音频打开更快、占用内存更少。");
            else
                Widgets::hintText("整段解码进内存（默认）：短促音效播放时无需解压等待。");
        }
        // 缓存格式：编码下拉框 + 当前编码的说明；Vorbis 追加质量滑杆。
        func drawFormat(self: AudioProperties)=> void
        {
            let labels = [
                "8位整数（无压缩）",
                "16位整数（无压缩）",
                "32位浮点（无压缩）",
                "ADPCM（有损压缩）",
                "Vorbis（有损压缩）",
            ];
            SetNextItemWidth(GetContentRegionAvail().0);
            match (Combo("##audio_cache_format", labels,
                    option::value(self.m_format)))
            {
                none?;
                value(index)?
                {
                    if (index != self.m_format)
                    {
                        self.m_format = index;
                        self->markDirty();
                    }
                }
            }
            if (IsItemHovered())
                do SetTooltip(
                    "PCM 档（8/16位整数、32位浮点）为无损档，按所选位深存储波形；"
                    + "压缩档为有损：ADPCM 解码成本极低、适合高频短音效，Vorbis "
                    + "体积更小且质量可调，适合音乐/长音频。源音频任何编码"
                    + "（含24位/整数32位/64位浮点）都会先解码再转换。");

            Widgets::hintText(cacheFormatSummary(self.m_format));

            if (self.m_format == 4)
            {
                Spacing();
                TextDisabled("压缩质量");
                SetNextItemWidth(GetContentRegionAvail().0);
                match (SliderFloatFormat("##audio_vorbis_quality",
                        self.m_quality * 100., 0., 100., "%.0f%%"))
                {
                    none?;
                    value(percent)?
                    {
                        // 滑杆按整数百分比取值；与保存值比较整数百分比，
                        // 避免浮点往返误标为“有改动”
                        let percent_int = percent as int;
                        if (percent_int != (self.m_quality * 100.) as int)
                        {
                            self.m_quality = percent_int as real / 100.;
                            self->markDirty();
                        }
                    }
                }
                Widgets::hintText(
                    "质量越高音质越好、缓存越大：0% 约 64 kbps 立体声，"
                    + "100% 约 500 kbps，默认 50%。");
            }
        }
        // 页脚：主操作保存 + 状态/未保存提醒。
        func drawActions(self: AudioProperties)=> void
        {
            if (Theme::primaryButton("保存", (-1., 0.)))
            {
                if (self->saveSettings())
                {
                    // 磁盘缓存按校验码在下次加载时自动重建。
                    self.m_dirty = false;
                    self.m_status = "已保存，已加载的音频需重新加载后生效。";
                }
            }

            if (self.m_status->len > 0)
                TextColored(Theme::SUCCESS, self.m_status);
            else if (self.m_dirty)
                TextColored(Theme::WARNING, "有未保存的修改");
            else
                // 状态行位置恒定占一行：保存后出现提示时窗口不会再次
                // 长高（窗口只在头两帧自适应尺寸）
                Dummy((0., GetTextLineHeight()));
        }
        public func run(self: AudioProperties)=> bool
        {
            Theme::assetFileHeader(Icons::MUSIC,
                filename(self.m_path), self.m_runtime_path,
                self.m_path->to_string);

            Theme::sectionLabel("音频信息");
            self->drawInfo();
            Spacing();

            Theme::sectionLabel("播放方式");
            self->drawStreaming();
            Spacing();

            Theme::sectionLabel("缓存格式");
            self->drawFormat();
            Spacing();

            Separator();
            self->drawActions();

            return true;
        }
    }

    // 音频格式枚举的显示名（与 je::audio::buffer::format 一一对应）。
    func formatName(format: je::audio::buffer::format)=> string
    {
        if (format == je::audio::buffer::format::MONO8)
            return "8位单声道";
        if (format == je::audio::buffer::format::MONO16)
            return "16位单声道";
        if (format == je::audio::buffer::format::MONO32F)
            return "32位浮点单声道";
        if (format == je::audio::buffer::format::STEREO8)
            return "8位立体声";
        if (format == je::audio::buffer::format::STEREO16)
            return "16位立体声";
        return "32位浮点立体声";
    }

    // 音频缓存压缩编码的显示名（与 je::audio::buffer::codec 一一对应）。
    func codecDisplayName(codec: je::audio::buffer::codec)=> string
    {
        if (codec == je::audio::buffer::codec::ADPCM)
            return "ADPCM";
        if (codec == je::audio::buffer::codec::VORBIS)
            return "Vorbis";
        return "无压缩";
    }

    // 缓存格式选项的说明文本（下拉框下方的一行取舍提示）。
    func cacheFormatSummary(index: int)=> string
    {
        if (index == 1)
            return "无损：按 16 位整数存储波形，音质与体积均衡。";
        if (index == 2)
            return "无损：按 32 位浮点存储波形，精度最高、体积也最大。";
        if (index == 3)
            return "有损：ADPCM 约 4:1，解码开销极低，适合高频短音效。";
        if (index == 4)
            return "有损：Vorbis 约 8-12:1，体积最小，适合音乐与长音频。";
        return "无损：按 8 位整数存储波形，体积最小（默认）。";
    }

    // 字节数的友好显示（B/KB/MB，整数运算，与「关于」窗口一致）。
    func prettyByteSize(bytes: int)=> string
    {
        if (bytes < 1024)
            return F"{bytes} B";
        if (bytes < 1024 * 1024)
            return F"{bytes / 1024} KB";
        return F"{bytes / 1024 / 1024} MB";
    }
}
