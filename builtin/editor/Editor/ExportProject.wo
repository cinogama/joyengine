// 项目导出向导（文件 → 导出项目...）。
//
// 流程参照旧版 export_project.wo，但全部改用当前编辑器的 API：
//   0 欢迎/确认  → 1 启动世界 → 2 分辨率 → 3 镜像分片大小 → 4 确认
// 点击“开始打包”后向导关闭，打包在 ModulePrepare 的后台线程里进行，
// 进度与错误显示在“项目导出”日志窗口中。
//
// 产物布局（<项目>/.export/）：
//   fimg.je4index + fimg.<N>.je4image   资源镜像（项目文件、着色器、启动脚本）
//   modules/lib<模块名>.dll              RELEASE 编译的原生模块（真实文件）
//   <项目名>.exe + 引擎运行库             引擎运行时
//   licenses/                            引擎使用的第三方许可证
//
// 镜像中的键约定与引擎的资源路径一致：项目文件使用 @/<相对路径>，
// 引擎内部着色器使用 !/builtin/shader/internal/<文件名>。

import pkg::std;
import pkg::fsys;
import pkg::interface;
import pkg::try;
import pkg::buffer;
import pkg::dumpling;
import pkg::platform;
import pkg::process;
import pkg::toml;
import pkg::worst;

import je;
import je::graphic;
import je::gui;
import je::internal;

import builtin::editor::GUI::Windows;
import builtin::editor::Editor::ModulePrepare;
import builtin::editor::Editor::Template;
import builtin::editor::Editor::Project;
import builtin::editor::Editor::ResourcePath;
import builtin::editor::Editor::WorldEditorViewport;

import builtin::editor::Singleton;

using std;
using fsys;
using platform;
using je;
using je::graphic;
using je::gui;
using dumpling;
using toml;
using JEEditor::GUI::Windows;
using JEEditor::Singleton;

namespace JEEditor::Editor
{
    // 导出设置会通过 Singleton 保存到项目的 .temp/export_settings.toml，
    // 下次打开导出向导时恢复。
    using ExportSettings = struct{
        m_compression_enabled: mut bool,
        m_compression_level: mut int,
        m_min_compress_size_kb: mut int,
        m_skip_extensions: mut string,
    }
    {
        public let SINGLETON_LABEL = "export_settings";

        public func createAndLoad(content: option<Toml>)=> ExportSettings
            where require!(ExportSettings: ISingleton);
        {
            let mut enabled = true;
            let mut level = 6;
            let mut min_kb = 1;
            let mut skip = je::internal::fimg_writer::default_skip_extensions();

            match (content)
            {
                none?;
                value(data)?
                {
                    match (data->get("compression_enabled"))
                    {
                        none?;
                        value(v)?
                        {
                            match (v->as_bool)
                            {
                                none?;
                                value(b)? enabled = b;
                            }
                        }
                    }
                    match (data->get("compression_level"))
                    {
                        none?;
                        value(v)?
                        {
                            match (v->as_int)
                            {
                                none?;
                                value(i)? level = i;
                            }
                        }
                    }
                    match (data->get("min_compress_size_kb"))
                    {
                        none?;
                        value(v)?
                        {
                            match (v->as_int)
                            {
                                none?;
                                value(i)? min_kb = i;
                            }
                        }
                    }
                    match (data->get("skip_extensions"))
                    {
                        none?;
                        value(v)?
                        {
                            match (v->as_string)
                            {
                                none?;
                                value(s)? skip = s;
                            }
                        }
                    }
                }
            }

            if (level < 1)
                level = 1;
            if (level > 9)
                level = 9;
            if (min_kb < 0)
                min_kb = 0;

            return ExportSettings{
                m_compression_enabled = mut enabled,
                m_compression_level = mut level,
                m_min_compress_size_kb = mut min_kb,
                m_skip_extensions = mut skip,
            };
        }

        public func save(self: ExportSettings)=> option<Toml>
        {
            let data = new_table();
            data->set("compression_enabled", self.m_compression_enabled);
            data->set("compression_level", self.m_compression_level);
            data->set("min_compress_size_kb", self.m_min_compress_size_kb);
            data->set("skip_extensions", self.m_skip_extensions);
            return option::value(data);
        }
    }

    using ExportProject = struct{
        m_step: mut int,
        // (打包键, 是否作为启动世界)；打包键形如 @/resource/worlds/x.je4world
        m_worlds: vec<(string, mutable<bool>)>,
        m_reso_index: mut int,
        m_resolution: mut (int, int),
        m_image_size_mb: mut int,
        m_compress_enabled: mut bool,
        m_compression_level: mut int,
        m_min_compress_size_kb: mut int,
        m_skip_extensions: mut string,
        m_closed: mut bool,
    }
    {
        // 视觉主题：与「项目」「关于」窗口共用一套暖橙色系，保持编辑器风格统一。
        let s_joy_logo = texture2d::load(option::none, "!/builtin/icon/Joy.png");
        let k_title_color = (242, 176, 109, 255);
        let k_panel_bg_color = (37, 37, 42, 255);
        let k_primary_btn_color = (219, 134, 63, 255);
        let k_primary_btn_hover_color = (241, 157, 89, 255);
        let k_primary_btn_active_color = (190, 113, 50, 255);
        let k_warning_color = (255, 184, 92, 255);
        let k_danger_color = (255, 128, 128, 255);

        // 向导内容固定尺寸：模态窗口为 AutoSize，固定宽度可避免切换步骤时
        // 窗口尺寸随内容抖动。
        let k_content_width = 560.;
        let k_content_height = 320.;

        let k_step_labels = ["准备", "启动世界", "画面", "镜像", "确认"];

        // 导出任务的输入快照。打包在后台线程进行，不能再去读编辑器里的
        // Project/ToWoo 集合（它们可能被编辑操作并发修改），因此在这里
        // 一次性取出全部信息。
        using Settings = struct{
            m_project_name: string,
            m_working_path: path_t,
            m_start_up_worlds: array<string>,
            m_resolution: (int, int),
            m_image_size_mb: int,
            m_compress_enabled: bool,
            m_compression_level: int,
            m_min_compress_size_kb: int,
            m_skip_extensions: string,
            m_modules: array<(string, path_t)>,
            m_towoo_components: array<(string, path_t)>,
            m_towoo_systems: array<(string, path_t)>,
            m_has_types_script: bool,
        };
        
        // 向导可选的分辨率列表，与旧版导出向导保持一致。
        func resolutions()
        {
            static let items = [
                ("1280x720 [16:9]", (1280, 720)),
                ("1366x768 [16:9]", (1366, 768)),
                ("1920x1080 [16:9]", (1920, 1080)),
                ("2560x1440 [16:9]", (2560, 1440)),
                ("3840x2160 [16:9]", (3840, 2160)),
                ("800x600 [4:3]", (800, 600)),
                ("1024x768 [4:3]", (1024, 768)),
                ("1400x1050 [4:3]", (1400, 1050)),
                ("1920x1440 [4:3]", (1920, 1440)),
            ];
            return items;
        }
        
        public func create()=> ExportProject
            where require!(ExportProject: IWindows);
        {
            let export_settings = apply:<ExportSettings>(func(s){ return s; });

            return ExportProject{
                m_step = mut 0,
                m_worlds = scanWorlds(),
                m_reso_index = mut 1,
                m_resolution = mut (1366, 768),
                m_image_size_mb = mut 128,
                m_compress_enabled = mut export_settings.m_compression_enabled,
                m_compression_level = mut export_settings.m_compression_level,
                m_min_compress_size_kb = mut export_settings.m_min_compress_size_kb,
                m_skip_extensions = mut export_settings.m_skip_extensions,
                m_closed = mut false,
            };
        }
        
        public func showExportProject()
        {
            do show(ExportProject::create());
        }
        
        public func getTitle(_: ExportProject)=> string
        {
            return "项目导出向导";
        }
        public func getAttrib(_: ExportProject)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse;
        }
        public func getSizeConstraints(_: ExportProject)=> SizeConstraints
        {
            return SizeConstraints::AutoSize;
        }
        public func isModal(_: ExportProject)=> bool
        {
            return true;
        }
        
        // ==========================
        //  向导界面
        // ==========================

        public func run(self: ExportProject)=> bool
        {
            drawHeader();
            Spacing();
            self->drawStepIndicator();

            // 步骤内容卡片：固定尺寸，避免 AutoSize 窗口随步骤内容跳动
            if (beginStepCard())
            {
                if (self.m_step == 0)
                    self->drawWelcomeStep();
                else if (self.m_step == 1)
                    self->drawWorldsStep();
                else if (self.m_step == 2)
                    self->drawResolutionStep();
                else if (self.m_step == 3)
                    self->drawImageSizeStep();
                else if (self.m_step == 4)
                    self->drawConfirmStep();
            }
            endStepCard();

            self->drawFooter();
            return !self.m_closed;
        }

        // 顶部横幅：吉祥物 + 标题 + 当前项目，与「项目」「关于」窗口一致。
        func drawHeader()
        {
            match (s_joy_logo)
            {
                none?;
                value(logo)?
                {
                    ImageSize(logo, 64., 64.);
                    SameLine();
                }
            }

            // 有吉祥物时文字列从它右侧开始；纹理缺失时即为窗口缩进处
            let text_x = GetCursorPos().0;

            SetWindowFontScale(1.6);
            TextColored(k_title_color, "项目导出");
            SetWindowFontScale(1.);

            setCursorX(text_x);
            TextDisabled(F"项目：{shrinkPath(projectName(), 36)}");
            if (IsItemHovered())
                do SetTooltip(workpath()->to_string);

            setCursorX(text_x);
            TextDisabled("收集资源、编译着色器并生成可独立运行的游戏");
        }

        // 顶部步骤指示条：已完成步骤填暖橙色，当前步骤带光晕与描边，
        // 未开始步骤用描边圆点；圆点之间用亮/暗连线表示进度。
        func drawStepIndicator(self: ExportProject)
        {
            let draw = GetWindowDrawList();
            let (sx, sy) = GetCursorScreenPos();
            let width = k_content_width;
            let radius = 13.;
            let label_gap = 7.;
            let row_height = radius * 2. + label_gap + GetTextLineHeight();
            let count = k_step_labels->len;
            let segment = width / (count as real);
            let cy = sy + radius + 2.;

            let text_c = GetStyleColor(ImGuiCol::ImGuiCol_Text);
            let disabled_c = GetStyleColor(ImGuiCol::ImGuiCol_TextDisabled);

            let accent_soft = (219, 134, 63, 210);
            let accent_glow = (242, 176, 109, 40);
            let done_fill = (188, 112, 52, 255);
            let idle_line = toColor32(disabled_c, 70);
            let idle_circle = toColor32(disabled_c, 130);
            let idle_bg = (45, 45, 52, 255);

            // 先画连接线，再用圆点盖住线头
            for (let mut i = 0; i + 1 < count; i += 1)
            {
                let x0 = sx + segment * ((i as real) + 0.5) + radius + 7.;
                let x1 = sx + segment * ((i as real) + 1.5) - radius - 7.;
                let line_c = (i < self.m_step) ? accent_soft | idle_line;
                draw->AddLine((x0, cy), (x1, cy), line_c, 2.);
            }

            for (let mut i = 0; i < count; i += 1)
            {
                let cx = sx + segment * ((i as real) + 0.5);
                let is_done = i < self.m_step;
                let is_current = i == self.m_step;

                if (is_current)
                {
                    draw->AddCircleFilled((cx, cy), radius + 5., accent_glow);
                    draw->AddCircleFilled((cx, cy), radius, k_title_color);
                    draw->AddCircle((cx, cy), radius + 3., (242, 176, 109, 140), 1.5);
                }
                else if (is_done)
                    draw->AddCircleFilled((cx, cy), radius, done_fill);
                else
                {
                    draw->AddCircleFilled((cx, cy), radius, idle_bg);
                    draw->AddCircle((cx, cy), radius, idle_circle, 1.5);
                }

                let mut number_c = toColor32(disabled_c, 200);
                if (is_done || is_current)
                    number_c = (28, 28, 32, 255);

                let number = F"{i + 1}";
                let number_size = CalcTextSize(number);
                draw->AddText(
                    (cx - number_size.0 * 0.5, cy - number_size.1 * 0.5),
                    number_c, number);

                let mut label_c = toColor32(disabled_c, 150);
                if (is_done)
                    label_c = toColor32(text_c, 220);
                if (is_current)
                    label_c = k_title_color;

                let label = k_step_labels[i];
                let label_size = CalcTextSize(label);
                draw->AddText(
                    (cx - label_size.0 * 0.5, cy + radius + label_gap),
                    label_c, label);
            }

            Dummy((width, row_height + 4.));
            Spacing();
        }

        // 步骤内容卡片：主题色底、微圆角、加厚内边距
        func beginStepCard()=> bool
        {
            PushStyleColor(ImGuiCol::ImGuiCol_ChildBg, k_panel_bg_color);
            PushStyleReal(StyleVar::ImGuiStyleVar_ChildRounding, 6.);
            PushStyleReal(StyleVar::ImGuiStyleVar_ChildBorderSize, 1.);
            PushStyleVec2(StyleVar::ImGuiStyleVar_WindowPadding, (16., 14.));
            return BeginChildSizeFlags("##export_step_card", k_content_width,
                k_content_height, WindowsAttribute::ImGuiWindowFlags_None);
        }
        func endStepCard()
        {
            EndChild();
            PopStyleVar(3);
            PopStyleColor(1);
        }

        // ==========================
        //  向导各步骤
        // ==========================

        func drawWelcomeStep(self: ExportProject)
        {
            do self;

            SeparatorText("开始之前");

            SetWindowFontScale(1.2);
            Text("把当前项目打包成可以独立分发的游戏");
            SetWindowFontScale(1.);
            Spacing();

            TextDisabled("向导会收集项目资源、编译着色器与原生模块，");
            TextDisabled("并生成可以直接运行的游戏程序。");
            Spacing();

            BulletText("建议先保存全部世界，确保打包的是最新数据");
            BulletText("原生模块会以 RELEASE 配置重新编译，可能需要较长时间");
            BulletText("资源与脚本会写入 .export 目录下的资源镜像");
            Spacing();

            drawCallout([
                "开始打包会先删除 .export 目录中的全部内容。",
                "如需保留之前的导出产物，请先自行备份。",
            ], k_warning_color);
            Spacing();

            if (ButtonSize("保存全部世界", (GetContentRegionAvail().0, 32.)))
                WorldEditorViewport::saveAllWorlds();

            TextDisabled("保存完成后，点击右下角的“开始配置”继续。");
        }

        func drawWorldsStep(self: ExportProject)
        {
            SeparatorText("启动世界");

            TextDisabled("勾选游戏启动时自动加载的世界；");
            TextDisabled("未勾选的世界仍会打包，只是不会自动载入。");
            Spacing();

            let avail = GetContentRegionAvail();
            let mut list_height = avail.1 - 40.;
            if (list_height < 80.)
                list_height = 80.;

            if (BeginChildSizeFlags("##export_world_list", avail.0, list_height,
                    WindowsAttribute::ImGuiWindowFlags_None))
            {
                if (self.m_worlds->len == 0)
                {
                    Spacing();
                    TextDisabled("项目中没有找到 .je4world 文件。");
                    TextDisabled("可以先在编辑器中新建世界，再回来导出。");
                }
                else
                {
                    for (let mut i = 0; i < self.m_worlds->len; i += 1)
                    {
                        let entry = self.m_worlds[i];
                        let display = F"{i + 1}.  "
                            + shrinkPath(worldDisplayPath(entry.0), 60);
                        match (CheckBox(F"{display}##world_{i}", entry.1->get))
                        {
                            none?;
                            value(checked)? entry.1->set(checked);
                        }
                        if (IsItemHovered())
                            do SetTooltip(entry.0);
                    }
                }
            }
            EndChild();

            Spacing();
            if (Button("全选"))
            {
                for (let mut i = 0; i < self.m_worlds->len; i += 1)
                    self.m_worlds[i].1->set(true);
            }
            SameLine();
            if (Button("全不选"))
            {
                for (let mut i = 0; i < self.m_worlds->len; i += 1)
                    self.m_worlds[i].1->set(false);
            }
            SameLine();
            TextDisabled(F"已选择 {self->selectedWorldCount()} / {self.m_worlds->len}");
        }

        func drawResolutionStep(self: ExportProject)
        {
            SeparatorText("默认画面分辨率");

            TextDisabled("游戏窗口启动时的默认大小。");
            Spacing();

            TextDisabled("分辨率");
            PushItemWidth(280.);
            match (Combo("##EXPORT_RESOLUTIONS", resolutionLabels(),
                    option::value(self.m_reso_index)))
            {
                none?;
                value(index)?
                {
                    self.m_reso_index = index;
                    self.m_resolution = resolutions()[index].1;
                }
            }
            PopItemWidth();

            Spacing();
            self->drawResolutionPreview();
        }

        // 按所选宽高比绘制窗口预览框，直观展示画面形状
        func drawResolutionPreview(self: ExportProject)
        {
            let (sx, sy) = GetCursorScreenPos();
            let width = GetContentRegionAvail().0;
            let area_height = 150.;
            let max_height = 118.;
            let aspect = (self.m_resolution.0 as real)
                / (self.m_resolution.1 as real);

            let mut w = width - 24.;
            let mut h = w / aspect;
            if (h > max_height)
            {
                h = max_height;
                w = h * aspect;
            }

            let x0 = sx + (width - w) * 0.5;
            let y0 = sy + (area_height - h) * 0.5;
            let draw = GetWindowDrawList();

            draw->AddRectFilled((x0, y0), (x0 + w, y0 + h), (26, 26, 31, 255));
            draw->AddRect((x0, y0), (x0 + w, y0 + h),
                (242, 176, 109, 150), 1.5);

            let label = F"{self.m_resolution.0} × {self.m_resolution.1}";
            let label_size = CalcTextSize(label);
            draw->AddText(
                (x0 + (w - label_size.0) * 0.5, y0 + (h - label_size.1) * 0.5),
                k_title_color, label);

            Dummy((width, area_height));
        }

        func drawImageSizeStep(self: ExportProject)
        {
            SeparatorText("镜像分片");

            TextDisabled("资源镜像会按分片大小切分为多个文件。");
            Spacing();

            SetNextItemWidth(220.);
            match (InputInt("分片大小（MB）##EXPORT_IMAGE_SIZE_MB",
                    self.m_image_size_mb))
            {
                none?;
                value(new_size)?
                {
                    if (new_size > 0)
                        self.m_image_size_mb = new_size;
                }
            }
            if (IsItemHovered())
                do SetTooltip("每个镜像分片的容量上限，默认为 128 MB。");

            Spacing();
            SeparatorText("压缩");

            match (CheckBox("压缩资源镜像##EXPORT_COMPRESS", self.m_compress_enabled))
            {
                none?;
                value(enabled)? self.m_compress_enabled = enabled;
            }

            BeginDisabled(!self.m_compress_enabled);

            SetNextItemWidth(240.);
            match (SliderInt("压缩级别##EXPORT_COMPRESS_LEVEL",
                    self.m_compression_level, 1, 9))
            {
                none?;
                value(level)? self.m_compression_level = level;
            }
            if (IsItemHovered())
                do SetTooltip("1 最快，9 压缩率最高。");

            SetNextItemWidth(240.);
            match (InputInt("最小压缩大小（KB）##EXPORT_MIN_COMPRESS",
                    self.m_min_compress_size_kb))
            {
                none?;
                value(min_kb)?
                {
                    if (min_kb >= 0)
                        self.m_min_compress_size_kb = min_kb;
                }
            }
            if (IsItemHovered())
                do SetTooltip("小于该大小的文件直接写入镜像，不再压缩。");

            TextDisabled("跳过扩展名（逗号分隔）");
            SetNextItemWidth(GetContentRegionAvail().0);
            match (InputText("##EXPORT_SKIP_EXT", self.m_skip_extensions))
            {
                none?;
                value(text)? self.m_skip_extensions = text;
            }
            if (IsItemHovered())
                do SetTooltip("PNG、JPEG、ZIP 等已经是压缩格式，通常无需重复压缩。");

            EndDisabled();

            Spacing();
            if (self.m_compress_enabled)
                TextDisabled("PNG/JPEG/ZIP 等已压缩格式默认不重复压缩。");
            else
                TextDisabled("压缩已关闭，资源将以原始大小写入镜像。");
        }

        func drawConfirmStep(self: ExportProject)
        {
            SeparatorText("打包摘要");

            let label_x = GetCursorPos().0;
            let label_w = 100.;

            drawSummaryRow(label_x, label_w, "项目名称", projectName());
            drawSummaryRow(label_x, label_w, "启动世界",
                F"{self->selectedWorldCount()} / {self.m_worlds->len} 个");
            drawSummaryRow(label_x, label_w, "分辨率",
                F"{self.m_resolution.0} × {self.m_resolution.1}");
            drawSummaryRow(label_x, label_w, "镜像分片",
                F"{self.m_image_size_mb} MB");

            if (self.m_compress_enabled)
            {
                drawSummaryRow(label_x, label_w, "镜像压缩",
                    F"等级 {self.m_compression_level}，最小 {self.m_min_compress_size_kb} KB");

                let mut skip_desc = self.m_skip_extensions;
                if (skip_desc->len == 0)
                    skip_desc = "（无）";
                drawSummaryRow(label_x, label_w, "跳过扩展名", skip_desc);
            }
            else
                drawSummaryRow(label_x, label_w, "镜像压缩", "关闭");

            drawSummaryRow(label_x, label_w, "输出目录",
                shrinkPath((workpath() / ".export")->to_string, 40));

            Spacing();
            drawCallout([
                "打包开始后向导会关闭，进度显示在“项目导出”窗口。",
                ".export 目录中的现有内容将被删除，请确认无需保留。",
            ], k_danger_color);

            Spacing();
            TextDisabled("准备好后，点击右下角的“开始打包”。");
        }

        // 底部信息与导航：左侧次要动作，右侧暖橙色主按钮
        func drawFooter(self: ExportProject)
        {
            Spacing();
            Separator();

            let export_dir = (workpath() / ".export")->to_string;
            TextDisabled(F"输出目录 {shrinkPath(export_dir, 56)}");
            if (IsItemHovered())
                do SetTooltip(export_dir);

            Spacing();

            let start_x = GetCursorPos().0;
            let width = GetContentRegionAvail().0;
            let button_height = 34.;
            let secondary_w = 108.;
            let primary_w = 190.;

            let secondary_label = (self.m_step == 0) ? "取消导出" | "上一步";
            if (ButtonSize(secondary_label, (secondary_w, button_height)))
            {
                if (self.m_step == 0)
                    self.m_closed = true;
                else
                    self.m_step -= 1;
            }

            let mut primary_label = "下一步";
            if (self.m_step == 0)
                primary_label = "开始配置";
            else if (self.m_step == 4)
                primary_label = "开始打包";

            // 主按钮右对齐：与左侧按钮同一行
            SameLine();
            setCursorX(start_x + width - primary_w);
            if (self->drawPrimaryButton(primary_label, (primary_w, button_height)))
            {
                if (self.m_step == 4)
                    self->startExport();
                else
                    self.m_step += 1;
            }
        }

        // ==========================
        //  界面辅助
        // ==========================

        func drawPrimaryButton(self: ExportProject, label: string,
            btn_size: ImVec2)=> bool
        {
            do self;

            PushStyleColor(ImGuiCol::ImGuiCol_Button, k_primary_btn_color);
            PushStyleColor(ImGuiCol::ImGuiCol_ButtonHovered,
                k_primary_btn_hover_color);
            PushStyleColor(ImGuiCol::ImGuiCol_ButtonActive,
                k_primary_btn_active_color);
            PushStyleReal(StyleVar::ImGuiStyleVar_FrameRounding, 5.);

            let clicked = ButtonSize(label, btn_size);

            PopStyleVar(1);
            PopStyleColor(3);
            return clicked;
        }

        // 提示块：淡色底 + 左侧色条 + 指定颜色的说明文字
        func drawCallout(lines: array<string>, accent: Color32RGBA)
        {
            let width = GetContentRegionAvail().0;
            let line_height = GetTextLineHeightWithSpacing();
            let height = line_height * ((lines->len) as real) + 12.;
            let (sx, sy) = GetCursorScreenPos();
            let draw = GetWindowDrawList();

            let bg = (accent.0, accent.1, accent.2, 26);
            let bar = (accent.0, accent.1, accent.2, 210);
            draw->AddRectFilled((sx, sy), (sx + width, sy + height), bg);
            draw->AddRectFilled((sx, sy), (sx + 3., sy + height), bar);

            // 逐行显式定位：Text 换行后会回到窗口左缘，不能沿用首行的缩进
            let mut line_y = sy + 6.;
            for (let line : lines)
            {
                SetCursorScreenPos((sx + 12., line_y));
                TextColored(accent, line);
                line_y += line_height;
            }

            // 复位到提示块下方，避免后续控件叠在框内
            SetCursorScreenPos((sx, sy + height));
        }

        // 摘要行：左侧弱化标签列 + 右侧取值
        func drawSummaryRow(label_x: real, label_w: real,
            label: string, value: string)
        {
            TextDisabled(label);
            SameLine();
            setCursorX(label_x + label_w);
            Text(value);
        }

        func setCursorX(x: real)
        {
            let (_, y) = GetCursorPos();
            SetCursorPos((x, y));
        }

        func shrinkPath(path: string, max_chars: int)=> string
        {
            if (path->len <= max_chars)
                return path;
            return "..." + path->sub(path->len - max_chars + 3);
        }

        // 打包键 @/resource/worlds/x.je4world 去掉前缀后显示
        func worldDisplayPath(pack_key: string)=> string
        {
            if (pack_key->begin_with("@/"))
                return pack_key->sub(2);
            return pack_key;
        }

        // ImGui 风格色（0..1 浮点）转为绘制用颜色
        func toColor32(c: (real, real, real, real), alpha: int)=> Color32RGBA
        {
            return ((c.0 * 255.) as int, (c.1 * 255.) as int,
                (c.2 * 255.) as int, alpha);
        }

        
        // ==========================
        //  向导数据
        // ==========================
        
        func projectName()=> string
        {
            let name = filename(workpath());
            return name->len == 0 ? "Game" | name;
        }
        
        func resolutionLabels()=> array<string>
        {
            let mut labels = []mut: vec<string>;
            for (let item : resolutions())
                labels->add(item.0);
                
            return labels->unsafe::asarray;
        }
        
        func selectedWorldCount(self: ExportProject)=> int
        {
            let mut count = 0;
            for (let entry : self.m_worlds)
            {
                if (entry.1->get)
                    count += 1;
            }
            return count;
        }
        
        func isHiddenRelativePath(rel: string)=> bool
        {
            // 相对路径无前导 '/'，补一个再查找 "/."，与旧版导出的隐藏文件规则一致。
            return ("/" + rel)->find("/.")->is_value;
        }
        
        // 扫描项目中的 .je4world，生成 @/ 形式的打包键。
        func scanWorlds()=> vec<(string, mutable<bool>)>
        {
            let mut worlds = []mut: vec<(string, mutable<bool>)>;
            
            match (allsubpath(workpath()))
            {
                ok(paths)?
                {
                    for (let p : paths)
                    {
                        if (!isfile(p) || extension(p)->lower != ".je4world")
                            continue;
                            
                        match (relative(p, workpath()))
                        {
                            ok(rel)?
                            {
                                if (rel->len == 0 || isHiddenRelativePath(rel))
                                    continue;
                                    
                                worlds->add((
                                        ResourcePath::toRuntimeResourcePath(p),
                                        mutable::create(false)));
                            }
                            err(_)?;
                        }
                    }
                }
                err(_)?;
            }
            
            return worlds;
        }
        
        // 过滤掉已从磁盘删除的注册条目：它们既不会被打包，也无法在运行期
        // 注册，保留在启动脚本里只会产生无意义的错误日志。
        func existingEntries(entries: array<(string, path_t)>)
        {
            let mut result = []mut: vec<(string, path_t)>;
            for (let (name, path) : entries)
            {
                if (isfile(path))
                    result->add((name, path));
            }
            return result->unsafe::asarray;
        }
        
        // 收集向导配置并启动后台打包。
        func startExport(self: ExportProject)
        {
            let mut start_up_worlds = []mut: vec<string>;
            for (let entry : self.m_worlds)
            {
                if (entry.1->get)
                    start_up_worlds->add(entry.0);
            }
            
            let settings = apply:<Project>(
                func(proj)
                {
                    return Settings{
                        m_project_name = projectName(),
                        m_working_path = workpath(),
                        m_start_up_worlds = start_up_worlds->unsafe::asarray,
                        m_resolution = self.m_resolution,
                        m_image_size_mb = self.m_image_size_mb,
                        m_compress_enabled = self.m_compress_enabled,
                        m_compression_level = self.m_compression_level,
                        m_min_compress_size_kb = self.m_min_compress_size_kb,
                        m_skip_extensions = self.m_skip_extensions,
                        m_modules = proj->getDeclaredModules(),
                        m_towoo_components = existingEntries(
                            proj->getAllToWooComponentNameAndPath()),
                        m_towoo_systems = existingEntries(
                            proj->getAllToWooSystemNameAndPath()),
                        m_has_types_script = isfile(
                            workpath() / "resource" / "editor" / "types.wo"),
                    };
                });
                
            do apply:<ExportSettings>(
                func(s)
                {
                    s.m_compression_enabled = self.m_compress_enabled;
                    s.m_compression_level = self.m_compression_level;
                    s.m_min_compress_size_kb = self.m_min_compress_size_kb;
                    s.m_skip_extensions = self.m_skip_extensions;
                });

            do showModal(
                ModulePrepare::createWithTitle(
                    "项目导出",
                    func(prepare: ModulePrepare){
                        return runExportJob(prepare, settings);
                    }));
                    
            self.m_closed = true;
        }
        
        // ==========================
        //  后台打包任务
        // ==========================
        
        func runExportJob(prepare: ModulePrepare, settings: Settings)
        {
            let export_path = settings.m_working_path / ".export";
            
            prepare->postMessage("开始打包……");
            prepare->postMessage(F"项目：{settings.m_project_name}");
            prepare->postMessage(F"导出目录：{export_path->to_string}");
            
            try! _ = remove(export_path)
                -> or_map(\e = F"删除旧的导出目录失败（{e}）";);
            try! _ = mkdir(export_path)
                -> or_map(\e = F"创建导出目录失败（{e}）";);
                
            let packer = je::internal::fimg_writer::create(
                export_path->to_string,
                settings.m_image_size_mb * 1024 * 1024,
                (settings.m_compress_enabled ? settings.m_compression_level | 0),
                settings.m_min_compress_size_kb * 1024,
                settings.m_skip_extensions);
                
            // 失败路径调用 abort 释放 writer；输出目录由下次导出前清理。
            let packer_finished = mutable::create(false);
            defer {
                if (!packer_finished->get)
                    packer->abort();
            };
            
            try! _ = packShaders(prepare, packer, settings.m_working_path);
            try! _ = buildAndCopyModules(prepare, export_path, settings.m_modules);
            try! _ = packProjectFiles(
                prepare, packer, settings.m_working_path, export_path);
            try! _ = packBootScript(prepare, packer, settings);
            try! _ = copyRuntimeFiles(prepare, export_path, settings);
            
            if (!packer->finish())
                throw! "写入资源镜像索引失败";
            packer_finished->set(true);
            packer->abort();
            
            prepare->postMessage("打包完成。");
            return_ok!;
        }
        
        // 编译并打包引擎内部着色器与项目着色器。
        //
        // 着色器编译使用 shader::load(option::none, ...)：
        //   * none 使加载器拿到空的 graphic context，不会触碰图形上下文
        //     的共享资源缓存，因此可以安全地在打包工作线程里调用；
        //   * 真正的 GPU 着色器对象在运行时绑定管线时才创建，这里只是
        //     CPU 侧的 Woolang 编译 + HLSL/SPIR-V/GLSL/MSL 生成 + 缓存写盘；
        //   * 磁盘缓存按源码 CRC 校验，源码有改动会自动重编译，保证随后
        //     打包的 .je4cache 与打包的源码一致。
        func packShaders(prepare: ModulePrepare, packer: je::internal::fimg_writer,
            working_path: path_t)
        {
            // 1. 引擎内部着色器：C++ 侧以 !/builtin/shader/internal/... 加载，
            //    必须随包携带，否则导出游戏启动时找不到这些着色器。
            let engine_root = normalize(std::host_path());
            let internal_shader_dir = engine_root / "builtin" / "shader" / "internal";
            
            prepare->postMessage(F"正在编译引擎内部着色器：{internal_shader_dir->to_string}");
            match (allsubpath(internal_shader_dir))
            {
                ok(paths)?
                {
                    for (let p : paths)
                    {
                        if (!isfile(p) || extension(p)->lower != ".shader")
                            continue;
                            
                        let pack_key = "!/builtin/shader/internal/" + filename(p);
                        try! _ = packOneShader(prepare, packer, p, pack_key);
                    }
                }
                err(_)?
                {
                    prepare->postMessage(F"无法扫描引擎内部着色器目录，跳过：{internal_shader_dir->to_string}");
                }
            }
            
            // 2. 项目着色器
            prepare->postMessage("正在编译项目着色器");
            match (allsubpath(working_path))
            {
                ok(paths)?
                {
                    for (let p : paths)
                    {
                        if (!isfile(p) || extension(p)->lower != ".shader")
                            continue;
                            
                        match (relative(p, working_path))
                        {
                            ok(rel)?
                            {
                                if (rel->len == 0 || isHiddenRelativePath(rel))
                                    continue;
                                    
                                let pack_key = ResourcePath::toRuntimeResourcePath(p);
                                if (!pack_key->begin_with("@/"))
                                {
                                    prepare->postMessage(
                                        F"跳过项目目录之外的着色器：{p->to_string}");
                                    continue;
                                }
                                
                                try! _ = packOneShader(prepare, packer, p, pack_key);
                            }
                            err(_)?;
                        }
                    }
                }
                err(_)?
                {
                    prepare->postMessage("无法扫描项目目录，跳过项目着色器");
                }
            }
            
            return_ok!;
        }
        
        // 编译一个着色器并打包源码与缓存。pack_key 同时是引擎运行时的
        // 资源路径（!/... 或 @/...），shader::load 直接用它定位源码。
        func packOneShader(prepare: ModulePrepare, packer: je::internal::fimg_writer,
            source_path: path_t, pack_key: string)
        {
            match (shader::load(option::none, pack_key))
            {
                none?
                {
                    prepare->postMessage(F"无法编译着色器，仅打包源码：{pack_key}");
                }
                value(_)?
                {
                    prepare->postMessage(F"已编译着色器：{pack_key}");
                }
            }
            
            if (!packer->pack(source_path->to_string, pack_key))
                throw! F"打包着色器源码失败：{source_path->to_string}";
                
            let cache_path = source_path->to_string + ".je4cache";
            if (isfile(normalize(cache_path)))
            {
                if (!packer->pack(cache_path, pack_key + ".je4cache"))
                    throw! F"打包着色器缓存失败：{cache_path}";
            }
            else
            {
                prepare->postMessage(F"未生成着色器缓存，跳过：{pack_key}");
            }
            
            return_ok!;
        }
        
        // 以 RELEASE 配置编译全部原生模块，并把产物动态库复制到 .export/modules。
        // 使用 build-only 入口，避免把 RELEASE 库热重载进正在运行的编辑器。
        func buildAndCopyModules(prepare: ModulePrepare, export_path: path_t,
            modules: array<(string, path_t)>)
        {
            if (modules->len == 0)
            {
                prepare->postMessage("项目中未声明原生模块，跳过模块编译。");
                return_ok!;
            }
            
            let modules_dir = export_path / "modules";
            if (!exist(modules_dir))
            {
                try! _ = mkdir(modules_dir)
                    -> or_map(\e = F"创建模块目录失败（{e}）";);
            }
            
            for (let (name, path) : modules)
            {
                prepare->postMessage(F"==== 编译模块 {name}（RELEASE） ====");
                
                try! dylib_path = ModulePrepare::configureAndBuildCppModuleDir(
                    prepare, path, name, ModulePrepare::BuildConfig::RELEASE);
                    
                let dst = modules_dir / ModulePrepare::moduleDylibFilename(name);
                prepare->postMessage(
                    F"复制模块：{dylib_path->to_string} -> {dst->to_string}");
                    
                try! _ = copy(dylib_path, dst)
                    -> or_map(\e = F"复制模块 {name} 失败（{e}）";);
            }
            
            return_ok!;
        }
        
        func isSkippedExtension(ext: string)=> bool
        {
            return ext == ".je4project"
                || ext == ".je4cache"
                || ext == ".dmp";
        }
        
        // 把 path 复制到 dst（保持目录结构），失败时抛出描述。
        func copyOrigin(path: path_t, dst: path_t)
        {
            let parent_dir = parent(dst);
            if (parent_dir->to_string->len > 0 && !exist(parent_dir))
            {
                try! _ = mkdir(parent_dir)
                    -> or_map(\e = F"创建目录失败（{e}）：{parent_dir->to_string}";);
            }
            
            try! _ = copy(path, dst)
                -> or_map(\e = F"复制文件失败（{e}）：{path->to_string}";);
                
            return_ok!;
        }
        
        // 按项目文件规则整理项目目录：脚本预编译为 WORT 二进制，动态库原样
        // 复制，其余文件打进资源镜像。着色器与 .je4cache 已在 packShaders
        // 中处理，这里跳过。
        func packProjectFiles(prepare: ModulePrepare,
            packer: je::internal::fimg_writer,
            working_path: path_t, export_path: path_t)
        {
            prepare->postMessage("正在整理项目文件……");
            
            try! paths = allsubpath(working_path)
                -> or_map(\e = F"遍历项目目录失败（{e}）";);
                
            for (let p : paths)
            {
                if (!isfile(p))
                    continue;
                    
                try! rel = relative(p, working_path)
                    -> or_map(\e = F"计算相对路径失败（{e}）：{p->to_string}";);
                    
                // 隐藏文件/目录（.export、.temp、.vscode、.git、.build*、
                // .runtime 等）整体跳过。
                if (rel->len == 0 || isHiddenRelativePath(rel))
                    continue;
                    
                let lower_rel = rel->lower;
                let ext = extension(p)->lower;
                
                if (isSkippedExtension(ext))
                    continue;
                    
                // C++ 模块源码已编译进动态库，不需要随包携带。
                if (lower_rel->find(".je4module/")->is_value)
                    continue;
                    
                // 着色器源码/缓存交由 packShaders 处理。
                if (ext == ".shader")
                    continue;
                    
                let pack_key = "@/" + rel;
                
                // 动态库需要真实文件才能被运行时加载。
                if (ext == ".dll" || ext == ".so" || ext == ".dylib")
                {
                    try! _ = copyOrigin(p, export_path / rel);
                    prepare->postMessage(F"复制 {pack_key}");
                    continue;
                }
                
                if (ext == ".wo")
                {
                    let fname = filename(p)->lower;
                    if (fname->end_with(".je.wo") || fname->end_with(".image.wo"))
                        continue;
                        
                    match (dumpling::Program::dump_file(p))
                    {
                        ok(binary)?
                        {
                            let builder = buffer::builder::create();
                            builder->appendbuffer(binary);
                            
                            if (!packer->pack_buffer(
                                    builder->ptr(0, builder->len),
                                    builder->len,
                                    pack_key))
                                throw! F"打包脚本失败：{pack_key}";
                                
                            prepare->postMessage(F"编译并打包脚本 {pack_key}");
                        }
                        err(errors)?
                        {
                            prepare->postMessage(
                                F"编译脚本失败，原样打包源码：{pack_key}");
                            prepare->postMessage(errors->to_string);
                            
                            if (!packer->pack(p->to_string, pack_key))
                                throw! F"打包脚本源码失败：{pack_key}";
                        }
                    }
                    continue;
                }
                
                if (!packer->pack(p->to_string, pack_key))
                    throw! F"打包文件失败：{pack_key}";
                    
                prepare->postMessage(F"打包 {pack_key}");
            }
            
            return_ok!;
        }
        
        // ==========================
        //  启动脚本生成
        // ==========================
        
        func generateModuleLoads(modules: array<(string, path_t)>)=> string
        {
            let mut code = "";
            for (let (name, _) : modules)
            {
                let dylib_name = ModulePrepare::moduleDylibFilename(name);
                
                code += "    match (load_module(" + name->enstring
                    + ", std::host_path() + \"/modules/\" + "
                    + dylib_name->enstring + "))\n"
                    + "    {\n"
                    + "        value(module_handle)?\n"
                    + "        {\n"
                    + "            loaded_modules->add(module_handle);\n"
                    + "        }\n"
                    + "        none?;\n"
                    + "    }\n";
            }
            return code;
        }
        
        func generateToWooLoads(func_name: string, entries: array<(string, path_t)>)=> string
        {
            let mut code = "";
            for (let (name, path) : entries)
            {
                code += "    match (je::towoo::" + func_name
                    + "(" + name->enstring + ", "
                    + ResourcePath::toRuntimeResourcePath(path)->enstring + "))\n"
                    + "    {\n"
                    + "        value(_)?;\n"
                    + "        none?\n"
                    + "        {\n"
                    + "            je::logerr(\"注册 ToWoo 类型失败：\" + "
                    + name->enstring + ");\n"
                    + "        }\n"
                    + "    }\n";
            }
            return code;
        }
        
        func generateTypeLoader(has_types_script: bool)=> string
        {
            if (!has_types_script)
                return "    // 项目中没有 resource/editor/types.wo，跳过类型序列化器装载。";
                
            return "    match (je::towoo::unsafe::dynamic_parser::update_types("
                + "\"@/resource/editor/types.wo\"))\n"
                + "    {\n"
                + "        ok(_)?;\n"
                + "        err(message)?\n"
                + "        {\n"
                + "            je::logerr(message);\n"
                + "        }\n"
                + "    }";
        }
        
        func generateWorldLoads(worlds: array<string>)=> string
        {
            let mut code = "";
            for (let world_path : worlds)
            {
                code += "    match (JEGaming::Loading::World::load(u, "
                    + world_path->enstring + "))\n"
                    + "    {\n"
                    + "        ok(w)?\n"
                    + "        {\n"
                    + "            w->set_enable(true);\n"
                    + "        }\n"
                    + "        err(message)?\n"
                    + "        {\n"
                    + "            je::logerr(message);\n"
                    + "        }\n"
                    + "    }\n";
            }
            return code;
        }
        
        func packBootScript(prepare: ModulePrepare,
            packer: je::internal::fimg_writer, settings: Settings)
        {
            prepare->postMessage("正在生成启动脚本……");
            
            try! template = Template::load(Template::Type::RUNTIME_MAIN)
                -> ok_or("读取启动脚本模板失败");
                
            let boot_source = template
                ->replace("$$LOAD_DYLIB_MODULES$$",
                    generateModuleLoads(settings.m_modules))
                ->replace("$$LOAD_TOWOO_COMPONENT$$",
                    generateToWooLoads(
                        "update_component", settings.m_towoo_components))
                ->replace("$$LOAD_TOWOO_SYSTEM$$",
                    generateToWooLoads(
                        "update_system", settings.m_towoo_systems))
                ->replace("$$LOAD_TYPE_LOADER$$",
                    generateTypeLoader(settings.m_has_types_script))
                ->replace("$$APPLY_RESOLUTION$$",
                    F"    je::internal::set_window_size({settings.m_resolution.0}, {settings.m_resolution.1});")
                ->replace("$$APPLY_TITLE$$",
                    F"    je::internal::set_window_title({settings.m_project_name->enstring});")
                ->replace("$$LOAD_WORLD_INSTANCE$$",
                    generateWorldLoads(settings.m_start_up_worlds));
                
            try! boot_binary = or_map(\e = e->to_string;) <|
                dumpling::Program::dump_source(
                    "@/builtin/main.wo", boot_source as buffer);
                    
            let builder = buffer::builder::create();
            builder->appendbuffer(boot_binary);
            
            if (!packer->pack_buffer(
                    builder->ptr(0, builder->len),
                    builder->len,
                    "@/builtin/main.wo"))
                throw! "打包启动脚本失败：@/builtin/main.wo";
                
            prepare->postMessage("已生成并打包启动脚本：@/builtin/main.wo");
            return_ok!;
        }
        
        // ==========================
        //  引擎运行时复制
        // ==========================
        
        func copyRuntimeFiles(prepare: ModulePrepare, export_path: path_t,
            settings: Settings)
        {
            let engine_root = normalize(std::host_path());
            
            // 1. 可执行文件：host_path 下与当前进程同名的文件。
            let exe_src = engine_root / filename(normalize(std::cmdlines()[0]));
            let exe_dst_name = settings.m_project_name
                + (os == Os::WINDOWS ? ".exe" | "");
            let exe_dst = export_path / exe_dst_name;
            
            prepare->postMessage(
                F"复制引擎运行时：{exe_src->to_string} -> {exe_dst_name}");
            try! _ = copy(exe_src, exe_dst)
                -> or_map(\e = F"复制引擎可执行文件失败（{e}）";);
                
            // 2. 引擎运行库。静态链接核心的构建可能没有这些动态库，缺失时只告警。
            let mut libs = []mut: vec<string>;
            libs->add(ModulePrepare::moduleDylibFilename("joyecs"));
            libs->add(ModulePrepare::moduleDylibFilename("woo"));
            libs->add(ModulePrepare::moduleDylibFilename("woort"));
            
            if (os == Os::WINDOWS)
                libs->add("OpenAL32.dll");
            else if (os == Os::MACOS)
                libs->add("libopenal.dylib");
            else
                libs->add("libopenal.so");
                
            for (let lib_name : libs)
            {
                let lib_path = engine_root / lib_name;
                if (!isfile(lib_path))
                {
                    prepare->postMessage(F"未找到运行库，跳过：{lib_name}");
                    continue;
                }
                
                try! _ = copy(lib_path, export_path / lib_name)
                    -> or_map(\e = F"复制运行库 {lib_name} 失败（{e}）";);
            }
            
            // 3. 引擎使用的第三方许可证。
            let licenses_path = engine_root / "licenses";
            if (isdir(licenses_path))
            {
                prepare->postMessage("复制第三方许可证……");
                try! _ = copy(licenses_path, export_path / "licenses")
                    -> or_map(\e = F"复制许可证目录失败（{e}）";);
            }
            
            // 4. Windows 下若项目根有 icon.ico，则替换导出程序的图标。
            if (os == Os::WINDOWS)
            {
                try! _ = applyIcon(exe_dst);
            }
                
            return_ok!;
        }
        
        func applyIcon(exe_path: path_t)
        {
            let icon_path = workpath() / "icon.ico";
            if (!isfile(icon_path))
                return_ok!;
                
            let rcedit_path = normalize(std::host_path())
                / "builtin" / "rcedit-x64.exe";
            if (!isfile(rcedit_path))
            {
                logwarn("未找到 builtin/rcedit-x64.exe，跳过设置程序图标");
                return_ok!;
            }
            
            match (process::create(rcedit_path, [
                    rcedit_path->to_string,
                    exe_path->to_string,
                    "--set-icon",
                    icon_path->to_string,
                ]))
            {
                none?
                {
                    logwarn("无法启动 rcedit 设置程序图标");
                }
                value(proc)?
                {
                    match (process::wait(proc))
                    {
                        ok(status)?
                        {
                            if (status != 0 as process::status_t)
                                logwarn(F"rcedit 设置程序图标失败，退出码：{status}");
                        }
                        err(code)?
                        {
                            logwarn(F"等待 rcedit 结束失败（{code}）");
                        }
                    }
                }
            }
            
            return_ok!;
        }
    }
}
