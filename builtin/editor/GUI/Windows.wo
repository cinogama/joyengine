import woo::std;

import je;
import je::gui;

import pkg::interface;
import pkg::try;

import Menu;
import Shortcut;

using std;
using je;
using je::gui;

namespace JEEditor::GUI::Windows
{
    public union SizeConstraints
    {
        Unlimited,
        AutoSize,
        Limited((ImVec2, ImVec2)),
    }
    
    interface! IWindows
    {
        public func getTitle(self)=> string;
        public func getAttrib(self)=> WindowsAttribute
        {
            do self;
            return WindowsAttribute::ImGuiWindowFlags_None;
        }
        public func getSizeConstraints(self)=> SizeConstraints
        {
            do self;
            return SizeConstraints::AutoSize;
        }
        public func getShortcut(self)=> option<Shortcut>
        {
            do self;
            return option::none;
        }
        public func getMenu(self)=> option<Menu>
        {
            do self;
            return option::none;
        }
        public func getSpawnPos(self)=> option<ImVec2>
        {
            do self;
            return option::none;
        }
        public func onPreClose(self)=> bool
        {
            do self;
            return true;
        }
        public func onCreate(self)=> void
        {
            do self;
        }
        public func onClose(self)=> void
        {
            do self;
        }
        
        public func run(self)=> bool;
    };
    
    using WindowsState = struct{
        m_is_unique: bool,
        m_title: string,
        
        m_closing_request: mut bool,
    }
    {
        let s_unique_window_record = {}mut: map<string, IWindows>;
        let s_windows_states = {}mut: map<IWindows, WindowsState>;
        
        func try_register_window(iw: IWindows, title: string, is_unique: bool)=> option<WindowsState>
        {
            if (is_unique)
            {
                if (s_unique_window_record->contains(title))
                    return option::none;
                s_unique_window_record->set(title, iw);
            }
            
            let window_state = WindowsState{
                m_is_unique = is_unique,
                m_title = title,
                
                m_closing_request = mut false,
            };
            s_windows_states->set(iw, window_state);
            
            return option::value(window_state);
        }
        func unregister_window(iw: IWindows)
        {
            match (s_windows_states->get(iw))
            {
                none?
                    logerr("Unexpected window instance, not registered yet.");
                value(state)?
                {
                    if (state.m_is_unique)
                    {
                        if (!s_unique_window_record->remove(state.m_title))
                            logerr(F"Unique window named `{state.m_title}` not found in s_unique_window_record.");
                    }
                    do s_windows_states->remove(iw);
                }
            }
        }

        public func isUnique(self: WindowsState)
        {
            return self.m_is_unique;
        }
        public func getTitle(self: WindowsState)
        {
            return self.m_title;
        }
        public func requestToClose(self: WindowsState)
        {
            self.m_closing_request = true;
        }
    }
    namespace IWindows
    {
        func _engine_imgui_show_job(
            i: IWindows, title: string, state: WindowsState, menu: option<Menu>, shortcut: option<Shortcut>)=> bool
        {
            let mut attrib = i->getAttrib;
            
            if (!state.m_is_unique)
                attrib += WindowsAttribute::ImGuiWindowFlags_NoSavedSettings;
                
            if (menu->is_value)
                attrib += WindowsAttribute::ImGuiWindowFlags_MenuBar;
                
            match (i->getSizeConstraints)
            {
                Unlimited?;
                AutoSize?
                    attrib += WindowsAttribute::ImGuiWindowFlags_NoResize
                        + WindowsAttribute::ImGuiWindowFlags_AlwaysAutoResize;
                Limited((min, max))?
                    SetNextWindowSizeConstraints(min, max);
            }
            
            let (show, mut open) = BeginAttrOpen(title, attrib);
            defer End();
            
            // 来自外部的关闭请求
            if (state.m_closing_request)
            {
                state.m_closing_request = false;
                open = false;
            }

            if (!open)
                open = !i->onPreClose;
                
            if (show)
            {
                match (shortcut)
                {
                    none?;
                    value(shortcut_instance)?
                        shortcut_instance->update();
                }
                
                match (menu)
                {
                    none?;
                    value(menu_instance)?
                        menu_instance->showMenuBar();
                }
                
                if (!i->run())
                    open = false;
            }
            
            return open;
        }
        func _show(i: IWindows, state: WindowsState)
        {
            let title = state.m_is_unique
                ? state.m_title
                | state.m_title->replace("$ID", F"##{JobID()}")
                ;
                
            let menu_instance = i->getMenu;
            let shortcut_instance = i->getShortcut;
            
            match (i->getSpawnPos)
            {
                none?;
                value(pos)?
                    SetNextWindowPos(pos);
            }
            
            i->onCreate();
            {
                while (i->_engine_imgui_show_job(
                        title, state, menu_instance, shortcut_instance))
                {
                    std::yield();
                }
                
                WindowsState::unregister_window(i);
            }
            i->onClose();
        }
    }
    
    public func show<T>(window_instance: T)=> option<IWindows>
    // where require!(T: IWindows);
    {
        let mut title = window_instance->getTitle;
        let is_unique = title->find("$ID")->is_none;
        
        let i = IWindows::create(window_instance);
        try! window_state = WindowsState::try_register_window(i, title, is_unique);
        
        launch_coroutine(\= i->_show(window_state););
        return option::value(i);
    }

    // 仅限特殊情况使用：
    namespace internal
    {
        public func getAllWindows()=> array<IWindows>
        {
            return WindowsState::s_windows_states->keys;
        }
        public func tryGetWindowState(iw: IWindows)=> option<WindowsState>
        {
            return WindowsState::s_windows_states->get(iw);
        }
    }
}
