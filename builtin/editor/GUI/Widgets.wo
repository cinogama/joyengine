import pkg::std;

import je;
import je::gui;
import je::towoo;
import je::towoo::types;

using std;
using je;
using je::gui;

namespace JEEditor::GUI::Widgets
{
    // 在当前行绘制“旋转圆点”加载动画并在动画右侧排版提示文本：
    // 一圈圆点绕圆心连续旋转，头部（tail=0）最亮最大、向尾部渐暗渐小，
    // 形成拖尾的彗星效果；点的位置由 sin/cos 按相位直接计算。
    public func drawBusySpinner(label: string)
    {
        let dot_count = 12;
        let radius = 8.;
        let head_angle = GetTime() * 5.;  // 旋转相位：每秒5弧度≈0.8圈

        let text_size = CalcTextSize(label);
        let cursor = GetCursorScreenPos();
        let center = (cursor.0 + radius + 2., cursor.1 + text_size.1 * 0.5);
        let draw_list = GetWindowDrawList();

        for (let mut i = 0; i < dot_count; i += 1)
        {
            let tail = i as real / dot_count as real;  // 0=头部 → 1=尾部
            let fade = 1. - tail;
            let angle = head_angle - tail * 2. * mathf::PI;

            draw_list->AddCircleFilled(
                (center.0 + mathf::cos(angle) * radius,
                    center.1 + mathf::sin(angle) * radius),
                1.1 + 1.9 * fade,
                (120, 190, 255, (70. + 185. * fade * fade) as int));
        }

        // 占位动画区域后，把提示文本排到动画右侧
        Dummy(((radius + 2.) * 2., text_size.1));
        SameLine();
        TextColored((120, 190, 255, 255), label);
    }

    // ============================================================
    // 检视面板成员编辑的两列布局辅助
    // （JEEditor::Editor::Inspector.wo 与 builtin/script/editor.wo 共用）
    //
    // 约定：检视面板在成员行的左侧绘制成员名标签列，把控件光标定位
    // 到右侧“控件列”起点后调用 dynamic_parser::edit。简单类型一个控件
    // 占满控件列即可；多行（列表/组合）编辑器先用 editColumnX 记下
    // 控件列起点，再用 beginRow / beginStepRow 让每一行“行标签 + 控件”
    // 与控件列对齐，避免各行从窗口缩进处起排、挤成一坨。
    // ============================================================

    // 仅调整光标的横/纵坐标，另一轴保持不变
    public func setCursorX(x: real)=> void
    {
        let (_, y) = GetCursorPos();
        SetCursorPos((x, y));
    }
    public func setCursorY(y: real)=> void
    {
        let (x, _) = GetCursorPos();
        SetCursorPos((x, y));
    }

    // 编辑器入口处的控件列起点（窗口坐标 X）：必须在绘制任何控件前
    // 调用（此刻调用方已把光标定位到控件列）
    public func editColumnX()=> real
    {
        return GetCursorPos().0;
    }

    // 在控件列内起一行：行标签画在 col_x 起、label_w 宽的子列内并与
    // 控件框垂直居中，控件从 col_x + label_w 起占满剩余宽度
    // （SetNextItemWidth 已设置好，控件自身的可见标签应为空）。
    // 调用后需立刻提交该行控件。
    public func beginRow(label: string, col_x: real, label_w: real)=> void
    {
        setCursorX(col_x);
        setCursorY(GetCursorPos().1 + (GetFrameHeight() - GetTextLineHeight()) * 0.5);
        TextDisabled(label);
        SameLine();
        setCursorX(col_x + label_w);
        SetNextItemWidth(GetContentRegionAvail().0);
    }

    // 同 beginRow，但用于 InputInt 这类把步进按钮画在输入框之外的
    // 控件：为框外的按钮预留右侧空间，避免被面板边缘裁掉
    public func beginStepRow(label: string, col_x: real, label_w: real)=> void
    {
        beginRow(label, col_x, label_w);
        SetNextItemWidth(GetContentRegionAvail().0 - 56.);
    }

    // 多边形顶点环编辑（Physics2D::vertex_list 与
    // Light2D::BlockShadow::block_mesh 的公共结构）：首行“顶点数”步进
    // 控件与成员名同行，其后每个顶点一行“点N + XY 输入”（物理侧要求
    // 至少 3 个顶点才能构成多边形）。返回有改动时的新顶点表，无改动
    // 返回 none。
    public func editPointRing(
        points: vec<vec2>, col_x: real, tag: string)=> option<vec<vec2>>
    {
        let mut pts = points;
        let mut changed = false;

        beginStepRow("顶点数", col_x, 56.);
        match (InputInt(F"##{tag}_count", pts->len)->>\n = n < 3 ? 3 | n;)
        {
            value(count)?
            {
                if (count != pts->len)
                {
                    pts->resize(count, (0., 0.) as vec2);
                    changed = true;
                }
            }
            none?;
        }

        for (let mut i = 0; i < pts->len; i += 1)
        {
            beginRow(F"点{i}", col_x, 56.);
            match (InputFloat2(F"##{tag}_{i}", pts[i][0], pts[i][1])->>\v = v as vec2;)
            {
                value(np)?
                {
                    // 索引结果不可变：重建顶点表替换第 i 项
                    let updated = []mut: vec<vec2>;
                    for (let mut j = 0; j < pts->len; j += 1)
                        updated->add(
                            (j == i) ? np | ((pts[j][0], pts[j][1]) as vec2));
                    pts = updated;
                    changed = true;
                }
                none?;
            }
        }

        if (changed)
            return option::value(pts);
        return option::none;
    }
}
