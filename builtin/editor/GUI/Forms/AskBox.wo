import pkg::std;

import je::gui;

import pkg::interface;

import builtin::editor::GUI::Icons;
import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Shortcut;
import builtin::editor::GUI::Theme;

using std;
using je::gui;

namespace JEEditor::GUI::Forms
{
    using AskBox = struct{
        m_title: string,
        m_text: string,
        
        m_on_yes: mut option<()=> void>,
        m_on_no: mut option<()=> void>,
        
        m_close: mut bool,
    }
    {
        public func create(title: string, text: string)=> AskBox
            where require!(AskBox: Windows::IWindows);
        {
            return AskBox{
                m_title = title,
                m_text = text,
                m_on_yes = mut option::none,
                m_on_no = mut option::none,
                m_close = mut false,
            };
        }
        
        public func getTitle(self: AskBox)=> string
        {
            return F"确认: {self.m_title}";
        }
        public func getAttrib(_: AskBox)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                + WindowsAttribute::ImGuiWindowFlags_NoSavedSettings
                ;
        }
        public func isModal(_: AskBox)=> bool
        {
            return true;
        }
        public func getShortcut(self: AskBox)=> option<Shortcut>
        {
            return option::value <|
                Shortcut::begin()
                    -> shortCut([ImGuiKey::ImGuiKey_Enter], \= self->onEnter;)
                    -> shortCut([ImGuiKey::ImGuiKey_Escape], \= self.m_close = true;)
                    -> shortCut([ImGuiKey::ImGuiKey_Backspace], \= self.m_close = true;)
                    -> finish
                    ;
        }
        // public func getSpawnPos(_: AskBox)=> option<ImVec2>
        // {
        //     return option::value(GetMousePos());
        // }
        public func onEnter(self: AskBox)
        {
            self.m_close = true;
            do self.m_on_yes->> \callback = callback();;
        }
        public func run(self: AskBox)=> bool
        {
            match(Icons::ASK)
            {
                none?;
                value(ask_icon)?
                {
                    ImageSize(ask_icon, 32., 32.);
                    SameLine();
                }
            }
            
            PushTextWrapPos(0.);
            Text(self.m_text);
            PopTextWrapPos();
            
            Spacing();
            PushStyleColor(ImGuiCol::ImGuiCol_Separator, Theme::SEPARATOR);
            Separator();
            PopStyleColor(1);

            if (Theme::ghostButton("取消", (0., 0.)))
                self.m_close = true;
                
            SameLine();
            if (Theme::ghostButton("否", (0., 0.)))
            {
                self.m_close = true;
                do self.m_on_no->> \callback = callback();;
            }
            SameLine();
            // “是”是主操作：品牌橙实心按钮，和两个次要选择明确分层
            if (Theme::primaryButton("是", (0., 0.)))
                self->onEnter();
                
            return !self.m_close;
        }
        
        public func show(title: string, text: string)
        {
            let askbox = AskBox::create(title, text);
            do Windows::show(askbox);
            return askbox;
        }
        public func onYes(self: AskBox, callback: ()=> void)
        {
            self.m_on_yes = option::value(callback);
            return self;
        }
        public func onNo(self: AskBox, callback: ()=> void)
        {
            self.m_on_no = option::value(callback);
            return self;
        }
    }
}
