import pkg::std;

import je::graphic;
import je::gui;

import pkg::interface;

import builtin::editor::GUI::Icons;
import builtin::editor::GUI::Windows;
import builtin::editor::GUI::Shortcut;

using std;
using je::gui;
using je::graphic;

namespace JEEditor::GUI::Forms
{
    using MsgBox = struct{
        m_title: string,
        m_text: string,
        m_icon: option<texture>,
        
        m_closed: mut bool,
    }
    {
        public func create(title: string, text: string, icon: option<texture>)=> MsgBox
            where require!(MsgBox: Windows::IWindows);
        {
            return MsgBox{
                m_title = title,
                m_text = text,
                m_icon = icon,
                
                m_closed = mut false,
            };
        }
        
        public func getTitle(self: MsgBox)=> string
        {
            return F"消息: {self.m_title}";
        }
        public func getAttrib(_: MsgBox)=> WindowsAttribute
        {
            return WindowsAttribute::ImGuiWindowFlags_NoDocking
                + WindowsAttribute::ImGuiWindowFlags_NoCollapse
                ;
        }
        public func isModal(_: MsgBox)=> bool
        {
            return true;
        }
        public func getShortcut(self: MsgBox)=> option<Shortcut>
        {
            return option::value <|
                Shortcut::begin()
                    -> shortCut([ImGuiKey::ImGuiKey_Enter], \=self.m_closed = true;)
                    -> finish
                    ;
        }
        // public func getSpawnPos(_: MsgBox)=> option<ImVec2>
        // {
        //     return option::value(GetMousePos());
        // }
        public func run(self: MsgBox)=> bool
        {
            match (self.m_icon)
            {
                none?;
                value(icon)?
                {
                    ImageSize(icon, 32., 32.);
                    SameLine();
                }
            }
            Text(self.m_text);
            
            if (Button("确认"))
                self.m_closed = true;
                
            return !self.m_closed;
        }
        
        public func msg(title: string, text: string)
        {
            do Windows::show(MsgBox::create(title, text, option::none));
        }
        public func err(title: string, text: string)
        {
            do Windows::show(MsgBox::create(title, text, Icons::WARNING));
        }
    }
}
