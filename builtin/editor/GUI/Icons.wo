    // 1x1 纯白纹理（RGBA 像素在创建时给定）
    public let WHITE = texture2d::create_with_pixels(1, 1,
        buffer::createui8(255)->appendui8(255)->appendui8(255)->appendui8(255));

    public let WARNING = texture2d::load(option::none, "!/builtin/icon/Warning.png");
