import woo::std;

import je::ecs;

import World;

using je;

namespace JEEditor::Inspector::Universe
{
    using UniverseCtx = struct{
        m_universe: universe,
    }
    {
        func create()
        {
            return UniverseCtx{
                m_universe = universe::create(),
            };
        }
        public func instance()=> UniverseCtx
        {
            static let _instance = create();
            
            return _instance;
        }

        public func getUniverse(self: UniverseCtx)
        {
            return self.m_universe;
        }
    };
}
