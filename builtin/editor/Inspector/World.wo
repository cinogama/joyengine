import woo::std;
import je::typeinfo;
import je::ecs;

import pkg::fsys;

import Universe;
import builtin::editor::Editor::WorldEditorViewport;

using je;
using fsys;

namespace JEEditor::Inspector::World
{
    using WorldCtx = struct{
        m_name: mut string,
        m_runtime_systems: vec<typeinfo>,

        m_saving_path: mut option<path_t>,
    }
    {
        public func create()=> WorldCtx
        {
            return WorldCtx{
                m_name = mut "<unnamed>",
                m_runtime_systems = []mut,

                m_saving_path = mut option::none,
            };
        }
    }
    /* ---------------------------------------------------------- */
}
