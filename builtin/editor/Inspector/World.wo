import woo::std;
import je;

import Universe;

using je;

namespace JEEditor::Inspector::World
{
    using WorldCtx = struct{
        m_name: mut string,
        m_runtime_systems: vec<typeinfo>,
    }
    {
        public func create()=> WorldCtx
        {
            return WorldCtx{
                m_name = mut "<unnamed>",
                m_runtime_systems = []mut,
            };
        }
    }
    /* ---------------------------------------------------------- */
    public func get_entities(w: world)=> array<entity>
    {
        return w->get_all_entities([]);
    }
    public func get_attached_systems(w: world)=> array<typeinfo>
    {
        return w->get_all_systems();
    }
    public func get_runtime_systems(w: world)=> array<typeinfo>
    {
        return Universe::UniverseCtx::instance()->world_ctx(w)
            .m_runtime_systems->to_array;
    }
    public func get_name(w: world)=> string
    {
        return Universe::UniverseCtx::instance()->world_ctx(w)
            .m_name;
    }
    public func set_name(w: world, name: string)
    {
        return Universe::UniverseCtx::instance()->world_ctx(w)
            .m_name = name;
    }
    public func close(w: world)
    {
        Universe::UniverseCtx::instance()->close_world_ctx(w);
        w->close();
    }
}
