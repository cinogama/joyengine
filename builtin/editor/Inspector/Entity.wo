import woo::std;

import pkg::worst;

import je::ecs;
import je::internal;

using je;

namespace JEEditor::Inspector::Entity
{
    public func get_name(e: entity)=> string
    {
        return e->internal::name;   
    }
    public func set_name(e: entity, name: string)
    {
        e->internal::set_name(name);
    }
}