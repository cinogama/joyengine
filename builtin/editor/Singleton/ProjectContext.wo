import woo::std;

import pkg::singleton;

import builtin::editor::Editor::Project::Context;

using JEEditor::Editor::Project;

namespace JEEditor::Singleton::ProjetContext
{
    let _instance = singleton::create(
        "JEEditor::Singleton::ProjetContext",
        0,
        \= std::mutable::create:<option<Context>>(option::none););

    public func setProjectContext(proj_ctx: Context)
    {
        _instance->apply(\u = u->set <| option::value(proj_ctx););
    }
}