import woo::std;

import je::ecs;

using je;

namespace JEEditor::Singleton
{
    using Universe = struct{
        m_universe: universe,
    }
    {
        func create()
        {
            return Universe{
                m_universe = universe::create(),
            };
        }
        public func instance()=> Universe
        {
            static let _instance = create();
            
            return _instance;
        }

        public func getUniverse(self: Universe)
        {
            return self.m_universe;
        }
    };
}
