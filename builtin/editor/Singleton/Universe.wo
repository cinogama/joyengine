import pkg::std;
import pkg::toml;
import pkg::singleton;
import pkg::interface;

import je::ecs;

import Singleton;

using je;
using toml;

namespace JEEditor::Singleton
{
    using Universe = struct{
        m_universe: universe,
    }
    {
        public let singleton_label = "universe";
        public func create_and_load(_: option<Toml>)=> Universe
            where require!(Universe: ISingleton);
        {
            return Universe{
                m_universe = universe::create(),
            };
        }
        
        let singleton = register:<Universe>();
        
        public func getUniverse()=> universe
        {
            return singleton->apply(\v = v.m_universe;);
        }
    }
}
