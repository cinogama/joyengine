import pkg::std;

import je::ecs;

import pkg::singleton;

using je;

namespace JEEditor::Singleton::Universe
{
    let _instance = singleton::create(
        "JEEditor::Singleton::Universe",
        0,
        \= std::mutable::create:<option<universe>>(option::none););
        
    public func createUniverse()=> universe
    {
        return _instance->apply(
            func(u){
                assert(u->get->is_none);

                let uni = universe::create();
                u->set <| option::value(uni);

                return uni;
            });
    }
    public func resetUniverse()
    {
        _instance->apply(
            func(u){
                assert(u->get->is_value);
                u->set <| option::none;
            });
    }
    public func getUniverse()=> universe
    {
        return _instance->apply(\u = u->get->unwrap;);
    }
}
