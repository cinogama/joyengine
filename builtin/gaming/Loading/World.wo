import pkg::std;
import pkg::async;
import pkg::toml;
import pkg::try;
import pkg::thread;

import je;
import je::ecs;
import je::typeinfo;

import builtin::gaming::Saving::World;

using std;
using toml;
using je;
using je::file;

namespace JEGaming::Loading::World
{
    // 世界级缓存：世界文件旁存在 <path>.je4cache 时，创建持有 WorldCache
    // 的引擎内部实体（配对 Editor::Invisible：不显示、不随世界存档）。
    // 缓存路径不写进世界文件，加载时按世界路径重新建立；各子系统按这个
    // 实体读取自己使用的缓存字段（如音频环境）。缓存由编辑器手动/导出时
    // 烘焙产生，缺失时子系统自行实时构建，不影响世界正常加载。
    func attachWorldCache(w: world, path: string)=> void
    {
        // 导出后缓存位于资源镜像中：用引擎文件接口探测（磁盘优先、镜像兜底）
        if (!file::exists(path + ".je4cache"))
            return;

        match (typeinfo::load("WorldCache"))
        {
            none?
                logerr("WorldCache component is not registered, world cache disabled.");
            value(world_cache_type)?
            {
                match (typeinfo::load("Editor::Invisible"))
                {
                    none?;
                    value(invisible_type)?
                    {
                        match (w->add_entity([world_cache_type, invisible_type]))
                        {
                            none?
                                logerr(F"Failed to create WorldCache entity for `{path}`.");
                            value(e)?
                            {
                                match (e->get_component(world_cache_type))
                                {
                                    none?;
                                    value(cinst)?
                                        match (cinst->get_member("cache_path"))
                                        {
                                            none?;
                                            value((mtype, maddr))?
                                                do towoo::unsafe::dynamic_parser::restore(
                                                    mtype, maddr, path + ".je4cache");
                                        }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    public func load(u: universe, path: string)=> result<world, string>
    {
        try! world_dat = readall(path)
            -> ok_or(F"Failed to load world from `{path}`.")
            =>> parse
            ;

        let w = Saving::World::restore(u, world_dat);
        attachWorldCache(w, path);
        return_ok! w;
    }
    public async! func loadAsync(u: universe, path: string)=> result<world, string>
    {
        let r = mutable::create(option::none: option<result<world, string>>);
        do thread::create(func(){
                r->set <| option::value <| World::load(u, path);
            });
            
        for (;;)
        {
            match (r->get)
            {
                none? yield!;
                value(r)?
                    return r;
            }
        }
    }
}
