import pkg::std;
import pkg::try;
import pkg::toml;
import pkg::async;
import pkg::thread;

import je;
import je::ecs;

import builtin::gaming::Saving::Entity;

using std;
using je;
using je::file;
using toml;

namespace JEGaming::Loading::Entity
{
    public func load(w: world, path: string)=> result<entity, string>
    {
        try! entity_dat = readall(path)
            -> ok_or(F"Failed to load entity from `{path}`.")
            =>> parse
            ;
            
        return Saving::Entity::restore(w, entity_dat)
            -> ok_or(F"Bad entity data of `{path}`.");
    }
}
