import pkg::std;

import pkg::toml;
import pkg::worst;
import pkg::iterator;

import je;
import je::ecs;
import je::typeinfo;
import je::internal;

import Entity;

using std;
using je;
using toml;
using iterator;

namespace JEGaming::Saving::World
{
    public func saveWithCustomEntitySaver(w: world, entity_saver: (entity)=> Toml)=> Toml
    {
        let world_dat = new_table();

        // 这里不能引用 je::towoo::components：导出启动脚本会导入本模块，
        // 而 components.wo 的顶层 typeinfo 初始化发生在 import 阶段，早于
        // 原生模块与 ToWoo 组件注册，此时查询项目类型会得到 none 并 panic。
        let invisible_type = je::typeinfo::load("Editor::Invisible");

        // Save entities
        let entities_dat = []mut: vec<mut (entity::internal::euid_t, Toml)>;
        for (let e : w->internal::get_all_entities())
        {
            let mut invisible = false;
            match (invisible_type)
            {
                value(t)? invisible = e->get_component(t)->is_value;
                none?;
            }
            if (invisible)
                continue;

            entities_dat->add(mut (
                    e->internal::get_entity_uid->or(0h as entity::internal::euid_t),
                    entity_saver(e),
                ));
        }
        sort_in_place(entities_dat, \(ida, _), (idb, _) = ida < idb;);
        
        world_dat->set("entities", from(entities_dat->> \(_, edat) = edat;));
        world_dat->set("systems", from(
                w->internal::get_all_systems->iter
                    |> map(\tinfo = tinfo->name;)
                    |> filter(\tname = !tname->begin_with("Editor::");)
                    ));
                    
        return world_dat;
    }
    public func save(w: world)=> Toml
    {
        return saveWithCustomEntitySaver(w, Entity::save);
    }
    public func restoreWithCustomEntityRestorer(
        u: universe, wdat: Toml, entity_restorer: (world, Toml)=> option<entity>)=> world
        {
        let w = world::create(u);
        
        // Restore systems.
        let systems_dat =
            wdat->get("systems")
                =>> \v = v->as_array;->or([])
                -> connect(
                    wdat->get("running_systems")
                        =>> \v = v->as_array;->or([]));
                        
        for (let sdat : systems_dat)
        {
            match (sdat->as_string=>> \tname = typeinfo::load(tname);)
            {
                none?;
                value(systype)?
                    do w->add_system(systype);
            }
        }
        
        // Restore entities.
        let entities_dat = wdat->get("entities")=>> \v = v->as_array;->or([]);
        for (let edat : entities_dat)
            do entity_restorer(w, edat);
            
        return w;
    }
    public func restore(u: universe, wdat: Toml)=> world
    {
        return restoreWithCustomEntityRestorer(u, wdat, Entity::restore);
    }
}
