import woo::std;

import pkg::toml;
import pkg::worst;

import je;
import je::ecs;
import je::typeinfo;
import je::internal;

import Entity;

using std;
using je;
using toml;

namespace JEGaming::Saving::World
{
    public func save(w: world)=> Toml
    {
        let world_dat = new_table();
        
        // Save entities
        let entities_dat = w->internal::get_all_entities([])
            ->> \e = mut (
                    e->internal::get_entity_uid->or(0h as entity::internal::euid_t),
                    Entity::save(e),
                )
                ;
            ;
        sort_in_place(entities_dat, \(ida, _), (idb, _) = ida < idb;);

        world_dat->set("entities", from(entities_dat->> \(_, edat) = edat;));
        world_dat->set("systems", from(w->internal::get_all_systems->>\tinfo = tinfo->name;));

        return world_dat;
    }
    public func restore(u: universe, wdat: Toml)=> world
    {
        let w = world::create(u);

        return w;
    }
}
