import woo::std;

import pkg::toml;
import pkg::worst;
import pkg::iterator;

import je;
import je::ecs;
import je::typeinfo;
import je::internal;

import Entity;

using std;
using je;
using toml;
using iterator;

namespace JEGaming::Saving::World
{
    public func save(w: world)=> Toml
    {
        let world_dat = new_table();
        
        // Save entities
        let entities_dat = w->internal::get_all_entities()
            ->> \e = mut (
                    e->internal::get_entity_uid->or(0h as entity::internal::euid_t),
                    Entity::save(e),
                )
                ;
            ;
        sort_in_place(entities_dat, \(ida, _), (idb, _) = ida < idb;);
        
        world_dat->set("entities", from(entities_dat->> \(_, edat) = edat;));
        world_dat->set("systems", from(
                w->internal::get_all_systems->iter
                    |> map(\tinfo = tinfo->name;)
                    |> filter(\tname = !tname->begin_with("Editor::");)
                    ));
                    
        return world_dat;
    }
    public func restore(u: universe, wdat: Toml)=> world
    {
        let w = world::create(u);
        
        // Restore systems.
        let systems_dat =
            wdat->get("systems")
                =>> \v = v->as_array;->or([])
                -> connect(
                    wdat->get("running_systems")
                        =>> \v = v->as_array;->or([]));
                        
        for (let sdat : systems_dat)
        {
            match (sdat->as_string=>> \tname = typeinfo::load(tname);)
            {
                none?;
                value(systype)?
                    do w->add_system(systype);
            }
        }
        
        // Restore entities.
        let entities_dat = wdat->get("entities")=>> \v = v->as_array;->or([]);
        for (let edat : entities_dat)
            do Entity::restore(w, edat);
            
        return w;
    }
}
