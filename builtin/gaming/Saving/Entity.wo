import woo::std;

import pkg::toml;
import pkg::try;
import pkg::worst;

import je;
import je::ecs;
import je::typeinfo;
import je::graphic;
import je::internal;

using std;
using je;
using toml;
using je::graphic;

namespace JEGaming::Saving::Entity
{
    func _save_component(cinst: component)=> Toml
    {
        let component_dat = new_table();
        for (let (mname, mtype, maddr) : cinst->get_members)
        {
            match (towoo::unsafe::dynamic_parser::save(mtype, maddr))
            {
                none?;
                value(saved_data)?
                    component_dat->set(mname, saved_data);
            }
        }
        return component_dat;
    }
    
    func _save_components(e: entity)=> Toml
    {
        let components_dat = new_table();
        for (let ctype : e->internal::get_components_types()
            /* 为了确保顺序，此处始终按照字母序排列 */
            |> sort(\l, r = l->name < r->name;))
        {
            let ctype_name = ctype->name;
            if (ctype_name->begin_with("Editor::"))
                /* Donot save editor components */
                continue;
                
            components_dat->set(
                ctype->name,
                _save_component(
                    e->get_component(ctype)->unwrap));
        }
        return components_dat;
    }
    
    func _save_shader(sinst: shader)=> option<Toml>
    {
        let shader_dat = new_table();
        
        match (sinst->path)
        {
            none?
                /* Skip builtin shader. */
                return option::none;
            value(shader_path)?
                shader_dat->set("path", shader_path);
        }
        
        for (let (uname, uinst) : sinst->get_uniforms)
        {
            match (uinst)
            {
                integer(vi)?
                    shader_dat->set(uname, vi);
                integer2((vi1, vi2))?
                    shader_dat->set(uname, from([vi1, vi2]));
                integer3((vi1, vi2, vi3))?
                    shader_dat->set(uname, from([vi1, vi2, vi3]));
                integer4((vi1, vi2, vi3, vi4))?
                    shader_dat->set(uname, from([vi1, vi2, vi3, vi4]));
                float(vr)?
                    shader_dat->set(uname, vr);
                float2((vr1, vr2))?
                    shader_dat->set(uname, from([vr1, vr2]));
                float3((vr1, vr2, vr3))?
                    shader_dat->set(uname, from([vr1, vr2, vr3]));
                float4((vr1, vr2, vr3, vr4))?
                    shader_dat->set(uname, from([vr1, vr2, vr3, vr4]));
                _?/* Ignore. */;
            }
        }
        return option::value(shader_dat);
    }
    
    func _save_shaders(e: entity)=> Toml
    {
        let shaders_dat = new_array();
        for (let sinst : e->get_shaders())
        {
            match (_save_shader(sinst))
            {
                none? /* Skip builtin shader */;
                value(shader_dat)?
                    shaders_dat->push(shader_dat);
            }
        }
        return shaders_dat;
    }
    
    func _save_textures(e: entity)=> Toml
    {
        let textures_dat = new_table();
        for (let (tpass, tinst) : e->get_textures)
        {
            match (tinst->path)
            {
                none? /* Skip builtin texture */;
                value(texture_path)?
                    textures_dat->set(tpass as string, texture_path);
            }
        }
        return textures_dat;
    }
    
    func _diff_component(ecdat: Toml, pcdat: option<Toml>)=> option<Toml>
    {
        func _compare_component_field(ecfdat: Toml, pcfdat: option<Toml>)=> option<string>
        {
            // 实体的组件成员数据必然是字符串类型
            match (pcfdat=>> \v = v->as_string;)
            {
                none?
                    return ecfdat->as_string;
                value(pcfdata)?
                    return ecfdat->as_string=>> \v = v != pcfdata ? option::value(v) | option::none;;
            }
        }
        
        let diff = new_table();
        
        let pcdata = pcdat=>> \v = v->as_table;->or({});
        for (let (fname, fdat) : ecdat->as_table->or({}))
        {
            match (_compare_component_field(fdat, pcdata->get(fname)))
            {
                none?;
                value(diff_dat)?
                    diff->set(fname, diff_dat);
            }
        }
        return diff->len > 0 ? option::value(diff) | option::none;
    }
    
    func _diff_components(
        entity_components_dat: dict<string, Toml>,
        prefab_components_dat: dict<string, Toml>)=> option<Toml>
    {
        let component_diff = new_table();
        for (let (ectype, ecdat) : entity_components_dat)
        {
            match (_diff_component(ecdat, prefab_components_dat->get(ectype)))
            {
                none?;
                value(cdiff)?
                    component_diff->set(ectype, cdiff);
            }
        }
        
        return (component_diff->len > 0)
            ? option::value(component_diff)
            | option::none;
    }
    
    func _diff_removed_components(
        entity_components_dat: dict<string, Toml>,
        prefab_components_dat: dict<string, Toml>)=> option<Toml>
    {
        let removed_components = new_array();
        for (let (pctype, _) : prefab_components_dat)
        {
            if (!entity_components_dat->contains(pctype))
                removed_components->push(pctype);
        }
        
        return removed_components->len > 0
            ? option::value(removed_components)
            | option::none
            ;
    }
    
    func _diff_textures(
        entity_textures_dat: dict<string, Toml>,
        prefab_textures_dat: dict<string, Toml>)=> option<Toml>
    {
        let diff = new_table();
        for (let (etpass, etpath) : entity_textures_dat)
        {
            let etpath_ = etpath->as_string;
            match (etpath_)
            {
                none?;
                value(path)?
                    if (prefab_textures_dat->get(etpass)=>> \v = v->as_string;->> \v = v != path;->or(true))
                        diff->set(etpass, path);
            }
        }
        return diff->len > 0
            ? option::value(diff)
            | option::none
            ;
    }
    
    func _diff_removed_textures(
        entity_textures_dat: dict<string, Toml>,
        prefab_textures_dat: dict<string, Toml>)=> option<Toml>
    {
        let removed_textures = new_array();
        for (let (_, ptpath) : prefab_textures_dat)
        {
            let ptpath_ = ptpath->as_string;
            match (ptpath_)
            {
                none?;
                value(path)?
                    if (!entity_textures_dat->contains(path)
                        || entity_textures_dat[path]->as_string->is_none)
                    {
                        removed_textures->push(path);
                    }
            }
        }
        return removed_textures->len > 0
            ? option::value(removed_textures)
            | option::none
            ;
    }
    
    func _shader_path(sdat: Toml)=> string
    {
        return sdat->get("path")=>> \v = v->as_string;->or("");
    }
    
    func _toml_value_equal(a: Toml, b: Toml)=> bool
    {
        if (a->is_int && b->is_int)
            return a->as_int->unwrap == b->as_int->unwrap;
        if (a->is_float && b->is_float)
            return a->as_float->unwrap == b->as_float->unwrap;
        if (a->is_bool && b->is_bool)
            return a->as_bool->unwrap == b->as_bool->unwrap;
        if (a->is_string && b->is_string)
            return a->as_string->unwrap == b->as_string->unwrap;
        if (a->is_array && b->is_array)
        {
            let av = a->as_array->unwrap;
            let bv = b->as_array->unwrap;
            if (av->len != bv->len)
                return false;
            for (let mut k = 0; k < av->len; k += 1)
            {
                if (!_toml_value_equal(av[k], bv[k]))
                    return false;
            }
            return true;
        }
        return false;
    }
    
    // 对「路径序列」做 LCS，返回 map：实体下标 -> 匹配到的预设体下标。
    // 未匹配的实体下标 = 新增；未匹配的预设体下标 = 删除（隐式）。
    func _align_shaders(epath: vec<string>, ppath: vec<string>)=> map<int, int>
    {
        let m = epath->len;
        let n = ppath->len;
        let stride = n + 1;
        let dp = array::create((m + 1) * stride, mut 0);
        
        for (let mut i = m - 1; i >= 0; i -= 1)
        {
            for (let mut j = n - 1; j >= 0; j -= 1)
            {
                if (epath[i] == ppath[j])
                    dp[i * stride + j] = dp[(i + 1) * stride + (j + 1)] + 1;
                else
                {
                    let down = dp[(i + 1) * stride + j];
                    let right = dp[i * stride + (j + 1)];
                    dp[i * stride + j] = down > right ? down | right;
                }
            }
        }
        
        let align = map::create:<int, int>(0);
        let mut bi = 0;
        let mut bj = 0;
        while (bi < m && bj < n)
        {
            if (epath[bi] == ppath[bj])
            {
                align->map::set(bi, bj);
                bi += 1;
                bj += 1;
            }
            else if (dp[(bi + 1) * stride + bj] >= dp[bi * stride + (bj + 1)])
                bi += 1;
            else
                bj += 1;
        }
        return align;
    }
    
    func _diff_shaders(
        entity_shaders_dat: array<Toml>,
        prefab_shaders_dat: array<Toml>)=> option<Toml>
    {
        let m = entity_shaders_dat->len;
        let n = prefab_shaders_dat->len;
        
        let epath = []mut: vec<string>;
        for (let sdat : entity_shaders_dat)
            epath->vec::add(_shader_path(sdat));
        let ppath = []mut: vec<string>;
        for (let sdat : prefab_shaders_dat)
            ppath->vec::add(_shader_path(sdat));
            
        let align = _align_shaders(epath, ppath);
        
        let result = new_array();
        let mut matched = 0;
        let mut uniform_changed = false;
        
        for (let mut i = 0; i < m; i += 1)
        {
            if (align->map::contains(i))
            {
                matched += 1;
                let j = align->map::get(i)->unwrap;
                let slot = new_table();
                slot->set("from", j);
                let psdat = prefab_shaders_dat[j];
                for (let (uname, uval) : entity_shaders_dat[i]->as_table->or({}))
                {
                    if (uname == "path")
                        continue;
                    let same = psdat->get(uname)=>> \pv = option::value(_toml_value_equal(uval, pv));->or(false);
                    if (!same)
                    {
                        slot->set(uname, uval);
                        uniform_changed = true;
                    }
                }
                result->push(slot);
            }
            else
                result->push(entity_shaders_dat[i]->clone());
        }
        
        let any_change = (matched < m) || (matched < n) || uniform_changed;
        return any_change ? option::value(result) | option::none;
    }
    
    func diff(entity_dat: Toml, prefab_entity_dat: Toml)=> Toml
    {
        let diff_dat = new_table();
        
        // Always keep the entity's own name.
        diff_dat->set("name", entity_dat["name"]);
        
        let entity_components_dat =
            entity_dat->get("components")=>> \v = v->as_table;->or({});
        let prefab_components_dat =
            prefab_entity_dat->get("components")=>> \v = v->as_table;->or({});
            
        // Components.
        do _diff_components(entity_components_dat, prefab_components_dat)
            ->> \cdiff = diff_dat->set("components", cdiff);
            ;
            
        do _diff_removed_components(entity_components_dat, prefab_components_dat)
            ->> \cdiff = diff_dat->set("removed_components", cdiff);
            ;
            
        // -- textures --
        let entity_textures_dat =
            entity_dat->get("textures")=>> \v = v->as_table;->or({});
        let prefab_textures_dat =
            prefab_entity_dat->get("textures")=>> \v = v->as_table;->or({});
            
        do _diff_textures(entity_textures_dat, prefab_textures_dat)
            ->> \tdiff = diff_dat->set("textures", tdiff);
            ;
        do _diff_removed_textures(entity_textures_dat, prefab_textures_dat)
            ->> \tdiff = diff_dat->set("removed_textures", tdiff);
            ;
            
        // -- shaders --
        let entity_shaders_dat =
            entity_dat->get("shaders")=>> \v = v->as_array;->or([]);
        let prefab_shaders_dat =
            prefab_entity_dat->get("shaders")=>> \v = v->as_array;->or([]);
            
        do _diff_shaders(entity_shaders_dat, prefab_shaders_dat)
            ->> \sdiff = diff_dat->set("shaders", sdiff);
            ;
            
        return diff_dat;
    }
    
    func load_prefab_dat_from_file(engine_path: string)=> option<Toml>
    {
        try! prefab_content = file::readall(engine_path);
        
        return parse(prefab_content)->okay;
    }
    
    public func save(e: entity)=> Toml
    {
        let toml = new_table();
        
        // 0. Save name.
        toml->set("name", e->internal::name);
        
        // 1. Walk through all components.
        toml->set("components", _save_components(e));
        
        // 2. Save shaders.
        toml->set("shaders", _save_shaders(e));
        
        // 3. Save textures.
        toml->set("textures", _save_textures(e));
        
        // 4. Calc diff by prefab data.
        match (e->internal::get_prefab_path())
        {
            none?
                return toml;
            value(prefab_path)?
            {
                let diff_dat_may_none = try!{
                    try! prefab_dat = load_prefab_dat_from_file(prefab_path);
                    
                    let diff_dat = diff(toml, prefab_dat);
                    diff_dat->set("prefab", prefab_path);
                    
                    return_value! diff_dat;
                };
                
                match (diff_dat_may_none)
                {
                    value(diff_dat)?
                        return diff_dat;
                    none?
                        // 尽管无法读取预设体数据，但是依然保留预设体关系
                        toml->set("prefab", prefab_path);
                }
            }
        }
        return toml;
    }
}
