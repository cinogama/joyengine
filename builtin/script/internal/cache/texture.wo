// 图片纹理缓存生成器：把图片解码后的像素与 <图片路径>.je4texture 属性源
// 文件（TOML，可选）中的设置，一同写入引擎可直接使用的二进制缓存文档
//（je_cache_binary_* 格式）。
//
// 由引擎在 <图片路径>.je4cache 缺失或失效时加载，调用 generate：
//   cache  —— C 侧创建好的缓存写入器（文件头已写入，校验码为图片与属性
//             源文件内容连续计算的 CRC64）
//   source —— 图片的引擎路径（@/ 或 !/）
//
// 图片经 je::file::readall 读取字节、pkg::image 解码（image::frombuffer），
// 像素用 image::pixels 取出（RGBA8，行序与 getpix 坐标一致，即自底向上，
// 与纹理像素缓冲约定相同），经 binary_writer::append_buffer 写入。
//
// 缓存像素默认按 GPU 支持的 BC1/BC3 块压缩存储（属性源文件
// pixel_format = "compressed"，也是默认值）：全部像素不透明时用 BC1
//（8 字节/块），存在半透明像素时用 BC3（16 字节/块，带 8 位 alpha）。
// 压缩由 je::cache::choose_texture_bc_format / compress_texture_bc 完成，
// 块数据可以直接交给图形库上传。属性源文件声明 pixel_format = "raw" 时
// 存储原始 RGBA8。
//
// 文档结构与 src/jeecs_graphic_api_basic.cpp 的读取逻辑一一对应：
//   DOCUMENT
//     "width"       -> INT32
//     "height"      -> INT32
//     "color_space" -> INT32（0 = sRGB，1 = Linear）
//     "format"      -> INT32（0 = RGBA8，1 = BC1，2 = BC3）
//     "pixels"      -> BUFFER（对应 format 的像素/块数据，行序自底向上；
//                             非压缩为 宽 * 高 * 4 字节，BC1/BC3 为
//                             ceil(宽/4) * ceil(高/4) * 8/16 字节）

import pkg::std;
import pkg::buffer;
import pkg::image;
import pkg::toml;

import je;
import je::cache;

using std;
using buffer;
using toml;

// 读取 <图片路径>.je4texture 中的颜色空间与是否压缩缓存像素，返回
// (color_space, compressed)。属性源文件是可选的：文件不存在或键缺失时用
// 默认值（sRGB、压缩）；文件存在但无法解析时返回 none。
func load_settings(source: string)=> option<(int, bool)>
{
    let settings_path = source + ".je4texture";

    let mut color_space = 0;
    let mut compressed = true;
    match (je::file::readall(settings_path))
    {
        value(text)?
        {
            match (toml::parse(text))
            {
                ok(root)?
                {
                    match (root["color_space"]->as_string)
                    {
                        value(name)?
                        {
                            if (name->lower == "linear")
                                color_space = 1;
                        }
                        none?;
                    }
                    // 只有显式的 raw 关闭压缩；其他取值（含键缺失）都按默认的
                    // 压缩处理。
                    match (root["pixel_format"]->as_string)
                    {
                        value(name)?
                        {
                            if (name->lower == "raw")
                                compressed = false;
                        }
                        none?;
                    }
                }
                err(msg)?
                {
                    je::logerr(F"无法解析纹理属性 TOML 文件 {settings_path}：{msg}");
                    return option::none;
                }
            }
        }
        none?;
    }
    return option::value((color_space, compressed));
}

extern func generate(
    cache: je::cache::binary_writer, source: string)=> bool
{
    let mut content = option::none: option<string>;
    match (je::file::readall(source))
    {
        value(data)? content = option::value(data);
        none?
        {
            je::logerr(F"无法读取图片文件 {source}");
            return false;
        }
    }

    // readall 返回 string（字节内容），frombuffer 需要 buffer 类型。
    let filedata = buffer::builder::fromstring(content->unwrap);

    let mut decoded = option::none: option<image>;
    match (image::frombuffer(filedata->peekbuffer(0, filedata->len)))
    {
        value(decoded_image)? decoded = option::value(decoded_image);
        none?
        {
            je::logerr(F"无法解码图片文件 {source}");
            return false;
        }
    }
    let decoded_image = decoded->unwrap;

    let mut color_space = 0;
    let mut compressed = true;
    match (load_settings(source))
    {
        value(settings)?
        {
            let (space, use_compressed) = settings;
            color_space = space;
            compressed = use_compressed;
        }
        none? return false;
    }

    let (width, height) = decoded_image->size;

    // 0 = RGBA8，1 = BC1，2 = BC3（与 C 侧读取逻辑一致）
    let mut cache_format = 0;
    let mut pixels = decoded_image->pixels;

    if (compressed)
    {
        cache_format =
            je::cache::choose_texture_bc_format(pixels, width, height);
        match (je::cache::compress_texture_bc(
            pixels, width, height, cache_format))
        {
            value(block_data)? pixels = block_data;
            none?
            {
                je::logerr(F"无法压缩图片纹理 {source}");
                return false;
            }
        }
    }

    if (!cache->append_document())
        return false;
    if (!cache->append_string("width") || !cache->append_int32(width))
        return false;
    if (!cache->append_string("height") || !cache->append_int32(height))
        return false;
    if (!cache->append_string("color_space") || !cache->append_int32(color_space))
        return false;
    if (!cache->append_string("format") || !cache->append_int32(cache_format))
        return false;
    if (!cache->append_string("pixels") || !cache->append_buffer(pixels))
        return false;
    return cache->append_end();
}
