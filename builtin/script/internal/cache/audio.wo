// 音频缓存生成器：把音频文件解码后的 PCM 波形数据转换为 .je4audio 指定的
// 缓存格式（缺省 8 位整数），与流式播放配置一同写入引擎可直接使用的二进制
// 缓存文档（je_cache_binary_* 格式）。
//
// 由引擎在 <音频路径>.je4cache 缺失或失效时加载，调用 generate：
//   cache  —— C 侧创建好的缓存写入器（文件头已写入，校验码为音频文件与
//             属性源文件内容连续计算的 CRC64）
//   source —— 音频的引擎路径（@/ 或 !/）
//
// 音频经 je::file::readall 读取字节、pkg::audio 解码
//（audio::frombuffer，保持 @/!/fimg 的引擎路径解析），再按配置经
// wav::pcm_as 转换为目标编码（声道数与帧数不变，样本值钳制到 [-1, 1]），
// 经 binary_writer::append_buffer 写入。仅支持单声道/立体声（OpenAL 的
// 缓冲格式约束）；其它声道数在生成期报错，不写缓存。
//
// 文档结构与 src/jeecs_audio_impl_openal.cpp 的读取逻辑一一对应
//（bits / is_float 描述转换后实际存储的 PCM）：
//   DOCUMENT
//     "channels"   -> INT32
//     "samplerate" -> INT32
//     "bits"       -> INT32（存储位数：8/16 整数或 32）
//     "is_float"   -> BOOL（true = 32位 IEEE 浮点）
//     "streaming"  -> BOOL（true = 应以流式方式播放）
//     "pcm"        -> BUFFER（转换后的交织 PCM，帧数 = len / (channels * bits/8)）

import pkg::std;
import pkg::buffer;
import pkg::audio;
import pkg::toml;

import je;
import je::cache;

using std;
using buffer;
using toml;

// 读取 <音频路径>.je4audio 的配置：
//   streaming —— 流式播放（bool，缺省 false）
//   format    —— 缓存格式 "i8" / "i16" / "f32"（缺省 "i8"，优先 8 位音频）
// 属性源文件是可选的：文件不存在或键缺失时用默认值；文件无法解析或
// format 取值未知时返回 none（配置错误应中止生成，而不是悄悄降级）。
func load_settings(source: string)=> option<(bool, int, bool)>
{
    let settings_path = source + ".je4audio";

    let mut streaming = false;
    let mut bits = 8;
    let mut is_float = false;

    match (je::file::readall(settings_path))
    {
        value(text)?
        {
            match (toml::parse(text))
            {
                ok(root)?
                {
                    match (root["streaming"]->as_bool)
                    {
                        value(flag)? streaming = flag;
                        none?;
                    }

                    match (root["format"]->as_string)
                    {
                        value(name)?
                        {
                            if (name->lower == "i16")
                            {
                                bits = 16;
                            }
                            else if (name->lower == "f32")
                            {
                                bits = 32;
                                is_float = true;
                            }
                            else if (name->lower != "i8")
                            {
                                je::logerr(F"未知的音频缓存格式 {name}（{settings_path}，应为 i8/i16/f32）");
                                return option::none;
                            }
                        }
                        none?;
                    }
                }
                err(msg)?
                {
                    je::logerr(F"无法解析音频属性 TOML 文件 {settings_path}：{msg}");
                    return option::none;
                }
            }
        }
        none?;
    }
    return option::value((streaming, bits, is_float));
}

extern func generate(
    cache: je::cache::binary_writer, source: string)=> bool
{
    let mut content = option::none: option<string>;
    match (je::file::readall(source))
    {
        value(data)? content = option::value(data);
        none?
        {
            je::logerr(F"无法读取音频文件 {source}");
            return false;
        }
    }

    // readall 返回 string（字节内容），frombuffer 需要 buffer 类型。
    let filedata = buffer::builder::fromstring(content->unwrap);

    let mut decoded = option::none: option<audio::wav>;
    match (audio::frombuffer(filedata->peekbuffer(0, filedata->len)))
    {
        ok(wav)? decoded = option::value(wav);
        err(errno)?
        {
            je::logerr(F"无法解码音频文件 {source}（错误码 {errno as int}）");
            return false;
        }
    }
    let wav = decoded->unwrap;

    if (wav->channels != 1 && wav->channels != 2)
    {
        je::logerr(F"不支持的音频声道数 {wav->channels}（{source}，仅支持单声道/立体声）");
        return false;
    }

    let mut streaming = false;
    let mut bits = 8;
    let mut is_float = false;
    match (load_settings(source))
    {
        value(settings)?
        {
            let (setting_streaming, setting_bits, setting_is_float) = settings;
            streaming = setting_streaming;
            bits = setting_bits;
            is_float = setting_is_float;
        }
        none? return false;
    }

    if (!cache->append_document())
        return false;
    if (!cache->append_string("channels") || !cache->append_int32(wav->channels))
        return false;
    if (!cache->append_string("samplerate") || !cache->append_int32(wav->samplerate))
        return false;
    if (!cache->append_string("bits") || !cache->append_int32(bits))
        return false;
    if (!cache->append_string("is_float") || !cache->append_bool(is_float))
        return false;
    if (!cache->append_string("streaming") || !cache->append_bool(streaming))
        return false;
    if (!cache->append_string("pcm") || !cache->append_buffer(wav->pcm_as(bits, is_float)))
        return false;
    return cache->append_end();
}
