// =============================================
// 这个脚本用于向编辑器提供各类型的编辑拓展
// （edit；各类型的序列化拓展见同目录 types.wo）
// 此脚本如果存在错误，项目将无法被编辑器载入
//
// 成员编辑的两列布局约定（与检视面板 Inspector.wo 约定，辅助函数见
// JEEditor::GUI::Widgets）：调用方在成员行左侧绘制成员名标签列，把
// 控件光标定位到右侧“控件列”起点后调用 edit。简单类型一个控件占满
// 控件列；多行（列表/组合）编辑器先用 Widgets::editColumnX 记下控件
// 列起点，再用 Widgets::beginRow / beginStepRow 逐行对齐（行标签在
// 左、控件在右），不再各行从窗口缩进处起排。
// =============================================

namespace bool
{
    using parser = void
    {
        public extern func edit(val: bool, tag: string)=> option<bool>
        {
            return CheckBox(F"##{tag}", val);
        }
    }
}
