                none?
                    return option::none;
                value(points)?
                    return option::value(points->to_array as Light2D::BlockShadow::block_mesh);
            }
        }
    }
}
// Light2D::Range::light_shape：范围光的同心环多边形（layer-major：
// positions 为 [ilayer * m_point_count + ipoint]，strengths 每环一项）。
namespace Light2D::Range::light_shape
{
    using parser = void
    {
        public extern func edit(val: Light2D::Range::light_shape, tag: string)=> option<Light2D::Range::light_shape>
        {
            let mut point_count = val.m_point_count;
            let mut strengths = (val.m_strength)->to_vec;
            let mut positions = (val.m_positions)->to_vec;
            let mut need_update = false;
            let col_x = Widgets::editColumnX();

            // 每环顶点数（环至少 3 个顶点才能构成多边形），首行与成员名同行
            Widgets::beginStepRow("每环顶点数", col_x, 84.);
            match (InputInt(F"##{tag}_pcount", point_count)->>\n = n < 3 ? 3 | n;)
            {
                value(count)?
                {
                    if (count != point_count)
                    {
                        point_count = count;
                        positions->resize(strengths->len * count, (0., 0.) as vec2);
                        need_update = true;
                    }
                }
                none?;
            }

            // 环数（每环一个强度；改变环数时同步伸缩 positions）
            Widgets::beginStepRow("环数", col_x, 84.);
            match (InputInt(F"##{tag}_rings", strengths->len)->>\n = n < 1 ? 1 | n;)
            {
                value(count)?
                {
                    if (count != strengths->len)
                    {
                        let old_len = strengths->len;
                        strengths->resize(count, 1. as float);
                        let newpos = []mut: vec<vec2>;
                        for (let mut l = 0; l < count; l += 1)
                            for (let mut p = 0; p < point_count; p += 1)
                                newpos->add((l < old_len)
                                    ? positions[l * point_count + p]
                                    | ((0., 0.) as vec2));
                        positions = newpos;
                        need_update = true;
                    }
                }
                none?;
            }

            for (let mut l = 0; l < strengths->len; l += 1)
            {
                Widgets::beginRow(F"环{l} 强度", col_x, 84.);
                match (InputFloat(F"##{tag}_st{l}", strengths[l]))
                {
                    value(ns)?
                    {
                        // 索引结果不可变：重建强度表替换第 l 项
                        let updated = []mut: vec<float>;
                        for (let mut j = 0; j < strengths->len; j += 1)
                            updated->add((j == l) ? (ns as float) | strengths[j]);
                        strengths = updated;
                        need_update = true;
                    }
                    none?;
                }
            }

            for (let mut i = 0; i < positions->len; i += 1)
            {
                Widgets::beginRow(F"环{i / point_count} 点{i % point_count}", col_x, 84.);
                match (InputFloat2(F"##{tag}_pos{i}", positions[i][0], positions[i][1])->>\v = v as vec2;)
                {
                    value(np)?
                    {
                        // 索引结果不可变：重建位置表替换第 i 项
                        let updated = []mut: vec<vec2>;
                        for (let mut j = 0; j < positions->len; j += 1)
                            updated->add((j == i) ? np | positions[j]);
                        positions = updated;
                        need_update = true;
                    }
                    none?;
                }
            }

            if (need_update)
                return option::value(Light2D::Range::light_shape{
                    m_point_count = point_count,
                    m_strength = strengths->to_array,
                    m_positions = positions->to_array,
                });
            return option::none;
        }
    }
}
// Particle::color_gradient：粒子颜色随生命周期（0~1）的 RGBA 渐变。
// 编辑器首行绘制渐变预览条，其下“关键帧数”一行；每个关键帧占两行：
// “时间N”（0~1）一行、“颜色N”（RGBA）一行，全部对齐控件列。
// 关键帧应按时间升序排列（运行时按升序采样）。
namespace Particle::color_gradient
{
    // 钳制到 [0,1]
    func clamp01(v: real)=> real
    {
        return (v < 0.) ? 0. | ((v > 1.) ? 1. | v);
    }
    // 按关键帧插值采样（与引擎侧 color_gradient::sample 一致）
    func sample(times: vec<float>, colors: vec<vec4>, t: real)=> vec4
    {
        let count = times->len;
        if (count == 0 || colors->len == 0)
            return (1., 1., 1., 1.) as vec4;
        if (count == 1 || t <= times[0] as real)
            return colors[0];
        if (t >= times[count - 1] as real)
            return colors[count - 1];
        for (let mut i = 1; i < count; i += 1)
        {
            if (t <= times[i] as real)
            {
                let t0 = times[i - 1] as real;
                let t1 = times[i] as real;
                let span = t1 - t0;
                let k = (span > 0.) ? (t - t0) / span | 0.;
                let c0 = colors[i - 1];
                let c1 = colors[i];
                return (
                    c0.0 + (c1.0 - c0.0) * k,
                    c0.1 + (c1.1 - c0.1) * k,
                    c0.2 + (c1.2 - c0.2) * k,
                    c0.3 + (c1.3 - c0.3) * k) as vec4;
            }
        }
        return colors[count - 1];
    }
    // 颜色分量转 0~255 的 ImGui 颜色分量
    func to8(v: real)=> int
    {
        let c = clamp01(v) * 255.;
        return (c < 0.) ? 0 | ((c > 255.) ? 255 | (c + 0.5) as int);
    }
    // 替换第 i 项（vec 索引结果不可变，重建表替换）
    func replace_at(src: vec<float>, i: int, v: float)=> vec<float>
    {
        let updated = []mut: vec<float>;
        for (let mut j = 0; j < src->len; j += 1)
            updated->add((j == i) ? v | src[j]);
        return updated;
    }
    func replace_color_at(src: vec<vec4>, i: int, v: vec4)=> vec<vec4>
    {
        let updated = []mut: vec<vec4>;
        for (let mut j = 0; j < src->len; j += 1)
            updated->add((j == i) ? v | src[j]);
        return updated;
    }

    using parser = void
    {
        public extern func edit(val: Particle::color_gradient, tag: string)=> option<Particle::color_gradient>
        {
            let mut times = (val.m_times)->to_vec;
            let mut colors = (val.m_colors)->to_vec;
            let mut need_update = false;
            let col_x = Widgets::editColumnX();

            // 渐变预览条：24 段色带按关键帧插值着色，并推进布局光标
            let draw_list = GetWindowDrawList();
            let bar_pos = GetCursorScreenPos();
            let bar_w = GetContentRegionAvail().0;
            let bar_h = 12.;
            for (let mut i = 0; i < 24; i += 1)
            {
                let t = i as real / 24.;
                let c = sample(times, colors, t);
                let x0 = bar_pos.0 + bar_w * t;
                let x1 = bar_pos.0 + bar_w * ((i + 1) as real / 24.);
                do draw_list->AddRectFilled(
                    (x0, bar_pos.1),
                    (x1, bar_pos.1 + bar_h),
                    (to8(c.0), to8(c.1), to8(c.2), to8(c.3)));
            }
            do Dummy((0., bar_h + 6.));

            // 关键帧数（至少 1 帧），首行与成员名同行
            Widgets::beginStepRow("关键帧数", col_x, 72.);
            match (InputInt(F"##{tag}_count", times->len)->>\n = n < 1 ? 1 | n;)
            {
                value(count)?
                {
                    if (count != times->len)
                    {
                        times->resize(count, 1. as float);
                        colors->resize(count, (1., 1., 1., 1.) as vec4);
                        need_update = true;
                    }
                }
                none?;
            }

            // 每个关键帧两行：时间（0~1）、颜色（RGBA）
            for (let mut i = 0; i < times->len; i += 1)
            {
                Widgets::beginRow(F"时间{i}", col_x, 72.);
                match (InputFloat(F"##{tag}_t{i}", times[i] as real)->>\t = clamp01(t);)
                {
                    value(nt)?
                    {
                        times = replace_at(times, i, nt as float);
                        need_update = true;
                    }
                    none?;
                }

                Widgets::beginRow(F"颜色{i}", col_x, 72.);
                match (InputFloat4(
                        F"##{tag}_c{i}",
                        colors[i][0] as real, colors[i][1] as real,
                        colors[i][2] as real, colors[i][3] as real)->>\v = v as vec4;)
                {
                    value(nc)?
                    {
                        colors = replace_color_at(colors, i, nc);
                        need_update = true;
                    }
                    none?;
                }
            }

            if (need_update)
                return option::value(Particle::color_gradient{
                    m_times = times->to_array,
                    m_colors = colors->to_array,
                });
            return option::none;
        }
    }
}
// Particle::scalar_curve：粒子标量（如尺寸）随生命周期（0~1）的
// (时间, 数值) 关键帧曲线。编辑器首行绘制归一化曲线预览，其下
// “关键帧数”一行；每个关键帧一行“关键帧N”的时间与数值输入。
// 关键帧应按时间升序排列（运行时按升序采样）。
namespace Particle::scalar_curve
{
    // 按关键帧插值采样（与引擎侧 scalar_curve::sample 一致）
    func sample(keys: vec<vec2>, t: real)=> real
    {
        let count = keys->len;
        if (count == 0)
            return 1.;
        if (count == 1 || t <= keys[0][0] as real)
            return keys[0][1] as real;
        if (t >= keys[count - 1][0] as real)
            return keys[count - 1][1] as real;
        for (let mut i = 1; i < count; i += 1)
        {
            if (t <= keys[i][0] as real)
            {
                let k0 = keys[i - 1];
                let k1 = keys[i];
                let span = k1[0] as real - k0[0] as real;
                let k = (span > 0.) ? (t - k0[0] as real) / span | 0.;
                return k0[1] as real + (k1[1] as real - k0[1] as real) * k;
            }
        }
        return keys[count - 1][1] as real;
    }
    // 替换第 i 项（vec 索引结果不可变，重建表替换）
    func replace_at(src: vec<vec2>, i: int, v: vec2)=> vec<vec2>
    {
        let updated = []mut: vec<vec2>;
        for (let mut j = 0; j < src->len; j += 1)
            updated->add((j == i) ? v | src[j]);
        return updated;
    }

    using parser = void
    {
        public extern func edit(val: Particle::scalar_curve, tag: string)=> option<Particle::scalar_curve>
        {
            let mut keys = (val.m_keys)->to_vec;
            let mut need_update = false;
            let col_x = Widgets::editColumnX();

            // 曲线预览：以最大绝对值为纵轴归一化绘制折线，并推进布局光标
            let mut vabs_max = 0.001;
            for (let k : keys)
            {
                let kv = k[1] as real;
                let a = (kv < 0.) ? -kv | kv;
                if (a > vabs_max)
                    vabs_max = a;
            }

            let draw_list = GetWindowDrawList();
            let plot_pos = GetCursorScreenPos();
            let plot_w = GetContentRegionAvail().0;
            let plot_h = 22.;
            do draw_list->AddRect(
                (plot_pos.0, plot_pos.1),
                (plot_pos.0 + plot_w, plot_pos.1 + plot_h),
                (90, 90, 90, 255), 1.);
            do draw_list->AddLine(
                (plot_pos.0, plot_pos.1 + plot_h * 0.5),
                (plot_pos.0 + plot_w, plot_pos.1 + plot_h * 0.5),
                (70, 70, 70, 255), 1.);
            for (let mut i = 0; i < 28; i += 1)
            {
                let t0 = i as real / 28.;
                let t1 = (i + 1) as real / 28.;
                let v0 = sample(keys, t0) / vabs_max * 0.5 + 0.5;
                let v1 = sample(keys, t1) / vabs_max * 0.5 + 0.5;
                do draw_list->AddLine(
                    (plot_pos.0 + plot_w * t0, plot_pos.1 + plot_h * (1. - v0)),
                    (plot_pos.0 + plot_w * t1, plot_pos.1 + plot_h * (1. - v1)),
                    (240, 200, 90, 255), 2.);
            }
            do Dummy((0., plot_h + 6.));

            // 关键帧数（至少 1 帧），首行与成员名同行
            Widgets::beginStepRow("关键帧数", col_x, 72.);
            match (InputInt(F"##{tag}_count", keys->len)->>\n = n < 1 ? 1 | n;)
            {
                value(count)?
                {
                    if (count != keys->len)
                    {
                        keys->resize(count, (1., 1.) as vec2);
                        need_update = true;
                    }
                }
                none?;
            }

            // 每个关键帧一行：时间与数值
            for (let mut i = 0; i < keys->len; i += 1)
            {
                Widgets::beginRow(F"关键帧{i}", col_x, 72.);
                match (InputFloat2(
                        F"##{tag}_k{i}", keys[i][0] as real, keys[i][1] as real)->>\v = v as vec2;)
                {
                    value(nk)?
                    {
                        let t = (nk.0 < 0.) ? 0. | nk.0;
                        keys = replace_at(keys, i, (t, nk.1) as vec2);
                        need_update = true;
                    }
                    none?;
                }
            }

            if (need_update)
                return option::value(Particle::scalar_curve{
                    m_keys = keys->to_array,
                });
            return option::none;
        }
    }
}
// Animation::FrameAnimation::animation_list：帧动画引用表（运行时结构见
// jeecs.hpp 的 Animation::FrameAnimation）。每个条目引用一个 .je4animation
// 文件（m_path 为 @/ 运行时相对路径），并可指定载入后自动播放的动作与循环。
namespace Animation::FrameAnimation::animation_list
{
    // 动作名缓存（runtime_path -> 动作名表 / 文件最后写入时间）：
    // .je4animation 可能正在动画编辑器中被修改，以时间戳判断缓存失效。
    let mut s_action_names_cache = {}mut: map<string, array<string>>;
    let mut s_action_names_stamp = {}mut: map<string, int>;

    // 读取动画文件中的动作名列表；文件缺失或无法解析时返回空表。
    func read_action_names(runtime_path: string)=> array<string>
    {
        if (runtime_path == "")
        {
            let empty = []mut: vec<string>;
            return empty->to_array;
        }

        let local_path = ResourcePath::toLocalResourcePath(runtime_path);
        let mut stamp = -1;
        match (fsys::lastwrite(local_path))
        {
            value(t)? stamp = t as int;
            none?;
        }

        match (s_action_names_stamp->get(runtime_path))
        {
            value(cached)?
            {
                if (cached == stamp)
                {
                    match (s_action_names_cache->get(runtime_path))
                    {
                        value(names)? return names;
                        none?;
                    }
                }
            }
            none?;
        }

        let mut names = []mut: vec<string>;
        match (JEEditor::Editor::Animation2D::AnimationContext::open(local_path))
        {
            ok(ctx)? names = ctx->action_names->to_vec;
            err(_)?;
        }

        let arr = names->to_array;
        s_action_names_cache->set(runtime_path, arr);
        s_action_names_stamp->set(runtime_path, stamp);
        return arr;
    }

    // 以下 entry_* 辅助：struct 成员不可变，修改单个字段需重建整个条目
    func entry_with_path(entry: Animation::FrameAnimation::animation_state, path: string)=> Animation::FrameAnimation::animation_state
    {
        return Animation::FrameAnimation::animation_state{
            m_path = path,
            m_action = entry.m_action,
            m_loop = entry.m_loop,
        };
    }
    func entry_with_action(entry: Animation::FrameAnimation::animation_state, action: option<string>)=> Animation::FrameAnimation::animation_state
    {
        return Animation::FrameAnimation::animation_state{
            m_path = entry.m_path,
            m_action = action,
            m_loop = entry.m_loop,
        };
    }
    func entry_with_loop(entry: Animation::FrameAnimation::animation_state, loop_flag: bool)=> Animation::FrameAnimation::animation_state
    {
        return Animation::FrameAnimation::animation_state{
            m_path = entry.m_path,
            m_action = entry.m_action,
            m_loop = loop_flag,
        };
    }
    // 替换第 i 项（vec 没有原地 set，remove + insert 换入）
    func replace_entry(entries: vec<Animation::FrameAnimation::animation_state>, i: int, entry: Animation::FrameAnimation::animation_state)=> void
    {
        do entries->remove(i);
        do entries->insert(i, entry);
    }

    using parser = void
    {
        public extern func edit(val: Animation::FrameAnimation::animation_list, tag: string)=> option<Animation::FrameAnimation::animation_list>
        {
            let mut entries = (val as array<Animation::FrameAnimation::animation_state>)->to_vec;
            let mut need_update = false;
            let col_x = Widgets::editColumnX();

            // 动画条目数，首行与成员名同行
            Widgets::beginStepRow("动画数", col_x, 56.);
            match (InputInt(F"##{tag}_count", entries->len)->>\n = n < 0 ? 0 | n;)
            {
                value(count)?
                {
                    if (count != entries->len)
                    {
                        entries->resize(count, Animation::FrameAnimation::animation_state{
                            m_path = "",
                            m_action = option::none,
                            m_loop = false,
                        });
                        need_update = true;
                    }
                }
                none?;
            }

            // 每个条目占两行：“文件 + 移除”一行，“动作 + 循环”一行
            for (let mut i = 0; i < entries->len; i += 1)
            {
                // 1) 动画文件：从资源浏览器拖入 .je4animation；字段右缘
                //    紧邻的 × 只清除引用，行末的 × 移除整个条目
                let mut cur_local = option::none: option<fsys::path_t>;
                if (entries[i].m_path != "")
                    cur_local = option::value(ResourcePath::toLocalResourcePath(entries[i].m_path));

                Widgets::beginRow(F"文件{i}", col_x, 56.);
                // 行末还要放“移除条目”× 按钮，为它预留右侧空间
                match (FileDrop::FileTrailing(F"##{tag}_file{i}", cur_local, 32.))
                {
                    none?;
                    value(p)?
                    {
                        let mut new_path = "";
                        match (p)
                        {
                            value(lp)? new_path = ResourcePath::toRuntimeResourcePath(lp);
                            none?;
                        }
                        // 换文件/清除后原动作引用不再可靠，一并清空
                        replace_entry(entries, i,
                            entry_with_path(entry_with_action(entries[i], option::none: option<string>), new_path));
                        need_update = true;
                    }
                }
                SameLine();
                if (ButtonSize(F"×##{tag}_{i}", (22., 0.)))
                {
                    do entries->remove(i);
                    // 回退索引并跳过本条目余下行，让递增后仍指向原第 i+1 项
                    i -= 1;
                    need_update = true;
                    continue;
                }
                else
                {
                    if (IsItemHovered())
                        do SetTooltip("移除该动画条目");
                }

                // 2) 载入后自动播放的动作：Combo 列出文件中的动作名；
                //    当前动作不在文件中时附加标注项展示，避免值被静默丢弃
                let file_names = read_action_names(entries[i].m_path);
                let mut cur_action = "";
                match (entries[i].m_action)
                {
                    value(a)? cur_action = a;
                    none?;
                }

                let mut raw_names = []mut: vec<string>;
                let mut disp = []mut: vec<string>;
                raw_names->add("");
                disp->add("（不自动播放）");
                let mut sel = 0;
                for (let n : file_names)
                {
                    raw_names->add(n);
                    disp->add(n);
                    if (n == cur_action)
                        sel = raw_names->len - 1;
                }
                if (cur_action != "" && sel == 0)
                {
                    raw_names->add(cur_action);
                    disp->add(F"{cur_action}（文件中不存在）");
                    sel = raw_names->len - 1;
                }

                Widgets::beginRow(F"动作{i}", col_x, 56.);
                // 同行还要放“循环”开关，为其预留右侧空间
                SetNextItemWidth(GetContentRegionAvail().0 - 74.);
                match (Combo(F"##{tag}_act{i}", disp->to_array, option::value(sel)))
                {
                    value(idx)?
                    {
                        let picked = raw_names->get_or(idx, "");
                        let mut act = option::none: option<string>;
                        if (picked != "")
                            act = option::value(picked);
                        replace_entry(entries, i, entry_with_action(entries[i], act));
                        need_update = true;
                    }
                    none?;
                }

                // 3) 循环开关
                SameLine();
                match (CheckBox(F"循环##{tag}_loop{i}", entries[i].m_loop))
                {
                    value(l)?
                    {
                        replace_entry(entries, i, entry_with_loop(entries[i], l));
                        need_update = true;
                    }
                    none?;
                }
            }

            if (entries->len == 0)
            {
                Widgets::setCursorX(col_x);
                do TextDisabled("无动画条目，点击上方“动画数”的 + 添加");
            }

            if (need_update)
                return option::value(entries->to_array as Animation::FrameAnimation::animation_list);
            return option::none;
        }
    }
}
namespace file_resource
{
    using parser = void
    {
        public extern func edit(val: file_resource, tag: string)=> option<file_resource>
        {
            match (FileDrop::File(tag, val.path->>\p = ResourcePath::toLocalResourcePath(p);))
            {
                value(p)?

                    return option::value(file_resource{
                            path = p->> \p = ResourcePath::toRuntimeResourcePath(p);,
                        });
                none?
                    return option::none;
            }
        }
    }
}
namespace uuid
{
    using parser = void
    {
        public extern func edit(val: uuid, tag: string)=> option<uuid>
        {
            return InputText(F"##{tag}", val as string)->> \dat = dat as uuid;;
        }
    }
}
namespace string
{
    using parser = void
    {
        public extern func edit(val: string, tag: string)=> option<string>
        {
            return InputText(F"##{tag}", val as string);
        }
    }
}

namespace UserInterface::Origin::origin_center
{
    using parser = void
    {
        public extern func edit(val: UserInterface::Origin::origin_center, tag: string)=> option<UserInterface::Origin::origin_center>
        {
            // 3×3 方位选择格：行=上/中/下，列=左/中/右，当前方位以实心
            // 圆点（RadioButton）标出；格子从控件列起点排布、间距均匀，
            // 读作一块“方位垫”，不再是一串平铺的复选框
            let cells = [
                origin_center::left + origin_center::top, origin_center::top, origin_center::right + origin_center::top,
                origin_center::left, origin_center::center, origin_center::right,
                origin_center::left + origin_center::bottom, origin_center::bottom, origin_center::right + origin_center::bottom,
            ];
            let mut newval = val;
            let col_x = Widgets::editColumnX();

            PushStyleVec2(StyleVar::ImGuiStyleVar_ItemSpacing, (10., 6.));
            for (let mut row = 0; row < 3; row += 1)
            {
                Widgets::setCursorX(col_x);
                for (let mut col = 0; col < 3; col += 1)
                {
                    if (col > 0)
                        SameLine();
                    if (RadioButton(F"##{tag}_{row * 3 + col}", cells[row * 3 + col] == val))
                        newval = cells[row * 3 + col];
                }
            }
            PopStyleVar(1);

            if (newval != val)
                return option::value(newval);
            else
                return option::none;
        }
    }
}
