import je;
import je::editor::graphic;

import pkg::std;

public func entry(_: je::graphic::texture2d, _/*lbpos*/: (int, int), _/*range*/: (int, int))
    => bool
{
    return true;
}

public func pixel(t: je::graphic::texture2d, x: int, y: int)
    => (real, real, real, real)
{
    let (r, g, b, a) = tex(t, x, y);
    return (
        r + std::rand(-0.05, 0.05), 
        g + std::rand(-0.05, 0.05),
        b + std::rand(-0.05, 0.05),
        a);
}
