namespace bool
{
    using parser = void
    {
        public extern func saving(val: bool)=> string
        {
            return val as string;
        }
        public extern func restoring(dat: string)=> bool
        {
            return dat as bool;
        }
        public extern func edit(val: bool, tag: string)=> option<bool>
        {
            return CheckBox(F"##{tag}", val);
        }
    }
}
