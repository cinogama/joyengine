// =============================================
// 这个脚本用于向引擎提供各类型的序列化拓展
// （saving / restoring；各类型的编辑器拓展见同目录 editor.wo）
// 此脚本如果存在错误，项目将无法被编辑器载入
// =============================================

namespace bool
{
    using parser = void
    {
        public extern func saving(val: bool)=> string
        {
            return val as string;
        }
        public extern func restoring(dat: string)=> bool
        {
            return dat as bool;
        }
    }
}
