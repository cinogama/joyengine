        // ==================== 单元格渲染信息（编辑器预览用） ====================
        // 某格被拆分为 1 个(普通瓦片/整块地形)或 4 个(四象限地形)子四边形；
        // 返回数据与实际渲染完全一致（含自动图块象限解析）。
        extern("libjoyecs", "wojeapi_tilemap_cell_quad_count")
            public func cell_quad_count(map: int, layer: int, x: int, y: int)=> int;

        // 返回 (源纹理路径, u0, v0, u1, v1, 象限列, 象限行, 象限网格数)；
        // UV 为引擎空间（v 向上）；象限自左上角起于 qcols×qcols 网格。
        // idx 无效时返回 none。
        extern("libjoyecs", "wojeapi_tilemap_cell_quad")
            public func cell_quad(map: int, layer: int, x: int, y: int, idx: int)=> option<(string, real, real, real, real, int, int, int)>;

        // ==================== 友好封装 ====================
        public let TILE_ID_BASE = 0x100000;

        public func tile_value(tileset_idx: int, tile_id: int)=> int
        {
            return (tileset_idx + 1) * TILE_ID_BASE + tile_id;
        }
        public func terrain_value(tileset_idx: int, terrain_id: int)=> int
        {
            return -((tileset_idx + 1) * TILE_ID_BASE + terrain_id);
        }
        // 解码瓦片值：返回 (图集下标, 局部 id, 是否地形)；v==0 时返回 (-1, 0, false)
        public func decode_value(v: int)=> (int, int, bool)
        {
            if (v == 0)
                return (-1, 0, false);
            let a = v < 0 ? -v | v;
            let idx = a / TILE_ID_BASE - 1;
            let local = a % TILE_ID_BASE;
            return (idx, local, v < 0);
        }

        public func walkable(map: int, x: int, y: int)=> bool
        {
            return is_walkable(map, x, y) != 0;
        }
        public func walkable_on(map: int, layer: int, x: int, y: int)=> bool
        {
            return is_walkable_on(map, layer, x, y) != 0;
        }

        // 类型化属性读取（无值/解析失败返回 none）
        public func property_int(map: int, layer: int, x: int, y: int, name: string)=> option<int>
        {
            match (get_property(map, layer, x, y, name))
            {
                value(s)? { return option::value(s as int); }
                none? { return option::none; }
            }
        }
        public func property_real(map: int, layer: int, x: int, y: int, name: string)=> option<real>
        {
            match (get_property(map, layer, x, y, name))
            {
                value(s)? { return option::value(s as real); }
                none? { return option::none; }
            }
        }
        public func property_bool(map: int, layer: int, x: int, y: int, name: string)=> option<bool>
        {
            match (get_property(map, layer, x, y, name))
            {
                value(s)? { return option::value(s == "true"); }
                none? { return option::none; }
            }
        }

        // 收集 find_cells 的全部命中（格子坐标列表）
        public func collect_cells(map: int, layer: int, name: string, value: string)=> vec<(int, int)>
        {
            let mut result = []mut: vec<(int, int)>;
            let count = find_cells(map, layer, name, value);
            for (let mut i = 0; i < count; i += 1)
            {
                let (x, y) = find_get(map, i);
                result->add((x, y));
            }
            return result;
        }

        // ==================== 坐标换算 ====================
        // 瓦片中心的世界坐标（相对地图根实体；地图向 +x 与 -y 展开）
        public func tile_center(map: int, x: int, y: int)=> (real, real)
        {
            let (_, _, tile_px, _) = map_size(map);
            let tpx = tile_px as real;
            return ((x as real + 0.5) * tpx, -(y as real + 0.5) * tpx);
        }
        // 世界坐标（相对地图根实体）所在瓦片
        public func tile_at_world(map: int, world_x: real, world_y: real)=> (int, int)
        {
            let (_, _, tile_px, _) = map_size(map);
            let tpx = tile_px as real;
            return ((world_x / tpx) as int, ((-world_y) / tpx) as int);
        }
    }
}
