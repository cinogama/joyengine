            // 返回 (纹理路径, 瓦片像素, 列数, 行数)
            extern("libjoyecs", "wojeapi_tilemap_source_info")
                public func source_info(self: Tileset, source_idx: int)=> (string, int, int, int);

            // ==================== 图集源纹理附加层级 ====================
            // 附加层级（如法线图集）与源纹理共用同一瓦片网格，按各自
            // 通道（pass >= 1，通道 0 由主纹理/反照率固定占用）展开为
            // 独立数组纹理供分片采样
