        // ==================== 自动图块地形种类 ====================
        public enum terrain_kind
        {
            SINGLE = 0,     // 单块：始终取锚点整块
            RPGMAKER = 1,   // RPGMaker XP 式四象限：锚点起 2x3 格条带
            BLOB47 = 2,     // blob47：47 变体（显式变体表或锚点行优先扫描）
            RPGMAKER_VX = 3, // RPGMaker VX/VX Ace 式四象限：锚点起 2x3 格
                             // 块（右上 2x2 为内部填充，与 A2 表兼容）
        }

        // ==================== 图层自阴影行为 ====================
        // 与引擎侧 je_LayerSelfShadow 一一对应（Light2D 延迟光照管线）：
        // 分片同挂 PerBlockSelfShadow，自阴影按 MAX 合并：只加深阴影，
        // 不清除本层 BlockShadow / 其它图层已写入的遮挡阴影。TopDown 下
        // 每个格子以格顶（bottom + 1）作为逐像素排序键，参与与实体
        // SelfShadow / 遮挡阴影的前后关系仲裁。
        public enum self_shadow
        {
            OFF = 0,    // 禁用：该层分片不挂 SelfShadow 组件，图块正常
                        // 接收更高层遮挡体投下的阴影
            ON = 1,     // 启用（常开）：无论光源高度，自阴影覆盖始终按
                        // factor 生效（auto_disable = false）
            AUTO = 2,   // 启用（自动）：光源不高于该层时不追加自阴影
                        // 覆盖、图块受光（auto_disable = true；仍会被
                        // 遮挡阴影遮挡）；TopDown 光源下按格判定：格底边
                        // 不低于光源高度线时该格受光，否则写 factor
                        //（分片同挂 PerBlockSelfShadow，网格顶点携带
                        // 块底边高度）
        }

        // ==================== 图层遮挡阴影行为 ====================
        // 与引擎侧 je_LayerBlockShadow 一一对应（Light2D 延迟光照管线）。
        // 轮廓阴影段的逐像素排序 key 取该段自身的最低边，并合并与本段
        // 格子严格相邻（8 邻域）的其它开启 BlockShadow 图层墙段。贴合的
        // 跨层上下墙段因此共享较低基座，不会在上段 Y 更高时被实体
        // SelfShadow 清除；隔开 2 格以上的墙不会把 key 拉低。
        public enum block_shadow
        {
            OFF = 0,    // 禁用：该层分片不挂 BlockShadow 组件，瓦片
                        // 不遮挡光线（不投阴影体）
            ON = 1,     // 启用（常开）：瓦片占据轮廓始终按 factor 投射
                        // 硬阴影，与光源高度无关（auto_disable = false）
            AUTO = 2,   // 启用（自动）：光源不高于该层时不投射遮挡
                        // 阴影（auto_disable = true）
        }

        // ==================== 属性值类型 ====================
        // 与引擎侧 je_PropertyType 一一对应；Woolang 侧的取值形态：
        //   BOOL→bool  STRING→string  INT→int  FLOAT→real
        //   VEC2→(real, real)  VEC3→(real, real, real)  VEC4→(real, real, real, real)
        // 属性接口按类型拆为对应后缀的函数（如 get_property_int）。
        public enum property_type
        {
            BOOL = 0,
            STRING = 1,
            INT = 2,
            FLOAT = 3,
            VEC2 = 4,
            VEC3 = 5,
            VEC4 = 6,
        }

        // ==================== 瓦片值编解码 ====================
        public let TILE_ID_BASE = 0x100000;

        public func tile_value(tileset_idx: int, tile_id: int)=> int
        {
            return (tileset_idx + 1) * TILE_ID_BASE + tile_id;
        }
        public func terrain_value(tileset_idx: int, terrain_id: int)=> int
        {
            return -((tileset_idx + 1) * TILE_ID_BASE + terrain_id);
        }
        // 解码瓦片值：返回 (图集下标, 局部 id, 是否地形)；空格（v==0）返回 none
        public func decode_value(v: int)=> option<(int, int, bool)>
        {
            if (v == 0)
                return option::none;
            let a = v < 0 ? -v | v;
            let idx = a / TILE_ID_BASE - 1;
            let local = a % TILE_ID_BASE;
            return option::value((idx, local, v < 0));
        }
    }
}
