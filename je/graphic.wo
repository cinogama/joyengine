        }
        
        public using render_branch = handle;
        namespace render_branch
        {
            extern("libjoyecs", "wojeapi_branch_new_frame")
                public func new_frame(self: render_branch, priority: int)=> void;
            
            extern("libjoyecs", "wojeapi_branch_new_command_buffer")
                public func new_command_buffer(self: render_branch, fb: option<framebuffer>, x: int, y: int, w: int, h: int)=> command_buffer;
        }
    }
}
