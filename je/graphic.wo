// Joyengine 4.x
import woo::std;
import je::ecs;
import pkg::buffer;

namespace je
{
    namespace graphic
    {
        public using vertex = gchandle
        {
            public enum type
            {
                LINES = 0,
                LINESTRIP,
                TRIANGLES,
                TRIANGLESTRIP,
            }
            
            extern("libjoyecs", "wojeapi_vertex_load")
                public func load(univ: option<universe>, path: string)=> option<vertex>;
                
            extern("libjoyecs", "wojeapi_vertex_create")
                public func create(vtype: type, vertices: array<real>, indices: array<int>, formats: array<int>)=> vertex;
                
            extern("libjoyecs", "wojeapi_vertex_path")
                public func path(self: vertex)=> option<string>;
        }
        
        public using texture = gchandle
        {
            extern("libjoyecs", "wojeapi_texture_open")
                public func load(univ: option<universe>, path: string)=> option<texture>;
                
            extern("libjoyecs", "wojeapi_texture_create")
                public func create(width: int, height: int)=> texture;
                
            extern("libjoyecs", "wojeapi_texture_clip")
                public func clip(src: texture, x: int, y: int, w: int, h: int)=> texture;
                
            extern("libjoyecs", "wojeapi_texture_bind_path")
                public func bind_path(self: texture, new_path: string)=> void;
                
            extern("libjoyecs", "wojeapi_texture_path")
                public func path(self: texture)=> option<string>;
                
            extern("libjoyecs", "wojeapi_texture_get_size")
                public func size(self: texture)=> (int, int);
                
            extern("libjoyecs", "wojeapi_texture_get_pixel")
                public func pix(self: texture, pos: (int, int))=> pixel;
                
            public using pixel = gchandle;
            namespace pixel
            {
                extern("libjoyecs", "wojeapi_texture_set_pixel_color")
                    public func set_color(self: pixel, rgba: (real,real,real,real))=> void;
                    
                extern("libjoyecs", "wojeapi_texture_pixel_color")
                    public func get_color(self: pixel)=> (real, real, real, real);
            }
        }
        
        public using character = struct{
            m_texture: texture,
            m_character: char,
            m_width: int,
            m_height: int,
            m_advise_width: int,
            m_advise_height: int,
            m_baseline_offset_x: int,
            m_baseline_offset_y: int,
        };
        
        public using font = gchandle
        {
            extern("libjoyecs", "wojeapi_font_open")
                public func load(path: string, font_width: int)=> option<font>;
                
            extern("libjoyecs", "wojeapi_font_load_char")
                public func load_char(self: font, ch: char)=> character;
                
            extern("libjoyecs", "wojeapi_font_string_texture")
                public func load_string(self: font, str: string)=> texture;
        }
        
        public using shader = gchandle
        {
            extern("libjoyecs", "wojeapi_shader_open")
                public func load(univ: option<universe>, path: string)=> option<shader>;
                
            extern("libjoyecs", "wojeapi_shader_create")
                public func create(univ: option<universe>, vpath: string, src: string)=> option<shader>;
                
            extern("libjoyecs", "wojeapi_shader_path")
                public func path(self: shader)=> option<string>;
                
            public union uniform_variable
            {
                integer(int),
                integer2((int, int)),
                integer3((int, int, int)),
                integer4((int, int, int, int)),
                float(real),
                float2((real, real)),
                float3((real, real, real)),
                float4((real, real, real, real)),
                texture(int),
                others,
            }
            
            public using uniform_value_data = struct {
                n : int,
                x : real,
                y : real,
                z : real,
                w : real,
            };
            
            extern("libjoyecs", "wojeapi_get_uniforms_from_shader")
                public func get_uniforms(self: shader)=> map<string, uniform_variable>;
                
            extern("libjoyecs", "wojeapi_set_uniforms_int")
                func _set_uniform_int(shad: shader, name: string, val: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int2")
                func _set_uniform_int2(shad: shader, name: string, x: int, y: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int3")
                func _set_uniform_int3(shad: shader, name: string, x: int, y: int, z: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int4")
                func _set_uniform_int4(shad: shader, name: string, x: int, y: int, z: int, w: int)=> void;
                
            extern("libjoyecs", "wojeapi_set_uniforms_float")
                func _set_uniform_float(shad: shader, name: string, val: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float2")
                func _set_uniform_float2(shad: shader, name: string, x: real, y: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float3")
                func _set_uniform_float3(shad: shader, name: string, x: real, y: real, z: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float4")
                func _set_uniform_float4(shad: shader, name: string, x: real, y: real, z: real, w: real)=> void;
                
            public func set_uniform<T>(self: shader, name: string, val: T)
                where val is int
                || val is (int, int)
                || val is (int, int, int)
                || val is (int, int, int, int)
                || val is real
                || val is (real, real)
                || val is (real, real, real)
                || val is (real, real, real, real);
            {
                if (val is int)
                    _set_uniform_int(self, name, val);
                if (val is (int, int))
                    _set_uniform_int2(self, name, val...);
                else if (val is (int, int, int))
                    _set_uniform_int3(self, name, val...);
                else if (val is (int, int, int, int))
                    _set_uniform_int4(self, name, val...);
                else if (val is real)
                    _set_uniform_float(self, name, val);
                else if (val is (real, real))
                    _set_uniform_float2(self, name, val...);
                else if (val is (real, real, real))
                    _set_uniform_float3(self, name, val...);
                else if (val is (real, real, real, real))
                    _set_uniform_float4(self, name, val...);
                else
                    std::panic("Here should not been exec.");
            }
        }
        
        public using framebuffer = gchandle
        {
            public enum color_format
            {
                MONO = 1,
                RGBA = 4,
                FLOAT16 = 16,
            }

            extern("libjoyecs", "wojeapi_framebuffer_create")
                public func create(
                    width: int,
                    height: int,
                    color_attachment_formats: array<int>,
                    contain_depth_attachment: bool)=> option<framebuffer>;

            extern("libjoyecs", "wojeapi_framebuffer_get_attachment")
                public func attachment(self: framebuffer, index: int)=> option<texture>;

            extern("libjoyecs", "wojeapi_framebuffer_get_size")
                public func size(self: framebuffer)=> (int, int);
        }
        
        public using uniformbuffer = gchandle
        {
            extern("libjoyecs", "wojeapi_uniformbuffer_create")
                public func create(binding_place: int, buffer_size: int)=> option<uniformbuffer>;
            
            extern("libjoyecs", "wojeapi_uniformbuffer_update")
                public func update(self: uniformbuffer, offset: int, data: buffer)=> void;
        }
        
        public using rendchain = handle;
        namespace rendchain
        {
            extern("libjoyecs", "wojeapi_rchain_create")
                public func create()=> rendchain;
            
            extern("libjoyecs", "wojeapi_rchain_close")
                public func close(self: rendchain)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_begin")
                public func begin(self: rendchain, fb: option<framebuffer>, x: int, y: int, w: int, h: int)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_bind_uniform_buffer")
                public func bind_uniform_buffer(self: rendchain, ub: uniformbuffer)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_clear_color_buffer")
                public func clear_color_buffer(self: rendchain, attachment_index: int, color: (real, real, real, real))=> void;
            
            extern("libjoyecs", "wojeapi_rchain_clear_depth_buffer")
                public func clear_depth_buffer(self: rendchain, depth: real)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_allocate_texture_group")
                public func allocate_texture_group(self: rendchain)=> texture_group;
            
            extern("libjoyecs", "wojeapi_rchain_bind_texture")
                public func bind_texture(self: rendchain, tg: texture_group, binding_pass: int, tex: texture)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_draw")
                public func draw(self: rendchain, shad: shader, vert: vertex, tg: option<texture_group>)=> rend_action;
            
            extern("libjoyecs", "wojeapi_rchain_commit")
                public func commit(self: rendchain, ctx: glcontext)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_get_target_framebuf")
                public func get_target_framebuf(self: rendchain)=> option<handle>;
        }
        
        public using texture_group = handle;
        
        public using rend_action = handle;
        namespace rend_action
        {
            extern("libjoyecs", "wojeapi_rchain_set_uniform_buffer")
                public func set_uniform_buffer(self: rend_action, ub: uniformbuffer)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_set_uniform_int")
                func _set_uniform_int(act: rend_action, shad: shader, name: string, val: int)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_int2")
                func _set_uniform_int2(act: rend_action, shad: shader, name: string, x: int, y: int)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_int3")
                func _set_uniform_int3(act: rend_action, shad: shader, name: string, x: int, y: int, z: int)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_int4")
                func _set_uniform_int4(act: rend_action, shad: shader, name: string, x: int, y: int, z: int, w: int)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float")
                func _set_uniform_float(act: rend_action, shad: shader, name: string, val: real)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float2")
                func _set_uniform_float2(act: rend_action, shad: shader, name: string, x: real, y: real)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float3")
                func _set_uniform_float3(act: rend_action, shad: shader, name: string, x: real, y: real, z: real)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float4")
                func _set_uniform_float4(act: rend_action, shad: shader, name: string, x: real, y: real, z: real, w: real)=> void;
            
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float2x2")
                func _set_uniform_float2x2(act: rend_action, shad: shader, name: string, 
                    m0: real, m1: real, m2: real, m3: real)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float3x3")
                func _set_uniform_float3x3(act: rend_action, shad: shader, name: string, 
                    m0: real, m1: real, m2: real, m3: real, m4: real, m5: real, m6: real, m7: real, m8: real)=> void;
            extern("libjoyecs", "wojeapi_rchain_set_uniform_float4x4")
                func _set_uniform_float4x4(act: rend_action, shad: shader, name: string, 
                    m0: real, m1: real, m2: real, m3: real, 
                    m4: real, m5: real, m6: real, m7: real, 
                    m8: real, m9: real, m10: real, m11: real, 
                    m12: real, m13: real, m14: real, m15: real)=> void;
            
            public func set_uniform<T>(self: rend_action, shad: shader, name: string, val: T)
                where val is int
                || val is (int, int)
                || val is (int, int, int)
                || val is (int, int, int, int)
                || val is real
                || val is (real, real)
                || val is (real, real, real)
                || val is (real, real, real, real);
            {
                if (val is int)
                    _set_uniform_int(self, shad, name, val);
                else if (val is (int, int))
                    _set_uniform_int2(self, shad, name, val...);
                else if (val is (int, int, int))
                    _set_uniform_int3(self, shad, name, val...);
                else if (val is (int, int, int, int))
                    _set_uniform_int4(self, shad, name, val...);
                else if (val is real)
                    _set_uniform_float(self, shad, name, val);
                else if (val is (real, real))
                    _set_uniform_float2(self, shad, name, val...);
                else if (val is (real, real, real))
                    _set_uniform_float3(self, shad, name, val...);
                else if (val is (real, real, real, real))
                    _set_uniform_float4(self, shad, name, val...);
                else
                    std::panic("Here should not been exec.");
            }
            
            public func set_uniform_mat4x4(self: rend_action, shad: shader, name: string, val: (real, real, real, real, real, real, real, real, real, real, real, real, real, real, real, real))
            {
                _set_uniform_float4x4(self, shad, name, val...);
            }
            
            public func set_uniform_mat3x3(self: rend_action, shad: shader, name: string, val: (real, real, real, real, real, real, real, real, real))
            {
                _set_uniform_float3x3(self, shad, name, val...);
            }
            
            public func set_uniform_mat2x2(self: rend_action, shad: shader, name: string, val: (real, real, real, real))
            {
                _set_uniform_float2x2(self, shad, name, val...);
            }
        }
        
        public using glcontext = handle;
        
        public using graphic_uhost = handle;
        namespace graphic_uhost
        {
            extern("libjoyecs", "wojeapi_uhost_get_or_create_for_universe")
                public func get_or_create(u: universe)=> graphic_uhost;
            
            extern("libjoyecs", "wojeapi_uhost_get_context")
                public func get_context(self: graphic_uhost)=> glcontext;
            
            extern("libjoyecs", "wojeapi_uhost_set_skip_behavior")
                public func set_skip_behavior(self: graphic_uhost, skip_all_draw: bool)=> void;
            
            extern("libjoyecs", "wojeapi_uhost_alloc_branch")
                public func alloc_branch(self: graphic_uhost)=> rendchain_branch;
            
            extern("libjoyecs", "wojeapi_uhost_free_branch")
                public func free_branch(self: graphic_uhost, br: rendchain_branch)=> void;
        }
        
        public using rendchain_branch = handle;
        namespace rendchain_branch
        {
            extern("libjoyecs", "wojeapi_branch_new_frame")
                public func new_frame(self: rendchain_branch, priority: int)=> void;
            
            extern("libjoyecs", "wojeapi_branch_new_chain")
                public func new_chain(self: rendchain_branch, fb: option<framebuffer>, x: int, y: int, w: int, h: int)=> rendchain;
        }
    }
}
