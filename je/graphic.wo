// Joyengine 4.x
import pkg::std;

import je::ecs;

import pkg::buffer;

namespace je
{
    namespace graphic
    {
        public using vertex = gchandle
        {
            public enum type
            {
                LINESTRIP = 0,
                TRIANGLES,
                TRIANGLESTRIP,
            }
            
            extern("libjoyecs", "wojeapi_vertex_load")
                public func load(univ: option<universe>, path: string)=> option<vertex>;
                
            extern("libjoyecs", "wojeapi_vertex_create")
                public func create(vtype: type, vertices: array<real>, indices: array<int>, formats: array<int>)=> option<vertex>;
                
            extern("libjoyecs", "wojeapi_vertex_path")
                public func path(self: vertex)=> option<string>;

            // 整体重写顶点数据并收缩激活索引数量（语义见
            // jegl_update_vertex_buffer）：vertices 为一份完整的顶点数据，
            // 不能超过创建时的容量；indices 只取"激活索引数量"一个语义
            //（索引缓冲保持创建时的内容不变）。注意包围盒不会重算，
            // 依赖视锥剔除的调用方应以覆盖完整范围的初始数据创建缓冲。
            extern("libjoyecs", "wojeapi_vertex_update")
                public func update(self: vertex, vertices: array<real>, indices: int)=> void;

            // 模型顶点数据的局部空间包围盒，返回
            // (min_x, min_y, min_z, max_x, max_y, max_z)；
            // 顶点格式不含 3 分量位置时包围盒为全 0（由调用方处理退化）
            extern("libjoyecs", "wojeapi_vertex_aabb")
                public func aabb(self: vertex)=> (real, real, real, real, real, real);
        }
        
        public using texture2d = gchandle
        {
            extern("libjoyecs", "wojeapi_texture2d_open")
                public func load(univ: option<universe>, path: string)=> option<texture2d>;

            extern("libjoyecs", "wojeapi_texture2d_create")
                public func create(width: int, height: int)=> texture2d;

            extern("libjoyecs", "wojeapi_texture2d_clip")
                public func clip(src: texture2d, x: int, y: int, w: int, h: int)=> texture2d;

            extern("libjoyecs", "wojeapi_texture2d_bind_path")
                public func bind_path(self: texture2d, new_path: string)=> void;

            extern("libjoyecs", "wojeapi_texture2d_path")
                public func path(self: texture2d)=> option<string>;

            extern("libjoyecs", "wojeapi_texture2d_size")
                public func size(self: texture2d)=> (int, int);

            extern("libjoyecs", "wojeapi_texture2d_pix")
                public func pix(self: texture2d, pos: (int, int))=> pixel;

            public using pixel = gchandle;
            namespace pixel
            {
                extern("libjoyecs", "wojeapi_texture_set_pixel_color")
                    public func set_color(self: pixel, rgba: (real,real,real,real))=> void;

                extern("libjoyecs", "wojeapi_texture_pixel_color")
                    public func get_color(self: pixel)=> (real, real, real, real);
            }
        }

        public using texture3d = gchandle
        {
            extern("libjoyecs", "wojeapi_texture3d_create")
                public func create(width: int, height: int, depth: int)=> texture3d;
        }

        public using texture_array = gchandle
        {
            extern("libjoyecs", "wojeapi_texturearray_create")
                public func create(width: int, height: int, layers: int)=> texture_array;

            extern("libjoyecs", "wojeapi_texturearray_layers")
                public func layers(self: texture_array)=> int;

            // 直接改写纹理层数据（经引擎侧 API 获取像素指针）后，
            // 调用此接口触发重上传
            extern("libjoyecs", "wojeapi_texturearray_mark_modified")
                public func mark_modified(self: texture_array)=> void;
        }

        public using texture_cube = gchandle
        {
            extern("libjoyecs", "wojeapi_texturecube_create")
                public func create(width: int, height: int)=> texture_cube;
        }

        public using texture_msaa = gchandle
        {
            extern("libjoyecs", "wojeapi_texturemsaa_create")
                public func create(width: int, height: int, samples: int)=> texture_msaa;
        }

        public using character = struct{
            m_texture: texture2d,
            m_character: char,
            m_width: int,
            m_height: int,
            m_advise_width: int,
            m_advise_height: int,
            m_baseline_offset_x: int,
            m_baseline_offset_y: int,
        };
        
        public using font = gchandle
        {
            extern("libjoyecs", "wojeapi_font_open")
                public func load(path: string)=> option<font>;

            extern("libjoyecs", "wojeapi_font_load_char")
                public func load_char(self: font, size: int, ch: char)=> character;
        }
        
        public using shader = gchandle
        {
            extern("libjoyecs", "wojeapi_shader_open")
                public func load(univ: option<universe>, path: string)=> option<shader>;
                
            extern("libjoyecs", "wojeapi_shader_create")
                public func create(univ: option<universe>, vpath: string, src: string)=> option<shader>;
                
            extern("libjoyecs", "wojeapi_shader_path")
                public func path(self: shader)=> option<string>;
                
            public union uniform_variable
            {
                integer(int),
                integer2((int, int)),
                integer3((int, int, int)),
                integer4((int, int, int, int)),
                float(real),
                float2((real, real)),
                float3((real, real, real)),
                float4((real, real, real, real)),
                texture(int),
                others,
                // Declared by woshader::Type::Color; stored as linear RGBA.
                color((real, real, real, real)),
            }
            
            public using uniform_value_data = struct {
                n : int,
                x : real,
                y : real,
                z : real,
                w : real,
            };
            
            extern("libjoyecs", "wojeapi_get_uniforms_from_shader")
                public func get_uniforms(self: shader)=> map<string, uniform_variable>;
                
            extern("libjoyecs", "wojeapi_set_uniforms_int")
                func _set_uniform_int(shad: shader, name: string, val: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int2")
                func _set_uniform_int2(shad: shader, name: string, x: int, y: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int3")
                func _set_uniform_int3(shad: shader, name: string, x: int, y: int, z: int)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_int4")
                func _set_uniform_int4(shad: shader, name: string, x: int, y: int, z: int, w: int)=> void;
                
            extern("libjoyecs", "wojeapi_set_uniforms_float")
                func _set_uniform_float(shad: shader, name: string, val: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float2")
                func _set_uniform_float2(shad: shader, name: string, x: real, y: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float3")
                func _set_uniform_float3(shad: shader, name: string, x: real, y: real, z: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_float4")
                func _set_uniform_float4(shad: shader, name: string, x: real, y: real, z: real, w: real)=> void;
            extern("libjoyecs", "wojeapi_set_uniforms_color")
                func _set_uniform_color(shad: shader, name: string, x: real, y: real, z: real, w: real)=> void;
                
            public func set_uniform<T>(self: shader, name: string, val: T)
                where val is int
                || val is (int, int)
                || val is (int, int, int)
                || val is (int, int, int, int)
                || val is real
                || val is (real, real)
                || val is (real, real, real)
                || val is (real, real, real, real);
            {
                if (val is int)
                    _set_uniform_int(self, name, val);
                if (val is (int, int))
                    _set_uniform_int2(self, name, val...);
                else if (val is (int, int, int))
                    _set_uniform_int3(self, name, val...);
                else if (val is (int, int, int, int))
                    _set_uniform_int4(self, name, val...);
                else if (val is real)
                    _set_uniform_float(self, name, val);
                else if (val is (real, real))
                    _set_uniform_float2(self, name, val...);
                else if (val is (real, real, real))
                    _set_uniform_float3(self, name, val...);
                else if (val is (real, real, real, real))
                    _set_uniform_float4(self, name, val...);
                else
                    std::panic("Here should not been exec.");
            }
            // Color uniforms carry linear RGBA. This variant is explicit so
            // callers can express colour intent; the underlying slot is float4.
            public func set_uniform_color(
                self: shader, name: string, val: (real, real, real, real))=> void
            {
                _set_uniform_color(self, name, val...);
            }
        }
        
        public using framebuffer = gchandle
        {
            public enum color_format
            {
                MONO = 1,
                RGBA = 4,
                FLOAT16 = 16,
            }

            extern("libjoyecs", "wojeapi_framebuffer_create")
                public func create(
                    width: int,
                    height: int,
                    color_attachment_formats: array<int>,
                    contain_depth_attachment: bool)=> option<framebuffer>;

            extern("libjoyecs", "wojeapi_framebuffer_get_attachment")
                public func attachment(self: framebuffer, index: int)=> option<texture2d>;

            extern("libjoyecs", "wojeapi_framebuffer_get_size")
                public func size(self: framebuffer)=> (int, int);
        }
        
        public using uniformbuffer = gchandle
        {
            extern("libjoyecs", "wojeapi_uniformbuffer_create")
                public func create(binding_place: int, buffer_size: int)=> option<uniformbuffer>;
            extern("libjoyecs", "wojeapi_uniformbuffer_update")
                public func update(self: uniformbuffer, offset: int, data: buffer)=> void;
        }
        
        public using command_buffer = handle;
        namespace command_buffer
        {
            extern("libjoyecs", "wojeapi_command_buffer_bind_uniform_buffer")
                public func bind_uniform_buffer(self: command_buffer, ub: uniformbuffer)=> void;
            
            extern("libjoyecs", "wojeapi_command_buffer_clear_color_buffer")
                public func clear_color_buffer(self: command_buffer, attachment_index: int, color: (real, real, real, real))=> void;
            
            extern("libjoyecs", "wojeapi_command_buffer_clear_depth_buffer")
                public func clear_depth_buffer(self: command_buffer, depth: real)=> void;
            
            extern("libjoyecs", "wojeapi_command_buffer_bind_texture")
                public func bind_texture(self: command_buffer, binding_pass: int, tex: texture2d)=> void;
            
            extern("libjoyecs", "wojeapi_command_buffer_draw")
                public func draw(self: command_buffer, shad: shader, vert: vertex)=> draw_action;
            
            extern("libjoyecs", "wojeapi_command_buffer_commit")
                public func commit(self: command_buffer)=> void;
        }
        
        public using draw_action = handle;
        namespace draw_action
        {
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_int")
                func _set_uniform_int(act: draw_action, shad: shader, name: string, val: int)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_int2")
                func _set_uniform_int2(act: draw_action, shad: shader, name: string, x: int, y: int)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_int3")
                func _set_uniform_int3(act: draw_action, shad: shader, name: string, x: int, y: int, z: int)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_int4")
                func _set_uniform_int4(act: draw_action, shad: shader, name: string, x: int, y: int, z: int, w: int)=> void;
            
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float")
                func _set_uniform_float(act: draw_action, shad: shader, name: string, val: real)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float2")
                func _set_uniform_float2(act: draw_action, shad: shader, name: string, x: real, y: real)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float3")
                func _set_uniform_float3(act: draw_action, shad: shader, name: string, x: real, y: real, z: real)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float4")
                func _set_uniform_float4(act: draw_action, shad: shader, name: string, x: real, y: real, z: real, w: real)=> void;
            
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float2x2")
                func _set_uniform_float2x2(act: draw_action, shad: shader, name: string,
                    m0: real, m1: real, m2: real, m3: real)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float3x3")
                func _set_uniform_float3x3(act: draw_action, shad: shader, name: string,
                    m0: real, m1: real, m2: real, m3: real, m4: real, m5: real, m6: real, m7: real, m8: real)=> void;
            extern("libjoyecs", "wojeapi_draw_action_set_uniform_float4x4")
                func _set_uniform_float4x4(act: draw_action, shad: shader, name: string,
                    m0: real, m1: real, m2: real, m3: real, 
                    m4: real, m5: real, m6: real, m7: real, 
                    m8: real, m9: real, m10: real, m11: real, 
                    m12: real, m13: real, m14: real, m15: real)=> void;
            
            public func set_uniform<T>(self: draw_action, shad: shader, name: string, val: T)
                where val is int
                || val is (int, int)
                || val is (int, int, int)
                || val is (int, int, int, int)
                || val is real
                || val is (real, real)
                || val is (real, real, real)
                || val is (real, real, real, real);
            {
                if (val is int)
                    _set_uniform_int(self, shad, name, val);
                else if (val is (int, int))
                    _set_uniform_int2(self, shad, name, val...);
                else if (val is (int, int, int))
                    _set_uniform_int3(self, shad, name, val...);
                else if (val is (int, int, int, int))
                    _set_uniform_int4(self, shad, name, val...);
                else if (val is real)
                    _set_uniform_float(self, shad, name, val);
                else if (val is (real, real))
                    _set_uniform_float2(self, shad, name, val...);
                else if (val is (real, real, real))
                    _set_uniform_float3(self, shad, name, val...);
                else if (val is (real, real, real, real))
                    _set_uniform_float4(self, shad, name, val...);
                else
                    std::panic("Here should not been exec.");
            }

            public func set_uniform_color(
                self: draw_action, shad: shader, name: string,
                val: (real, real, real, real))=> void
            {
                _set_uniform_float4(self, shad, name, val...);
            }

            public func set_uniform_mat4x4(
                self: draw_action,
                shad: shader, 
                name: string, 
                val: (real, real, real, real, real, real, real, real, real, real, real, real, real, real, real, real))
            {
                _set_uniform_float4x4(self, shad, name, val...);
            }
            
            public func set_uniform_mat3x3(
                self: draw_action,
                shad: shader, 
                name: string, 
                val: (real, real, real, real, real, real, real, real, real))
            {
                _set_uniform_float3x3(self, shad, name, val...);
            }
            
            public func set_uniform_mat2x2(
                self: draw_action,
                shad: shader, 
                name: string, 
                val: (real, real, real, real))
            {
                _set_uniform_float2x2(self, shad, name, val...);
            }
        }
        
        public using glcontext = handle;
        
        public using graphic_uhost = handle;
