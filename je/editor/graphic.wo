// Joyengine 4.x
//
// 状态说明（2026-11 核对）：本文件当前无任何引用——没有模块 import 它，
// 也没有按文件名的动态加载点；且其自身已无法通过编译检查（缺少
// import je::graphic）。pixel/entry/main 的 extern 契约看起来是早期
// "脚本化像素处理"方案的模板遗留。确认无用后可删除。
import je;

public func tex(t: je::graphic::texture2d, x: int, y: int)
{
    return t->pix((x, y))->get_color();
}

// 需要两个函数:
// pixel: (tex, int, int)=> (real, real, real, real)
// entry: (tex)=> bool

func main_impl<VoidT>(target_texture: je::graphic::texture2d, (lx, ly): (int, int), (rw, rh): (int, int))
{
    if (!entry(target_texture, (lx, ly), (rw, rh)))
        return;
        
    let result_pixels = array::create(rw * rh, mut (0.,0.,0.,0.));
    
    for (let mut y = 0; y < rh; y += 1)
        for (let mut x = 0; x < rw; x += 1)
            result_pixels[y * rw + x] = pixel(target_texture, x + lx, y + ly);
            
    for (let mut y = 0; y < rh; y += 1)
        for (let mut x = 0; x < rw; x += 1)
            target_texture->pix((x + lx, y + ly))->set_color(result_pixels[y * rw + x]);
}
extern func main(target_texture: je::graphic::texture2d, lbpos: (int, int), range: (int, int))
{
    main_impl:<void>(target_texture, lbpos, range);
}
